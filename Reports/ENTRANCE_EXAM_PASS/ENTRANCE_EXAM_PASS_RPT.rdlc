  <Code>Function ToKhmer(num As String) As String
    Dim s As String = CStr(num)
    s = s.Replace("0","០")
    s = s.Replace("1","១")
    s = s.Replace("2","២")
    s = s.Replace("3","៣")
    s = s.Replace("4","៤")
    s = s.Replace("5","៥")
    s = s.Replace("6","៦")
    s = s.Replace("7","៧")
    s = s.Replace("8","៨")
    s = s.Replace("9","៩")
    Return s
End Function</Code>
