          <Textbox Name="Textbox12">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="បញ្ឈប់បញ្ចីឈ្មោះត្រឹម " 
&amp; Code.ToKhmer(Count(Fields!SEX.Value)) 
&amp; " នាក់ ស្រីចំនួន " 
&amp; Code.ToKhmer(Sum(IIf(Fields!SEX.Value = "Female", 1, 0))) 
&amp; " នាក់"</Value>
                    <Style>
                      <FontFamily>Khmer OS Battambang</FontFamily>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Left</TextAlign>
                </Style>
