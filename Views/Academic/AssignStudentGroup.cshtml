@using BBU_SYSTEM.Data
@{
    ViewData["Title"] = "Index";
    ViewData["OpenMenu"] = "AcademicTask";
    ViewData["Action"] = "AssignGroup"; 
    var campuses = AssignGroupCampusConstant.Campuses;
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <div class="row">
                    <div class="col-12">
                        <div class="margin" id="rangeButtons">
                            @foreach (var item in campuses.Select((st, index) => new { st, index }))
                            {
                                var btnClass = item.index == 0 ? "btn-primary active" : "btn-outline-primary";
                                <button type="button" class="btn @btnClass btn-sm" value="@item.st.Key">
                                    @item.st.Value
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div id="formContainer"></div>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
@section Scripts
{
    <script src="~/function/Degree.js"></script>
    <script src="~/function/School.js"></script>
    <script src="~/function/Field.js"></script>
    <script src="~/function/Promotion.js"></script>
    <script src="~/function/Stage.js"></script>
    <script src="~/function/Term.js"></script>
    <script src="~/function/Group.js"></script>
    <script src="~/function/AssignStudentGroup.js"></script>
}