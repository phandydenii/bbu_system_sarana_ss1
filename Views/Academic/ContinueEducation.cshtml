 @{
    ViewData["Title"] = "Index";
    ViewData["OpenMenu"] = "AcademicTask";
    ViewData["Action"] = "ContinueEducation";
}
<div class="card card-primary card-outline card-outline-tabs">
    <div class="card-header p-0 border-bottom-0">
        <ul class="nav nav-tabs" id="custom-tabs-four-tab" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" id="custom-tabs-four-tab1-tab" data-toggle="pill"
                   href="#custom-tabs-four-tab1" role="tab"
                   aria-controls="custom-tabs-four-tab1"
                   aria-selected="true">ពិន្ទុពីសាកលវិទ្យាល័យផ្សេង</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="custom-tabs-four-tab2-tab" data-toggle="pill"
                   href="#custom-tabs-four-tab2" role="tab" aria-controls="custom-tabs-four-tab2"
                   aria-selected="false">
                    មុខវិជ្ជាប្រឡងសង
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="custom-tabs-four-tab3-tab" data-toggle="pill"
                   href="#custom-tabs-four-tab3" role="tab"
                   aria-controls="custom-tabs-four-tab3"
                   aria-selected="false">
                    ប្រវត្តពិន្ទុប្រឡងសង
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="custom-tabs-four-tab4-tab" data-toggle="pill"
                   href="#custom-tabs-four-tab4" role="tab" aria-controls="custom-tabs-four-tab4"
                   aria-selected="false">
                    បំពេញបន្ថែម
                </a>
            </li>
        </ul>
    </div>
    <div class="tab-content" id="custom-tabs-four-tabContent">
        <div class="tab-pane fade show active" id="custom-tabs-four-tab1" role="tabpanel"
             aria-labelledby="custom-tabs-four-tab1-tab">
            <partial name="ContinueEducation/StudentOtherUniversity"/>
        </div>
        <div class="tab-pane fade show" id="custom-tabs-four-tab2" role="tabpanel"
             aria-labelledby="custom-tabs-four-tab2-tab">
            <partial name="ContinueEducation/StudentReExam"/>
        </div>
        <div class="tab-pane fade show" id="custom-tabs-four-tab3" role="tabpanel"
             aria-labelledby="custom-tabs-four-tab3-tab">
            <partial name="ContinueEducation/ExamScoreHistory"/>
        </div>
        <div class="tab-pane fade show" id="custom-tabs-four-tab4" role="tabpanel"
             aria-labelledby="custom-tabs-four-tab4-tab">
            <partial name="ContinueEducation/ComplementationSemester"/>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
@section Scripts
{
    <script src="~/function/ContinueEducation.js"></script>
}
