@using BBU_SYSTEM.ViewModel
@{
    var req = new AssignGroupViewModel();
}
<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Filter Diploma Group</h3>
            </div>
            <div class="card-body" style="height: 500px;">
                <form id="frmFilter">
                    <input asp-for="@req.IsAll" type="checkbox" checked="checked" hidden="hidden"/>
                    <div class="row">
                        <div class="col-12">
                            <label aria-required="true" class="required">Degree</label>
                            <select id="cboDegree" asp-for="@req.DegreeId" class="form-control select2"
                                    disabled="disabled">
                            </select>
                        </div>
                    </div> 
                    <div class="row">
                        <div class="col-12">
                            <label class="required">School</label>
                            <select id="cboSchool" asp-for="@req.SchoolId" class="form-control select2">
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <label>Field</label>
                            <select asp-for="@req.FieldId" class="form-control select2">
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-4">
                            <label>Promotion</label>
                            <select id="cboPromotion" asp-for="@req.PromotionId"
                                    class="form-control select2">
                            </select>
                        </div>
                        <div class="col-4">
                            <label>Stage</label>
                            <select id="cboStage" asp-for="@req.StageId" class="form-control select2">
                            </select>
                        </div>
                        <div class="col-4">
                            <label>Study Time</label>
                            <select id="cboStudyTime" asp-for="@req.StudyTime"
                                    class="form-control select2">
                                <option selected="selected" disabled value="0">Study Time</option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="card-footer">
                <button class="btn btn-success float-right" id="btnFilter" form="frmFilter"><i
                                                                                                class="fas fa-filter"></i>
                    Filter
                </button>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Students List</h3>
                <h3 class="card-title float-right">Selected Students: <span id="countStudent">0</span>
                </h3>
            </div>
            <div class="card-body table-responsive p-0" style="height: 500px;">
                <table id="tblStudent"
                       class="table table-sm table-bordered table-striped table-head-fixed text-nowrap">
                    <thead>
                    <tr>
                        <th>no</th>
                        <th>student_id</th>
                        <th>name</th>
                        <th>gender</th>
                        <th>dob</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
            <div class="card-footer">
                <div class="row">
                    <div class="col-sm-2">
                        <div class="form-group">
                            <div class="form-group clearfix">
                                <div class="icheck-primary d-inline">
                                    <input type="checkbox" id="allStudent" required>
                                    <label for="allStudent">Select all</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="form-group clearfix">
                            <div class="icheck-primary d-inline">
                                <input type="checkbox" id="chbGroupAllStage">
                                <label for="chbGroupAllStage">Group all stage</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <div class="form-group clearfix">
                            <div class="icheck-primary d-inline">
                                <input type="checkbox" id="chbGroupAllStudyTime">
                                <label for="chbGroupAllStudyTime">Group all study time</label>
                            </div>
                        </div>
                    </div>
                    @* <label class="col-sm-2"> Assign to group</label> *@
                    <div class="col-sm-3">
                        <select id="cboGroup" class="form-control select2">
                            <option selected="selected" disabled value="-1">Select Group</option>
                        </select>
                    </div>
                    <button id="btnAssignGroup" class="btn btn-success btn-sm col-sm-1">
                        Assign
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    async function GetDegree() {
        const cboDegree = $("#cboDegree");
        cboDegree.empty();
        cboDegree.append(`<option value='0' disabled>Select Degree</option>`);
        const degrees = await Degree.GetAllDegree();
        degrees.forEach(item => {
            cboDegree.append(`<option value='${item.degreeId}'>${item.degreeName}</option>`);
        });
        cboDegree.val('3').trigger("change");
    }

    $(document).ready(function () {
        $(".select2").select2();
        GetDegree();
    });

    async function filterDiploma() {
        //degree, school, promotion, stage, study-time
        $.ajax({
            url: `/student/get-students-registry-diploma`,
            type: "POST",
            data: frmFilter.serialize(),
            success: function (data) {
                // console.log(data);
                // clear old table data
                tblStudent.find("tbody").empty();
                // loop and append
                data.data.forEach(function (item, index) {
                    tblStudent.find("tbody").append(`
                            <tr>
                                <td>${index + 1}</td>
                                <td>${item.studentId}</td>
                                <td>${item.studentName}</td>
                                <td>${item.sex}</td>
                                <td>${formatDate(item.dateOfBirth)}</td>
                            </tr>
                        `);
                });
            },
            error: function (xhr) {
                console.log(xhr.responseText);
            }
        });
    }
</script>