@using BBU_SYSTEM.ViewModel

@{
var req = new AssignGroupViewModel();
}

<div id="doctor_formRoot" class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Filter Doctor Group</h3>
            </div>

            <div class="card-body" style="height: 500px;">
                <form id="doctor_frmFilter">
                    @Html.AntiForgeryToken()

                    <input asp-for="@req.IsAll"
                           type="checkbox"
                           checked="checked"
                           hidden="hidden" />

                    <div class="row">
                        <div class="col-12">
                            <label class="required">Degree</label>
                            <select id="doctor_cboDegree"
                                    asp-for="@req.DegreeId"
                                    class="form-control select2"
                                    disabled="disabled">
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <label class="required">School</label>
                            <select id="doctor_cboSchool"
                                    asp-for="@req.SchoolId"
                                    class="form-control select2">
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <label class="required">Field</label>
                            <select id="doctor_cboField"
                                    asp-for="@req.FieldId"
                                    class="form-control select2">
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-6">
                            <label class="required">Promotion</label>
                            <select id="doctor_cboPromotion"
                                    asp-for="@req.PromotionId"
                                    class="form-control select2">
                            </select>
                        </div>

                        <div class="col-6">
                            <label class="required">Stage</label>
                            <select id="doctor_cboStage"
                                    asp-for="@req.StageId"
                                    class="form-control select2">
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <label class="required">Study Time</label>
                            <select id="doctor_cboStudyTime"
                                    asp-for="@req.StudyTime"
                                    class="form-control select2">
                            </select>
                        </div>
                    </div>
                </form>
            </div>

            <div class="card-footer">
                <button type="button"
                        class="btn btn-success float-right"
                        id="doctor_btnFilter">
                    <i class="fas fa-filter"></i> Filter
                </button>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Students List</h3>
                <h3 class="card-title float-right">
                    Selected Students: <span id="doctor_countStudent">0</span>
                </h3>
            </div>

            <div class="card-body table-responsive p-0" style="height: 500px;">
                <table id="doctor_tblStudent"
                       class="table table-sm table-bordered table-striped table-head-fixed text-nowrap"
                       style="width: 100%;">
                    <thead>
                    <tr>
                        <th class="text-center" style="width: 36px;">
                            <button type="button"
                                    id="doctor_btnSelectAllStudent"
                                    class="btn btn-sm btn-light p-0"
                                    title="Select all students"
                                    style="width: 26px; height: 26px;">
                                <i class="fas fa-check-double"></i>
                            </button>
                        </th>
                        <th class="text-center">student_id</th>
                        <th>name</th>
                        <th>name_in_khmer</th>
                        <th class="text-center">gender</th>
                        <th class="text-center">dob</th>
                    </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

            <div class="card-footer">
                <div class="row align-items-center">
                    <div class="col-sm-3">
                        <div class="icheck-primary d-inline">
                            <input type="checkbox" id="doctor_chbGroupAllStage">
                            <label for="doctor_chbGroupAllStage">Group all stage</label>
                        </div>
                    </div>

                    <div class="col-sm-3">
                        <div class="icheck-primary d-inline">
                            <input type="checkbox" id="doctor_chbGroupAllStudyTime">
                            <label for="doctor_chbGroupAllStudyTime">Group all study time</label>
                        </div>
                    </div>

                    <div class="col-sm-4">
                        <select id="doctor_cboGroup" class="form-control select2">
                            <option value="" selected disabled>Assign to group</option>
                        </select>
                    </div>

                    <div class="col-sm-2">
                        <button type="button"
                                id="doctor_btnAssignGroup"
                                class="btn btn-success btn-sm btn-block">
                            <i class="fas fa-check"></i> Assign
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(async function () {
        const formRoot = $("#doctor_formRoot");
        const cboDegree = $("#doctor_cboDegree");
        const cboSchool = $("#doctor_cboSchool");
        const cboField = $("#doctor_cboField");
        const cboPromotion = $("#doctor_cboPromotion");
        const cboStage = $("#doctor_cboStage");
        const cboStudyTime = $("#doctor_cboStudyTime");
        const cboGroup = $("#doctor_cboGroup");

        const tblStudent = $("#doctor_tblStudent");
        const btnFilter = $("#doctor_btnFilter");
        const btnAssignGroup = $("#doctor_btnAssignGroup");
        const btnSelectAllStudent = $("#doctor_btnSelectAllStudent");
        const chbGroupAllStage = $("#doctor_chbGroupAllStage");
        const chbGroupAllStudyTime = $("#doctor_chbGroupAllStudyTime");

        const selectedStudentIds = new Set();
        let dtStudent = null;

        formRoot.find(".select2").select2({
            width: "100%"
        });

        btnFilter.prop("disabled", true);
        btnAssignGroup.prop("disabled", true);

        function getItems(response) {
            if (Array.isArray(response)) {
                return response;
            }

            return response && Array.isArray(response.data)
                ? response.data
                : [];
        }

        function resetSelect(select, placeholder) {
            select
                .empty()
                .append(`<option value="" selected disabled>${placeholder}</option>`)
                .val("")
                .trigger("change.select2");
        }

        function hasFilterValues() {
            return Boolean(
                cboDegree.val() &&
                cboSchool.val() &&
                cboField.val() &&
                cboPromotion.val() &&
                cboStage.val() &&
                cboStudyTime.val()
            );
        }

        function updateFilterButton() {
            btnFilter.prop("disabled", !hasFilterValues());
        }

        function updateSelectionState() {
            const checkboxes = tblStudent.find("tbody .chkStudentRow");
            const allVisibleSelected =
                checkboxes.length > 0 &&
                checkboxes.filter(":checked").length === checkboxes.length;

            $("#doctor_countStudent").text(selectedStudentIds.size);

            btnAssignGroup.prop(
                "disabled",
                selectedStudentIds.size === 0 || !cboGroup.val()
            );

            btnSelectAllStudent
                .find("i")
                .toggleClass("fa-check-double", !allVisibleSelected)
                .toggleClass("fa-times", allVisibleSelected);

            btnSelectAllStudent.attr(
                "title",
                allVisibleSelected
                    ? "Unselect all students"
                    : "Select all students"
            );
        }

        async function GetDegree() {
            resetSelect(cboDegree, "Select Degree");

            const degrees = getItems(await Degree.GetAllDegree());

            degrees.forEach(function (item) {
                cboDegree.append(
                    `<option value="${item.degreeId}">${item.degreeName}</option>`
                );
            });

            // Doctor degree
            cboDegree.val("5").trigger("change.select2");
        }

        async function GetSchool() {
            resetSelect(cboSchool, "Select School");

            const schools = getItems(await School.GetSchool());

            schools.forEach(function (item) {
                cboSchool.append(
                    `<option value="${item.schoolId}">${item.schoolName}</option>`
                );
            });
        }

        async function GetField() {
            resetSelect(cboField, "Select Field");

            const degreeId = Number(cboDegree.val()) || 0;
            const schoolId = Number(cboSchool.val()) || 0;

            if (!degreeId || !schoolId) {
                updateFilterButton();
                return;
            }

            const fields = getItems(await Field.GetFields({
                isAll: true,
                degreeId: degreeId,
                schoolId: schoolId
            }));

            fields.forEach(function (item) {
                cboField.append(
                    `<option value="${item.fieldId}">${item.fieldName}</option>`
                );
            });

            updateFilterButton();
        }

        async function GetPromotion() {
            resetSelect(cboPromotion, "Promotion");
            resetSelect(cboStage, "Stage");
            resetSelect(cboGroup, "Assign to group");

            const degreeId = Number(cboDegree.val()) || 0;
            const schoolId = Number(cboSchool.val()) || 0;

            if (!degreeId || !schoolId) {
                updateFilterButton();
                return;
            }

            const promotions = getItems(await Promotion.GetPromotions({
                isSelect2: true,
                degreeId: degreeId,
                schoolId: schoolId
            }));

            if (promotions.length === 0) {
                resetSelect(cboPromotion, "No promotion available");
                updateFilterButton();
                return;
            }

            promotions.forEach(function (item) {
                cboPromotion.append(
                    `<option value="${item.promotionId}">${item.promotionNo}</option>`
                );
            });

            updateFilterButton();
        }

        async function GetStage() {
            resetSelect(cboStage, "Stage");
            resetSelect(cboGroup, "Assign to group");

            const promotionId = Number(cboPromotion.val()) || 0;

            if (!promotionId) {
                updateFilterButton();
                return;
            }

            const stages = getItems(await Stage.GetStages({
                promotionId: promotionId
            }));

            stages.forEach(function (item) {
                cboStage.append(
                    `<option value="${item.stageId}">${item.stageNo}</option>`
                );
            });

            updateFilterButton();
        }

        async function GetStudyTime() {
            resetSelect(cboStudyTime, "Study Time");

            try {
                const response = await fetch("/study-time/get-study-time");
                const result = await response.json();
                const studyTimes = getItems(result);

                studyTimes.forEach(function (item) {
                    cboStudyTime.append(
                        `<option value="${item.studyTimeValue}">${item.studyTimeValue}</option>`
                    );
                });
            } catch (error) {
                ShowToastError("Failed to load study times.");
            }

            updateFilterButton();
        }

        async function GetGroup() {
            resetSelect(cboGroup, "Assign to group");
            updateSelectionState();

            const promotionId = Number(cboPromotion.val()) || 0;
            const stageNo = cboStage.find("option:selected").text();
            const studyTime = cboStudyTime.val();

            if (!promotionId || !cboStage.val() || !studyTime) {
                return;
            }

            try {
                const response = await $.ajax({
                    url: "/group/get-groups-filter",
                    type: "POST",
                    data: {
                        promotionId: promotionId,
                        stageNo: stageNo,
                        studyTime: studyTime,
                        allStage: chbGroupAllStage.is(":checked"),
                        allTime: chbGroupAllStudyTime.is(":checked")
                    }
                });

                getItems(response).forEach(function (item) {
                    cboGroup.append(
                        `<option value="${item.groupId}">${item.groupName}</option>`
                    );
                });

                cboGroup.trigger("change.select2");
            } catch (xhr) {
                ShowToastError(
                    xhr.responseText || "Failed to load groups."
                );
            }
        }

        function getStudentRequest(data) {
            data.__RequestVerificationToken =
                $("#doctor_frmFilter input[name='__RequestVerificationToken']").val();

            data.IsAll = true;
            data.DegreeId = cboDegree.val();
            data.SchoolId = cboSchool.val();
            data.FieldId = cboField.val();
            data.PromotionId = cboPromotion.val();
            data.StageId = cboStage.val();

            // Send both IDs and displayed numbers for compatible server-side filtering.
            data.PromotionNo = cboPromotion.find("option:selected").text();
            data.StageNo = cboStage.find("option:selected").text();
            data.StudyTime = cboStudyTime.val();

            return data;
        }

        function createStudentTable() {
            return new Promise(function (resolve) {
                dtStudent = tblStudent.DataTable({
                    destroy: true,
                    paging: true,
                    pageLength: 100,
                    lengthChange: false,
                    searching: false,
                    ordering: false,
                    info: false,
                    responsive: false,
                    autoWidth: false,
                    scrollX: true,
                    scrollY: "420px",
                    scrollCollapse: true,
                    processing: true,
                    serverSide: false,
                    ajax: {
                        url: "/assign-student-group/get-students-registry-doctor",
                        type: "POST",
                        data: getStudentRequest,
                        dataSrc: function (response) {
                            return getItems(response);
                        },
                        error: function (xhr) {
                            ShowToastError(
                                xhr.responseText || "Failed to load students."
                            );
                        }
                    },
                    columns: [
                        {
                            data: null,
                            className: "text-center",
                            orderable: false,
                            searchable: false,
                            width: 36,
                            render: function (data, type, row) {
                                const checked = selectedStudentIds.has(row.studentId)
                                    ? "checked"
                                    : "";

                                return `
                                    <input type="checkbox"
                                           class="chkStudentRow"
                                           value="${row.studentId}"
                                           ${checked}
                                           style="width:16px;height:16px;cursor:pointer;">
                                `;
                            }
                        },
                        {
                            data: "studentId",
                            className: "text-center"
                        },
                        { data: "studentName" },
                        { data: "studentNameInKhmer" },
                        {
                            data: "sex",
                            className: "text-center"
                        },
                        {
                            data: "dateOfBirth",
                            className: "text-center",
                            render: function (data) {
                                return data ? formatDate(data) : "";
                            }
                        }
                    ],
                    drawCallback: function () {
                        tblStudent.find("tbody .chkStudentRow").each(function () {
                            const checkbox = $(this);
                            const isChecked = selectedStudentIds.has(checkbox.val());

                            checkbox.prop("checked", isChecked);
                            checkbox.closest("tr").toggleClass("highlight", isChecked);
                        });

                        updateSelectionState();
                    },
                    initComplete: function () {
                        resolve();
                    }
                });
            });
        }

        function loadStudentTable() {
            selectedStudentIds.clear();
            updateSelectionState();

            if (!dtStudent) {
                return createStudentTable();
            }

            return new Promise(function (resolve) {
                dtStudent.ajax.reload(function () {
                    resolve();
                }, true);
            });
        }

        cboSchool.on("change", async function () {
            await GetField();
            await GetPromotion();
            updateFilterButton();
        });

        cboField.on("change", updateFilterButton);

        cboPromotion.on("change", async function () {
            await GetStage();
            updateFilterButton();
        });

        cboStage.on("change", async function () {
            await GetGroup();
            updateFilterButton();
        });

        cboStudyTime.on("change", async function () {
            await GetGroup();
            updateFilterButton();
        });

        chbGroupAllStage.on("change", GetGroup);
        chbGroupAllStudyTime.on("change", GetGroup);
        cboGroup.on("change", updateSelectionState);

        btnFilter.on("click", async function (event) {
            event.preventDefault();

            if (!hasFilterValues()) {
                ShowToastError("Please select all required filters.");
                return;
            }

            showLoading();

            try {
                await loadStudentTable();
            } finally {
                hideLoading(1);
            }
        });

        tblStudent.on("change", ".chkStudentRow", function () {
            const checkbox = $(this);
            const studentId = checkbox.val();
            const isChecked = checkbox.is(":checked");

            if (isChecked) {
                selectedStudentIds.add(studentId);
            } else {
                selectedStudentIds.delete(studentId);
            }

            checkbox.closest("tr").toggleClass("highlight", isChecked);
            updateSelectionState();
        });

        btnSelectAllStudent.on("click", function (event) {
            event.preventDefault();

            const checkboxes = tblStudent.find("tbody .chkStudentRow");
            const shouldSelect =
                checkboxes.length > 0 &&
                checkboxes.filter(":checked").length !== checkboxes.length;

            checkboxes.each(function () {
                const checkbox = $(this);
                const studentId = checkbox.val();

                checkbox.prop("checked", shouldSelect);
                checkbox.closest("tr").toggleClass("highlight", shouldSelect);

                if (shouldSelect) {
                    selectedStudentIds.add(studentId);
                } else {
                    selectedStudentIds.delete(studentId);
                }
            });

            updateSelectionState();
        });

        btnAssignGroup.on("click", function (event) {
            event.preventDefault();

            const groupId = cboGroup.val();
            const groupName = cboGroup.find("option:selected").text();
            const studentIds = Array.from(selectedStudentIds);

            if (!groupId) {
                ShowToastError("Please select a group.");
                return;
            }

            if (studentIds.length === 0) {
                ShowToastError("Please select at least one student.");
                return;
            }

            const message = `
                <h5>
                    Are you sure you want to assign
                    <strong>${studentIds.length}</strong> student(s)
                    to group <strong>${groupName}</strong>?
                </h5>
            `;

            ShowBoxConfirm(message, function () {
                btnAssignGroup.prop("disabled", true);
                showLoading();

                $.ajax({
                    url: `/assign-student-group/assign/${encodeURIComponent(groupId)}`,
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify(studentIds),
                    headers: {
                        RequestVerificationToken:
                            $("#doctor_frmFilter input[name='__RequestVerificationToken']").val()
                    },
                    success: async function (response) {
                        ShowToastSuccess(
                            response.message ||
                            `Assigned ${studentIds.length} student(s) to ${groupName}.`
                        );

                        await loadStudentTable();
                    },
                    error: function (xhr) {
                        ShowToastError(
                            xhr.responseJSON?.message ||
                            xhr.responseText ||
                            "Failed to assign students."
                        );
                    },
                    complete: function () {
                        hideLoading(1);
                        updateSelectionState();
                    }
                });
            });
        });

        try {
            await GetDegree();
            await GetSchool();
            await GetStudyTime();
        } catch (error) {
            ShowToastError("Failed to load doctor form data.");
        }

        updateFilterButton();
        updateSelectionState();
    });
</script>
