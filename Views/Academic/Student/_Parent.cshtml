@model BBU_SYSTEM.ViewModel.StudentViewModel
<div class="tab-pane fade" id="custom-tabs-four-parent" role="tabpanel"
     aria-labelledby="custom-tabs-four-parent-tab">
       <label>Father Name</label>
       <input type="text" class="form-control" id="txtDegreeEng" placeholder=""
              value="@Html.DisplayFor(m => m.Student!.FatherNameInKhmer)">
       <label>Father Occupation</label>
       <input type="text" class="form-control" id="txtDegreeEng" placeholder=""
              value="@Html.DisplayFor(m => m.Student!.FatherOccupationInKhmer)">
       <label>Mother Name</label>
       <input type="text" class="form-control" id="txtDegreeEng" placeholder=""
              value="@Html.DisplayFor(m => m.Student!.MotherNameInKhmer)">
       <label>Mother Occupation</label>
       <input type="text" class="form-control" id="txtDegreeEng" placeholder=""
              value="@Html.DisplayFor(m => m.Student!.MotherOccupationInKhmer)">
</div>