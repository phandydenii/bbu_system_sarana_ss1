<div class="modal fade" id="StudentMarkModal" data-backdrop="static">
    <div class="modal-dialog modal-md">
        <div class="modal-content">

            <div class="modal-header">
                <h4 class="modal-title">Edit Student Mark</h4>
            </div>

            <div class="modal-body">
                <form id="studentMarkForm">
                    <input type="hidden" id="studentMark_ComplementFailedCourseScoreId" name="ComplementFailedCourseScoreId" value="0" />
                    <input type="hidden" id="studentMark_StudentId" name="StudentId" />
                    <input type="hidden" id="studentMark_CourseId" name="CourseId" />
                    <input type="hidden" id="studentMark_TermNo" name="TermNo" />

                    <div class="row">
                        <div class="col-12">
                            <label>Course</label>
                            <input type="text" id="studentMark_CourseName" class="form-control" readonly />
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-4">
                            <label>Term</label>
                            <input type="number" id="studentMark_TermNoDisplay" class="form-control" readonly />
                        </div>

                        <div class="col-4">
                            <label>Midterm</label>
                            <input type="number" id="studentMark_MidTermScore" name="MidTermScore" class="form-control" step="0.01" min="0" />
                        </div>

                        <div class="col-4">
                            <label>Final</label>
                            <input type="number" id="studentMark_FinalScore" name="FinalScore" class="form-control" step="0.01" min="0" />
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="submit" form="studentMarkForm" class="btn btn-primary">
                    <i class="fas fa-save"></i> Save Change
                </button>
                <button type="button" id="btnCloseStudentMark" class="btn btn-danger">
                    <i class="fas fa-close"></i> Close
                </button>
            </div>

        </div>
    </div>
</div>
<div class="modal fade" id="ScoreHistoryModal" data-backdrop="static">
    <div class="modal-dialog modal-md">
        <div class="modal-content">

            <div class="modal-header">
                <h4 class="modal-title">Edit Score History</h4>
            </div>

            <div class="modal-body">
                <form id="scoreHistoryForm">
                    <input type="hidden" id="scoreHistory_ScoreHistoryId" name="ScoreHistoryId" value="0" />
                    <input type="hidden" id="scoreHistory_StudentId" name="StudentId" />
                    <input type="hidden" id="scoreHistory_CourseId" name="CourseId" />
                    <input type="hidden" id="scoreHistory_TermNo" name="TermNo" />
                    <input type="hidden" id="scoreHistory_Time" name="Time" />
                    <div class="row">
                        <div class="col-12">
                            <label>Course</label>
                            <input type="text" id="scoreHistory_CourseName" class="form-control" readonly />
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-4">
                            <label>Term</label>
                            <input type="number" id="scoreHistory_TermNoDisplay" class="form-control" readonly />
                        </div>

                        <div class="col-4">
                            <label>Midterm Score</label>
                            <input type="number"
                                   id="scoreHistory_MidTermScore"
                                   name="MidTermScore"
                                   class="form-control"
                                   step="0.01"
                                   min="0" />
                        </div>

                        <div class="col-4">
                            <label>Final Score</label>
                            <input type="number"
                                   id="scoreHistory_FinalScore"
                                   name="FinalScore"
                                   class="form-control"
                                   step="0.01"
                                   min="0" />
                        </div>
                    </div>
                </form>
                
            </div>

            <div class="modal-footer">
                <button type="submit" form="scoreHistoryForm" class="btn btn-primary">
                    <i class="fas fa-save"></i> Save Change
                </button>

                <button type="button" id="btnCloseScoreHistory" class="btn btn-danger">
                    <i class="fas fa-times"></i> Close
                </button>
            </div>

        </div>
    </div>
</div>