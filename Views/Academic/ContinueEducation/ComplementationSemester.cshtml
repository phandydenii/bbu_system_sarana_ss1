<div style="margin: 10px">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">
                <div class="margin" id="rangeButtons">
                    <button type="button" class="btn btn-primary btn-sm" value="1">បំពេញបន្ថែមឆមាស
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm" value="2">
                        បំពេញបន្ថែមតម្រង់ទិស
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm" value="3">
                        បំពេញបន្ថែមមុខវិជ្ជាធ្លាក់
                    </button>
                </div>
            </div>
        </div>
        <hr/>
        <div class="row">
            <div class="col-md-5">
                <div class="card card-outline card-primary">
                    <div class="card-header bg-white d-flex align-items-center justify-content-between">
                        <h3 class="card-title font-weight-bold text-primary m-0">Student List</h3>

                        <h4 id="studentComplementationCountText"
                            class="text-muted mb-0 ml-auto text-right"
                            style="font-size: 18px; font-weight: 500;">
                        </h4>
                    </div>
                    <div class="card-body">
                        <table id="tblComplementationStudent" class="table table-sm table-bordered table-striped"
                               style="width: 100%;">
                            <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Gender</th>
                                <th>DOB</th>
                            </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-7">
                <div class="card card-outline card-primary">
                    <div class="card-header">
                        <h3 class="card-title">Score</h3>
                    </div>
                    <div class="card-body">
                        <table id="tblComplementationScore" class="table table-sm table-bordered table-striped"
                               style="width: 100%;">
                            <thead>
                            <tr>
                                <th>term</th>
                                <th>name</th>
                                <th>midterm_score</th>
                                <th>final_score</th>
                                <th>grade</th>
                            </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>