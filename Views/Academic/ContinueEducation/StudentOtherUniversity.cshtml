@using BBU_SYSTEM.DTOs
@model BBU_SYSTEM.ViewModel.ListData
@{
    ViewData["Title"] = "Index";
    ViewData["OpenMenu"] = "AcademicTask";
    ViewData["Action"] = "OtherBranchScore";
}
<div class="card-body">
    <div class="row">
        <div class="col-md-6">
            <div class="card card-outline card-primary">
                <div class="card-header bg-white d-flex align-items-center justify-content-between">
                    <h3 class="card-title font-weight-bold text-primary m-0">Other University Students</h3>
                    <h4 id="studentCountText" class="text-muted mb-0 ml-auto text-end" style="font-size: 18px;font-weight: 500;"></h4>
                </div>
                <div class="card-body">
                    <table id="tblStudentOtherUniversity" class="table table-sm table-bordered table-striped"
                           style="width: 100%;">
                        <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Gender</th>
                            <th>DOB</th>
                        </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card card-outline card-primary">
                <div class="card-header">
                    <h3 class="card-title">Scores</h3>
                </div>
                <div class="card-body">
                    <table id="tblOtherUniversityScore" class="table table-sm table-bordered table-striped"
                           style="width: 100%;">
                        <thead>
                        <tr>
                            <th class="hide-col">id</th>
                            <th>term</th>
                            <th>name</th>
                            <th>total</th>
                            <th>grade</th>
                            <th>action</th>
                        </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="ExternalScoreModal" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h4 class="modal-title">External Score</h4>
            </div>

            <div class="modal-body">
                <form id="externalScoreForm">

                    <input type="hidden"
                           id="externalScore_ExternalScoreId"
                           name="ExternalScoreId"
                           value="0"
                           class="form-control" />

                    <input type="hidden"
                           id="externalScore_StudentId"
                           name="StudentId"
                           class="form-control" />

                    <div class="row">
                        <div class="col-6">
                            <label class="required">Term No</label>
                            <input type="number"
                                   id="externalScore_TermNo"
                                   name="TermNo"
                                   class="form-control"
                                   placeholder="Enter term no"
                                   required />
                        </div>

                        <div class="col-6">
                            <label>Course Code</label>
                            <input type="text"
                                   id="externalScore_CourseCode"
                                   name="CourseCode"
                                   class="form-control"
                                   placeholder="Enter course code" />
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-6">
                            <label class="required">Course Name</label>
                            <input type="text"
                                   id="externalScore_CourseName"
                                   name="CourseName"
                                   class="form-control"
                                   placeholder="Enter course name"
                                   required />
                        </div>

                        <div class="col-6">
                            <label class="required">Course Name Khmer</label>
                            <input type="text"
                                   id="externalScore_CourseNameInKhmer"
                                   name="CourseNameInKhmer"
                                   class="form-control"
                                   placeholder="Enter course name Khmer" required/>
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-4">
                            <label class="required">Credit</label>
                            <input type="number"
                                   id="externalScore_Credit"
                                   name="Credit"
                                   class="form-control"
                                   placeholder="Credit"
                                   min="0" required/>
                        </div>

                        <div class="col-4">
                            <label>Total</label>
                            <input type="number"
                                   id="externalScore_Total"
                                   name="Total"
                                   class="form-control"
                                   placeholder="Total score"
                                   min="0"
                                   step="0.01" />
                        </div>

                        <div class="col-4">
                            <label class="required">Grade</label>
                            <input type="text"
                                   id="externalScore_Grade"
                                   name="Grade"
                                   class="form-control"
                                   placeholder="Grade" required/>
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-6">
                            <label>Year Start</label>
                            <input type="number"
                                   id="externalScore_YearStart"
                                   name="YearStart"
                                   class="form-control"
                                   placeholder="Year start" />
                        </div>

                        <div class="col-6">
                            <label>Year End</label>
                            <input type="number"
                                   id="externalScore_YearEnd"
                                   name="YearEnd"
                                   class="form-control"
                                   placeholder="Year end" />
                        </div>
                    </div>

                </form>
            </div>

            <div class="modal-footer">
                <button type="submit"
                        form="externalScoreForm"
                        class="btn btn-primary float-right">
                    <i class="fas fa-save"></i> Save Change
                </button>

                <button type="button"
                        id="btnCloseExternalScore"
                        class="btn btn-danger float-right">
                    <i class="fas fa-close"></i> Close
                </button>
            </div>

        </div>
    </div>
</div>