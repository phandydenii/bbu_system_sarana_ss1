@model BBU_SYSTEM.ViewModel.ListData
@{
    ViewData["Title"] = "Index";
    ViewData["OpenMenu"] = "AcademicTask";
    ViewData["Action"] = "OtherBranchScore";
    var reExamPaymentDetailDto = new StudentReexamPaymentDetail();
}
<div class="card-body">
    <div class="row">
        <div class="col-md-5">
            <div class="card card-outline card-primary">
                <div class="card-header">
                    <h3 class="card-title">Extend Student List</h3>
                </div>
                <div class="card-body">
                    <table id="tblStudentReExam" class="table table-sm table-bordered table-striped"
                           style="width: 100%;">
                        <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Gender</th>
                            <th>DOB</th>
                        </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card card-outline card-primary">
                <div class="card-header">
                    <h3 class="card-title">Invoice</h3>
                </div>
                <div class="card-body">
                    <table id="tblInvoice" class="table table-sm table-bordered table-striped"
                           style="width: 100%;">
                        <thead>
                        <tr>
                            <th>no</th>
                            <th>date</th>
                            <th>paid</th>
                            <th>note</th>
                        </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card card-outline card-primary">
                <div class="card-header">
                    <h3 class="card-title">ReExam Subject</h3>
                </div>
                <div class="card-body">
                    <form id="">
                        <div class="row">
                            <div class="col-6">
                                <label>Subject</label>
                                <select class="select select2" asp-for="@reExamPaymentDetailDto.CourseId">
                                    <option value="1">1</option>
                                </select>
                            </div>
                            <div class="col-2">
                                <label>Term</label>
                                <input type="number" class="form-control" asp-for="@reExamPaymentDetailDto.TermNo" min="1" value="1"/>
                            </div>
                            <div class="col-2">
                                <label>Time</label>
                                <input type="number" class="form-control" asp-for="@reExamPaymentDetailDto.Time" min="1" value="1"/>
                            </div>
                            <div class="col-2">
                                <label>&nbsp;</label>
                                <button type="submit" class="btn form-control btn-success">Add</button>
                            </div>
                        </div>
                    </form>
                    <br>
                    <table id="tblReExamPaymentDetail" class="table table-sm table-bordered table-striped"
                           style="width: 100%;">
                        <thead>
                        <tr>
                            <th>name</th>
                            <th>term</th>
                            <th>time</th>
                            <th>action</th>
                        </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
