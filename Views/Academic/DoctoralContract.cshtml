@{
    ViewData["Title"] = "Index";
    ViewData["OpenMenu"] = "AcademicTask";
    ViewData["Action"] = "DoctoralContract";
}
<div class="row">
    <div class="col-12">
        <div class="card">
            @* <div class="card-header"> *@
            @*     $1$ <h3 class="card-title">Doctor Student List</h3> #1# *@
            @*     <button class="btn btn-success">Filter</button> *@
            @* </div> *@
            <div class="card-body">
                <table id="tblStudentDiscount" class="table table-sm table-bordered table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>Student Id</th>
                        <th>Name English</th>
                        <th>Name Khmer</th>
                        <th>Gender</th>
                        <th>DOB</th>
                        <th>Phone</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<script>
    
    $(document).ready(function () {
        fetchStudentDiscount();
    });

    function fetchStudentDiscount() {
        $("#tblStudentDiscount").DataTable().clear().destroy();
        $("#tblStudentDiscount")
            .DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: `/doctor-contract/gets`,
                    type: "POST",
                },
                columns: [
                    {data: "studentId"},
                    {data: "studentName"},
                    {data: "studentNameInKhmer"},
                    {data: "sex"},
                    {
                        data: null,
                        render: function (data, type, row) {
                            const date = formatDate(row.date_of_birth);
                            return date;
                        }
                    },
                    {data: "phone"},
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `<a onclick="OnView('${row.student_id}')" class="btn btn-success btn-sm"><i class="fas fa-eye"></i> View</a>`;
                        }
                    }
                ]
            })
    }

</script>