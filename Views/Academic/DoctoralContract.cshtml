@{
    ViewData["Title"] = "Index";
    ViewData["OpenMenu"] = "AcademicTask";
    ViewData["Action"] = "DoctoralContract";
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Doctoral Contract List</h3>
                <button type="button" class="btn btn-success btn-sm float-right" onclick="openAddDoctoralContract()">
                    <i class="fas fa-plus"></i>
                    Add New
                </button>
            </div>
            <div class="card-body">
                <table id="tblDoctoralContract"
                       class="table table-sm table-bordered table-striped"
                       style="width:100%;">
                    <thead>
                    <tr>
                        <th>Contract Id</th>
                        <th>Student Id</th>
                        <th>Term No</th>
                        <th>Fee</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Note</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_DoctoralContract"/>
<script>
    let doctoralContractTable = null;

    $(document).ready(function () {
        fetchDoctoralContract();

        $("#btnCloseDoctoralContract").on("click", function (e) {
            e.preventDefault();
            clearDoctoralContractForm();
            $("#DoctoralContractModal").modal("hide");
        });
    });

    function reloadDoctoralContractTable() {
        if (doctoralContractTable) {
            doctoralContractTable.ajax.reload(null, false);
        }
    }

    function fetchDoctoralContract() {
        const tblDoctoralContract = $("#tblDoctoralContract");

        if ($.fn.DataTable.isDataTable("#tblDoctoralContract")) {
            tblDoctoralContract.DataTable().clear().destroy();
            tblDoctoralContract.empty();
        }

        doctoralContractTable = tblDoctoralContract.DataTable({
            destroy: true,
            paging: true,
            lengthChange: true,
            searching: true,
            ordering: true,
            info: true,

            responsive: false,
            autoWidth: false,
            scrollX: true,
            scrollCollapse: true,

            processing: true,
            serverSide: true,
            order: [[0, "desc"]],

            ajax: {
                url: "/doctor-contract/gets",
                type: "POST",
                error: function (xhr) {
                    console.log(xhr.responseText);
                    ShowToastError("Cannot load doctoral contract data.");
                }
            },

            columns: [
                {
                    title: "Contract Id",
                    data: "contractId",
                    width: "90px"
                },
                {
                    title: "Student Id",
                    data: "studentId",
                    width: "120px"
                },
                {
                    title: "Term No",
                    data: "termNo",
                    width: "100px"
                },
                {
                    title: "Fee",
                    data: "fee",
                    width: "100px"
                },
                {
                    title: "Start Date",
                    data: "startDate",
                    width: "130px",
                    render: function (data) {
                        return formatDateOnly(data);
                    }
                },
                {
                    title: "End Date",
                    data: "endDate",
                    width: "130px",
                    render: function (data) {
                        return formatDateOnly(data);
                    }
                },
                {
                    title: "Note",
                    data: "note",
                    render: function (data) {
                        return renderTruncate(data);
                    }
                },
                {
                    title: "Action",
                    data: null,
                    width: "180px",
                    className: "dt-action text-center",
                    orderable: false,
                    searchable: false,
                    render: function () {
                        return `
                            <div class="dt-action">
                                <button type="button" class="btn btn-warning btn-sm btnEditDoctoralContract">
                                    <i class="fas fa-edit"></i> Edit
                                </button>
                                <button type="button" class="btn btn-danger btn-sm btnDeleteDoctoralContract">
                                    <i class="fa-solid fa-trash"></i> Delete
                                </button>
                            </div>
                        `;
                    }
                }
            ],

            initComplete: function () {
                let api = this.api();

                MyApp.utils.dataTableDebounceSearch("#tblDoctoralContract", 500);

                setTimeout(function () {
                    api.columns.adjust();
                }, 500);
            },

            drawCallback: function () {
                this.api().columns.adjust();
            }
        });

        setTimeout(function () {
            if (doctoralContractTable) {
                doctoralContractTable.columns.adjust();
            }
        }, 1000);
    }

    function clearDoctoralContractForm() {
        const formElement = $("#doctoralContractForm")[0];

        if (formElement) {
            formElement.reset();
        }

        $("#doctoralContract_ContractId").val(0);
        $("#doctoralContract_StudentId").val("");
        $("#doctoralContract_TermNo").val("");
        $("#doctoralContract_Fee").val("");
        $("#doctoralContract_StartDate").val("");
        $("#doctoralContract_EndDate").val("");
        $("#doctoralContract_Note").val("");
    }

    function openAddDoctoralContract() {
        clearDoctoralContractForm();

        $("#DoctoralContractModal").find(".modal-title").text("Add New");
        $("#DoctoralContractModal").modal("show");
    }

    $("#btnAddDoctoralContract").on("click", function () {
        openAddDoctoralContract();
    });

    $("#tblDoctoralContract").on("click", ".btnEditDoctoralContract", function () {
        let rowElement = $(this).closest("tr");

        if (rowElement.hasClass("child")) {
            rowElement = rowElement.prev();
        }

        const selectedRow = doctoralContractTable.row(rowElement).data();

        if (!selectedRow) {
            ShowToastError("Cannot get selected doctoral contract data.");
            return;
        }

        $("#DoctoralContractModal").find(".modal-title").text("Update");

        $("#doctoralContract_ContractId").val(selectedRow["contractId"]);
        $("#doctoralContract_StudentId").val(selectedRow["studentId"]);
        $("#doctoralContract_TermNo").val(selectedRow["termNo"]);
        $("#doctoralContract_Fee").val(selectedRow["fee"]);
        $("#doctoralContract_StartDate").val(formatDateForInput(selectedRow["startDate"]));
        $("#doctoralContract_EndDate").val(formatDateForInput(selectedRow["endDate"]));
        $("#doctoralContract_Note").val(selectedRow["note"] || "");

        $("#DoctoralContractModal").modal("show");
    });

    $("#tblDoctoralContract").on("click", ".btnDeleteDoctoralContract", function () {
        let rowElement = $(this).closest("tr");

        if (rowElement.hasClass("child")) {
            rowElement = rowElement.prev();
        }

        const selectedRow = doctoralContractTable.row(rowElement).data();

        if (!selectedRow) {
            ShowToastError("Cannot get selected doctoral contract data.");
            return;
        }

        if (!confirm("Are you sure you want to delete this doctoral contract?")) {
            return;
        }

        $.ajax({
            url: "/doctor-contract/delete/" + selectedRow["contractId"],
            type: "DELETE",
            success: function (response) {
                const code = response.status?.code;
                const message = response.status?.message;

                if (code === "200" || code === 200) {
                    ShowToastSuccess(message || "Deleted successfully!");
                    reloadDoctoralContractTable();
                } else {
                    ShowToastError(message || "Delete failed.");
                }
            },
            error: function () {
                ShowToastError("Delete failed.");
            }
        });
    });

    $("#doctoralContractForm").on("submit", function (e) {
        e.preventDefault();

        const contractId = $("#doctoralContract_ContractId").val() || "0";
        const formData = $("#doctoralContractForm").serialize();

        $.ajax({
            url: "/doctor-contract/save-change",
            type: "POST",
            data: formData,
            success: function (response) {
                const code = response.status?.code;
                const message = response.status?.message;

                if (code === "200" || code === 200) {
                    if (contractId !== "0") {
                        ShowToastSuccess(message || "Updated successfully!");
                    } else {
                        ShowToastSuccess(message || "Saved successfully!");
                    }

                    clearDoctoralContractForm();
                    $("#DoctoralContractModal").modal("hide");
                    reloadDoctoralContractTable();
                } else {
                    ShowToastError(message || "Save failed.");
                }
            },
            error: function (xhr) {
                if (xhr.status === 401) {
                    ShowToastError("Unauthorized. Please login again.");
                    return;
                }

                const message =
                    xhr["responseJSON"]?.["status"]?.["message"] ||
                    xhr["responseJSON"]?.["message"] ||
                    "Server error.";

                ShowToastError(message);
            }
        });
    });

    function formatDateOnly(value) {
        if (!value) return "";

        const text = String(value);

        if (text.length >= 10 && text.includes("-")) {
            const parts = text.substring(0, 10).split("-");
            return `${parts[2]}/${parts[1]}/${parts[0]}`;
        }

        return text;
    }

    function formatDateForInput(value) {
        if (!value) return "";

        const text = String(value);

        if (text.length >= 10 && text.includes("-")) {
            return text.substring(0, 10);
        }

        return "";
    }
</script>