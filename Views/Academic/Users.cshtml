@{
    ViewData["Title"] = "Index";
    ViewData["OpenMenu"] = "AcademicTask";
    ViewData["Action"] = "AcademicUser";
    var userPriviledges = User.FindAll("Permission").ToList();
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">User</h3>
            </div>
            <div class="card-body">
                <table id="tblAdminUser" class="table table-bordered table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>User Id</th>
                        <th>Username</th>
                        <th>Password</th>
                        <th>Group</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_UserPriviledge"/>

@section scripts{
    <script>
        const tblAdminUser = $("#tblAdminUser");
        const UserPriviledgeModal = $("#UserPriviledgeModal");

        const userPirveledge = @Html.Raw(Json.Serialize(userPriviledges));

        $(document).ready(function () {
            LoadData();
        });

        function LoadData() {
            tblAdminUser.DataTable().clear().destroy();
            tblAdminUser.DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: `/user/academic-user`,
                    type: "POST",
                },
                columns: [
                    {data: "userId"},
                    {data: "userName"},
                    {
                        data: "password",
                        render: (data, type, row) => {
                            return `<i class="fas fa-eye-slash"></i>`
                        }
                    },
                    {data: "userGroup"},
                    {data: "status"},
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `
                        <a id="btnEdit" class="btn btn-success btn-sm"><i class='fas fa-gear'></i> Manage</a>
                    `;
                        }
                    }
                ]
            })
        }

        tblAdminUser.on("click", "#btnEdit", function () {
            const $row = $(this).closest("tr");
            const data = tblAdminUser.DataTable().row($row).data();
            console.log(data);
            UserPriviledgeModal.modal("show");
        });

        function OnSavePriviledge() {
            const userId = $("#userId").val();
            const userPriviledge = $("#userPriviledge").val();
            $.ajax({
                url: `/user/academicusser/priviledge/${userId}`,
                type: "POST",
                data: {
                    userId: userId,
                    userPriviledge: userPriviledge
                },
                success: function (response) {
                }
            })
        }

        function OnSavePassword() {
            const userId = $("#userId").val();
            const password = $("#password").val();
            $.ajax({
                url: `/user/academicusser/password/${userId}`,
                type: "POST",
                data: {
                    userId: userId,
                    password: password
                },
            })
        }

        function OnSaveUser() {
            const userId = $("#userId").val();
            const userName = $("#userName").val();
            const userGroup = $("#userGroup").val();
            $.ajax({
                url: `/user/academicusser/user/${userId}`,
                type: "POST",
                data: {
                    userId: userId,
                    userName: userName,
                    userGroup: userGroup
                }
            })
        }

        function OnSave() {
            OnSavePriviledge();
            OnSavePassword();
            OnSaveUser();
            LoadData();
            UserPriviledgeModal.modal("hide");
        }

        function OnCancel() {
            UserPriviledgeModal.modal("hide");
        }

        function OnDelete(userId) {
            if (confirm("Are you sure you want to delete this user?")) {
                $.ajax({
                    url: `/user/academicusser/delete/${userId}`,
                    type: "POST",
                    success: function (response) {
                        if (response.success) {
                            alert("User deleted successfully.");
                            LoadData();
                        } else {
                            alert("Error deleting user: " + response.message);
                        }
                    }
                })
            }
        }
    </script>
}
