@using BBU_SYSTEM.DTOs
@{
    var roomDto = new RoomDto();
}

<div class="modal fade" id="RoomModal" data-backdrop="static">
    <div class="modal-dialog modal-md">
        <div class="modal-content">

            <div class="modal-header">
                <h4 class="modal-title">Room</h4>
            </div>

            <div class="modal-body">
                <form id="roomForm">

                    <input type="hidden"
                           id="room_RoomId"
                           name="RoomId"
                           value="0"
                           class="form-control" />

                    <div class="row">
                        <div class="col-12">
                            <label class="required">Room Name</label>
                            <input type="text"
                                   id="room_RoomName"
                                   name="RoomName"
                                   class="form-control"
                                   placeholder="Enter room name"
                                   required />
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-6">
                            <label>Capacity</label>
                            <input type="number"
                                   id="room_Capacity"
                                   name="Capacity"
                                   class="form-control"
                                   placeholder="Capacity"
                                   min="0"
                                   value="0"
                                   required />
                        </div>

                        <div class="col-6">
                            <label class="required">Room Type</label>
                            <input type="text"
                                   id="room_RoomType"
                                   name="RoomType"
                                   class="form-control"
                                   placeholder="Room type"
                                   required />
                        </div>
                    </div>

                </form>
            </div>

            <div class="modal-footer">
                <button type="submit"
                        form="roomForm"
                        class="btn btn-primary float-right">
                    <i class="fas fa-save"></i> Save Change
                </button>

                <button type="button"
                        id="btnCloseRoom"
                        class="btn btn-danger float-right">
                    <i class="fas fa-close"></i> Close
                </button>
            </div>

        </div>
    </div>
</div>