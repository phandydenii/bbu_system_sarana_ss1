@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer;
@{
    ViewData["Controller"] = "DailyReport";
    ViewData["Action"] = "DailyReport"; 
    ViewData["HideHeader"] = true;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="m-0 font-weight-bold text-dark">Daily Report</h3>
        <small class="text-muted">View daily operational logs, monitor activity records, and create new entries.</small>
    </div> 
    <button type="button" id="btnAddNew" class="btn btn-success btn-sm float-right">
        <i class="fas fa-plus"></i>
        Add New
    </button>
</div>

<div class="row">
    <div class="col-12">
        <div class="card"> 
            <div class="card-body">
                <table id="tblDailyReport" class="table table-bordered table-striped table-sm" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>@Localizer["Id"]</th>
                        <th>@Localizer["Title"]</th>
                        <th>@Localizer["Description"]</th> 
                        <th>@Localizer["CreateDate"]</th>
                        <th>@Localizer["Action"]</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script> 
<partial name="_ValidationScriptsPartial"/> 
<partial name="_DailyReportModal"/>
@section Scripts
{
    <script>
        const i18n = {
            edit: '@Localizer["Edit"]',
            delete: '@Localizer["Delete"]',
            view: '@Localizer["View"]'
        };
    </script>
    <script src="~/function/DailyReport.js"></script>
}
