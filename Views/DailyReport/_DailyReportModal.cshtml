@using BBU_SYSTEM.DTOs
@{
    var dailyReportDto = new DailyReportDto();
    var campus = new Dictionary<string, string>
    {
        { "pp", "PP" },
        { "tk", "TK" },
        { "sr", "SR" },
        { "sh", "SH" },
        { "bb", "BB" },
        { "st", "ST" },
        { "rk", "RK" },
        { "bmc", "BMC" },
        { "tb", "TB" },
    };
}
<div class="modal fade" id="modalDailyReport" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="formDailyReport" enctype="multipart/form-data">
                <div class="modal-header">
                    <h4 class="modal-title">Daily Report</h4>
                    <div class="card-tools">
                        <select asp-for="@dailyReportDto.Campus" class="custom-select" style="width: 100%;">
                            @foreach (var i in campus)
                            {
                                <option value="@i.Key">@i.Value</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-body">
                    <input asp-for="@dailyReportDto.Id" type="hidden"/>
                    <div class="row">
                        <div class="col-9">
                            <div class="form-group">
                                <label class="required">Title</label>
                                <input type="text" asp-for="@dailyReportDto.Title" class="form-control"
                                       placeholder="Enter title"
                                       required="required">
                                <span asp-validation-for="@dailyReportDto.Title" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="form-group">
                                <label class="required">Report Date</label>
                                <input type="date" asp-for="@dailyReportDto.ReportDate" class="form-control" required="required">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-9">
                            <div class="form-group">
                                <label>Title Khmer</label>
                                <input type="text" asp-for="@dailyReportDto.TitleKhmer" class="form-control"
                                       placeholder="Enter title khmer">
                                <span asp-validation-for="@dailyReportDto.TitleKhmer" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="form-group">
                                <label>Request Date</label>
                                <input type="date" asp-for="@dailyReportDto.RequestDate" class="form-control" required="required">
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Description <span id="charCount">0</span> / 300 characters</label>
                        <textarea type="text" asp-for="@dailyReportDto.Description" rows="3" class="form-control"
                                  placeholder="Enter description" maxlength="1000"></textarea>
                        <span asp-validation-for="@dailyReportDto.Description" class="text-danger"></span>
                    </div>
                    <input type="file" id="fileInput" name="images" multiple accept="image/*" hidden
                           onchange="previewFiles()"/>
                    <div class="preview-image" id="preview">
                        <button type="button" class="add-image-btn"
                                onclick="document.getElementById('fileInput').click()">
                            <i class="fas fa-images"></i>
                        </button>
                    </div>
                </div>
                <div class="modal-footer float-right">
                    <button type="submit" form="formDailyReport" class="btn btn-primary"><i class="fas fa-save"></i>
                        Save
                        changes
                    </button>
                    <button type="button" class="btn btn-danger" id="btnClose"><i class="fas fa-close"></i> Close
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

