@model BBU_SYSTEM.Models.Req.RegistryReq

<div class="form-group clearfix">
    <div class="icheck-primary d-inline">
        <input asp-for="Student!.IsReceivePhoto"
               type="checkbox"
               id="isReceivePhoto" />

        <label for="isReceivePhoto">Received Photo</label>
    </div>
</div>

<div class="form-group">
    <label asp-for="Student!.Note">Note</label>

    <textarea asp-for="Student!.Note"
              rows="4"
              class="form-control"
              placeholder="Enter note"></textarea>

    <span asp-validation-for="Student!.Note"
          class="text-danger"></span>
</div>