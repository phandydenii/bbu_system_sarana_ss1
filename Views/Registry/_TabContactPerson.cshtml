@using BBU_SYSTEM.DTOs
@using BBU_SYSTEM.Models.Req
 @{
    var registryReq = new RegistryReq();
}
<label>Phone</label>
<input type="text" class="form-control" asp-for="@registryReq!.Student!.Phone"
       placeholder="">
<label>Email</label>
<input type="text" class="form-control" asp-for="@registryReq!.Student!.Email"
       placeholder="">
<label>Address</label>
<textarea type="text" rows="4" class="form-control"
          asp-for="@registryReq.Student!.Address" placeholder=""></textarea>
<label>Address Khmer</label>
<textarea type="text" rows="4" class="form-control"
          asp-for="@registryReq.Student!.AddressInKhmer" placeholder=""></textarea>