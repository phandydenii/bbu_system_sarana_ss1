@{
ViewData["Title"] = "Student Registry";
ViewData["OpenMenu"] = "Administration";
ViewData["Action"] = "Register";
ViewData["HideHeader"] = true;
}

<style>
    #tblRegistry_wrapper {
        width: 100%;
    }

    #tblRegistry_wrapper:not(.registry-has-results) .dataTables_length,
    #tblRegistry_wrapper:not(.registry-has-results) .dt-length,
    #tblRegistry_wrapper:not(.registry-has-pages) .dataTables_paginate,
    #tblRegistry_wrapper:not(.registry-has-pages) .dt-paging {
        display: none;
    }

    #registryPage .registry-table-scroll {
        width: 100%;
        max-width: 100%;
        overflow-x: auto;
    }

    #tblRegistry th,
    #tblRegistry td {
        vertical-align: middle !important;
        white-space: nowrap;
    }

    #tblRegistry td.dt-action-col {
        text-align: center;
    }

    #tblRegistry .badge {
        min-width: 75px;
        padding: 6px 8px;
    }

    #RegistryDetailsModal {
        padding-right: 0 !important;
    }

    #RegistryDetailsModal .registry-details-dialog {
        width: calc(100vw - 40px);
        max-width: 1420px;
        margin: 20px auto;
    }

    #RegistryDetailsModal .registry-details-content {
        height: calc(100vh - 40px);
        max-height: calc(100vh - 40px);
        overflow: hidden;
    }

    #RegistryDetailsModal .registry-details-body {
        overflow-y: auto;
        overflow-x: hidden;
        padding: 10px;
    }

    #RegistryDetailsModal.registry-details-fullscreen .registry-details-dialog {
        width: 100vw;
        max-width: none;
        height: 100vh;
        margin: 0;
    }

    #RegistryDetailsModal.registry-details-fullscreen .registry-details-content {
        height: 100vh;
        max-height: 100vh;
        border-radius: 0;
    }

    @@media (max-width: 767.98px) {
        #RegistryDetailsModal .registry-details-dialog {
            width: calc(100vw - 16px);
            margin: 8px auto;
        }

        #RegistryDetailsModal .registry-details-content {
            height: calc(100vh - 16px);
            max-height: calc(100vh - 16px);
        }
    }
</style>

<div id="registryPage" class="container-fluid px-0 pt-3" data-ui-design="booking-clothes-sample">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div class="mr-3">
            <h3 class="m-0 font-weight-bold text-dark">Student Registry</h3>
            <small class="text-muted">Manage student registrations and academic records</small>
        </div>
        <button type="button"
                id="btnOpenCreateRegistryModal"
                class="btn btn-primary shadow-sm text-nowrap ml-auto mt-2 mt-sm-0">
            <i class="fas fa-plus-circle mr-1" aria-hidden="true"></i>
            New Register
        </button>
    </div>

    <div class="card card-outline card-primary shadow-sm mb-4">
        <div class="card-header bg-white py-2">
            <h3 class="card-title font-weight-bold text-secondary" style="font-size: 0.95rem;">
                <i class="fas fa-filter text-primary mr-1" aria-hidden="true"></i>
                Filter Registrations
            </h3>
            <div class="card-tools">
                <button type="button"
                        class="btn btn-tool"
                        data-card-widget="collapse"
                        aria-label="Toggle registration filters">
                    <i class="fas fa-minus" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        <div class="card-body bg-light py-3">
            <form id="frmRegistryFilters" novalidate>
                <div class="row align-items-end">
                    <div class="col-sm-6 col-lg-3 col-xl-2 mb-2 mb-xl-0">
                        <label for="registryDateRange" class="text-secondary small font-weight-bold">
                            Registration Date
                        </label>
                        <select id="registryDateRange"
                                class="custom-select"
                                aria-controls="registryCustomDates">
                            <option value="all" selected>All Dates</option>
                            <option value="today">Today</option>
                            <option value="last7">Last 7 Days</option>
                            <option value="month">This Month</option>
                            <option value="custom">Custom Range</option>
                        </select>
                    </div>
                    <div id="registryCustomDates" class="col-12 col-lg-6 col-xl-4 mb-2 mb-xl-0">
                        <div class="row">
                            <div class="col-sm-6 mb-2 mb-sm-0">
                                <label for="dtpFrom" class="text-secondary small font-weight-bold">
                                    From Date
                                </label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-white border-right-0">
                                            <i class="far fa-calendar-alt text-muted" aria-hidden="true"></i>
                                        </span>
                                    </div>
                                    <input type="date"
                                           id="dtpFrom"
                                           name="from"
                                           min="0001-01-01"
                                           max="9999-12-31"
                                           class="form-control border-left-0"
                                           aria-describedby="registryCustomDateHelp registryDateFilterError" />
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <label for="dtpTo" class="text-secondary small font-weight-bold">
                                    To Date
                                </label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-white border-right-0">
                                            <i class="far fa-calendar-alt text-muted" aria-hidden="true"></i>
                                        </span>
                                    </div>
                                    <input type="date"
                                           id="dtpTo"
                                           name="to"
                                           min="0001-01-01"
                                           max="9999-12-30"
                                           class="form-control border-left-0"
                                           aria-describedby="registryCustomDateHelp registryDateFilterError" />
                                </div>
                            </div>
                        </div>
                        <small id="registryCustomDateHelp" class="sr-only">
                            Enter one or both dates. Both selected dates are included.
                        </small>
                    </div>
                    <div class="col-auto d-flex mb-2 mb-xl-0">
                        <div class="btn-group shadow-sm" role="group" aria-label="Registration date filters">
                            <button type="submit"
                                    id="btnFilterRegistry"
                                    class="btn btn-success">
                                <i class="fas fa-search mr-1" aria-hidden="true"></i>
                                Filter
                            </button>
                            <button type="button"
                                    id="btnResetRegistryFilter"
                                    class="btn btn-success border-left"
                                    title="Reset filters"
                                    aria-label="Reset registration date filters">
                                <i class="fas fa-redo-alt" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div id="registryDateFilterError" class="text-danger small mt-2" role="alert" hidden></div>
                <div id="registryDateFilterSummary" class="small text-secondary mt-3" role="status">
                    Applied registration dates: All Dates
                </div>
            </form>
        </div>
    </div>

    <!-- DataTable card: retain all ten columns and the existing modal actions. -->
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <table id="tblRegistry"
                   class="table table-sm table-hover table-bordered table-striped"
                   style="width: 100%;">
                <thead class="thead-light">
                <tr>
                    <th>Student ID</th>
                    <th>Name English</th>
                    <th>Name Khmer</th>
                    <th>Gender</th>
                    <th>Date of Birth</th>
                    <th>Registry Date</th>
                    <th>Degree</th>
                    <th>School</th>
                    <th class="text-center">Status</th>
                    <th class="text-center" style="width: 105px;">Action</th>
                </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<div id="CreateRegistryModalHost"></div>

<div class="modal fade registry-details-fullscreen"
     id="RegistryDetailsModal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="RegistryDetailsModalLabel"
     aria-hidden="true"
     data-backdrop="static"
     data-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-centered registry-details-dialog"
         role="document">
        <div class="modal-content registry-details-content">
            <div class="modal-header">
                <h4 class="modal-title" id="RegistryDetailsModalLabel">
                    Student Information
                </h4>
                <div class="d-flex align-items-center">
                    <button type="button"
                            id="btnToggleRegistryDetailsSize"
                            class="btn btn-sm btn-link text-secondary mr-1"
                            title="Exit full screen"
                            aria-label="Toggle full screen">
                        <i class="fas fa-compress"></i>
                    </button>
                    <button type="button"
                            class="close"
                            data-dismiss="modal"
                            aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            </div>
            <div class="modal-body registry-details-body"
                 id="RegistryDetailsModalBody"></div>
        </div>
    </div>
</div>

@section Scripts
{
<script src="~/function/Degree.js"></script>
<script src="~/function/School.js"></script>
<script src="~/function/Field.js"></script>
<script src="~/function/Promotion.js"></script>
<script src="~/function/Stage.js"></script>
<script src="~/function/Term.js"></script>
<script src="~/function/Group.js"></script>
<script src="~/js/Components.js"></script>
<script>
    let registryTable = null;
    let appliedRegistryDates = { preset: "all", from: "", to: "" };
    let registryListRequest = null;
    let registryEntryCountUnavailable = false;
    const registrySearchPrompt = "Search by Student ID or name, or apply a date range.";
    const registryNoMatchesMessage = "No registrations match your search or date range.";
    let registryListEmptyMessage = registrySearchPrompt;

    $(function () {
        registerRegistryDateFilters();
        initializeRegistryTable();
    });

    function registerRegistryDateFilters() {
        $("#frmRegistryFilters")
            .off("submit.registryFilters")
            .on("submit.registryFilters", function (event) {
                event.preventDefault();
                applyRegistryDateFilters();
            });

        $("#registryDateRange")
            .off("change.registryFilters")
            .on("change.registryFilters", syncRegistryDateInputs);

        $("#dtpFrom, #dtpTo")
            .off("input.registryFilters change.registryFilters")
            .on("input.registryFilters change.registryFilters", function () {
                $("#registryDateRange").val("custom");
                setRegistryDateFilterError("");
            });

        $("#btnResetRegistryFilter")
            .off("click.registryFilters")
            .on("click.registryFilters", clearRegistryDateFilters);

        syncRegistryDateInputs();
    }

    function syncRegistryDateInputs() {
        const preset = $("#registryDateRange").val();

        if (preset !== "custom") {
            setRegistryDateInputs(getRegistryPresetDates(preset));
        }

        setRegistryDateFilterError("");
    }

    function setRegistryDateInputs({ from, to }) {
        $("#dtpFrom").val(from);
        $("#dtpTo").val(to);
    }

    function setRegistryDateFilterError(message, fieldSelector) {
        $("#registryDateFilterError").text(message).prop("hidden", !message);
        $("#dtpFrom, #dtpTo").removeAttr("aria-invalid");

        if (fieldSelector) {
            $(fieldSelector).attr("aria-invalid", "true").trigger("focus");
        }
    }

    function getRegistryPresetDates(preset, now = new Date()) {
        if (!["today", "last7", "month"].includes(preset)) {
            return { preset: "all", from: "", to: "" };
        }

        // Resolve the calendar day in Cambodia even if the device is in another timezone.
        const parts = Object.fromEntries(
            new Intl.DateTimeFormat("en-GB", {
                timeZone: "Asia/Phnom_Penh",
                year: "numeric",
                month: "2-digit",
                day: "2-digit"
            }).formatToParts(now).map(part => [part.type, part.value])
        );
        const year = Number(parts.year);
        const month = Number(parts.month) - 1;
        const today = Date.UTC(year, month, Number(parts.day));
        const isoDay = timestamp => new Date(timestamp).toISOString().slice(0, 10);

        if (preset === "month") {
            return {
                preset,
                from: isoDay(Date.UTC(year, month, 1)),
                to: isoDay(Date.UTC(year, month + 1, 0))
            };
        }

        const dayInMilliseconds = 24 * 60 * 60 * 1000;
        const firstDay = preset === "last7" ? today - 6 * dayInMilliseconds : today;
        return { preset, from: isoDay(firstDay), to: isoDay(today) };
    }

    function applyRegistryDateFilters() {
        const preset = $("#registryDateRange").val();
        let dates;

        setRegistryDateFilterError("");

        if (preset === "custom") {
            const fromInput = document.getElementById("dtpFrom");
            const toInput = document.getElementById("dtpTo");

            if (!fromInput.validity.valid) {
                setRegistryDateFilterError("Enter a valid From Date.", "#dtpFrom");
                return;
            }

            if (!toInput.validity.valid) {
                setRegistryDateFilterError("Enter a valid To Date.", "#dtpTo");
                return;
            }

            const from = fromInput.value;
            const to = toInput.value;

            if (!from && !to) {
                setRegistryDateFilterError("Enter at least one date, or choose All Dates.", "#dtpFrom");
                return;
            }

            if (from && to && from > to) {
                setRegistryDateFilterError("To Date must be on or after From Date.", "#dtpTo");
                return;
            }

            dates = { preset, from, to };
        } else {
            dates = getRegistryPresetDates(preset);
            setRegistryDateInputs(dates);
        }

        appliedRegistryDates = dates;
        updateRegistryDateFilterSummary();

        if (registryTable) {
            registryTable.ajax.reload(null, true);
        }
    }

    function clearRegistryDateFilters() {
        const hadDateFilter = Boolean(appliedRegistryDates.from || appliedRegistryDates.to);

        $("#registryDateRange").val("all");
        appliedRegistryDates = { preset: "all", from: "", to: "" };
        syncRegistryDateInputs();
        updateRegistryDateFilterSummary();

        // Reset dates only; keep the user's DataTables search.
        if (registryTable && hadDateFilter) {
            registryTable.ajax.reload(null, true);
        }
    }

    function updateRegistryDateFilterSummary() {
        const { preset, from, to } = appliedRegistryDates;
        const labels = {
            all: "All Dates",
            today: "Today",
            last7: "Last 7 Days",
            month: "This Month",
            custom: "Custom Range"
        };
        const displayDate = iso => iso.split("-").reverse().join("/");
        let summary = "Applied registration dates: " + labels[preset];

        if (from && to) {
            summary += " (" + displayDate(from) +
                (from === to ? "" : " – " + displayDate(to)) + ")";
        } else if (from) {
            summary += " (from " + displayDate(from) + ")";
        } else if (to) {
            summary += " (through " + displayDate(to) + ")";
        }

        $("#registryDateFilterSummary").text(summary);
    }

    function initializeRegistryTable() {
        const tableSelector = "#tblRegistry";

        if ($.fn.DataTable.isDataTable(tableSelector)) {
            $(tableSelector).DataTable().destroy();
            $(tableSelector).find("tbody").empty();
        }

        registryTable = $(tableSelector).DataTable({
            processing: true,
            serverSide: true,
            paging: true,
            lengthChange: true,
            searching: true,
            ordering: true,
            info: true,
            stateSave: false,

            responsive: false,
            autoWidth: false,
            scrollX: false,
            scrollY: "",

            order: [[0, "desc"]],

            ajax: loadRegistryRows,

            columns: [
                {
                    data: "studentId",
                    defaultContent: ""
                },
                {
                    data: "studentName",
                    defaultContent: ""
                },
                {
                    data: "studentNameInKhmer",
                    defaultContent: ""
                },
                {
                    data: "sex",
                    defaultContent: ""
                },
                {
                    data: "dateOfBirth",
                    defaultContent: "",
                    render: function (data, type) {
                        if (type !== "display" &&
                            type !== "filter") {
                            return data ?? "";
                        }

                        return formatDate(data);
                    }
                },
                {
                    data: "registrationDate",
                    defaultContent: "",
                    render: function (data, type) {
                        if (type !== "display" &&
                            type !== "filter") {
                            return data ?? "";
                        }

                        return formatDate(data);
                    }
                },
                {
                    data: "degreeName",
                    defaultContent: ""
                },
                {
                    data: "schoolName",
                    defaultContent: ""
                },
                {
                    data: "status",
                    defaultContent: "",
                    orderable: false,
                    searchable: false,
                    className: "text-center",
                    render: function (data, type) {
                        const status = String(data ?? "")
                            .trim()
                            .toUpperCase();

                        if (type !== "display") {
                            return status;
                        }

                        const badgeClasses = {
                            REGISTER: "badge-warning",
                            ACTIVE: "badge-primary",
                            QUIT: "badge-danger",
                            GRADUATED: "badge-fuchsia",
                            COMPLETED: "badge-pink"
                        };

                        const badgeClass =
                            badgeClasses[status] ??
                            "badge-secondary";

                        return `
                                <span class="badge ${badgeClass} px-2 py-1">
                                    ${escapeRegistryHtml(status)}
                                </span>
                            `;
                    }
                },
                {
                    data: "studentId",
                    defaultContent: "",
                    orderable: false,
                    searchable: false,
                    className: "dt-action-col",
                    render: function (data, type) {
                        if (type !== "display") {
                            return data ?? "";
                        }

                        const studentId = String(data ?? "").trim();
                        const safeStudentId =
                            escapeRegistryHtml(studentId);

                        return `
                                <button type="button"
                                        class="btn btn-warning btn-sm js-registry-manage"
                                        data-toggle="modal"
                                        data-target="#RegistryDetailsModal"
                                        data-student-id="${safeStudentId}">
                                    <i class="fas fa-cog mr-1"></i>
                                    Manage
                                </button>
                            `;
                    }
                }
            ],

            columnDefs: [
                { targets: 0, width: "90px" },
                { targets: 1, width: "145px" },
                { targets: 2, width: "145px" },
                { targets: 3, width: "65px" },
                { targets: 4, width: "100px" },
                { targets: 5, width: "105px" },
                { targets: 6, width: "130px" },
                { targets: 7, width: "180px" },
                { targets: 8, width: "85px" },
                {
                    targets: 9,
                    width: "105px",
                    orderable: false,
                    searchable: false
                }
            ],

            language: {
                processing: "Loading...",
                searchPlaceholder: "Student ID or name",
                info: "Showing _START_ to _END_ of _TOTAL_ entries",
                infoEmpty: "Showing 0 to 0 of _MAX_ entries",
                infoFiltered: "",
                thousands: ",",
                emptyTable: registrySearchPrompt,
                zeroRecords: registryNoMatchesMessage
            },

            infoCallback: function (_settings, _start, _end, _max, _total, text) {
                return registryEntryCountUnavailable ? "Total entries unavailable" : text;
            },

            initComplete: function () {
                // Scroll the single table instead of having DataTables clone its header.
                const $table = $(this.api().table().node());
                if (!$table.parent().hasClass("registry-table-scroll")) {
                    $table.wrap('<div class="registry-table-scroll" role="region" aria-label="Student Registry table" tabindex="0"></div>');
                }
                if (typeof MyApp !== "undefined" &&
                    typeof MyApp.utils?.dataTableDebounceSearch === "function") {
                    MyApp.utils.dataTableDebounceSearch(tableSelector, 500);
                }
            },

            drawCallback: function () {
                updateRegistryResultControls(this.api());
            }
        });
    }

    function loadRegistryRows(request, complete) {
        if (registryListRequest) {
            const previousRequest = registryListRequest;
            registryListRequest = null;
            previousRequest.abort();
        }

        const searchValue = String(request.search?.value ?? "").trim();
        const { from, to } = appliedRegistryDates;
        const summaryOnly = !searchValue && !from && !to;
        const emptyResponse = {
            draw: request.draw,
            recordsTotal: 0,
            recordsFiltered: 0,
            data: []
        };

        registryListEmptyMessage = summaryOnly ? registrySearchPrompt : registryNoMatchesMessage;
        const pending = $.ajax({
            url: "@Url.Action("GetStudentRegistryList", "Registry")",
            type: "POST",
            dataType: "json",
            data: {
                ...request,
                // Older controllers ignore countOnly; limit that fallback to one undisplayed row.
                ...(summaryOnly ? { start: 0, length: 1, countOnly: true } : {}),
                search: { ...request.search, value: searchValue },
                from,
                to
            }
        });
        registryListRequest = pending;

        function showLoadError(reason) {
            if (registryListRequest !== pending) return;

            registryEntryCountUnavailable = true;
            if (!summaryOnly) {
                registryListEmptyMessage = "Unable to load registrations. Try searching again.";
            }
            console.error("Cannot load student registry list:", reason);
            complete(emptyResponse);
            if (!summaryOnly && typeof ShowToastError === "function") {
                ShowToastError("Cannot load student registry list.");
            }
        }

        return pending.done(function (response) {
            if (registryListRequest !== pending) return;

            const recordsTotal = Number(response?.recordsTotal ?? NaN);
            const recordsFiltered = Number(response?.recordsFiltered ?? NaN);
            if (!Array.isArray(response?.data) ||
                !Number.isSafeInteger(recordsTotal) || recordsTotal < 0 ||
                !Number.isSafeInteger(recordsFiltered) || recordsFiltered < 0) {
                showLoadError("Unexpected list response.");
                return;
            }

            registryEntryCountUnavailable = false;
            if (summaryOnly) {
                // Give DataTables the true total for its footer, but no rows or pages.
                complete({ ...emptyResponse, recordsTotal });
            } else {
                complete({ ...response, draw: request.draw, recordsTotal, recordsFiltered });
            }
        }).fail(function (xhr, status) {
            if (status !== "abort") {
                showLoadError(xhr.status || status);
            }
        }).always(function () {
            if (registryListRequest === pending) {
                registryListRequest = null;
            }
        });
    }

    function updateRegistryResultControls(api) {
        const page = api.page.info();
        const hasResults = page.recordsDisplay > 0;

        $(api.table().container())
            .toggleClass("registry-has-results", hasResults)
            .toggleClass("registry-has-pages", hasResults && page.pages > 1);

        if (!hasResults) {
            $(api.table().body())
                .find("td.dataTables_empty, td.dt-empty")
                .text(registryListEmptyMessage);
        }
    }

    function escapeRegistryHtml(value) {
        return $("<div>")
            .text(value ?? "")
            .html();
    }

    const createRegistryModalHost = $("#CreateRegistryModalHost");
    const openCreateRegistryButton = $("#btnOpenCreateRegistryModal");
    let createRegistryRequest = null;

    openCreateRegistryButton
        .off("click.createRegistry")
        .on("click.createRegistry", function () {
            if (createRegistryRequest) return;
            const originalHtml = openCreateRegistryButton.html();
            openCreateRegistryButton
                .prop("disabled", true)
                .html(
                    '<i class="fas fa-spinner fa-spin mr-1"></i>Loading...'
                );
            createRegistryRequest = $.ajax({
                url: "/registry/create-new-student?modal=true",
                type: "GET",
                cache: false,
                timeout: 20000
            }).done(function (html) {
                createRegistryModalHost.html(html);
                const modal = $("#CreateRegistryModal");
                if (!modal.length) {
                    const message = "Create Registry modal was not returned.";
                    if (typeof ShowToastError === "function") {
                        ShowToastError(message);
                    } else {
                        alert(message);
                    }
                    createRegistryModalHost.empty();
                    return;
                }

                modal.modal({
                    backdrop: "static",
                    keyboard: false,
                    show: true
                });
            })
                .fail(function (xhr, status) {
                    if (status === "abort") {
                        return;
                    }

                    const message =
                        xhr.responseJSON?.status?.message ??
                        xhr.responseJSON?.message ??
                        "Unable to load the registration form.";

                    if (typeof ShowToastError === "function") {
                        ShowToastError(message);
                    } else {
                        alert(message);
                    }
                })
                .always(function () {
                    createRegistryRequest = null;
                    openCreateRegistryButton
                        .prop("disabled", false)
                        .html(originalHtml);
                });
        });

    $(document)
        .off("hidden.bs.modal.createRegistry", "#CreateRegistryModal")
        .on(
            "hidden.bs.modal.createRegistry",
            "#CreateRegistryModal",
            function () {
                createRegistryModalHost.empty();
            }
        );

    const registryDetailsModal = $("#RegistryDetailsModal");
    const registryDetailsBody = $("#RegistryDetailsModalBody");
    let registryDetailsRequest = null;

    $(document)
        .off("click.registryManage", ".js-registry-manage")
        .on("click.registryManage", ".js-registry-manage", function () {
            const studentId = String(
                $(this).attr("data-student-id") ?? ""
            ).trim();

            if (!studentId) {
                if (typeof ShowToastError === "function") {
                    ShowToastError("Student ID is missing.");
                }
                return;
            }

            loadRegistryDetails(studentId);
        });

    function loadRegistryDetails(studentId) {
        if (registryDetailsRequest) {
            registryDetailsRequest.abort();
        }

        registryDetailsBody.html(`
            <div class="d-flex justify-content-center align-items-center h-100">
                <div class="text-center">
                    <i class="fas fa-spinner fa-spin fa-2x text-primary"></i>
                    <div class="mt-2">Loading student information...</div>
                </div>
            </div>
        `);

        registryDetailsRequest = $.ajax({
            url: `/registry/details/${encodeURIComponent(studentId)}?modal=true`,
            type: "GET",
            cache: false,
            timeout: 20000
        })
            .done(function (html) {
                registryDetailsBody.html(html);
                initializeRegistryDetailsContent();
            })
            .fail(function (xhr, status) {
                if (status === "abort") {
                    return;
                }

                const message =
                    xhr.responseJSON?.status?.message ??
                    xhr.responseJSON?.message ??
                    "Unable to load registry details.";

                registryDetailsBody.html(`
                    <div class="alert alert-danger m-3">
                        ${escapeRegistryHtml(message)}
                    </div>
                `);

                if (typeof ShowToastError === "function") {
                    ShowToastError(message);
                }
            })
            .always(function () {
                registryDetailsRequest = null;
            });
    }

    function initializeRegistryDetailsContent() {
        const fieldset = $("#registryDetailsFieldset");

        fieldset.prop("disabled", true);
        fieldset
            .find("input:not([type='hidden']), select, textarea, button")
            .prop("disabled", true);

        $("#btnUpdateRegistryDetails").addClass("d-none");

        if ($.fn.select2) {
            registryDetailsBody.find(".select2").each(function () {
                const select = $(this);

                if (select.hasClass("select2-hidden-accessible")) {
                    select.select2("destroy");
                }

                select.select2({
                    width: "100%",
                    dropdownParent: registryDetailsModal
                });
            });
        }

        loadRegistryDetailsPersonalLookups();
    }

    function getRegistryStudentControl(propertyName) {
        return registryDetailsBody.find(
            `[name="Student.${propertyName}"], ` +
            `[name="registryReq.Student.${propertyName}"], ` +
            `#Student_${propertyName}, ` +
            `#registryReq_Student_${propertyName}`
        ).first();
    }

    function selectRegistrySavedValue(select, savedValue, appendIfMissing) {
        if (!select.length) {
            return;
        }

        const normalizedValue = String(savedValue ?? "").trim();

        if (!normalizedValue || normalizedValue === "0") {
            select.val("0").trigger("change.select2");
            return;
        }

        let matchingValue;

        select.find("option").each(function () {
            const optionValue = String(this.value ?? "").trim();
            const optionNumber = Number(optionValue);
            const savedNumber = Number(normalizedValue);
            const numericMatch =
                optionValue !== "" &&
                normalizedValue !== "" &&
                Number.isFinite(optionNumber) &&
                Number.isFinite(savedNumber) &&
                optionNumber === savedNumber;

            if (numericMatch || optionValue === normalizedValue) {
                matchingValue = this.value;
                return false;
            }
        });

        if (matchingValue === undefined && appendIfMissing) {
            select.append(new Option(normalizedValue, normalizedValue));
            matchingValue = normalizedValue;
        }

        if (matchingValue !== undefined) {
            select.val(matchingValue).trigger("change.select2");
        }
    }

    function loadRegistryDetailsPersonalLookups() {
        const form = $("#frmRegistryDetails");

        if (!form.length) {
            return;
        }

        const lookupValues = {
            PlaceOfBirthId: form.attr("data-place-of-birth-id"),
            NationalityId: form.attr("data-nationality-id"),
            FromProvinceId: form.attr("data-province-id"),
            RaceId: form.attr("data-race-id"),
            JobId: form.attr("data-job-id"),
            DisabilityId: form.attr("data-disability-id"),
            FromHighSchoolNameInKhmer:
                form.attr("data-high-school-name")
        };

        Object.keys(lookupValues).forEach(function (propertyName) {
            const select = getRegistryStudentControl(propertyName);
            const template = registryDetailsBody.find(
                `#registryDetailsLookupTemplates ` +
                `[data-registry-lookup="${propertyName}"]`
            ).first();

            if (!select.length || !template.length) {
                return;
            }

            const wasDisabled = select.prop("disabled");
            select.html(template.html());
            selectRegistrySavedValue(
                select,
                lookupValues[propertyName],
                propertyName === "FromHighSchoolNameInKhmer"
            );
            select.prop("disabled", wasDisabled);
            select.trigger("change.select2");
        });
    }

    $(document)
        .off("click.registryDetailsEdit", "#btnEnableRegistryDetailsEdit")
        .on("click.registryDetailsEdit", "#btnEnableRegistryDetailsEdit", function () {
            const fieldset = $("#registryDetailsFieldset");
            const enableEdit = fieldset.prop("disabled");

            fieldset.prop("disabled", !enableEdit);
            fieldset
                .find("input:not([type='hidden']), select, textarea, button")
                .prop("disabled", !enableEdit);

            $("#btnUpdateRegistryDetails")
                .toggleClass("d-none", !enableEdit);

            $(this)
                .toggleClass("btn-outline-primary", !enableEdit)
                .toggleClass("btn-primary", enableEdit)
                .attr(
                    "title",
                    enableEdit
                        ? "Cancel editing"
                        : "Edit student information"
                );
        });

    $(document)
        .off("change.registryDetailsPhoto", "#registryDetailsPhoto")
        .on("change.registryDetailsPhoto", "#registryDetailsPhoto", function () {
            const file = this.files && this.files[0];

            if (!file) {
                return;
            }

            $(this).next(".custom-file-label").text(file.name);

            const reader = new FileReader();
            reader.onload = function (event) {
                $("#registryDetailsPhotoPreview").attr(
                    "src",
                    event.target.result
                );
            };
            reader.readAsDataURL(file);
        });

    function buildRegistryDetailsFormData(formElement) {
        const source = new FormData(formElement);
        const normalized = new FormData();

        for (const entry of source.entries()) {
            normalized.append(
                entry[0].replace(/^registryReq\./i, ""),
                entry[1]
            );
        }

        return normalized;
    }

    function setRegistryUpdateLoading(isLoading) {
        const button = $("#btnUpdateRegistryDetails");

        if (!button.length) {
            return;
        }

        if (isLoading) {
            if (!button.data("original-html")) {
                button.data("original-html", button.html());
            }

            button
                .prop("disabled", true)
                .html(
                    '<i class="fas fa-spinner fa-spin mr-1"></i>Updating...'
                );
            return;
        }

        button
            .prop("disabled", false)
            .html(
                button.data("original-html") ||
                '<i class="fas fa-save mr-1"></i>Update'
            )
            .removeData("original-html")
            .removeData("submitting");
    }

    window.UpdateRegistryDetails = function (button, event) {
        if (event) {
            event.preventDefault();
            event.stopPropagation();
        }

        const form = $("#frmRegistryDetails");
        const updateButton = $(button);

        if (!form.length || updateButton.data("submitting")) {
            return false;
        }

        updateButton.data("submitting", true);
        form.trigger("submit");
        return false;
    };

    $(document)
        .off("submit.registryDetails", "#frmRegistryDetails")
        .on("submit.registryDetails", "#frmRegistryDetails", function (event) {
            event.preventDefault();

            const updateButton = $("#btnUpdateRegistryDetails");

            if (!updateButton.data("submitting")) {
                updateButton.data("submitting", true);
            }

            setRegistryUpdateLoading(true);

            $.ajax({
                url: this.action || "/registry/update",
                type: "POST",
                data: buildRegistryDetailsFormData(this),
                processData: false,
                contentType: false
            })
                .done(function (response) {
                    const code = String(
                        response?.status?.code ??
                        response?.code ??
                        "200"
                    );
                    const message =
                        response?.status?.message ??
                        response?.message ??
                        "Student updated successfully.";

                    if (code !== "200") {
                        if (typeof ShowToastError === "function") {
                            ShowToastError(message);
                        } else {
                            alert(message);
                        }
                        return;
                    }

                    if (typeof ShowToastSuccess === "function") {
                        ShowToastSuccess(message);
                    } else {
                        alert(message);
                    }

                    registryDetailsModal.modal("hide");

                    if ($.fn.DataTable.isDataTable("#tblRegistry")) {
                        $("#tblRegistry")
                            .DataTable()
                            .ajax.reload(null, false);
                    }
                })
                .fail(function (xhr) {
                    const message =
                        xhr.responseJSON?.status?.message ??
                        xhr.responseJSON?.message ??
                        "Unable to update the student.";

                    if (typeof ShowToastError === "function") {
                        ShowToastError(message);
                    } else {
                        alert(message);
                    }
                })
                .always(function () {
                    setRegistryUpdateLoading(false);
                });
        });

    $("#btnToggleRegistryDetailsSize")
        .off("click.registryDetailsSize")
        .on("click.registryDetailsSize", function () {
            registryDetailsModal.toggleClass(
                "registry-details-fullscreen"
            );

            const isFullscreen = registryDetailsModal.hasClass(
                "registry-details-fullscreen"
            );

            $(this)
                .attr(
                    "title",
                    isFullscreen ? "Exit full screen" : "Full screen"
                )
                .find("i")
                .toggleClass("fa-expand", !isFullscreen)
                .toggleClass("fa-compress", isFullscreen);
        });

    registryDetailsModal
        .off("hidden.bs.modal.registryDetails")
        .on("hidden.bs.modal.registryDetails", function () {
            if (registryDetailsRequest) {
                registryDetailsRequest.abort();
                registryDetailsRequest = null;
            }

            registryDetailsBody
                .find(".select2-hidden-accessible")
                .each(function () {
                    $(this).select2("destroy");
                });

            registryDetailsBody.empty();
            registryDetailsModal.addClass(
                "registry-details-fullscreen"
            );

            $("#btnToggleRegistryDetailsSize")
                .attr("title", "Exit full screen")
                .find("i")
                .removeClass("fa-expand")
                .addClass("fa-compress");
        });
</script>
}
