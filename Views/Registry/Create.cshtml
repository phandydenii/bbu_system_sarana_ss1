    function toggleResumeForm() {
        const shouldShow =
            chbAssToBac.prop("checked") ||
            chbBacToMas.prop("checked");

        if (shouldShow) {
            resume.removeAttr("hidden");

            resume
                .find("input, select, textarea")
                .prop("disabled", false);

            $("#registryReq_Resume_CSemester").val(1);
        } else {
            resume.attr("hidden", "hidden");

            resume
                .find("input, select, textarea")
                .prop("disabled", true);
        }
}

