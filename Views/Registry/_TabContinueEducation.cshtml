@model BBU_SYSTEM.Models.Req.RegistryReq

<div class="row">
    <div class="col-6">
        <div class="form-group">
            <label asp-for="Student!.CheckCompleteTerm">Term</label>

            <input asp-for="Student!.CheckCompleteTerm"
                   type="number"
                   min="1"
                   class="form-control input-sm" />

            <span asp-validation-for="Student!.CheckCompleteTerm"
                  class="text-danger"></span>
        </div>
    </div>

    <div class="col-6">
        <div class="form-group">
            <label>Status</label>

            <div class="clearfix">
                <div class="icheck-primary d-inline">
                    <input asp-for="Student!.CheckComplete"
                           type="checkbox"
                           id="checkComplete" />

                    <label for="checkComplete">
                        Received
                    </label>
                </div>
            </div>

            <span asp-validation-for="Student!.CheckComplete"
                  class="text-danger"></span>
        </div>
    </div>
</div>

<div class="form-group">
    <label asp-for="Student!.CheckCompleteNote">Note</label>

    <textarea asp-for="Student!.CheckCompleteNote"
              rows="4"
              class="form-control"
              placeholder="Enter note"></textarea>

    <span asp-validation-for="Student!.CheckCompleteNote"
          class="text-danger"></span>
</div>