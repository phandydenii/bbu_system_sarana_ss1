@using BBU_SYSTEM.DTOs
@{
    var contactPerson = new ContactPersonDto();
}
<label class="required">Name</label>
<input type="text" class="form-control" asp-for="@contactPerson.ContactPersonName" required>
<label>Job</label>
<input type="text" class="form-control" asp-for="@contactPerson.Job">
<label>Phone</label>
<input type="text" class="form-control" asp-for="@contactPerson.Phone">
<label>Address</label>
<textarea type="text" rows="4" class="form-control" asp-for="@contactPerson.Address"></textarea>