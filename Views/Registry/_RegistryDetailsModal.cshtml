@model BBU_SYSTEM.ViewModel.RegisryDetailViewModel
@using BBU_SYSTEM.DTOs
@using BBU_SYSTEM.Models.Req
@inject AutoMapper.IMapper Mapper

@{
    if (Model.StudentView?.Student == null ||
        Model.StudentView.Registry == null ||
        Model.StudentView.Degree == null ||
        Model.StudentView.School == null ||
        Model.ListData == null)
    {
        <div class="alert alert-warning m-3">
            Required registry information is missing for this student.
        </div>
        return;
    }

    var student = Model.StudentView.Student;
    var registry = Model.StudentView.Registry;
    var degree = Model.StudentView.Degree;
    var school = Model.StudentView.School;
    var field = Model.StudentView.Field;

    var degrees = Model.ListData.Degrees!;
    var schools = Model.ListData.Schools!;
    var provinces = Model.ListData.Provinces!;
    var nationalities = Model.ListData.Nationalities!;
    var races = Model.ListData.Races!;
    var studentJobs = Model.ListData.StudentJobs!;
    var disabilities = Model.ListData.Disabilities!;
    var highSchools = Model.ListData.HightSchools!;
    var fields = Model.ListData.Fields!
        .Where(x => x.DegreeId == degree.DegreeId && x.SchoolId == school.SchoolId)
        .ToList();
    var programs = fields
        .GroupBy(x => x.DegreeId)
        .Select(x => x.First())
        .ToList();
    var promotions = Model.ListData.Promotions!
        .Where(x => x.DegreeId == degree.DegreeId && x.SchoolId == school.SchoolId)
        .ToList();
    var stages = Model.ListData.Stages!
        .GroupBy(x => x.StageNo)
        .Select(x => x.First())
        .ToList();
    var terms = Model.ListData.Terms!
        .GroupBy(x => x.TermNo)
        .Select(x => x.First())
        .ToList();

    var registryReq = new RegistryReq
    {
        Student = Mapper.Map<StudentDto>(student),
        Registry = Mapper.Map<RegistryDto>(registry),
        ContactPerson = Model.StudentView.ContactPerson == null
            ? new ContactPersonDto()
            : Mapper.Map<ContactPersonDto>(Model.StudentView.ContactPerson),
        Scholarships = Model.StudentView.Schoolarships == null
            ? new List<StudentScholarshipDto>()
            : Mapper.Map<List<StudentScholarshipDto>>(Model.StudentView.Schoolarships),
        StudentCertificates = Model.StudentView.StudentCertificates == null
            ? new List<StudentCertificateDto>()
            : Mapper.Map<List<StudentCertificateDto>>(Model.StudentView.StudentCertificates),
        Extend = Model.StudentView.Extend == null
            ? new ExtendDto()
            : Mapper.Map<ExtendDto>(Model.StudentView.Extend),
        Resume = new ResumeDto(),
        IsContinue = student.IsContinuedStudent == 1,
        AssToBach = student.AssociateToBachelor == 1,
        // The Student entity does not expose BachelorToMaster.
        // Keep the checkbox clear until the user explicitly selects it.
        BachToMas = false,
        ProgramId = field?.DegreeId ?? 0
    };

    // AutoMapper does not always copy nullable lookup keys.  Keep the entity
    // values explicitly so the Personal tab can restore every saved option.
    registryReq.Student.PlaceOfBirthId = student.PlaceOfBirthId;
    registryReq.Student.NationalityId = student.NationalityId;
    registryReq.Student.FromProvinceId = student.FromProvinceId;
    registryReq.Student.RaceId = student.RaceId;
    registryReq.Student.JobId = student.JobId;
    registryReq.Student.DisabilityId = student.DisabilityId;
    registryReq.Student.FromHighSchoolNameInKhmer =
        student.FromHighSchoolNameInKhmer;
    registryReq.Student.MaritalStatus = student.MaritalStatus;
    registryReq.Student.IsReceivePhoto = student.IsPhotoReceived == 1;

    var showExtend = registryReq.Extend?.ExtendDate.HasValue == true;
    var studentPhotoSource = student.Photo != null && student.Photo.Length > 0
        ? $"data:image/jpeg;base64,{Convert.ToBase64String(student.Photo)}"
        : Url.Content("~/Images/add_user.png");
}

<div class="card card-success card-outline mb-0 registry-details-card">
    <div class="card-header">
        <h3 class="card-title">Student Information</h3>
        <div class="card-tools">
            <button type="button"
                    id="btnEnableRegistryDetailsEdit"
                    class="btn btn-sm btn-outline-primary"
                    title="Edit student information">
                <i class="fas fa-pen"></i>
            </button>
        </div>
    </div>

    <form id="frmRegistryDetails"
          method="post"
          enctype="multipart/form-data"
          novalidate
          asp-controller="Registry"
          asp-action="PutRegistry"
          data-place-of-birth-id="@student.PlaceOfBirthId"
          data-nationality-id="@student.NationalityId"
          data-province-id="@student.FromProvinceId"
          data-race-id="@student.RaceId"
          data-job-id="@student.JobId"
          data-disability-id="@student.DisabilityId"
          data-high-school-name="@student.FromHighSchoolNameInKhmer">
        @Html.AntiForgeryToken()
        <input type="hidden" name="oldStudentId" value="@student.StudentId">
        <input type="hidden" name="Student.StudentId" value="@student.StudentId">

        @* Server-rendered lookup templates make the modal independent from
           separate lookup API requests. They have no name attributes, so
           they are never included in the update request. *@
        <div id="registryDetailsLookupTemplates" class="d-none" aria-hidden="true">
            <select data-registry-lookup="PlaceOfBirthId">
                <option value="0">Select Place of Birth</option>
                @foreach (var item in provinces)
                {
                    <option value="@item.ProvinceId">@(item.ProvinceName ?? item.ProvinceInKhmer)</option>
                }
            </select>

            <select data-registry-lookup="NationalityId">
                <option value="0">Select Nationality</option>
                @foreach (var item in nationalities)
                {
                    <option value="@item.NationalityId">@item.NationalityName</option>
                }
            </select>

            <select data-registry-lookup="FromProvinceId">
                <option value="0">Select Province</option>
                @foreach (var item in provinces)
                {
                    <option value="@item.ProvinceId">@(item.ProvinceName ?? item.ProvinceInKhmer)</option>
                }
            </select>

            <select data-registry-lookup="RaceId">
                <option value="0">Select Race</option>
                @foreach (var item in races)
                {
                    <option value="@item.RaceId">@item.RaceName</option>
                }
            </select>

            <select data-registry-lookup="JobId">
                <option value="0">Select Job</option>
                @foreach (var item in studentJobs)
                {
                    <option value="@item.JobId">@item.JobName</option>
                }
            </select>

            <select data-registry-lookup="DisabilityId">
                <option value="0">Select Disability</option>
                @foreach (var item in disabilities)
                {
                    <option value="@item.Id">@item.DisabilityName</option>
                }
            </select>

            <select data-registry-lookup="FromHighSchoolNameInKhmer">
                <option value="0">Select High School</option>
                @foreach (var item in highSchools)
                {
                    <option value="@item.HighSchoolNameInKhmer">@item.HighSchoolNameInKhmer</option>
                }
            </select>
        </div>

        <div class="card-body p-2">
            <fieldset id="registryDetailsFieldset" disabled>
                <div class="row">
                    <div class="col-lg-7">
                        <div class="card card-primary card-outline card-outline-tabs h-100 mb-2">
                            <div class="card-header p-0 border-bottom-0">
                                <ul class="nav nav-tabs flex-nowrap overflow-auto" role="tablist">
                                    <li class="nav-item">
                                        <a class="nav-link active" data-toggle="pill"
                                           href="#registry-details-personal" role="tab">Personal</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" data-toggle="pill"
                                           href="#registry-details-contact" role="tab">Personal Contact</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" data-toggle="pill"
                                           href="#registry-details-relative" role="tab">Relative Contact</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" data-toggle="pill"
                                           href="#registry-details-parent" role="tab">Parent</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" data-toggle="pill"
                                           href="#registry-details-certificate" role="tab">Certificate</a>
                                    </li>
                                    @if (showExtend)
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link" data-toggle="pill"
                                               href="#registry-details-extend" role="tab">Extend</a>
                                        </li>
                                    }
                                    <li class="nav-item">
                                        <a class="nav-link" data-toggle="pill"
                                           href="#registry-details-note" role="tab">Note</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" data-toggle="pill"
                                           href="#registry-details-continue" role="tab">Continue</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" data-toggle="pill"
                                           href="#registry-details-image" role="tab">Image</a>
                                    </li>
                                </ul>
                            </div>

                            <div class="card-body p-2">
                                <div class="tab-content">
                                    <div class="tab-pane fade show active" id="registry-details-personal" role="tabpanel">
                                        <partial name="_TabPersonal" model="registryReq" />
                                    </div>
                                    <div class="tab-pane fade" id="registry-details-contact" role="tabpanel">
                                        <partial name="_TabContactPerson" model="registryReq" />
                                    </div>
                                    <div class="tab-pane fade" id="registry-details-relative" role="tabpanel">
                                        <partial name="_TabRelativeContact" model="registryReq" />
                                    </div>
                                    <div class="tab-pane fade" id="registry-details-parent" role="tabpanel">
                                        <partial name="_TabParent" model="registryReq" />
                                    </div>
                                    <div class="tab-pane fade" id="registry-details-certificate" role="tabpanel">
                                        <partial name="_TabCertificate" model="registryReq" />
                                    </div>
                                    @if (showExtend)
                                    {
                                        <div class="tab-pane fade" id="registry-details-extend" role="tabpanel">
                                            <partial name="_TabExtendFrom" model="registryReq" />
                                        </div>
                                    }
                                    <div class="tab-pane fade" id="registry-details-note" role="tabpanel">
                                        <partial name="_TabNote" model="registryReq" />
                                    </div>
                                    <div class="tab-pane fade" id="registry-details-continue" role="tabpanel">
                                        <partial name="_TabContinueEducation" model="registryReq" />
                                    </div>
                                    <div class="tab-pane fade" id="registry-details-image" role="tabpanel">
                                        <div class="text-center mb-3">
                                            <img src="@studentPhotoSource"
                                                 alt="Student photo"
                                                 id="registryDetailsPhotoPreview"
                                                 class="img-thumbnail"
                                                 style="max-width: 280px; max-height: 280px;">
                                        </div>
                                        <div class="custom-file">
                                            <input type="file"
                                                   class="custom-file-input"
                                                   id="registryDetailsPhoto"
                                                   name="studentPhoto"
                                                   accept="image/*">
                                            <label class="custom-file-label" for="registryDetailsPhoto">Choose image</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <div class="card card-primary card-outline h-100 mb-2">
                            <div class="card-body p-3">
                                <div class="row">
                                    <div class="col-md-4">
                                        <label>Degree</label>
                                        <select asp-for="@registryReq.Registry!.DegreeId"
                                                name="Registry.DegreeId"
                                                class="form-control select2">
                                            @foreach (var item in degrees)
                                            {
                                                <option value="@item.DegreeId">@item.DegreeName</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-8">
                                        <label>School</label>
                                        <select asp-for="@registryReq.Registry!.SchoolId"
                                                name="Registry.SchoolId"
                                                class="form-control select2">
                                            @foreach (var item in schools)
                                            {
                                                <option value="@item.SchoolId">@item.SchoolName</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-12">
                                        <label>Program</label>
                                        <select asp-for="@registryReq.ProgramId"
                                                name="ProgramId"
                                                class="form-control select2">
                                            @foreach (var item in programs)
                                            {
                                                <option value="@item.DegreeId">@item.DegreeName</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-12">
                                        <label>Field</label>
                                        <select asp-for="@registryReq.Student!.FieldId"
                                                name="Student.FieldId"
                                                class="form-control select2">
                                            @foreach (var item in fields)
                                            {
                                                <option value="@item.FieldId">@item.FieldName</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-3">
                                        <label>Promotion</label>
                                        <select asp-for="@registryReq.Registry!.PromotionNo"
                                                name="Registry.PromotionNo"
                                                class="form-control select2">
                                            @foreach (var item in promotions)
                                            {
                                                <option value="@item.PromotionNo">@item.PromotionNo</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label>Stage</label>
                                        <select asp-for="@registryReq.Registry!.StageNo"
                                                name="Registry.StageNo"
                                                class="form-control select2">
                                            @foreach (var item in stages)
                                            {
                                                <option value="@item.StageNo">@item.StageNo</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label>Term</label>
                                        <select asp-for="@registryReq.Registry!.TermNo"
                                                name="Registry.TermNo"
                                                class="form-control select2">
                                            @foreach (var item in terms)
                                            {
                                                <option value="@item.TermNo">@item.TermNo</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label>Study Time</label>
                                        <select asp-for="@registryReq.Registry!.StudyTime"
                                                name="Registry.StudyTime"
                                                class="form-control select2">
                                            @foreach (var item in Model.ListData.StudyTimes!)
                                            {
                                                <option value="@item.StudyTimeValue">@item.StudyTimeValue</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <hr>

                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="custom-control custom-checkbox">
                                            <input type="checkbox"
                                                   class="custom-control-input"
                                                   id="detailsIsContinue"
                                                   name="IsContinue"
                                                   asp-for="@registryReq.IsContinue">
                                            <label class="custom-control-label" for="detailsIsContinue">Continued Student</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="custom-control custom-checkbox">
                                            <input type="checkbox"
                                                   class="custom-control-input"
                                                   id="detailsAssToBach"
                                                   name="AssToBach"
                                                   asp-for="@registryReq.AssToBach">
                                            <label class="custom-control-label" for="detailsAssToBach">Associate to Bachelor</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="custom-control custom-checkbox">
                                            <input type="checkbox"
                                                   class="custom-control-input"
                                                   id="detailsBachToMas"
                                                   name="BachToMas"
                                                   asp-for="@registryReq.BachToMas">
                                            <label class="custom-control-label" for="detailsBachToMas">Bachelor to Master</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </fieldset>
        </div>

        <div class="card-footer text-right">
            <button type="button" class="btn btn-danger" data-dismiss="modal">
                <i class="fas fa-times mr-1"></i>Close
            </button>
            <button type="submit"
                    id="btnUpdateRegistryDetails"
                    class="btn btn-success d-none"
                    formnovalidate
                    onclick="return window.UpdateRegistryDetails(this, event);">
                <i class="fas fa-save mr-1"></i>Update
            </button>
        </div>
    </form>
</div>
