@using BBU_SYSTEM.DTOs
@{
    var privilegeGroup = new PrivilegeGroupDto();
}
<div class="modal fade" id="modelPrivilegeGroup" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Privilege Group</h4>
            </div>
            <div class="modal-body">
                <form id="formPrivilegeGroup">
                    <input asp-for="@privilegeGroup.Id" readonly class="form-control" value="0"/>
                    <div class="form-group">
                        <label class="required">Name</label>
                        <input type="text" asp-for="@privilegeGroup.GroupName" class="form-control"
                               placeholder="Enter name" pattern="^\S+$" title="Spaces are not allowed">
                    </div>
                </form>
            </div>
            <div class="modal-footer float-right">
                <button type="submit" form="formPrivilegeGroup" class="btn btn-primary"><i class="fas fa-save"></i> Save
                    changes
                </button>
                <button type="button" class="btn btn-danger" data-dismiss="modal"><i class="fas fa-close"></i> Close
                </button>
            </div>
        </div>
    </div>
</div>