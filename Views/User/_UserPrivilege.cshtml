@using BBU_SYSTEM.DTOs
@{
    var user = new UserDto();
}
<div class="modal fade" id="modelUserPrivilege" data-backdrop="static">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">User Privilege</h4>
                @* <input type="text" id="username" readonly class="form-control float-right" value=""/> *@
                <label id="username"></label>
            </div>
            <div class="modal-body">
                <input type="hidden" id="userId" readonly class="form-control" value="0"/>
                <p>List Privileges</p>
                <div class="row">
                    <div class="col-5 col-sm-3">
                        <div class="nav flex-column nav-tabs h-100" id="privilegeTabs" role="tablist" aria-orientation="vertical">
                            <!-- Dynamic tab links will go here -->
                        </div>
                    </div>

                    <div class="col-7 col-sm-9">
                        <div class="tab-content" id="privilegeTabContent">
                            <!-- Dynamic tab contents will go here -->
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer float-right"> 
                <button type="button" class="btn btn-danger" data-dismiss="modal"><i class="fas fa-close"></i> Close
                </button>
            </div>
        </div>
    </div>
</div>