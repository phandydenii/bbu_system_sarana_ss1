@model BBU_SYSTEM.DTOs.ResetPasswordDto
<div class="modal fade" id="modalResetPassword" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">User</h4>
            </div>
            <div class="modal-body">
                <form id="frmResetPassword"> 
                    <div class="form-group">
                        <label class="required">Username</label>
                        <input type="text" asp-for="@Model.Username" class="form-control"
                               placeholder="Enter name">
                    </div>
                    <div class="form-group">
                        <label class="required">Current Password</label>
                        <input type="text" asp-for="@Model.CurrentPassword" class="form-control" placeholder="Enter confirm password">
                    </div>
                    <div class="form-group">
                        <label class="required">New Password</label>
                        <input type="text" asp-for="@Model.NewPassword" class="form-control" placeholder="Enter password">
                    </div>
                    <div class="form-group">
                        <label class="required">Confirm Password</label>
                        <input type="text" asp-for="@Model.ConfirmPassword" class="form-control" placeholder="Enter confirm password">
                    </div>
                </form>
            </div>
            <div class="modal-footer float-right">
                <button type="submit" form="frmResetPassword" class="btn btn-primary"><i class="fas fa-save"></i> Save changes
                </button>
                <button type="button" class="btn btn-danger" data-dismiss="modal"><i class="fas fa-close"></i> Close
                </button>
            </div>
        </div>
    </div>
</div>