<script src="/AdminLTE/plugins/jquery/jquery.min.js"></script>
<script>
    $(document).ready(function () {

    });

    function LoadData() {
        $("#tblAdminUser").DataTable().clear().destroy();
        $("#tblAdminUser")
            .DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: `/user/administrationuser`,
                    type: "POST",
                },
                columns: [
                    {data: "user_id"},
                    {data: "user_name"},
                    {data: "password"},
                    {data: "user_group"},
                    {data: "status"}
                ]
            })
            .buttons()
            .container()
            .appendTo("#example1_wrapper .col-md-6:eq(0)");
    }
</script>