@model List<BBU_SYSTEM.Models.Student>
@{
    ViewData["OpenMenu"] = "Administration";
    ViewData["Action"] = "Discount";
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Discount Student</h3>
            </div>
            <div class="card-body">
                <table id="tblStudentDiscount" class="table table-sm table-bordered table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>Student Id</th>
                        <th>Name English</th>
                        <th>Name Khmer</th>
                        <th>Gender</th>
                        <th>DOB</th>
                        <th>Phone</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<partial name="_DiscountModal"/>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>

@section Scripts{
    <script>
        const tblStudentDiscount = $("#tblStudentDiscount");
        const tblStudentDiscountDetail = $("#tblStudentDiscountDetail");
        const btnSaveChange = $("#btnSaveChange");
        const btnNew = $("#btnNew");
        const frmDiscount = $("#frmDiscount");
        $(document).ready(function () {
            fetchStudentDiscount();
        });

        function fetchStudentDiscount() {
            tblStudentDiscount.DataTable().clear().destroy();
            tblStudentDiscount.DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                ajax: {
                    url: `/student-discount/gets`,
                    type: "POST",
                },
                columns: [
                    {data: "studentId"},
                    {data: "studentName"},
                    {data: "studentNameInKhmer"},
                    {data: "sex"},
                    {
                         data: null,
                        render: function (data, type, row) {
                             return formatDate(row.date_of_birth);
                        }
                    },
                    {data: "phone"},
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `<a id="btnView" class="btn btn-success btn-sm"><i class="fas fa-add"></i> Add Discount</a>`;
                        }
                    }
                ],
                initComplete: function () {
                    MyApp.utils.dataTableDebounceSearch("#tblStudentDiscount", 500);
                }
            })
        }

        tblStudentDiscount.on("click","#btnView", function (event) {
            const $row = $(this).closest("tr");
            const json = tblStudentDiscount.DataTable().row($row).data();
            btnSaveChange.prop("disabled", true);
            frmDiscount.find("input").prop("disabled", true);
            $("#studentId").val(json.studentId);
            $("#studentName").val(json.studentName);
            $("#studentNameKhmer").val(json.studentNameInKhmer);
            tblStudentDiscountDetail.DataTable().clear().destroy();
            tblStudentDiscountDetail.DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                ajax: {
                    url: `/student-discount/student-id/${json.studentId}`,
                    type: "POST",
                },
                columns: [
                    {data: "studentDiscountId"},
                    {
                        data: "discount",
                        render: function (data, type, row) {
                            return `${data}%`
                        }
                    },
                    {data: "term"},
                    {data: "note"},
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `<a class="btn btn-warning btn-xs" id="btnEdit"><i class="fas fa-edit"></i></a>
                                    <a class="btn btn-danger btn-xs" id="btnDelete"><i class="fas fa-trash"></i></a>`;
                        }
                    }
                ]
            });
            $("#DiscountModal").modal("show");
        }); 
        
        $("#btnClose").on("click", function () {
            frmDiscount[0].reset();
            $("#DiscountModal").modal("hide");
        });
        btnNew.on("click", function (event) {
            btnSaveChange.prop("disabled", false);
            frmDiscount.find("input").prop("disabled", false); 
        });
        
        tblStudentDiscountDetail.on("click", "#btnEdit", function (event) {
            const $row = $(this).closest("tr");
            const json = tblStudentDiscountDetail.DataTable().row($row).data();
            btnSaveChange.prop("disabled", false);
            frmDiscount.find("input").prop("disabled", false);
            $("#studentDiscount_StudentDiscountId").val(json.studentDiscountId);
            $("#studentDiscount_StudentId").val(json.studentId);
            $("#studentDiscount_Term").val(json.term);
            $("#studentDiscount_Discount").val(json.discount);
            $("#studentDiscount_Note").val(json.note);
        });
        tblStudentDiscountDetail.on("click", "#btnDelete", function (event) {
            const $row = $(this).closest("tr");
            const json = tblStudentDiscountDetail.DataTable().row($row).data();
            btnSaveChange.prop("disabled", false);
            frmDiscount.find("input").prop("disabled", false);
        });
    </script>
}
