@model List<BBU_SYSTEM.Models.Student>

@{
    ViewData["Title"] = "Student Discount";
    ViewData["OpenMenu"] = "Administration";
    ViewData["Action"] = "Discount";
    ViewData["HideHeader"] = true;
}

<style>
    #studentDiscountPage #tblStudentDiscount_wrapper {
        width: 100%;
    }

    #tblStudentDiscount_wrapper:not(.discount-has-results) .dataTables_length,
    #tblStudentDiscount_wrapper:not(.discount-has-results) .dt-length,
    #tblStudentDiscount_wrapper:not(.discount-has-pages) .dataTables_paginate,
    #tblStudentDiscount_wrapper:not(.discount-has-pages) .dt-paging {
        display: none;
    }

    #studentDiscountPage .student-discount-table-scroll {
        width: 100%;
        max-width: 100%;
        overflow-x: auto;
    }

    #tblStudentDiscount th,
    #tblStudentDiscount td {
        vertical-align: middle;
        white-space: nowrap;
    }

    #tblStudentDiscountDetail {
        width: 100% !important;
    }

    #tblStudentDiscountDetail th,
    #tblStudentDiscountDetail td {
        vertical-align: middle;
    }

    #tblStudentDiscountDetail tbody tr.highlight > td {
        background-color: #e8f0fe;
    }
</style>

<div id="studentDiscountPage" class="container-fluid px-0 pt-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div class="mr-3">
            <h3 class="m-0 font-weight-bold text-dark">Student Discount</h3>
            <small class="text-muted">Manage student discounts and term-based discount records</small>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <table id="tblStudentDiscount"
                   class="table table-sm table-hover table-bordered table-striped"
                   style="width: 100%;">
                <thead class="thead-light">
                <tr>
                    <th>Student ID</th>
                    <th>Name English</th>
                    <th>Name Khmer</th>
                    <th>Gender</th>
                    <th>DOB</th>
                    <th>Phone</th>
                    <th class="text-center" style="width: 150px;">Action</th>
                </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_DiscountModal" />
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>

@section Scripts
{
    <script>
        const tblStudentDiscount = $("#tblStudentDiscount");
        const tblStudentDiscountDetail = $("#tblStudentDiscountDetail");
        let studentDiscountDetailTable = null;
        let studentDiscountListRequest = null;
        let discountEntryCountUnavailable = false;
        const discountStudentSearchPrompt = "Search by Student ID or name to find a student.";
        const discountStudentNoMatches = "No students match your search.";
        let discountStudentEmptyMessage = discountStudentSearchPrompt;
        const btnSaveChange = $("#btnSaveChange");
        const btnNew = $("#btnNew");
        const frmDiscount = $("#frmDiscount");

        $(document).ready(function () {
            fetchStudentDiscount();

            tblStudentDiscountDetail.addClass(
                "table-sm table-hover table-bordered table-striped w-100"
            );
            tblStudentDiscountDetail.find("thead").addClass("thead-light");
        });

        function fetchStudentDiscount() {
            if ($.fn.DataTable.isDataTable("#tblStudentDiscount")) {
                tblStudentDiscount.DataTable().clear().destroy();
            }

            tblStudentDiscount.DataTable({
                processing: true,
                serverSide: true,
                paging: true,
                pageLength: 10,
                lengthChange: true,
                searching: true,
                info: true,
                stateSave: false,
                responsive: false,
                autoWidth: false,
                scrollX: false,
                scrollY: "",
                ajax: loadStudentDiscountRows,
                columns: [
                    { data: "studentId", defaultContent: "" },
                    { data: "studentName", defaultContent: "" },
                    { data: "studentNameInKhmer", defaultContent: "" },
                    { data: "sex", defaultContent: "" },
                    {
                        data: null,
                        defaultContent: "",
                        render: function (data, type, row) {
                            const dob = row.dateOfBirth ?? row.date_of_birth;
                            if (!dob) return "";
                            if (type !== "display" && type !== "filter") return dob;
                            return formatDate(dob);
                        }
                    },
                    { data: "phone", defaultContent: "" },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        className: "text-center text-nowrap",
                        render: function (data, type) {
                            if (type !== "display") return "";

                            return `<button type="button"
                                            class="btn btn-success btn-sm js-discount-open">
                                        <i class="fas fa-plus mr-1"></i>
                                        Add Discount
                                    </button>`;
                        }
                    }
                ],
                language: {
                    processing: "Loading...",
                    searchPlaceholder: "Student ID or name",
                    info: "Showing _START_ to _END_ of _TOTAL_ entries",
                    infoEmpty: "Showing 0 to 0 of _MAX_ entries",
                    infoFiltered: "",
                    thousands: ",",
                    emptyTable: discountStudentSearchPrompt,
                    zeroRecords: discountStudentNoMatches
                },
                infoCallback: function (_settings, _start, _end, _max, _total, text) {
                    return discountEntryCountUnavailable ? "Total entries unavailable" : text;
                },
                initComplete: function () {
                    const table = $(this.api().table().node());
                    if (!table.parent().hasClass("student-discount-table-scroll")) {
                        table.wrap('<div class="student-discount-table-scroll" role="region" aria-label="Student Discount table" tabindex="0"></div>');
                    }
                    debounceStudentDiscountSearch("#tblStudentDiscount");
                },
                drawCallback: function () {
                    const api = this.api();
                    const page = api.page.info();
                    const hasResults = page.recordsDisplay > 0;

                    $(api.table().container())
                        .toggleClass("discount-has-results", hasResults)
                        .toggleClass("discount-has-pages", hasResults && page.pages > 1);

                    if (!hasResults) {
                        $(api.table().body()).find("td.dataTables_empty, td.dt-empty").text(discountStudentEmptyMessage);
                    }
                }
            });
        }

        function loadStudentDiscountRows(request, complete) {
            if (studentDiscountListRequest) {
                const previousRequest = studentDiscountListRequest;
                studentDiscountListRequest = null;
                previousRequest.abort();
            }

            const search = String(request.search?.value ?? "").trim();
            const summaryOnly = !search;
            const emptyResponse = { draw: request.draw, recordsTotal: 0, recordsFiltered: 0, data: [] };
            discountStudentEmptyMessage = summaryOnly ? discountStudentSearchPrompt : discountStudentNoMatches;

            const pending = $.ajax({
                url: "/student-discount/gets",
                type: "POST",
                dataType: "json",
                data: {
                    ...request,
                    // Use the existing paged endpoint for the total without displaying its row.
                    ...(summaryOnly ? { start: 0, length: 1 } : {}),
                    search: { ...request.search, value: search }
                }
            });
            studentDiscountListRequest = pending;

            function showLoadError(reason, message) {
                if (studentDiscountListRequest !== pending) return;

                discountEntryCountUnavailable = true;
                if (!summaryOnly) {
                    discountStudentEmptyMessage = "Unable to load students. Try searching again.";
                }
                console.error("Cannot load student discount data:", reason);
                complete(emptyResponse);
                if (!summaryOnly) {
                    showStudentDiscountError(message || "Cannot load student discount data.");
                }
            }

            return pending.done(function (response) {
                if (studentDiscountListRequest !== pending) return;

                const recordsTotal = Number(response?.recordsTotal ?? NaN);
                const recordsFiltered = Number(response?.recordsFiltered ?? NaN);
                const rows = response?.data ?? (recordsFiltered === 0 ? [] : null);
                if (!Number.isSafeInteger(recordsTotal) || recordsTotal < 0 ||
                    (!summaryOnly && (!Array.isArray(rows) ||
                        !Number.isSafeInteger(recordsFiltered) || recordsFiltered < 0))) {
                    showLoadError("Unexpected list response.");
                    return;
                }

                discountEntryCountUnavailable = false;
                complete(summaryOnly
                    ? { ...emptyResponse, recordsTotal }
                    : { draw: request.draw, recordsTotal, recordsFiltered, data: rows });
            }).fail(function (xhr, status) {
                if (status !== "abort") {
                    showLoadError(xhr.status || status, xhr.responseJSON?.status?.message);
                }
            }).always(function () {
                if (studentDiscountListRequest === pending) {
                    studentDiscountListRequest = null;
                }
            });
        }

        function debounceStudentDiscountSearch(selector) {
            if (typeof MyApp !== "undefined" &&
                typeof MyApp.utils?.dataTableDebounceSearch === "function") {
                MyApp.utils.dataTableDebounceSearch(selector, 500);
            }
        }

        function getStudentDiscountTableRow(table, element) {
            let row = $(element).closest("tr");
            if (row.hasClass("child")) row = row.prev();
            return { element: row, data: table.DataTable().row(row).data() };
        }

        function showStudentDiscountError(message) {
            if (typeof ShowToastError === "function") {
                ShowToastError(message);
            } else {
                alert(message);
            }
        }

        tblStudentDiscount.on("click", ".js-discount-open", function (event) {
            event.preventDefault();
            const row = getStudentDiscountTableRow(tblStudentDiscount, this);
            const json = row.data;
            if (!json) return;

            btnSaveChange.prop("disabled", true);
            frmDiscount.find("input").prop("disabled", true);
            $("#studentId").val(json.studentId);
            $("#studentDiscount_StudentId").val(json.studentId);
            $("#studentName").val(json.studentName);
            $("#studentNameKhmer").val(json.studentNameInKhmer);

            if ($.fn.DataTable.isDataTable("#tblStudentDiscountDetail")) {
                tblStudentDiscountDetail.DataTable().destroy();
                tblStudentDiscountDetail.find("tbody").empty();
            }

            studentDiscountDetailTable = tblStudentDiscountDetail.DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                autoWidth: false,
                ajax: {
                    url: `/student-discount/student-id/${encodeURIComponent(json.studentId)}`,
                    type: "POST"
                },
                columns: [
                    { data: "studentDiscountId", defaultContent: "" },
                    {
                        data: "discount",
                        defaultContent: "",
                        render: function (data, type) {
                            if (type !== "display") return data;
                            return `${data ?? 0}%`;
                        }
                    },
                    { data: "term", defaultContent: "" },
                    { data: "note", defaultContent: "" },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        className: "text-center text-nowrap",
                        render: function (data, type) {
                            if (type !== "display") return "";

                            return `<button type="button"
                                            class="btn btn-warning btn-xs js-discount-edit"
                                            title="Edit discount"
                                            aria-label="Edit discount">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button type="button"
                                            class="btn btn-danger btn-xs js-discount-delete"
                                            title="Delete discount"
                                            aria-label="Delete discount">
                                        <i class="fas fa-trash"></i>
                                    </button>`;
                        }
                    }
                ],
                initComplete: function () {
                    debounceStudentDiscountSearch("#tblStudentDiscountDetail");
                }
            });

            $("#DiscountModal").modal("show");
        });

        $("#btnClose").on("click", function () {
            frmDiscount[0].reset();
            $("#DiscountModal").modal("hide");
        });

        btnNew.on("click", function (event) {
            event.preventDefault();
            btnSaveChange.prop("disabled", false);
            frmDiscount.find("input").prop("disabled", false);
        });

        frmDiscount.on("submit", function (event) {
            event.preventDefault();

            $.ajax({
                url: "/student-discount/save-change",
                type: "POST",
                data: frmDiscount.serialize(),
                success: function (response) {
                    if (String(response?.status?.code) === "200") {
                        ShowToastSuccess("Student discount saved successfully.");
                        if (studentDiscountDetailTable) {
                            studentDiscountDetailTable.ajax.reload();
                        }
                        frmDiscount[0].reset();
                        return;
                    }

                    ShowToastInfo("Failed to save student discount!");
                },
                error: function (xhr) {
                    showStudentDiscountError(
                        xhr.responseJSON?.status?.message || "Something went wrong!"
                    );
                }
            });
        });

        tblStudentDiscountDetail.on("click", ".js-discount-edit", function (event) {
            event.preventDefault();
            const row = getStudentDiscountTableRow(tblStudentDiscountDetail, this);
            const json = row.data;
            if (!json) return;

            tblStudentDiscountDetail.find("tbody tr").removeClass("highlight");
            row.element.addClass("highlight");
            btnSaveChange.prop("disabled", false);
            frmDiscount.find("input").prop("disabled", false);
            $("#studentDiscount_StudentDiscountId").val(json.studentDiscountId);
            $("#studentDiscount_StudentId").val(json.studentId);
            $("#studentDiscount_Term").val(json.term);
            $("#studentDiscount_Discount").val(json.discount);
            $("#studentDiscount_Note").val(json.note);
        });

        tblStudentDiscountDetail.on("click", ".js-discount-delete", function (event) {
            event.preventDefault();
            const row = typeof getStatisticalDiscountTableRow === "function"
                ? getStatisticalDiscountTableRow(tblStudentDiscountDetail, this)
                : getStudentDiscountTableRow(tblStudentDiscountDetail, this);
            const json = row.data;
            if (!json) return;

            tblStudentDiscountDetail.find("tbody tr").removeClass("highlight");
            row.element.addClass("highlight");
            btnSaveChange.prop("disabled", false);
            frmDiscount.find("input").prop("disabled", false);

            ShowBoxConfirm("Are you sure you want to delete this student Discount?", function () {
                $.ajax({
                    url: `/student-discount/delete/${encodeURIComponent(json.studentDiscountId)}`,
                    type: "DELETE",
                    success: function (response) {
                        if (String(response?.status?.code) === "200") {
                            ShowToastSuccess("Student discount deleted successfully.");
                            if (studentDiscountDetailTable) {
                                studentDiscountDetailTable.ajax.reload();
                            }
                            return;
                        }

                        ShowToastInfo("Failed to delete student discount!");
                    },
                    error: function (xhr) {
                        showStudentDiscountError(
                            xhr.responseJSON?.status?.message || "Something went wrong!"
                        );
                    }
                });
            });
        });
    </script>
}
