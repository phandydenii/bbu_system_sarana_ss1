@model List<BBU_SYSTEM.Models.Student>

@{
    ViewData["Title"] = "Student Discount";
    ViewData["OpenMenu"] = "Administration";
    ViewData["Action"] = "Discount";
    ViewData["HideHeader"] = true;
}

<style>
    #studentDiscountPage .student-discount-table-scroll {
        width: 100%;
        overflow-x: auto;
    }

    #tblStudentDiscount,
    #tblStudentDiscount_wrapper,
    #tblStudentDiscountDetail {
        width: 100% !important;
    }

    #tblStudentDiscount th,
    #tblStudentDiscount td,
    #tblStudentDiscountDetail th,
    #tblStudentDiscountDetail td {
        vertical-align: middle;
    }

    #tblStudentDiscountDetail tbody tr.highlight > td {
        background-color: #e8f0fe;
    }

    /* True Floating Popover Styling */
    .filter-wrapper {
        position: relative;
        display: inline-block;
    }

    .filter-popover-card {
        position: absolute;
        top: calc(100% + 5px);
        right: 0;
        z-index: 1050;
        display: none;
        width: 360px;
        background: #fff;
        border: 1px solid rgba(0,0,0,.15);
        border-radius: 0.375rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        padding: 1rem;
    }
    .filter-popover-card.show {
        display: block;
    }
</style>

<div id="studentDiscountPage" class="container-fluid px-0 pt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="m-0 font-weight-bold text-dark">Student Discount</h3>
            <small class="text-muted">Manage student discounts and term-based discount records</small>
        </div>

        <!-- Floating Popover Filter Wrapper -->
        <div class="filter-wrapper">
            <div class="d-flex align-items-center">
                <button type="button" id="btnToggleFilterPopover" class="btn btn-outline-secondary shadow-sm">
                    <i class="fas fa-filter text-primary mr-1"></i>
                    <span id="filterButtonLabel">Filter by Date</span>
                </button>
                <button type="button" id="btnClearActiveFilter" class="btn btn-outline-danger btn-sm ml-1" style="display: none;" title="Clear filter">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Floating Popover Panel -->
            <div id="studentDiscountFilterPopover" class="filter-popover-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="font-weight-bold text-secondary text-sm">Filter by Date Range</span>
                    <button type="button" class="close text-dark" id="btnCloseFilterPopover" aria-label="Close" style="outline: none;">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <!-- Quick Preset Buttons -->
                <div class="mb-3">
                    <div class="small text-muted mb-1">Quick Presets:</div>
                    <div class="btn-group btn-group-sm w-100" role="group">
                        <button type="button" class="btn btn-outline-secondary js-preset-filter" data-preset="today">Today</button>
                        <button type="button" class="btn btn-outline-secondary js-preset-filter" data-preset="last7">Last 7 Days</button>
                        <button type="button" class="btn btn-outline-secondary js-preset-filter" data-preset="thisMonth">This Month</button>
                    </div>
                </div>

                <form id="frmStudentDiscountFilters">
                    <div class="form-row">
                        <div class="col-6 mb-2">
                            <label for="discountFromDate" class="small text-muted font-weight-bold mb-1">From Date</label>
                            <input type="date"
                                   id="discountFromDate"
                                   name="fromDate"
                                   class="form-control form-control-sm" />
                        </div>
                        <div class="col-6 mb-2">
                            <label for="discountToDate" class="small text-muted font-weight-bold mb-1">To Date</label>
                            <input type="date"
                                   id="discountToDate"
                                   name="toDate"
                                   class="form-control form-control-sm" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                        <button type="button"
                                id="btnResetStudentDiscountFilters"
                                class="btn btn-link btn-sm text-danger p-0 text-decoration-none"
                                title="Reset filters">
                            <i class="fas fa-redo-alt mr-1"></i> Reset
                        </button>
                        <div>
                            <button type="button" id="btnCancelFilter" class="btn btn-secondary btn-sm mr-1">Cancel</button>
                            <button type="submit" class="btn btn-success btn-sm">Apply Filter</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body student-discount-table-scroll">
            <table id="tblStudentDiscount"
                   class="table table-sm table-hover table-bordered table-striped w-100"
                   style="width: 100%;">
                <thead class="thead-light">
                <tr>
                    <th>Student ID</th>
                    <th>Name English</th>
                    <th>Name Khmer</th>
                    <th>Gender</th>
                    <th>DOB</th>
                    <th>Phone</th>
                    <th class="text-center" style="width: 150px;">Action</th>
                </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_DiscountModal" />
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>

@section Scripts
{
    <script>
        const tblStudentDiscount = $("#tblStudentDiscount");
        const tblStudentDiscountDetail = $("#tblStudentDiscountDetail");
        let studentDiscountDetailTable = null;
        const btnSaveChange = $("#btnSaveChange");
        const btnNew = $("#btnNew");
        const frmDiscount = $("#frmDiscount");

        $(document).ready(function () {
            fetchStudentDiscount();

            tblStudentDiscountDetail.addClass(
                "table-sm table-hover table-bordered table-striped w-100"
            );
            tblStudentDiscountDetail.find("thead").addClass("thead-light");

            // Toggle Popover open/close
            $("#btnToggleFilterPopover").on("click", function (e) {
                e.stopPropagation();
                $("#studentDiscountFilterPopover").toggleClass("show");
            });

            $("#btnCloseFilterPopover, #btnCancelFilter").on("click", function () {
                $("#studentDiscountFilterPopover").removeClass("show");
            });

            // Close popover when clicking outside
            $(document).on("click", function (e) {
                if (!$(e.target).closest(".filter-wrapper").length) {
                    $("#studentDiscountFilterPopover").removeClass("show");
                }
            });

            // Quick Preset Selection Logic
            $(".js-preset-filter").on("click", function () {
                const preset = $(this).data("preset");
                const today = new Date();
                let from = "", to = "";

                const formatDateString = (d) => d.toISOString().split('T')[0];

                if (preset === "today") {
                    from = to = formatDateString(today);
                } else if (preset === "last7") {
                    let past = new Date();
                    past.setDate(today.getDate() - 7);
                    from = formatDateString(past);
                    to = formatDateString(today);
                } else if (preset === "thisMonth") {
                    let firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
                    let lastDay = new Date(today.getFullYear(), today.getMonth() + 1, 0);
                    from = formatDateString(firstDay);
                    to = formatDateString(lastDay);
                }

                $("#discountFromDate").val(from);
                $("#discountToDate").val(to);
            });

            $("#frmStudentDiscountFilters")
                .off("submit.studentDiscountFilters")
                .on("submit.studentDiscountFilters", function (event) {
                    event.preventDefault();
                    applyStudentDiscountDateFilter();
                });

            $("#btnResetStudentDiscountFilters")
                .off("click.studentDiscountFilters")
                .on("click.studentDiscountFilters", function () {
                    $("#discountFromDate, #discountToDate").val("");
                    $("#filterButtonLabel").text("Filter by Date");
                    $("#btnToggleFilterPopover").removeClass("btn-primary text-white").addClass("btn-outline-secondary");
                    $("#btnClearActiveFilter").hide();
                    $("#studentDiscountFilterPopover").removeClass("show");

                    if ($.fn.DataTable.isDataTable("#tblStudentDiscount")) {
                        tblStudentDiscount.DataTable().ajax.reload(null, true);
                    }
                });

            $("#btnClearActiveFilter").on("click", function () {
                $("#discountFromDate, #discountToDate").val("");
                $("#filterButtonLabel").text("Filter by Date");
                $("#btnToggleFilterPopover").removeClass("btn-primary text-white").addClass("btn-outline-secondary");
                $("#btnClearActiveFilter").hide();
                $("#studentDiscountFilterPopover").removeClass("show");

                if ($.fn.DataTable.isDataTable("#tblStudentDiscount")) {
                    tblStudentDiscount.DataTable().ajax.reload(null, true);
                }
            });
        });

        function applyStudentDiscountDateFilter() {
            const fromDate = $("#discountFromDate").val();
            const toDate = $("#discountToDate").val();

            if (fromDate && toDate && fromDate > toDate) {
                showStudentDiscountError("From Date must not be later than To Date.");
                return;
            }

            if (fromDate || toDate) {
                $("#filterButtonLabel").text(`Filter: ${fromDate || '...'} to ${toDate || '...'}`);
                $("#btnToggleFilterPopover").removeClass("btn-outline-secondary").addClass("btn-primary text-white");
                $("#btnClearActiveFilter").show();
            }

            $("#studentDiscountFilterPopover").removeClass("show");

            if ($.fn.DataTable.isDataTable("#tblStudentDiscount")) {
                tblStudentDiscount.DataTable().ajax.reload(null, true);
            }
        }

        function fetchStudentDiscount() {
            if ($.fn.DataTable.isDataTable("#tblStudentDiscount")) {
                tblStudentDiscount.DataTable().clear().destroy();
            }

            tblStudentDiscount.DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                autoWidth: false,
                pageLength: 10,
                searching: true,
                ajax: {
                    url: "/student-discount/gets",
                    type: "POST",
                    data: function (request) {
                        request.fromDate = $("#discountFromDate").val() || "";
                        request.toDate = $("#discountToDate").val() || "";
                    },
                    error: function (xhr) {
                        showStudentDiscountError(
                            xhr.responseJSON?.status?.message ||
                            "Cannot load student discount data."
                        );
                    }
                },
                columns: [
                    { data: "studentId", defaultContent: "" },
                    { data: "studentName", defaultContent: "" },
                    { data: "studentNameInKhmer", defaultContent: "" },
                    { data: "sex", defaultContent: "" },
                    {
                        data: null,
                        defaultContent: "",
                        render: function (data, type, row) {
                            const dob = row.dateOfBirth ?? row.date_of_birth;
                            if (!dob) return "";
                            if (type !== "display" && type !== "filter") return dob;
                            return formatDate(dob);
                        }
                    },
                    { data: "phone", defaultContent: "" },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        className: "text-center text-nowrap",
                        render: function (data, type) {
                            if (type !== "display") return "";

                            return `<button type="button"
                                            class="btn btn-success btn-sm js-discount-open">
                                        <i class="fas fa-plus mr-1"></i>
                                        Add Discount
                                    </button>`;
                        }
                    }
                ],
                initComplete: function () {
                    debounceStudentDiscountSearch("#tblStudentDiscount");
                }
            });
        }

        function debounceStudentDiscountSearch(selector) {
            if (typeof MyApp !== "undefined" &&
                typeof MyApp.utils?.dataTableDebounceSearch === "function") {
                MyApp.utils.dataTableDebounceSearch(selector, 500);
            }
        }

        function getStudentDiscountTableRow(table, element) {
            let row = $(element).closest("tr");
            if (row.hasClass("child")) row = row.prev();
            return { element: row, data: table.DataTable().row(row).data() };
        }

        function showStudentDiscountError(message) {
            if (typeof ShowToastError === "function") {
                ShowToastError(message);
            } else {
                alert(message);
            }
        }

        tblStudentDiscount.on("click", ".js-discount-open", function (event) {
            event.preventDefault();
            const row = getStudentDiscountTableRow(tblStudentDiscount, this);
            const json = row.data;
            if (!json) return;

            btnSaveChange.prop("disabled", true);
            frmDiscount.find("input").prop("disabled", true);
            $("#studentId").val(json.studentId);
            $("#studentDiscount_StudentId").val(json.studentId);
            $("#studentName").val(json.studentName);
            $("#studentNameKhmer").val(json.studentNameInKhmer);

            if ($.fn.DataTable.isDataTable("#tblStudentDiscountDetail")) {
                tblStudentDiscountDetail.DataTable().destroy();
                tblStudentDiscountDetail.find("tbody").empty();
            }

            studentDiscountDetailTable = tblStudentDiscountDetail.DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                autoWidth: false,
                ajax: {
                    url: `/student-discount/student-id/${encodeURIComponent(json.studentId)}`,
                    type: "POST"
                },
                columns: [
                    { data: "studentDiscountId", defaultContent: "" },
                    {
                        data: "discount",
                        defaultContent: "",
                        render: function (data, type) {
                            if (type !== "display") return data;
                            return `${data ?? 0}%`;
                        }
                    },
                    { data: "term", defaultContent: "" },
                    { data: "note", defaultContent: "" },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        className: "text-center text-nowrap",
                        render: function (data, type) {
                            if (type !== "display") return "";

                            return `<button type="button"
                                            class="btn btn-warning btn-xs js-discount-edit"
                                            title="Edit discount"
                                            aria-label="Edit discount">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button type="button"
                                            class="btn btn-danger btn-xs js-discount-delete"
                                            title="Delete discount"
                                            aria-label="Delete discount">
                                        <i class="fas fa-trash"></i>
                                    </button>`;
                        }
                    }
                ],
                initComplete: function () {
                    debounceStudentDiscountSearch("#tblStudentDiscountDetail");
                }
            });

            $("#DiscountModal").modal("show");
        });

        $("#btnClose").on("click", function () {
            frmDiscount[0].reset();
            $("#DiscountModal").modal("hide");
        });

        btnNew.on("click", function (event) {
            event.preventDefault();
            btnSaveChange.prop("disabled", false);
            frmDiscount.find("input").prop("disabled", false);
        });

        frmDiscount.on("submit", function (event) {
            event.preventDefault();

            $.ajax({
                url: "/student-discount/save-change",
                type: "POST",
                data: frmDiscount.serialize(),
                success: function (response) {
                    if (String(response?.status?.code) === "200") {
                        ShowToastSuccess("Student discount saved successfully.");
                        if (studentDiscountDetailTable) {
                            studentDiscountDetailTable.ajax.reload();
                        }
                        frmDiscount[0].reset();
                        return;
                    }

                    ShowToastInfo("Failed to save student discount!");
                },
                error: function (xhr) {
                    showStudentDiscountError(
                        xhr.responseJSON?.status?.message || "Something went wrong!"
                    );
                }
            });
        });

        tblStudentDiscountDetail.on("click", ".js-discount-edit", function (event) {
            event.preventDefault();
            const row = getStudentDiscountTableRow(tblStudentDiscountDetail, this);
            const json = row.data;
            if (!json) return;

            tblStudentDiscountDetail.find("tbody tr").removeClass("highlight");
            row.element.addClass("highlight");
            btnSaveChange.prop("disabled", false);
            frmDiscount.find("input").prop("disabled", false);
            $("#studentDiscount_StudentDiscountId").val(json.studentDiscountId);
            $("#studentDiscount_StudentId").val(json.studentId);
            $("#studentDiscount_Term").val(json.term);
            $("#studentDiscount_Discount").val(json.discount);
            $("#studentDiscount_Note").val(json.note);
        });

        tblStudentDiscountDetail.on("click", ".js-discount-delete", function (event) {
            event.preventDefault();
            const row = getStatisticalDiscountTableRow ? getStatisticalDiscountTableRow(tblStudentDiscountDetail, this) : getStudentDiscountTableRow(tblStudentDiscountDetail, this);
            const json = row.data;
            if (!json) return;

            tblStudentDiscountDetail.find("tbody tr").removeClass("highlight");
            row.element.addClass("highlight");
            btnSaveChange.prop("disabled", false);
            frmDiscount.find("input").prop("disabled", false);

            ShowBoxConfirm("Are you sure you want to delete this student Discount?", function () {
                $.ajax({
                    url: `/student-discount/delete/${encodeURIComponent(json.studentDiscountId)}`,
                    type: "DELETE",
                    success: function (response) {
                        if (String(response?.status?.code) === "200") {
                            ShowToastSuccess("Student discount deleted successfully.");
                            if (studentDiscountDetailTable) {
                                studentDiscountDetailTable.ajax.reload();
                            }
                            return;
                        }

                        ShowToastInfo("Failed to delete student discount!");
                    },
                    error: function (xhr) {
                        showStudentDiscountError(
                            xhr.responseJSON?.status?.message || "Something went wrong!"
                        );
                    }
                });
            });
        });
    </script>
}