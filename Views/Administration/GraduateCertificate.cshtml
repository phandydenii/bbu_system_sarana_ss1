@{
    ViewData["OpenMenu"] = "Administration";
    ViewData["Action"] = "GraduateLetter";
}
<div class="row">
    <div class="col-12">
        <div class="card">
            @* <div class="card-header">
                <div class="margin">
                    <button class="btn btn-primary" id="btnAddNewGraduateCertificate">Add New</button>
                </div>
            </div> *@
            <div class="card-body">
                <table id="tblStudent" class="table table-sm table-bordered table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>Student Id</th>
                        <th>Name English</th>
                        <th>Name Khmer</th>
                        <th>Gender</th>
                        <th>DOB</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<partial name="_GraduateLetter"/>
<script src="/AdminLTE/plugins/jquery/jquery.min.js"></script>

@section Scripts
{
    <script>
        let certificateData = {};
        let bookingData = {};
        
        const tblStudent = $('#tblStudent');
        const modalGraduateLetter = $('#modalGraduateLetter');
        const btnSave = $("#btnSave");
        const formCertificateInfo = $("#formCertificateInfo");
        const formBookingInfo = $("#formBookingInfo");
        
        $(document).ready(function () {
            fetchStudent();
            // btnSave.prop("disabled", true);
            
            $('#formCertificateInfo :input').each(function () {
                certificateData[this.name] = $(this).val();
            });
            
            $('#formBookingInfo :input').each(function () {
                bookingData[this.name] = $(this).val();
            });
        });

        function isFormCertificateChanged() {
            let changed = false;
            $('#formCertificateInfo :input').each(function () {
                if (certificateData[this.name] !== $(this).val()) {
                    changed = true;
                    return false; // stop loop
                }
            });
            return changed;
        }

        function isFormBookingChanged() {
            let changed = false;
            $('#formBookingInfo :input').each(function () {
                if (bookingData[this.name] !== $(this).val()) {
                    changed = true;
                    return false; // stop loop
                }
            });
            return changed;
        }

        function fetchStudent() {
            tblStudent.DataTable().clear().destroy();
            tblStudent.DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                ajax: {
                    url: "/student/academic/student-list", // Endpoint to fetch paginated data
                    type: "POST",
                    error: function (xhr, status, error) {
                        console.log(xhr.responseText);
                    }
                },
                columns: [
                    {data: "studentId"},
                    {data: "studentName"},
                    {data: "studentNameInKhmer"},
                    {data: "sex"},
                    {
                        data: null,
                        render: function (data, type, row) {
                            const dt = formatDate(row.dateOfBirth, "DD/MM/YYYY");
                            return `${dt}`
                        }
                    },
                    {data: "phone"},
                    {
                        data: null,
                        render: function (data, type, row) {
                            if (row.status === "REGISTER") {
                                return ` <span class="badge badge-warning">${row.status}</span>`;
                            } else if (row.status === "ACTIVE") {
                                return ` <span class="badge badge-primary">${row.status}</span>`;
                            } else if (row.status === "QUIT") {
                                return ` <span class="badge badge-danger">${row.status}</span>`;
                            }
                            return ` <span class="badge badge-secondary">${row.status}</span>`;
                        }
                    },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `
                            <button class="btn btn-primary btn-sm" id="btnManageLetter"><i class='fas fa-gear'></i> Manage Letter</button>
                        `;
                        }
                    }
                ]
            });
        }
        
        tblStudent.on("click","#btnManageLetter", function (e) {
            showLoading();
            e.preventDefault();
            const $row = $(this).closest("tr");
            const data = tblStudent.DataTable().row($row).data(); 
            getStudent(data.studentId);
            modalGraduateLetter.modal("show");
            hideLoading();
        });


        function getStudent(student_id) {
            $.ajax({
                url: "/student/academic/student-id/" + student_id,
                type: "GET",
                data: {student_id: student_id},
                success: function (data) { 
                    if (data) {
                        const student = data.student; 
                        // console.log(student);
                        const degree = data["degree"];
                        const school = data["school"];
                        const field = data["field"];
                        const promotion = data["promotion"];
                        const stage = data["stage"];
                        const term = data["term"];
                        const group = data["group"];
                        const groupRoom = data["groupRoom"];
                        const registry = data["registry"];
                        $("#student_StudentId").val(student.studentId);
                        $("#student_StudentName").val(student.studentName);
                        $("#student_StudentNameInKhmer").val(student.studentNameInKhmer);
                        $("#student_Sex").val(student.sex);
                        $("#student_Phone").val(student.phone);
                        $("#student_AcceptDate").val(formatDate(student.acceptDate, "YYYY-MM-DD"));
                        $("#student_CertificateNo").val(student.certificateNo);
                        
                        $("#chbCertificateOut").prop('checked',student.certificateOut).trigger('change');
                        
                        $("#student_GraduateLetterNo").val(student.graduateLetterNo);
                        $("#chbWithdraw").prop('checked',student.isAcceptCertificate);
                        $("#student_NoteTicket").val(student.noteTicket);
                        $("#student_DateOfBirth").val(formatDate(student.dateOfBirth));
                        $("#student_ApprovedDate").val(formatDate(student.approvedDate, "YYYY-MM-DD"));
                        
                        $("#txtDegree").val(degree.degreeName);
                        $("#txtSchool").val(school.schoolName);
                        $("#txtField").val(field.fieldName);
                        $("#txtPromotion").val(promotion.promotionNo); 
                        $("#txtStage").val(stage.stageNo); 
                        $("#txtTerm").val(term.termNo); 
                        $("#txtGroup").val(group.groupName);
 
                        
                    } else {
                        alert("Student not found.");
                    }
                },
                error: function (e) {
                    console.log(e.responseText);
                }
            });
        }
    
        btnSave.on("click", function (e) {
            e.preventDefault();
            if (isFormCertificateChanged()) {  
                const formData = formCertificateInfo.serialize();
                $.ajax({
                    url: `/student/academic/update-accept-certificate/${$("#student_StudentId").val()}`,
                    method: 'PATCH',
                    data: formData,
                    success: function (response) {
                        if (response.status.code === "200") {
                            ShowToastSuccess(response.status.message);
                        }else {
                            ShowToastError(response.status.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        ShowToastError(xhr.responseText);
                    }
                });
            }
        });
    </script>
}
