@using BBU_SYSTEM.DTOs
@model BBU_SYSTEM.ViewModel.LetterViewModel
@{
    var student = new StudentDto();
}
<div class="modal fade" id="modalGraduateLetter" tabindex="-1" role="dialog" aria-labelledby="modalGraduateLetterTitle"
     aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg">
            <!-- Modal Header -->
            <div class="modal-header bg-primary text-white py-2">
                <div class="d-flex align-items-center justify-content-between w-100 mr-2">
                    <h5 class="modal-title font-weight-bold m-0" id="modalGraduateLetterTitle" style="font-size: 1.1rem;">
                        <i class="fas fa-user-graduate mr-2"></i> Graduate Letter
                    </h5>
                    <span class="badge badge-warning px-3 py-1 font-weight-bold" id="lblNote">Owe Certificate</span>
                </div>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <!-- Modal Body -->
            <div class="modal-body bg-light p-3">
                <div class="row">
                    
                    <!-- Left Column: Personal Information -->
                    <div class="col-lg-6 mb-3">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-header bg-white py-2">
                                <h6 class="card-title font-weight-bold text-dark m-0">
                                    <i class="fas fa-id-card text-primary mr-1"></i> Personal Information
                                </h6>
                            </div>
                            <div class="card-body py-2">
                                <div class="row">
                                    <div class="col-md-4 form-group mb-2">
                                        <label class="form-label text-muted small font-weight-bold mb-1">ID</label>
                                        <input type="text" class="form-control bg-light" asp-for="@student.StudentId" readonly />
                                    </div>
                                    <div class="col-md-8 form-group mb-2">
                                        <label class="form-label text-muted small font-weight-bold mb-1">Name</label>
                                        <input type="text" class="form-control form-control-sm bg-light" asp-for="@student.StudentName" readonly />
                                    </div>
                                </div>

                                <div class="form-group mb-2">
                                    <label class="form-label text-muted small font-weight-bold mb-1">Name (in Khmer)</label>
                                    <input type="text" class="form-control form-control-sm bg-light" asp-for="@student.StudentNameInKhmer" readonly />
                                </div>

                                <div class="row">
                                    <div class="col-md-6 form-group mb-2">
                                        <label class="form-label text-muted small font-weight-bold mb-1">Sex</label>
                                        <input type="text" class="form-control form-control-sm bg-light" asp-for="@student.Sex" readonly />
                                    </div>
                                    <div class="col-md-6 form-group mb-2">
                                        <label class="form-label text-muted small font-weight-bold mb-1">Date of Birth</label>
                                        <input type="text" class="form-control form-control-sm bg-light" asp-for="@student.DateOfBirth" readonly />
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 form-group mb-2">
                                        <label class="form-label text-muted small font-weight-bold mb-1">Approved Date</label>
                                        <input type="date" class="form-control form-control-sm" asp-for="@student.ApprovedDate" />
                                    </div>
                                    <div class="col-md-6 form-group mb-2">
                                        <label class="form-label text-muted small font-weight-bold mb-1">Letter Identity</label>
                                        <input type="text" class="form-control form-control-sm" asp-for="@student.GraduateLetterNo" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Right Column: Academic Information -->
                    <div class="col-lg-6 mb-3">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-header bg-white py-2">
                                <h6 class="card-title font-weight-bold text-dark m-0">
                                    <i class="fas fa-graduation-cap text-primary mr-1"></i> Academic Information
                                </h6>
                            </div>
                            <div class="card-body py-2">
                                <div class="form-group row mb-2">
                                    <label class="col-sm-3 col-form-label col-form-label-sm text-muted font-weight-bold">Degree</label>
                                    <div class="col-sm-9">
                                        <input type="text" class="form-control form-control-sm bg-light" id="txtDegree" readonly />
                                    </div>
                                </div>

                                <div class="form-group row mb-2">
                                    <label class="col-sm-3 col-form-label col-form-label-sm text-muted font-weight-bold">School</label>
                                    <div class="col-sm-9">
                                        <input type="text" class="form-control form-control-sm bg-light" id="txtSchool" readonly />
                                    </div>
                                </div>

                                <div class="form-group row mb-2">
                                    <label class="col-sm-3 col-form-label col-form-label-sm text-muted font-weight-bold">Field</label>
                                    <div class="col-sm-9">
                                        <input type="text" class="form-control form-control-sm bg-light" id="txtField" readonly />
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4 form-group mb-2">
                                        <label class="form-label text-muted small font-weight-bold mb-1">Promotion</label>
                                        <input type="text" class="form-control form-control-sm bg-light" id="txtPromotion" readonly />
                                    </div>
                                    <div class="col-md-4 form-group mb-2">
                                        <label class="form-label text-muted small font-weight-bold mb-1">Stage</label>
                                        <input type="text" class="form-control form-control-sm bg-light" id="txtStage" readonly />
                                    </div>
                                    <div class="col-md-4 form-group mb-2">
                                        <label class="form-label text-muted small font-weight-bold mb-1">Term</label>
                                        <input type="text" class="form-control form-control-sm bg-light" id="txtTerm" readonly />
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 form-group mb-2">
                                        <label class="form-label text-muted small font-weight-bold mb-1">Group</label>
                                        <input type="text" class="form-control form-control-sm bg-light" id="txtGroup" readonly />
                                    </div>
                                    <div class="col-md-6 form-group mb-2">
                                        <label class="form-label text-muted small font-weight-bold mb-1">Study Time</label>
                                        <input type="text" class="form-control form-control-sm bg-light" id="txtStudyTime" value="SAT & SUN" readonly />
                                    </div>
                                </div>

                                <div class="form-group row mb-0">
                                    <label class="col-sm-3 col-form-label col-form-label-sm text-muted font-weight-bold">Room</label>
                                    <div class="col-sm-9">
                                        <input type="text" class="form-control form-control-sm bg-light" id="txtRoom" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div> 
                    
                    <!-- Forms -->
                    <form id="formCertificateInfo" class="w-100">
                        <div class="row">
                            <!-- Certificate Information -->
                            <div class="col-lg-6 mb-2">
                                <div class="card h-100 shadow-sm border-0">
                                    <div class="card-header bg-white py-2">
                                        <h6 class="card-title font-weight-bold text-dark m-0">
                                            <i class="fas fa-certificate text-success mr-1"></i>
                                            Certificate Information
                                        </h6>
                                    </div>
                                    <div class="card-body py-2">
                                        <div class="custom-control custom-checkbox mb-2">
                                            <input type="checkbox"
                                                   class="custom-control-input"
                                                   asp-for="@student.IsAcceptCertificate" />
                                            <label class="custom-control-label font-weight-normal text-dark"
                                                   for="student_IsAcceptCertificate">
                                                បានដកយកសញ្ញាបត្ររាល់
                                            </label>
                                        </div>
                                        <div class="form-group row mb-2">
                                            <label class="col-sm-4 col-form-label col-form-label-sm text-muted font-weight-bold">
                                                លេខទូរស័ព្ទ
                                            </label>
                                            <div class="col-sm-8">
                                                <input type="text"
                                                       class="form-control form-control-sm"
                                                       asp-for="@student.Phone" />
                                            </div>
                                        </div>
                                        <div class="form-group row mb-2">
                                            <label class="col-sm-4 col-form-label col-form-label-sm text-muted font-weight-bold">
                                                ថ្ងៃដកសញ្ញាបត្រ
                                            </label>
                                            <div class="col-sm-8">
                                                <input type="date"
                                                       class="form-control form-control-sm"
                                                       asp-for="@student.AcceptDate" />
                                            </div>
                                        </div>
                                        <div class="form-group row mb-2">
                                            <label class="col-sm-4 col-form-label col-form-label-sm text-muted font-weight-bold">
                                                លេខខ្នងសំបុត្រ
                                            </label>
                                            <div class="col-sm-8">
                                                <div class="input-group input-group-sm">
                                                    <input type="text"
                                                           class="form-control"
                                                           asp-for="@student.CertificateNo" />
                                                    <div class="input-group-append">
                                                        <button type="button"
                                                                class="btn btn-outline-secondary"
                                                                id="btnAddCertificateNo">
                                                            Add
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-group row mb-0">
                                            <label class="col-sm-4 col-form-label col-form-label-sm text-muted font-weight-bold">
                                                សម្គាល់
                                            </label>
                                            <div class="col-sm-8">
                                                <input type="text"
                                                       class="form-control form-control-sm"
                                                       asp-for="@student.NoteTicket" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Note -->
                            <div class="col-lg-6 mb-2">
                                <div class="card h-100 shadow-sm border-0">
                                    <div class="card-header bg-white py-2">
                                        <h6 class="card-title font-weight-bold text-dark m-0">
                                            <i class="fas fa-paper-plane text-warning mr-1"></i>
                                            Note (For Certificate Out)
                                        </h6>
                                    </div>
                                    <div class="card-body py-2">
                                        <div class="custom-control custom-checkbox mb-2">
                                            <input type="checkbox"
                                                   class="custom-control-input"
                                                   asp-for="@student.CertificateOut" />
                                            <label class="custom-control-label font-weight-normal text-dark"
                                                   for="student_CertificateOut">
                                                សញ្ញាបត្រត្រូវបានបញ្ជូនទៅក្រសួងរាល់
                                            </label>
                                        </div>
                                        <div class="form-group mb-0">
                                            <label class="form-label text-muted small font-weight-bold mb-1"
                                                   for="student_MinistryNote">
                                                ខ្វះ
                                            </label>
                                            <input type="text"
                                                   id="student_MinistryNote"
                                                   class="form-control form-control-sm"
                                                   placeholder="..." />
                                        </div>
            
                                    </div>
                                </div>
                            </div>
            
                        </div>
                    </form>
                </div>
            </div>

            <!-- Modal Footer Buttons -->
            <div class="modal-footer bg-white border-top-0 py-2 d-flex justify-content-end">
                <div>
                    <button type="button" class="btn btn-secondary shadow-sm px-3" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i> Close
                    </button>
                    <button type="submit" class="btn btn-primary shadow-sm px-4" id="btnSave">
                        <i class="fas fa-save mr-1"></i> Save
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>