@using BBU_SYSTEM.DTOs
@{
    var group = new GroupDto();
    var grouproom = new GroupRoomDto();
    var req = new
    {
        group,
        grouproom
    };
}
<style>
    .transfer-modal-dialog.modal-fullscreen-custom {
        max-width: 98vw;
        width: 98vw;
        height: 96vh;
        margin: 1vh auto;
    } 
    .transfer-modal-dialog.modal-fullscreen-custom .modal-content {
        height: 96vh;
     } 
    .transfer-modal-dialog.modal-fullscreen-custom .modal-body {
        overflow-y: auto;
     }
</style>
<div class="modal fade" id="TransferModal" data-backdrop="static">
    <div class="modal-dialog modal-xl transfer-modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Transfer</h4>
                <div class="ml-auto">
                    <button type="button" id="btnToggleTransferFullScreen" class="btn btn-sm btn-outline-secondary mr-1">
                        <i class="fa-solid fa-expand"></i>
                    </button> 
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div> 
            </div>
            <div class="modal-body"> 
                <div class="row">
                    <div class="col-6">
                        <div class="card">
                            <div class="card-header">
                                <label>Student Transfer</label>
                                <label class="card-title float-right">Count: <span id="countStudent">0</span></label>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive" style="height: 500px; overflow-x: auto;">
                                    <table id="tblTransferStudent"
                                           class="table table-sm table-bordered table-striped table-head-fixed"
                                           style="width: 100%;">
                                        <thead>
                                        <tr>
                                            <th class="text-center" style="width:40px;">
                                                <input type="checkbox" class="chkTransferStudentAll">
                                            </th>
                                            <th style="width: 90px;">Id</th>
                                            <th>Name</th>
                                            <th style="width: 80px;">Gender</th>
                                            <th style="width: 120px;">Date of Birth</th>
                                        </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <label>Transfer to Group</label>
                        <table id="tblTransferGroup" class="table table-sm table-bordered table-hover dataTable dtr-inline"
                               style="width: 100%;">
                            <thead>
                            <tr>
                                <th>Id</th>
                                <th>Group</th>
                                <th>Field Id</th>
                                <th>Field</th>
                                <th>Stage Id</th>
                                <th>Stage</th>
                            </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnTransfer" class="btn btn-success float-right">
                    <i class="fas fa-exchange"></i> 
                    Transfer
                </button>
                <button class="btn btn-danger float-right"><i class="fa-solid fa-xmark"></i> Close</button>
            </div>
        </div>
    </div>
</div>

