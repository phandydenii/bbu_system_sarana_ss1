@using BBU_SYSTEM.DTOs
@{
    var group = new GroupDto();
    var grouproom = new GroupRoomDto();
    var req = new
    {
        group,
        grouproom
    };
}
<style>
    #TransferModal .transfer-modal-dialog {
        transition: all 0.2s ease-in-out;
    }

    #TransferModal .transfer-modal-dialog.modal-fullscreen-custom {
        max-width: 100vw !important;
        width: 100vw !important;
        height: 100vh !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    #TransferModal .transfer-modal-dialog.modal-fullscreen-custom .modal-content {
        height: 100vh !important;
        border-radius: 0 !important;
        border: 0;
    }

    #TransferModal .transfer-modal-dialog.modal-fullscreen-custom .modal-body {
        height: calc(100vh - 120px);
        overflow-y: auto;
        overflow-x: hidden;
        padding: 1rem;
    }

    #TransferModal .transfer-modal-dialog.modal-fullscreen-custom .modal-header,
    #TransferModal .transfer-modal-dialog.modal-fullscreen-custom .modal-footer {
        flex-shrink: 0;
    }

    #TransferModal .transfer-modal-dialog.modal-fullscreen-custom .table-responsive {
        height: calc(100vh - 250px) !important;
        overflow-y: auto;
        overflow-x: auto;
    }

    #TransferModal .transfer-modal-dialog.modal-fullscreen-custom #tblTransferGroup_wrapper {
        max-height: calc(100vh - 210px);
        overflow-y: auto;
    }
</style>
<div class="modal fade" id="TransferModal" data-backdrop="static">
    <div class="modal-dialog modal-xl transfer-modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Transfer</h4>
                <div class="ml-auto">
                    <button type="button" id="btnToggleTransferFullScreen" class="btn btn-sm btn-outline-secondary mr-1">
                        <i class="fa-solid fa-expand"></i>
                    </button> 
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div> 
            </div>
            <div class="modal-body"> 
                <div class="row">
                    <div class="col-6">
                        <div class="card">
                            <div class="card-header">
                                <label>Student Transfer</label>
                                <label class="card-title float-right">Count: <span id="countStudent">0</span></label>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive" style="height: 500px; overflow-x: auto;">
                                    <table id="tblTransferStudent"
                                           class="table table-sm table-bordered table-striped table-head-fixed"
                                           style="width: 100%;">
                                        <thead>
                                        <tr>
                                            <th class="text-center" style="width:40px;">
                                                <input type="checkbox" class="chkTransferStudentAll">
                                            </th>
                                            <th style="width: 90px;">Id</th>
                                            <th>Name</th>
                                            <th style="width: 80px;">Gender</th>
                                            <th style="width: 120px;">Date of Birth</th>
                                        </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <label>Transfer to Group</label>
                        <table id="tblTransferGroup" class="table table-sm table-bordered table-hover dataTable dtr-inline"
                               style="width: 100%;">
                            <thead>
                            <tr>
                                <th>Id</th>
                                <th>Group</th>
                                <th>Field Id</th>
                                <th>Field</th>
                                <th>Stage Id</th>
                                <th>Stage</th>
                            </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnTransfer" class="btn btn-success float-right">
                    <i class="fas fa-exchange"></i> 
                    Transfer
                </button>
                <button type="button" class="btn btn-danger float-right" data-dismiss="modal">
                    <i class="fa-solid fa-xmark"></i> Close
                </button>
            </div>
        </div>
    </div>
</div>
<script>
    window.SetTransferFullScreen = function (isFullScreen = true) {
        const dialog = $("#TransferModal .transfer-modal-dialog");
        const icon = $("#btnToggleTransferFullScreen").find("i");

        dialog.toggleClass("modal-fullscreen-custom", isFullScreen);

        if (isFullScreen) {
            icon.removeClass("fa-expand").addClass("fa-compress");
        } else {
            icon.removeClass("fa-compress").addClass("fa-expand");
        }

        setTimeout(function () {
            if ($.fn.DataTable) {
                if ($.fn.DataTable.isDataTable("#tblTransferStudent")) {
                    $("#tblTransferStudent").DataTable().columns.adjust();
                }

                if ($.fn.DataTable.isDataTable("#tblTransferGroup")) {
                    $("#tblTransferGroup").DataTable().columns.adjust();
                }
            }
        }, 200);
    };

    $(document)
        .off("click", "#btnToggleTransferFullScreen")
        .on("click", "#btnToggleTransferFullScreen", function (e) {
            e.preventDefault();

            const dialog = $("#TransferModal .transfer-modal-dialog");
            const isFullScreen = dialog.hasClass("modal-fullscreen-custom");

            SetTransferFullScreen(!isFullScreen);
        });

    $("#TransferModal")
        .off("hidden.bs.modal")
        .on("hidden.bs.modal", function () {
            SetTransferFullScreen(false);
        });
</script>

