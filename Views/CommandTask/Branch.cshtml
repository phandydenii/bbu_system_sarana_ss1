@{
    ViewData["OpenMenu"] = "CommandTask";
    ViewData["Action"] = "Branch";
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Branch</h3>
                <button type="button" class="btn btn-success btn-sm float-right" onclick="openAddBranch()">
                    <i class="fas fa-plus"></i>
                    Add New
                </button>
            </div>
            <div class="card-body">
                <table id="tblBranch" class="table table-sm table-bordered table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Name Khmer</th>
                        <th>Short</th>
                        <th>Address</th>
                        <th>Phone</th>
                        <th>action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_BranchModal"/>

@section Scripts{
    <script>
    const tblBranch = $("#tblBranch");
    const branchModal = $("#BranchModal");
    const branchForm = $("#branchForm");

    const branchIdInput = $("#branch_BranchId");
    const branchNameInput = $("#branch_BranchName");
    const branchNameKhmerInput = $("#branch_BranchNameInKhmer");
    const shortNameInput = $("#branch_ShortName");
    const addressInput = $("#branch_Address");
    const phoneInput = $("#branch_Phone");

    $(document).ready(function () {
        fetchBranch();
    });

    function fetchBranch() {
        if ($.fn.DataTable.isDataTable("#tblBranch")) {
            tblBranch.DataTable().clear().destroy();
            tblBranch.empty();
        }

        branchTable = tblBranch.DataTable({
            destroy: true,
            paging: true,
            lengthChange: true,
            searching: true,
            ordering: true,
            info: true,

            responsive: false,
            autoWidth: false,
            scrollX: true,
            scrollCollapse: true,

            processing: true,
            serverSide: true,
            order: [[0, "desc"]],

            ajax: {
                url: "/branch/get-branch",
                type: "POST",
                error: function (xhr) {
                    console.log(xhr.responseText);
                    ShowToastError("Cannot load branch data.");
                }
            },

            columns: [
                {
                    title: "ID",
                    data: "branchId",
                    width: "70px"
                },
                {
                    title: "Branch Name",
                    data: "branchName",
                    width: "250px",
                    render: function (data) {
                        return renderTruncate(data);
                    }
                },
                {
                    title: "Branch Name Khmer",
                    data: "branchNameInKhmer",
                    width: "300px",
                    render: function (data) {
                        return renderTruncate(data);
                    }
                },
                {
                    title: "Short Name",
                    data: "shortName",
                    width: "130px",
                    render: function (data) {
                        return renderTruncate(data);
                    }
                },
                {
                    title: "Address",
                    data: "address",
                    width: "300px",
                    render: function (data) {
                        return renderTruncate(data);
                    }
                },
                {
                    title: "Phone",
                    data: "phone",
                    width: "150px",
                    render: function (data) {
                        return renderTruncate(data);
                    }
                },
                {

                    title: "Action",
                    data: null,
                    width: "180px",
                    className: "dt-action",
                    orderable: false,
                    searchable: false,
                    render: function () {
                        return `
                        <div class="text-nowrap text-center">
                            <a href="javascript:void(0)" class="btnEdit btn btn-warning btn-sm">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <a href="javascript:void(0)" class="btnDelete btn btn-danger btn-sm">
                                <i class="fa-solid fa-trash"></i> Delete
                            </a>
                        </div>
                    `;
                    }
                }
            ],

            initComplete: function () {
                let api = this.api();
                MyApp.utils.dataTableDebounceSearch("#tblBranch", 500);

                setTimeout(function () {
                    api.columns.adjust();
                }, 500);
            },

            drawCallback: function () {
                this.api().columns.adjust();
            }
        });

        setTimeout(function () {
            branchTable.columns.adjust();
        }, 1000);
    }

    function clearBranchForm() {
        branchForm[0].reset();

        branchIdInput.val(0);
        branchNameInput.val("");
        branchNameKhmerInput.val("");
        shortNameInput.val("");
        addressInput.val("");
        phoneInput.val("");
    }

    function openAddBranch() {
        clearBranchForm();
        branchModal.find(".modal-title").text("Add Branch");
        branchModal.modal("show");
    }

    tblBranch.on("click", ".btnEdit", function (event) {
        event.preventDefault();

        let rowElement = $(this).closest("tr");

        if (rowElement.hasClass("child")) {
            rowElement = rowElement.prev();
        }

        const selectedRow = tblBranch.DataTable().row(rowElement).data();

        if (!selectedRow) {
            ShowToastError("Cannot get selected branch data.");
            return;
        }

        branchIdInput.val(selectedRow["branchId"]);
        branchNameInput.val(selectedRow["branchName"]);
        branchNameKhmerInput.val(selectedRow["branchNameInKhmer"]);
        shortNameInput.val(selectedRow["shortName"] || "");
        addressInput.val(selectedRow["address"] || "");
        phoneInput.val(selectedRow["phone"] || "");

        branchModal.find(".modal-title").text("Edit Branch");
        branchModal.modal("show");
    });

    tblBranch.on("click", ".btnDelete", function (event) {
        event.preventDefault();

        let rowElement = $(this).closest("tr");

        if (rowElement.hasClass("child")) {
            rowElement = rowElement.prev();
        }

        const selectedRow = tblBranch.DataTable().row(rowElement).data();

        if (!selectedRow) {
            ShowToastError("Cannot get selected branch data.");
            return;
        }

        if (!confirm("Are you sure you want to delete this branch?")) {
            return;
        }

        $.ajax({
            url: "/branch/delete/" + selectedRow["branchId"],
            method: "DELETE",
            success: function (response) {
                const code =  response.status?.code;
                const message = response.status?.message;

                if (code === "200" || code === 200) {
                    ShowToastSuccess(message || "Delete successfully!");
                    tblBranch.DataTable().ajax.reload();
                } else {
                    ShowToastError(message || "Delete failed.");
                }
            },
            error: function (xhr) {
                const message =
                    xhr["responseJSON"]?.["status"]?.["message"] ||
                    xhr["responseJSON"]?.["message"] ||
                    "Delete failed.";

                ShowToastError(message);
            }
        });
    });

    $(document).on("submit", "#branchForm", function (event) {
        event.preventDefault();

        const branchId = branchIdInput.val() || "0";
    
        $.ajax({
            url: "/branch/save-branch",
            method: "POST",
            data: branchForm.serialize(),
            success: function (response) {
                const code = response.status?.code;
                const message = response.status?.message;

                if (code === "200" || code === 200) {
                    if (branchId !== "0") {
                        ShowToastSuccess(message || "Updated successfully!");
                    } else {
                        ShowToastSuccess(message || "Saved successfully!");
                    }

                    clearBranchForm();
                    branchModal.modal("hide");
                    tblBranch.DataTable().ajax.reload();
                } else {
                    ShowToastError(message || "Save failed.");
                }
            },
            error: function (xhr) {
                const message =
                    xhr["responseJSON"]?.["status"]?.["message"] ||
                    xhr["responseJSON"]?.["message"] ||
                    "Server error.";

                ShowToastError(message);
            }
        });
    });

    $(document).on("click", "#btnClose", function (event) {
        event.preventDefault();

        clearBranchForm();
        branchModal.modal("hide");
    });
</script>
}