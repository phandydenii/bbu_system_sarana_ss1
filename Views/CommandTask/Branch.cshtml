@{
    ViewData["OpenMenu"] = "CommandTask";
    ViewData["Action"] = "Branch";
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Branch</h3>
                <button type="button" class="btn btn-success btn-sm float-right" data-toggle="modal" data-target="#BranchModal">
                    <i class="fas fa-plus"></i>
                    Add New
                </button>
            </div>
            <div class="card-body">
                <table id="tblBranch" class="table table-sm table-bordered table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Name Khmer</th>
                        <th>Short</th>
                        <th>Address</th>
                        <th>Phone</th>
                        <th>action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_BranchModal"/>

@section Scripts{
    <script src="~/function/Branch.js"></script>
    <script>
    const tblBranch = $("#tblBranch");
    const btnClose = $("#btnClose");

    $(document).ready(async function () {
        fetchBranch();
    });

    function fetchBranch() {
        tblBranch.DataTable().clear().destroy();
        tblBranch.DataTable({
            paging: true,
            lengthChange: true,
            searching: true,
            ordering: true,
            info: true,
            responsive: true,
            processing: true,
            serverSide: true,
            order: [[0, "desc"]],
            ajax: {
                url: "/branch/get-branches",
                type: "POST"
            },
            columns: [
                { data: "branchId" },
                { data: "branchName" },
                { data: "branchNameInKhmer" },
                { data: "shortName" },
                { data: "phone" },
                { data: "address",
                    render:function(data, type, row){
                    if(type !== 'display') return data;
                    
                    const shortAddress = data && data.length > 30 ?
                        data.substring(0, 30) + "..." : data;
                    return `<span title="${data}">${shortAddress}</span>`;
                    }
                },
                {
                    data: null,
                    width: "80px", // give it a bit more room
                    render: function () {
                        return `
                            <div style="display: flex; gap: 6px; padding: 4px 2px;">
                                <a id="btnEdit" class="btn btn-success btn-sm" style="padding: 2px 6px; line-height: 1.4;">
                                    <i class="fas fa-edit"></i>
                                     Edit
                                </a>
                                <a id="btnDelete" class="btn btn-danger btn-sm" style="padding: 2px 6px; line-height: 1.4;">
                                    <i class="fa-solid fa-trash"></i>
                                    Delete
                                </a>
                            </div>
                        `;
                    }
                }
            ],
            initComplete: function(){
                MyApp.utils.dataTableDebounceSearch("#tblBranch", 500);
            }
        });
    }

    tblBranch.on("click", "#btnEdit", function (event) {
        event.preventDefault();
        
        let $row = $(this).closest('tr');
        if($row.hasClass('child')){
            $row = $row.prev();
        }
        const selectedRow = tblBranch.DataTable().row($row).data();
        console.log(selectedRow);
        
        const branch = new Branch(selectedRow);
        $("#branch_BranchId").val(branch.branchId);
        $("#branch_BranchName").val(branch.branchName);
        $("#branch_BranchNameInKhmer").val(branch.branchNameInKhmer);
        $("#branch_ShortName").val(branch.shortName);
        $("#branch_Phone").val(branch.phone);
        $("#branch_Address").val(branch.address);
        
        $("#BranchModal").modal("show");
    });

    tblBranch.on("click", "#btnDelete", function (event) {
        event.preventDefault();

        const $row = $(this).closest('tr');
        const selectedRow = tblBranch.DataTable().row($row).data();
        if(!confirm("Are you sure you want to delete this branch?")) return;
        $.ajax({
            url: "/branch/delete/" + selectedRow.branchId,
            method: "DELETE",
            success:function(response){
                if(response.status.code === "200"){
                    ShowToastSuccess("Delete successfully!");
                    $("#tblBranch").DataTable().ajax.reload();
                }else {
                    ShowToastError(response.message);
                }
            },
            error: function (error) {
                if (error.responseJSON && error.responseJSON.message) {
                    ShowToastError(error.responseJSON.message);
                }
            }
        });
    });

    $(document).on("submit", "#branchForm", function (event) {
        event.preventDefault();

        if (!this.checkValidity()) {
            this.reportValidity();
            return;
        }
        const form = $(this);
        const formData = $(form).serialize();
        $("#branch_id").val();
        $.ajax({
            url: "/branch/save-branch",
            method: "POST",
            data: formData,
            success: function (response) {
                if(response.status.code === "200"){
                    ShowToastSuccess("Saved successfully!");    
                    $("#branchForm")[0].reset();
                    $("#BranchModal").modal("hide");
                    $("#tblBranch").DataTable().ajax.reload();
                } else {
                    ShowToastError(response.message);
                }
            },
            error: function (error) {
                if (error.responseJSON && error.responseJSON.message) {
                    ShowToastError(error.responseJSON.message);
                }
            }
        });
    });

    $(document).on("click", "#btnClose", function (event) {
        event.preventDefault();
        $("#branchForm")[0].reset();
        $("#BranchModal").modal("hide");
    });
</script>
}