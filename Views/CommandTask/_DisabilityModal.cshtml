@using BBU_SYSTEM.DTOs
@{
    var disability = new DisabilityDto();
}
<div class="modal fade" id="disabilityModal" data-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Disability</h4>
            </div>
            <div class="modal-body">
                <form id="formDisability">
                    <input asp-for="@disability.Id" hidden readonly class="form-control" value="0"/>
                    <div class="form-group">
                        <label class="required">Name</label>
                        <input type="text" asp-for="@disability.DisabilityName" class="form-control"
                               placeholder="Enter name" required>
                    </div>
                    <div class="form-group">
                        <label class="required">Name Khmer</label>
                        <input type="text" asp-for="@disability.DisabilityNameKh" class="form-control"
                               placeholder="Enter name khmer" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="submit" form="formDisability" class="btn btn-success">
                    <i class="fas fa-save"></i> Save
                </button>
                <button type="button" class="btn btn-danger btnCloseDisability">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>