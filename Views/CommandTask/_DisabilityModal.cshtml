@using BBU_SYSTEM.DTOs
@{
    @model DisabilityDto
    //var disability = new DisabilityDto();
}
<div class="modal fade" id="disabilityModal" data-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Disability</h4>
            </div>
            <div class="modal-body">
                <form id="disabilityForm">
                    <input asp-for="Id" hidden readonly class="form-control" value="0"/>
                    <div class="form-group">
                        <label>Name</label>
                        <input type="text" asp-for="DisabilityName" class="form-control"
                               placeholder="Enter name" required>
                    </div>
                    <div class="form-group">
                        <label>Name Khmer</label>
                        <input type="text" asp-for="DisabilityNameKh" class="form-control"
                               placeholder="Enter name khmer" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="submit" form="disabilityForm" class="btn btn-success">
                    <i class="fas fa-save"></i> Save
                </button>
                <button id="btnClose" type="button" class="btn btn-danger">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>