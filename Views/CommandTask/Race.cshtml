@{
    ViewData["OpenMenu"] = "CommandTask";
    ViewData["Action"] = "Race";
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Race</h3>
                <button type="button" class="btn btn-success btn-sm float-right" data-toggle="modal" data-target="#raceModal">
                    <i class="fas fa-plus"></i>
                    Add New
                </button>
            </div>
            <div class="card-body">
                <table id="tblRace" class="table table-sm table-bordered table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name English</th>
                        <th>Name Khmer</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_RaceModal"/>

@section Scripts
{
    <script src="~/function/Race.js"></script>
    <script>
        const tblRace = $("#tblRace");

        $(document).ready(function () {
            fetchRace();
        });

        function fetchRace() {
            tblRace.DataTable().clear().destroy();
            tblRace.DataTable({
                paging: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                responsive: true,
                processing: true,
                serverSide: true,
                order: [[0, "desc"]],
                ajax: {
                    url: "/Race/get-races",
                    type: "POST"
                },
                columns: [
                    {data: "raceId"},
                    {data: "raceName"},
                    {data: "raceInKhmer"},
                    {
                        data: null,
                        render: function () {
                            return `
                            <a id="btnEdit" class="btn btn-success btn-sm">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                        `;
                        }
                    }
                ],
                initComplete: function () {
                    MyApp.utils.dataTableDebounceSearch("#tblRace", 500);
                }
            });
        }

        tblRace.on("click", "#btnEdit", function () {
            let row = $(this).closest("tr");
            if (row.hasClass("child")) {
                row = row.prev();
            }
            const selectedRow = $("#tblSchool").DataTable().row(row).data();
            const race = new Race(selectedRow);
            $("#race_RaceId").val(race.raceId);
            $("#race_RaceName").val(race.raceName);
            $("#race_RaceInKhmer").val(race.raceInKhmer);

            $("#raceModal").modal("show");
        });

        $("#raceForm").on("submit", function (e) {
            e.preventDefault();
            const form = $(this);
            const formData = form.serialize();
            $.ajax({
                url: "/race/SaveChange",
                method: "POST",
                data: formData,
                success: function (response) {
                    if (response.status === "200") {
                        ShowToastSuccess("Save successfully");
                        $("#raceForm")[0].reset();
                        $("#raceModal").modal("hide");
                        $("#tblRace").dataTable().ajax.reload();
                    } else {
                        ShowToastError(response.message);
                    }
                },
                error: function (error) {
                    if (error.responseJSON && error.responseJSON.message) {
                        ShowToastError(error.responseJSON.message);
                    }
                }
            });
        });
        
        $("#btnClose").on("click", function (event) {
            event.preventDefault();
            $("#raceForm")[0].reset();
            $("#raceModal").modal("hide");
        });
    </script>
}
