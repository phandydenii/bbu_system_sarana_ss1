@using BBU_SYSTEM.DTOs
@{
    var school = new SchoolDto();
}
<div class="modal fade" id="SchoolModal" data-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">School</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="schoolForm">
                    <input type="hidden" id="school_SchoolId" name="SchoolId" value="0" />

                    <div class="form-group">
                        <label class="required">Name</label>
                        <input type="text"
                               id="school_SchoolName"
                               name="SchoolName"
                               class="form-control"
                               placeholder="Enter name" required/>
                    </div>

                    <div class="form-group">
                        <label class="required">Name Khmer</label>
                        <input type="text"
                               id="school_SchoolNameInKhmer"
                               name="SchoolNameInKhmer"
                               class="form-control"
                               placeholder="Enter name khmer" required/>
                    </div>

                    <div class="row">
                        <div class="col-3">
                            <div class="form-group">
                                <label class="required">Code</label>
                                <input type="text"
                                       id="school_SchoolCode"
                                       name="SchoolCode"
                                       class="form-control"
                                       placeholder="Enter code" required/>
                            </div>
                        </div>

                        <div class="col-9">
                            <div class="form-group">
                                <label class="required">Faculty</label>
                                <select id="school_FacultyId"
                                        name="FacultyId"
                                        class="form-control select2" required>
                                    <option value="">Select Faculty</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <input type="checkbox" id="chkFoundation" />
                        <label>is foundation</label>

                        <input type="hidden"
                               id="school_IsFoundationSchool"
                               name="IsFoundationSchool"
                               value="0" />
                    </div>
                </form>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="submit" form="schoolForm" class="btn btn-primary">
                    <i class="fas fa-save"></i>
                    Save changes
                </button>
                <button type="button" class="btn btn-danger" data-dismiss="modal"><i class="fas fa-close"></i> Close
                </button>
            </div>
        </div>
    </div>
</div>