@using BBU_SYSTEM.DTOs
@using School = BBU_SYSTEM.Modelsss.School
@{
    @model SchoolDto
    //var school = new SchoolDto();
}
<div class="modal fade" id="SchoolModal" data-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">School</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="schoolForm">
                    <input asp-for="SchoolId" hidden readonly class="form-control" value="0" />
                    <div class="form-group">
                        <label>Name</label>
                        <input type="text"
                               asp-for="SchoolName"
                               class="form-control"
                               placeholder="Enter name" required/>
                    </div>
                    <div class="form-group">
                        <label>Name Khmer</label>
                        <input type="text"
                               asp-for="SchoolNameInKhmer"
                               class="form-control"
                               placeholder="Enter name khmer" required/>
                    </div>
                    <div class="row">
                        <div class="col-3">
                            <div class="form-group">
                                <label>Code</label>
                                <input type="text"
                                       asp-for="SchoolCode"
                                       class="form-control"
                                       placeholder="Enter code" required/>
                            </div>
                        </div>
                        <div class="col-9">
                            <div class="form-group">
                                <label>Faculty</label>
                                <select asp-for="FacultyId" class="form-control" required>
                                    <option value="">Select Faculty</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <input type="checkbox" id="chkFoundation"/>
                        <label for="chkFoundation"> Foundation</label>
                        <input hidden id="IsFoundationSchool" name="IsFoundationSchool" value="0" />
                    </div>
                </form>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="submit" form="schoolForm" class="btn btn-primary">
                    <i class="fas fa-save"></i>
                    Save changes
                </button>
                <button id="btnClose" type="button" class="btn btn-danger" data-dismiss="modal"><i class="fas fa-close"></i> Close
                </button>
            </div>
        </div>
    </div>
</div>