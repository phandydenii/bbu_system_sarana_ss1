@{
    ViewData["OpenMenu"] = "CommandTask";
    ViewData["Action"] = "Nationality";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Nationality</h3>
                <button type="button" class="btn btn-success btn-sm float-right" data-toggle="modal" data-target="#nationalityModal">
                    <i class="fas fa-plus"></i>
                    Add New
                </button>
            </div>
            <div class="card-body">
                <table id="tblNationality" class="table table-sm table-bordered table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name English</th>
                        <th>Name Khmer</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_NationalityModal"/>

@section Scripts
{
    <script src="~/function/Nationality.js"></script>
    <script>
        const  tblNationality = $("#tblNationality");
        $(document).ready(function () {
            fetchNationality();
        });

        function fetchNationality() {
            tblNationality.DataTable().clear().destroy();
            tblNationality.DataTable({
                paging: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                responsive: true,
                processing: true,
                serverSide: true,
                order:[[0, "desc"]],
                ajax: {
                    url: "/Nationality/get-nationalities",
                    type: "POST"
                },
                columns: [
                    {data: "nationalityId"},
                    {data: "nationalityName"},
                    {data: "nationalityInKhmer"},
                    {
                        data: null,
                        render: function () {
                            return `
                            <a id="btnEdit" class="btn btn-success btn-sm">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                        `;
                        }
                    }
                ],
                initComplete: function(){
                    MyApp.utils.dataTableDebounceSearch("#tblNationality", 500);
                }
            });
        }

        tblNationality.on("click", "#btnEdit", function (e) {
            e.preventDefault();
            let row = $(this).closest("tr");
            if (row.hasClass("child")) {
                row = row.prev();
            }
            const selectedRow = tblNationality.DataTable().row(row).data();
            const nationality = new Nationality(selectedRow);
            $("#nationality_NationalityId").val(nationality.nationalityId);
            $("#nationality_NationalityName").val(nationality.nationalityName);
            $("#nationality_NationalityInKhmer").val(nationality.nationalityInKhmer);

            $("#nationalityModal").modal("show");
        });

        $("#nationalityForm").on("submit", function (e) {
            e.preventDefault();
            
            const form = $(this);
            const formData = form.serialize();
            $.ajax({
                url: "/Nationality/SaveChange",
                method: "POST",
                data: formData,
                success: function(response){
                    if(response.status.code === "200"){
                        ShowToastSuccess("Saved Successfully");
                        $("#nationalityForm")[0].reset();
                        $("#nationalityModal").modal("hide");
                        $("#tblNationality").DataTable().ajax.reload();
                    } else {
                        ShowToastError(response.message);
                    }
                },
                error: function (error) {
                    if (error.responseJSON && error.responseJSON.message) {
                        ShowToastError(error.responseJSON.message);
                    }
                }
            });
        });
        $("#btnClose").on("click", function(){
            $("#nationalityForm")[0].reset();
            $("#nationalityModal").modal("hide");
        });
    </script>
}
