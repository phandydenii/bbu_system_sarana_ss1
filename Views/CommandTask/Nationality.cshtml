@{
    ViewData["OpenMenu"] = "CommandTask";
    ViewData["Action"] = "Nationality";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Nationality</h3>
                <button type="button" id="btnNewNationality" class="btn btn-success btn-sm float-right">
                    <i class="fas fa-plus"></i>
                    Add New
                </button>
            </div>
            <div class="card-body">
                <table id="tblNationality" class="table table-sm table-bordered table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name English</th>
                        <th>Name Khmer</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_NationalityModal"/>
<script>
    $(document).ready(function () {
        fetchNationality();

        $("#btnNewNationality").on("click", function (e) {
            e.preventDefault();

            clearNationalityForm();

            $("#nationalityModal").find(".modal-title").text("Add Nationality");
            $("#nationalityModal").modal("show");
        });

        $(document).on("click", ".btnCloseNationality", function () {
            clearNationalityForm();
            $("#nationalityModal").modal("hide");
        });
    });

    function fetchNationality() {
        if ($.fn.DataTable.isDataTable("#tblNationality")) {
            $("#tblNationality").DataTable().clear().destroy();
        }

        $("#tblNationality").DataTable({
            paging: true,
            lengthChange: true,
            searching: true,
            ordering: true,
            info: true,
            responsive: true,
            processing: true,
            serverSide: true,
            ajax: {
                url: "/Nationality/get-nationalities",
                type: "POST"
            },
            columns: [
                { data: "nationalityId" },
                { data: "nationalityName" },
                { data: "nationalityInKhmer" },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function () {
                        return `
                            <a href="javascript:void(0)" class="btnEdit btn btn-success btn-sm">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                        `;
                    }
                }
            ]
        });
    }

    function clearNationalityForm() {
        $("#formNationality")[0].reset();

        $("#nationality_NationalityId").val(0);
        $("#nationality_NationalityName").val("");
        $("#nationality_NationalityInKhmer").val("");
    }

    $("#tblNationality").on("click", ".btnEdit", function () {
        let row = $(this).closest("tr");

        if (row.hasClass("child")) {
            row = row.prev();
        }

        const selectedRow = $("#tblNationality").DataTable().row(row).data();

        if (!selectedRow) {
            ShowToastError("Cannot get selected nationality data.");
            return;
        }

        $("#nationality_NationalityId").val(selectedRow.nationalityId);
        $("#nationality_NationalityName").val(selectedRow.nationalityName);
        $("#nationality_NationalityInKhmer").val(selectedRow.nationalityInKhmer);

        $("#nationalityModal").find(".modal-title").text("Edit Nationality");
        $("#nationalityModal").modal("show");
    });

    $("#formNationality").on("submit", function (e) {
        e.preventDefault();

        const nationalityId = $("#nationality_NationalityId").val() || "0";
        const nationalityName = ($("#nationality_NationalityName").val() || "").trim();
        const nationalityKhmer = ($("#nationality_NationalityInKhmer").val() || "").trim();

        $.ajax({
            url: "/Nationality/SaveChange",
            method: "POST",
            data: {
                NationalityId: nationalityId,
                NationalityName: nationalityName,
                NationalityInKhmer: nationalityKhmer
            },
            success: function (response) {
                const code = response["status"]?.["code"] || response["code"];
                const message = response["status"]?.["message"] || response["message"];

                if (code === "200" || code === 200) {
                    if (nationalityId !== "0") {
                        ShowToastSuccess(message || "Updated successfully!");
                    } else {
                        ShowToastSuccess(message || "Saved successfully!");
                    }

                    clearNationalityForm();
                    $("#nationalityModal").modal("hide");
                    $("#tblNationality").DataTable().ajax.reload();
                } else {
                    ShowToastError(message || "Save failed.");
                }
            },
            error: function (xhr) {
                const message =
                    xhr["responseJSON"]?.["status"]?.["message"] ||
                    xhr["responseJSON"]?.["message"] ||
                    "Server error.";

                ShowToastError(message);
            }
        });
    });
</script>