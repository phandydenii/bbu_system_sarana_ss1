@using BBU_SYSTEM.DTOs
@using Race = BBU_SYSTEM.Modelsss.Race
@{
    var race = new RaceDto();
}
<div class="modal fade" id="raceModal" data-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Race</h4>
            </div>
            <div class="modal-body">
                <form id="formRace">
                    <input type="hidden" asp-for="@race.RaceId" name="RaceId" value="0" />
                    <div class="form-group">
                        <label>Name</label>
                        <input type="text"
                               asp-for="@race.RaceName"
                               name="RaceName"
                               class="form-control"
                               placeholder="Enter name" />
                    </div>

                    <div class="form-group">
                        <label>Name Khmer</label>
                        <input type="text"
                               asp-for="@race.RaceInKhmer"
                               name="RaceInKhmer"
                               class="form-control"
                               placeholder="Enter name khmer" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="submit" form="formRace" class="btn btn-success">
                    <i class="fas fa-save"></i> Save
                </button>
                <button type="button" class="btn btn-danger btnCloseRace">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>