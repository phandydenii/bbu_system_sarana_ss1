@{
    ViewData["OpenMenu"] = "CommandTask";
    ViewData["Action"] = "Faculty";
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Faculty</h3>
                <button type="submit" class="btn btn-success btn-sm float-right" data-toggle="modal"
                        data-target="#FacultyModal">
                    <i class="fas fa-plus"></i>
                    Add New
                </button>
            </div>
            <div class="card-body">
                <table id="tblFaculty" class="table table-sm table-bordered table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name English</th>
                        <th>Name Khmer</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_FacaltyModal"/>

@section Scripts{
    <script src="~/function/Faculty.js"></script>
    <script>
    const tblFaculty = $("#tblFaculty");
    const btnClose = $("#btnClose");

    $(document).ready(async function () {
        fetchFaculty();
    });

    function fetchFaculty() {
        if ($.fn.DataTable.isDataTable("#tblFaculty")) {
            tblFaculty.DataTable().clear().destroy();
        }
        tblFaculty.DataTable({
            paging: true,
            lengthChange: true,
            searching: true,
            ordering: true,
            info: true,
            responsive: true,
            processing: true,
            serverSide: true,
            order:[[0,"desc"]],
            ajax: {
                url: "/Faculty/get-faculties",
                type: "POST"
            },
            columns: [
                { data: "facultyId" },
                { data: "facultyName" },
                { data: "facultyNameInKhmer" },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function () {
                        return `
                            <a id="btnEdit" class="btnEdit btn btn-success btn-sm">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <a id="btnDelete" class="btnDelete btn btn-danger btn-sm">
                                <i class="fa-solid fa-trash"></i> Delete
                            </a>
                        `;
                    }
                }
            ],
            initComplete: function(){
                MyApp.utils.dataTableDebounceSearch("#tblFaculty", 500);
            }
        });
    }

    tblFaculty.on("click", "#btnEdit", function (event) {
        event.preventDefault();

        let $row = $(this).closest('tr');
        if($row.hasClass('child')){
            $row = $row.prev();
        }
        const selectedRow = tblFaculty.DataTable().row($row).data();
        console.log(selectedRow);
        const faculty = new Faculty(selectedRow);
        $("#faculty_FacultyId").val(faculty.facultyId);
        $("#faculty_FacultyName").val(faculty.facultyName);
        $("#faculty_FacultyNameInKhmer").val(faculty.facultyNameInKhmer);
        
        $("#FacultyModal").modal("show");
    });

    tblFaculty.on("click", "#btnDelete", function (event) {
        event.preventDefault();

        let $row = $(this).closest('tr');
        if($row.hasClass('child')){
            $row = $row.prev();
        }
        const selectedRow = tblFaculty.DataTable().row($row).data();
        console.log(selectedRow);

        if (!confirm("Are you sure you want to delete this faculty?")) {
            return;
        }

        $.ajax({
            url: "/faculty/delete/" + selectedRow.facultyId,
            method: "DELETE",
            success:function(response){
                if(response.status.code === "200"){
                    ShowToastSuccess("Delete successfully!");
                    $("#tblFaculty").DataTable().ajax.reload();
                }else {
                    ShowToastError(response.message);
                }
            },
            error: function (error) {
                if (error.responseJSON && error.responseJSON.message) {
                    ShowToastError(error.responseJSON.message);
                }
            }
        });
    });

    $(document).on("submit", "#facultyForm", function (event) {
        event.preventDefault();
        if(!this.checkValidity()){
            this.reportValidity();
            return;
        }
        const form = $(this);
        const formData = $(form).serialize();
        $("#faculty_id").val();
        $.ajax({
            url: "/faculty/SaveChange",
            method: "POST",
            data: formData,
            success: function (response) {
                if(response.status.code === "200"){
                    ShowToastSuccess("Save successfully!");
                    $("#facultyForm")[0].reset();
                    $("#FacultyModal").modal("hide");
                    $("#tblFaculty").DataTable().ajax.reload();
                }else{
                    ShowToastError(response.message);
                }
            },
            error: function (error) {
                if (error.responseJSON && error.responseJSON.message) {
                    ShowToastError(error.responseJSON.message);
                }
            }
        });
    });

    $(document).on("click", "#btnClose", function (event) {
        event.preventDefault();
        $("#facultyForm")[0].reset();
        $("#FacultyModal").modal("hide");
    });
</script>
}

