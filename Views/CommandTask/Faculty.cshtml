@{
    ViewData["OpenMenu"] = "CommandTask";
    ViewData["Action"] = "Faculty";
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Faculty</h3>
                <button type="submit" class="btn btn-success btn-sm float-right" data-toggle="modal"
                        data-target="#FacultyModal">
                    <i class="fas fa-plus"></i>
                    Add New
                </button>
            </div>
            <div class="card-body">
                <table id="tblFaculty" class="table table-sm table-bordered table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name English</th>
                        <th>Name Khmer</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_FacaltyModal"/>

@section Scripts{
    <script>
    const tblFaculty = $("#tblFaculty");
    const facultyModal = $("#FacultyModal");
    const facultyForm = $("#facultyForm");

    const facultyIdInput = $("#faculty_FacultyId");
    const facultyNameInput = $("#faculty_FacultyName");
    const facultyNameKhmerInput = $("#faculty_FacultyNameInKhmer");

    $(document).ready(function () {
        fetchFaculty();
    });

    function fetchFaculty() {
        if ($.fn.DataTable.isDataTable("#tblFaculty")) {
            tblFaculty.DataTable().clear().destroy();
            tblFaculty.empty();
        }

        facultyTable = tblFaculty.DataTable({
            destroy: true,
            paging: true,
            lengthChange: true,
            searching: true,
            ordering: true,
            info: true,

            responsive: false,
            autoWidth: false,
            scrollX: true,
            scrollCollapse: true,

            processing: true,
            serverSide: true,
            order: [[0, "desc"]],

            ajax: {
                url: "/Faculty/get-faculties",
                type: "POST",
                error: function (xhr) {
                    console.log(xhr.responseText);
                    ShowToastError("Cannot load faculty data.");
                }
            },

            columns: [
                {
                    title: "ID",
                    data: "facultyId",
                    width: "70px"
                },
                {
                    title: "Faculty Name",
                    data: "facultyName",
                    width: "300px",
                    render: function (data) {
                        return renderTruncate(data);
                    }
                },
                {
                    title: "Faculty Name Khmer",
                    data: "facultyNameInKhmer",
                    width: "320px",
                    render: function (data) {
                        return renderTruncate(data);
                    }
                },
                {
                    title: "Action",
                    data: null,
                    width: "180px",
                    className: "dt-action",
                    orderable: false,
                    searchable: false,
                    render: function () {
                        return `
                        <div class="dt-action">
                            <a href="javascript:void(0)" class="btnEdit btn btn-warning btn-sm">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <a href="javascript:void(0)" class="btnDelete btn btn-danger btn-sm">
                                <i class="fa-solid fa-trash"></i> Delete
                            </a>
                        </div>
                    `;
                    }
                }
            ],

            initComplete: function () {
                let api = this.api();
                MyApp.utils.dataTableDebounceSearch("#tblFaculty", 500);

                setTimeout(function () {
                    api.columns.adjust();
                }, 500);
            },

            drawCallback: function () {
                this.api().columns.adjust();
            }
        });

        setTimeout(function () {
            facultyTable.columns.adjust();
        }, 1000);
    }

    function clearFacultyForm() {
        facultyForm[0].reset();

        facultyIdInput.val(0);
        facultyNameInput.val("");
        facultyNameKhmerInput.val("");
    }

    function openAddFaculty() {
        clearFacultyForm();
        facultyModal.find(".modal-title").text("Add Faculty");
        facultyModal.modal("show");
    }

    tblFaculty.on("click", ".btnEdit", function (event) {
        event.preventDefault();

        let rowElement = $(this).closest("tr");

        if (rowElement.hasClass("child")) {
            rowElement = rowElement.prev();
        }

        const selectedRow = tblFaculty.DataTable().row(rowElement).data();

        if (!selectedRow) {
            ShowToastError("Cannot get selected faculty data.");
            return;
        }

        facultyIdInput.val(selectedRow["facultyId"]);
        facultyNameInput.val(selectedRow["facultyName"]);
        facultyNameKhmerInput.val(selectedRow["facultyNameInKhmer"]);

        facultyModal.find(".modal-title").text("Edit Faculty");
        facultyModal.modal("show");
    });

    tblFaculty.on("click", ".btnDelete", function (event) {
        event.preventDefault();

        let rowElement = $(this).closest("tr");

        if (rowElement.hasClass("child")) {
            rowElement = rowElement.prev();
        }

        const selectedRow = tblFaculty.DataTable().row(rowElement).data();

        if (!selectedRow) {
            ShowToastError("Cannot get selected faculty data.");
            return;
        }

        if (!confirm("Are you sure you want to delete this faculty?")) {
            return;
        }

        $.ajax({
            url: "/faculty/delete/" + selectedRow["facultyId"],
            method: "DELETE",
            success: function (response) {
                const code = response.status?.code;
                const message = response.status?.message;

                if (code === "200" || code === 200) {
                    ShowToastSuccess(message || "Deleted successfully!");
                    tblFaculty.DataTable().ajax.reload();
                } else {
                    ShowToastError(message || "Delete failed.");
                }
            },
            error: function (xhr) {
                const message =
                    xhr["responseJSON"]?.["status"]?.["message"] ||
                    xhr["responseJSON"]?.["message"] ||
                    "Delete failed.";

                ShowToastError(message);
            }
        });
    });

    $(document).on("submit", "#facultyForm", function (event) {
        event.preventDefault();

        const facultyId = facultyIdInput.val() || "0";
        const facultyName = (facultyNameInput.val() || "").trim();
        const facultyNameKhmer = (facultyNameKhmerInput.val() || "").trim();
        
        $.ajax({
            url: "/faculty/SaveChange",
            method: "POST",
            data: {
                FacultyId: facultyId,
                FacultyName: facultyName,
                FacultyNameInKhmer: facultyNameKhmer
            },
            success: function (response) {
                const code = response.status?.code;
                const message = response.status?.message;

                if (code === "200" || code === 200) {
                    ShowToastSuccess(
                        message ||
                        (facultyId !== "0" ? "Updated successfully!" : "Saved successfully!")
                    );

                    clearFacultyForm();
                    facultyModal.modal("hide");
                    tblFaculty.DataTable().ajax.reload();
                } else {
                    ShowToastError(message || "Save failed.");
                }
            },
            error: function (xhr) {
                const message =
                    xhr["responseJSON"]?.["status"]?.["message"] ||
                    xhr["responseJSON"]?.["message"] ||
                    "Server error.";

                ShowToastError(message);
            }
        });
    });

    $(document).on("click", "#btnClose", function (event) {
        event.preventDefault();

        clearFacultyForm();
        facultyModal.modal("hide");
    });
</script>
}

