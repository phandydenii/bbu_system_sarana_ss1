@using BBU_SYSTEM.DTOs 
@{
    ViewData["OpenMenu"] = "CommandTask";
    ViewData["Action"] = "FieldCertificate";
    var fieldCertificate = new FieldCertificateDto();
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Field Certificate</h3>
                <button ype="button" id="btnAddFieldCertificate" class="btn btn-success btn-sm float-right">
                    <i class="fas fa-plus"></i>
                    Add New
                </button>
            </div>
            <div class="card-body">
                <table id="tblFieldCertificate" class="table table-sm table-bordered table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        @* <th>Id</th> *@ 
                        <th>Degree</th>
                        <th>Degree Khmer</th> 
                        <th>type</th>
                        <th>Field</th>
                        <th>type_kh</th>
                        <th>Field Khmer</th>
                        <th>Promotion</th> 
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_FieldCertificateModal"/>

<script src="~/function/FieldCertificate.js"></script>

@section Scripts
{
    <script src="~/function/Degree.js"></script>
    <script src="~/function/School.js"></script>
    <script src="~/function/Field.js"></script>
    <script src="~/function/Promotion.js"></script>
    <script src="~/function/Stage.js"></script>
    <script src="~/function/Term.js"></script>
    <script src="~/function/Group.js"></script>
    <script>
        const inputName = "fieldCertificate_";
        const cboDegree = $(`#${inputName}DegreeId`);
        const cboSchool = $(`#${inputName}SchoolId`);
        const cboField = $(`#${inputName}FieldId`);
        const cboPromotion = $(`#${inputName}PromotionNo`);
        const txtDegreeName = $(`#${inputName}DegreeName`);
        const txtDegreeNameKhmer = $(`#${inputName}DegreeNameKhmer`);
        const txtFieldName = $(`#${inputName}FieldName`);
        const txtFieldNameKhmer = $(`#${inputName}FieldNameKhmer`);
        const tblFieldCertificate = $("#tblFieldCertificate");
        const formFieldCertificate = $("#formFieldCertificate");
        const fieldCertificateModal =$("#fieldCertificateModal");
        const rdoAcademic = $("#rdoAcademic");
        const rdoProffesional = $("#rdoProffesional");
        let fieldList = [], degreeList = [];
        $(document).ready(async function () {
            fetchFieldCertificate();
            // await GetDegree();
            // await GetSchool();
        });

        async function GetDegree() {
            cboDegree.empty();
            cboDegree.append(`<option value="">Select Degree</option>`);

            const response = await Degree.GetAllDegree();
            const degrees = response.data || response.result || response;

            degreeList = degrees;

            degrees.forEach(item => {
                cboDegree.append(`
            <option value="${item.degreeId}">
                ${item.degreeName}
            </option>
        `);
            });

            cboDegree.val("");
        }

        async function GetSchool() {
            cboSchool.empty();
            cboSchool.append(`<option value="">Select School</option>`);

            const response = await School.GetSchool();
            const schools = response.data || response.result || response;

            schools.forEach(function (item) {
                cboSchool.append(`
            <option value="${item.schoolId}">
                ${item.schoolName}
            </option>
        `);
            });

            cboSchool.val("");
        }

        function fetchFieldCertificate() {
            tblFieldCertificate.DataTable().clear().destroy();
            tblFieldCertificate.DataTable({
                paging: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                responsive: true,
                processing: true,
                serverSide: true,
                ajax: {
                    url: `/field-certificate/get-field-certificates`,
                    type: "POST",
                    dataType: "json",
                    error: function (xhr, status, error) {
                        @* console.log(xhr.responseText); *@
                    }
                },
                columns: [
                    {data: "degreeName"},
                    {data: "degreeNameKhmer"},
                    {data: "type"},
                    {data: "fieldName"},
                    {data: "typeKhmer"},
                    {data: "fieldNameKhmer"},
                    {data: "promotionNo"}, 
                    {
                        data: null,
                        render: function (data, type, row) { 
                            return `<a id="btnEdit" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i> Edit</a>`;
                        }
                    }
                ]
            })
        }

        document.getElementById("btnAddFieldCertificate").addEventListener("click", async function () {
            showLoading();

            fieldCertificateModal.find(".modal-title").text("Add New");
            formFieldCertificate[0].reset();

            // reset id
            $("#fieldCertificate_Id").val(0);

            // reset dropdowns
            cboDegree.empty().append(`<option value="">Select Degree</option>`);
            cboSchool.empty().append(`<option value="">Select School</option>`);
            cboPromotion.empty().append(`<option value="">Select Promotion</option>`);
            cboField.empty().append(`<option value="">Select Field</option>`);

            // reset textboxes
            txtDegreeName.val("");
            txtDegreeNameKhmer.val("");
            txtFieldName.val("");
            txtFieldNameKhmer.val("");

            $("#fieldCertificate_Type").val("");
            $("#fieldCertificate_TypeKhmer").val("");

            // IMPORTANT: make Add New form same every time
            rdoProffesional.prop("checked", true);
            rdoAcademic.prop("checked", false);
            $("#groupOfField").prop("hidden", true);

            await GetDegree();
            await GetSchool();

            fieldCertificateModal.modal("show");

            hideLoading(1);
        });

        tblFieldCertificate.on("click","", function (event) {
            fieldCertificateModal.find(".modal-title").text("Update");
            fieldCertificateModal.modal("show");
        })
        document.getElementById("btnClose").addEventListener("click", function () {
            formFieldCertificate[0].reset();

            $("#fieldCertificate_Id").val(0);

            rdoProffesional.prop("checked", true);
            rdoAcademic.prop("checked", false);
            $("#groupOfField").prop("hidden", true);

            cboDegree.val("").trigger("change");
            cboSchool.val("").trigger("change");
            cboPromotion.empty().append(`<option value="">Select Promotion</option>`);
            cboField.empty().append(`<option value="">Select Field</option>`);

            fieldCertificateModal.modal("hide");
        });

        cboDegree.on("change", async function () {
            await loadFieldAndPromotion();
        });

        cboSchool.on("change", async function () {
            await loadFieldAndPromotion();
        });

        async function GetField(degreeId, schoolId) {
            cboField.empty();
            cboField.append("<option value=''>Select Field</option>");

            if (!degreeId || !schoolId) return;

            const response = await $.ajax({
                url: "/Field/get-fields",
                type: "POST",
                data: {
                    isAll: true,
                    degreeId: degreeId,
                    schoolId: schoolId
                }
            });

            const fields = response.data || response.result || response;
            fieldList = fields;

            fields.forEach(item => {
                cboField.append(`
            <option value="${item.fieldId}">
                ${item.fieldName}
            </option>
        `);
            });
        }
        async function loadFieldAndPromotion() {
            const degreeId = parseInt(cboDegree.val());
            const schoolId = parseInt(cboSchool.val());

            @* console.log("Degree:", degreeId); *@
            @* console.log("School:", schoolId); *@

            cboField.empty().append(`<option value="">Select Field</option>`);
            cboPromotion.empty().append(`<option value="">Select Promotion</option>`);

            if (!degreeId || !schoolId) {
                return;
            }

            await GetField(degreeId, schoolId);
            await GetPromotion(degreeId, schoolId);
        }

        async function GetPromotion(degreeId, schoolId) {
            cboPromotion.empty();
            cboPromotion.append("<option value=''>Select Promotion</option>");

            if (!degreeId || !schoolId) return;

            const response = await Promotion.GetPromotions();
            const promotions = response.data || response.result || response;

            let hasPromotion = false;

            promotions.forEach(item => {
                const itemDegreeId = item.degreeId || item.degree;
                const itemSchoolId = item.schoolId || item.school;

                if (parseInt(itemDegreeId) === parseInt(degreeId) &&
                    parseInt(itemSchoolId) === parseInt(schoolId)) {

                    cboPromotion.append(`
                <option value="${item.promotionNo}">
                    ${item.promotionNo}
                </option>
            `);

                    hasPromotion = true;
                }
            });

            if (!hasPromotion) {
                cboPromotion.empty();
                cboPromotion.append("<option value=''>No promotion available</option>");
            }
        }

        function setField() {
            const degree = degreeList.find(item => parseInt(item.degreeId) === parseInt(cboDegree.val()));
            const field = fieldList.find(item => parseInt(item.fieldId) === parseInt(cboField.val()));

            @* console.log("Selected Degree:", degree); *@
            @* console.log("Selected Field:", field); *@

            if (!degree || !field) return;

            txtDegreeName.val(`${degree.degreeName} of ${field.degreeName}`);
            txtDegreeNameKhmer.val(`${degree.degreeInKhmer}${field.degreeNameInKhmer}`);

            if (rdoAcademic.is(":checked")) {
                txtFieldName.val(field.fieldName || "");
                txtFieldNameKhmer.val(field.fieldNameInKhmer || "");

                $("#fieldCertificate_Type").val("in");
                $("#fieldCertificate_TypeKhmer").val(field.type ? "ជំនាញ" : "ឯកទេស");
            } else {
                txtFieldName.val("");
                txtFieldNameKhmer.val("");

                $("#fieldCertificate_Type").val("");
                $("#fieldCertificate_TypeKhmer").val("");
            }
        }

        formFieldCertificate.on("submit", function (event) {
            event.preventDefault();
            const form = $(this);
            const formData = form.serialize();
            $.ajax({
                url: '/field-certificate/save-change',
                method: 'POST',
                data: formData,
                success: function (response) {
                    if (response.status.code === "200") {
                        ShowToastSuccess("Saved successfully!");
                        formFieldCertificate[0].reset();
                        fieldCertificateModal.modal("hide");
                        tblFieldCertificate.DataTable().ajax.reload();
                    } else {
                        ShowToastError(response.status.message || response.message);
                    }
                },
                error: function (error) {
                    ShowToastError(error.responseJSON?.status?.message || error.responseText || "Server error.");
                    @* console.log(error); *@
                }
            });
        });

        tblFieldCertificate.on("click", "#btnEdit", async function (event) {
            event.preventDefault();
            showLoading();

            let $row = $(this).closest("tr");

            if ($row.hasClass("child")) {
                $row = $row.prev();
            }

            const data = tblFieldCertificate.DataTable().row($row).data();

            @* console.log("Edit data:", data); *@

            if (!data) {
                ShowToastError("Cannot get selected data.");
                hideLoading(1);
                return;
            }

            fieldCertificateModal.find(".modal-title").text("Update");
            formFieldCertificate[0].reset();

            $("#fieldCertificate_Id").val(data.id);

            // 1. Load Degree and School dropdown first
            await GetDegree();
            await GetSchool();

            // 2. Set Degree and School value
            cboDegree.val(data.degreeId).trigger("change.select2");
            cboSchool.val(data.schoolId).trigger("change.select2");

            // 3. Load Field and Promotion by selected Degree/School
            await GetField(data.degreeId, data.schoolId);
            await GetPromotion(data.degreeId, data.schoolId);

            // 4. Set Field and Promotion value
            cboField.val(data.fieldId).trigger("change.select2");
            cboPromotion.val(data.promotionNo).trigger("change.select2");

            // 5. Set textboxes
            txtDegreeName.val(data.degreeName || "");
            txtDegreeNameKhmer.val(data.degreeNameKhmer || "");

            if (data.fieldName !== "" && data.fieldName !== null) {
                rdoAcademic.prop("checked", true);
                rdoProffesional.prop("checked", false);

                $("#groupOfField").removeAttr("hidden");

                txtFieldName.val(data.fieldName || "");
                txtFieldNameKhmer.val(data.fieldNameKhmer || "");

                $("#fieldCertificate_Type").val(data.type || "");
                $("#fieldCertificate_TypeKhmer").val(data.typeKhmer || "");
            } else {
                rdoProffesional.prop("checked", true);
                rdoAcademic.prop("checked", false);

                $("#groupOfField").prop("hidden", true);

                txtFieldName.val("");
                txtFieldNameKhmer.val("");

                $("#fieldCertificate_Type").val("");
                $("#fieldCertificate_TypeKhmer").val("");
            }

            fieldCertificateModal.modal("show");
            hideLoading(1);
        });
        
        rdoProffesional.on("change", function (e) {
            $("#groupOfField").prop("hidden", "hidden");
            $("#fieldCertificate_Type").removeAttr("required");
            $("#fieldCertificate_TypeKhmer").removeAttr("required");
            $("#fieldCertificate_FieldName").removeAttr("required");
            $("#fieldCertificate_FieldNameKhmer").removeAttr("required");
            setField();
        });
        rdoAcademic.on("change", function (e) {
            $("#groupOfField").removeAttr("hidden");
            $("#fieldCertificate_Type").prop("required", "required");
            $("#fieldCertificate_TypeKhmer").prop("required", "required");
            $("#fieldCertificate_FieldName").prop("required", "required");
            $("#fieldCertificate_FieldNameKhmer").prop("required", "required");
            setField();
        });
    </script>
}

