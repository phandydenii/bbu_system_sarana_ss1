@{
    ViewData["OpenMenu"] = "CommandTask";
    ViewData["Action"] = "Province";
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Province</h3>
                <button type="submit" id="btnNewProvince" class="btn btn-success btn-sm float-right">
                    <i class="fas fa-plus"></i>
                    Add New
                </button>
                
            </div>
            <div class="card-body">
                <table id="tblProvince" class="table table-sm table-bordered table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Name Khmer</th>
                        <th>City</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_ProvinceModal"/>
<script>
    $(document).ready(function () {
        fetchProvince();
    });

    function fetchProvince() {
        if ($.fn.DataTable.isDataTable("#tblProvince")) {
            $("#tblProvince").DataTable().clear().destroy();
        }

        $("#tblProvince").DataTable({
            paging: true,
            lengthChange: true,
            searching: true,
            ordering: true,
            info: true,
            responsive: true,
            processing: true,
            serverSide: true,
            ajax: {
                url: "/Province/get-provinces",
                type: "POST"
            },
            columns: [
                { data: "provinceId" },
                { data: "provinceName" },
                { data: "provinceInKhmer" },
                {
                    data: "isCity",
                    render: function (data) {
                        return data === 1 || data === true ? "Yes" : "No";
                    }
                },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function () {
                        return `
                        <a href="javascript:void(0)" class="btnEdit btn btn-success btn-sm">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                    `;
                    }
                }
            ]
        });
    }
    function clearProvinceForm() {
        $("#formProvince")[0].reset();

        $("#province_ProvinceId").val(0);
        $("#province_ProvinceName").val("");
        $("#province_ProvinceNameInKhmer").val("");
        $("#province_IsCity").val(0);
        $("#chkIsCity").prop("checked", false);
    }
    $(document).on("click", "#btnClose", function (e) {
        e.preventDefault();

        clearProvinceForm();
        $("#provinceModal").modal("hide");
    });

    $("#btnNewProvince").on("click", function (e) {
        e.preventDefault();

        clearProvinceForm();

        $("#provinceModal").find(".modal-title").text("Add Province");
        $("#provinceModal").modal("show");
    });

    $("#tblProvince").on("click", ".btnEdit", function () {
        let row = $(this).closest("tr");

        if (row.hasClass("child")) {
            row = row.prev();
        }

        const selectedRow = $("#tblProvince").DataTable().row(row).data();

        if (!selectedRow) {
            ShowToastError("Cannot get selected province data.");
            return;
        }

        $("#province_ProvinceId").val(selectedRow.provinceId);
        $("#province_ProvinceName").val(selectedRow.provinceName);
        $("#province_ProvinceInKhmer").val(selectedRow.provinceInKhmer);

        const isCity = selectedRow.isCity === 1 || selectedRow.isCity === true;
        $("#chkIsCity").prop("checked", isCity);
        $("#province_IsCity").val(isCity ? 1 : 0);

        $("#provinceModal").find(".modal-title").text("Edit Province");
        $("#provinceModal").modal("show");
    });

    $("#formProvince").on("submit", function (e) {
        e.preventDefault();

        $("#province_IsCity").val($("#chkIsCity").is(":checked") ? 1 : 0);

        const formData = $("#formProvince").serialize();

        $.ajax({
            url: "/Province/SaveChange",
            method: "POST",
            data: formData,
            success: function (response) {
                const code = response.status?.code;
                const message = response.status?.message;

                if (code === "200" || code === 200) {
                    ShowToastSuccess(message || "Saved successfully!");
                    clearProvinceForm();
                    $("#provinceModal").modal("hide");
                    $("#tblProvince").DataTable().ajax.reload();
                } else {
                    ShowToastError(message || "Save failed.");
                }
            },
            error: function (xhr) {
                const message =
                    xhr["responseJSON"]?.["status"]?.["message"] ||
                    xhr["responseJSON"]?.["message"] ||
                    "Server error.";

                ShowToastError(message);
            }
        });
    });
</script>