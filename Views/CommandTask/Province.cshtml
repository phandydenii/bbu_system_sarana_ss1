@{
    ViewData["OpenMenu"] = "CommandTask";
    ViewData["Action"] = "Province";
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Province</h3>
                <button type="submit" class="btn btn-success btn-sm float-right" data-toggle="modal"
                        data-target="#ProvinceModal">
                    <i class="fas fa-plus"></i>
                    Add New
                </button>

            </div>
            <div class="card-body">
                <table id="tblProvince" class="table table-sm table-bordered table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Name Khmer</th>
                        <th>City</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_ProvinceModal"/>

@section Scripts{
    <script src="~/function/Province.js"></script>
    <script>
        const tblProvince = $("#tblProvince");

        $(document).ready(function () {
            fetchProvince();
        });

        function fetchProvince() {
            tblProvince.DataTable().clear().destroy();
            tblProvince.DataTable({
                paging: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                responsive: true,
                processing: true,
                serverSide: true,
                order:[[0, "desc"]],
                ajax: {
                    url: "/Province/get-provinces",
                    type: "POST"
                },
                columns: [
                    {data: "provinceId"},
                    {data: "provinceName"},
                    {data: "provinceInKhmer"},
                    {
                        data: "isCity",
                        render: function (data) {
                            return data === 1 ? "Yes" : "No";
                        }
                    },
                    {
                        data: null,
                        render: function () {
                            return `
                        <a id="btnEdit" class="btn btn-success btn-sm">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                    `;
                        }
                    }
                ],
                initComplete: function () {
                    MyApp.utils.dataTableDebounceSearch("#tblProvince", 500);
                }
            });
        }

        $(document).on("click", "#btnClose", function (e) {
            e.preventDefault();
            $("#provinceForm")[0].reset();
            $("#ProvinceModal").modal("hide");
        });


        tblProvince.on("click", "#btnEdit", function (e) {
            e.preventDefault();
            let $row = $(this).closest('tr');
            if ($row.hasClass('child')) {
                $row = $row.prev();
            }
            const selectedRow = tblProvince.DataTable().row($row).data();

            const province = new Province(selectedRow);
            $("#ProvinceId").val(province.provinceId);
            $("#ProvinceName").val(province.provinceName);
            $("#ProvinceInKhmer").val(province.provinceInKhmer);
            $("#chkIsCity").prop("checked", province.isCity === 1);
            $("#isCity").val(province.isCity);
            $("#ProvinceModal").modal("show");
        });

        $("#provinceForm").on("submit", function (e) {
            e.preventDefault();

            $("#isCity").val($("#chkIsCity").is(":checked") ? 1 : 0);

            const form = $(this);
            const formData = $(form).serialize();
            console.log(formData);
            $.ajax({
                url: "/Province/SaveChange",
                method: "POST",
                data: formData,
                success: function (response) {
                    if (response.status.code === "200") {
                        ShowToastSuccess("Saved successfully!");
                        $("#provinceForm")[0].reset();
                        $("#ProvinceModal").modal("hide");
                        $("#tblProvince").DataTable().ajax.reload();
                    } else {
                        ShowToastError(response.message);
                    }
                },
                error: function (error) {
                    if (error.responseJSON && error.responseJSON.message) {
                        ShowToastError(error.responseJSON.message);
                    }
                }
            });
        });
    </script>
}
