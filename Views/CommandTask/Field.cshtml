@{
    ViewData["OpenMenu"] = "CommandTask";
    ViewData["Action"] = "Field"; 
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <div class="row">
                    <div class="col-6">
                        <label>Degrees</label>
                        <div class="margin" id="rangeButtons">
                            <button type="button"
                                    class="btn btn-primary"
                                    onclick="setActive(this)"
                                    value="0">
                                All
                            </button>
                        </div>
                        @* <label>Degree</label> *@
                        @* <div class="margin" id="rangeButtons"> *@
                        @*     <button type="button" class="btn btn-primary" onclick="setActive(this)" value="0">All *@
                        @*     </button> *@
                        @* </div> *@
                    </div>
                    <div class="col-4">
                        <label>School</label>
                        <select id="cboSchool" class="form-control select2"></select>
                    </div>
                    <div class="col-2">
                        <label>#</label>
                        <button type="button" id="btnAddNew"
                                class="form-control btn btn-primary float-right">Add New
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <table id="tblField" class="table table-sm table-bordered table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Name Khmer</th> 
                        <th>Degree Name</th>
                        <th>Degree Name Khmer</th>
                        <th>Type</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_FieldModal"/>

@section Scripts{
    <script src="~/function/Degree.js"></script>
    <script src="~/function/School.js"></script>
    <script src="~/function/Field.js"></script>
    <script src="~/function/Promotion.js"></script>
    <script src="~/function/Stage.js"></script>
    <script src="~/function/Term.js"></script>
    <script src="~/function/Group.js"></script>
  <script>
    const tblField = $("#tblField");
    const cboSchool = $("#cboSchool");
    const modalField = $("#modalField");
    const formField = $("#formField");

    let fieldTable = null;
    let selectedDegreeId = 0;
    let selectedSchoolId = 0;

    let schoolList = [];
    let degreeList = [];

    $(document).ready(function () {
        initFieldTable();
        loadFieldPageData();

        $("#btnAddNew").on("click", function (event) {
            event.preventDefault();
            openAddField();
        });

        cboSchool.on("change", function () {
            selectedSchoolId = cboSchool.val() || 0;
            reloadFieldTable();
        });

        tblField.on("click", ".btnEditField", function (event) {
            event.preventDefault();
            openEditField(this);
        });

        $("#rdoAcademic").on("change", function (event) {
            $("#field_Type").prop("checked", event.target.checked);
        });

        $("#rdoProffesional").on("change", function (event) {
            $("#field_Type").prop("checked", !event.target.checked);
        });

        $(document).on("submit", "#formField", function (event) {
            event.preventDefault();
            saveField();
        });
    });

    function loadFieldPageData() {
        $.ajax({
            url: "/Field/get-field-page-data",
            type: "POST",
            success: function (response) {
                const data = response["data"];

                schoolList = data["schools"] || [];
                degreeList = data["degrees"] || [];

                bindDegreeButtons();
                bindFilterSchoolDropdown();
                bindModalSchoolDropdown();
                bindModalDegreeDropdown();

                setDefaultAllButton();
            },
            error: function () {
                ShowToastError("Cannot load school and degree data.");
            }
        });
    }

    function bindDegreeButtons() {
        const container = $("#rangeButtons");

        container.empty();

        container.append(
            '<button type="button" ' +
            'class="btn btn-primary" ' +
            'onclick="setActive(this)" ' +
            'value="0">All</button>'
        );

        degreeList.forEach(function (item) {
            container.append(
                '<button type="button" ' +
                'class="btn btn-outline-primary" ' +
                'onclick="setActive(this)" ' +
                'value="' + item["degreeId"] + '">' +
                item["degreeName"] +
                '</button>'
            );
        });
    }

    function setDefaultAllButton() {
        const allButton = $("#rangeButtons button[value='0']");

        $("#rangeButtons button")
            .removeClass("btn-primary")
            .addClass("btn-outline-primary");

        allButton
            .removeClass("btn-outline-primary")
            .addClass("btn-primary");

        selectedDegreeId = 0;
        selectedSchoolId = 0;
    }

    function setActive(button) {
        $("#rangeButtons button")
            .removeClass("btn-primary")
            .addClass("btn-outline-primary");

        $(button)
            .removeClass("btn-outline-primary")
            .addClass("btn-primary");

        selectedDegreeId = parseInt($(button).val()) || 0;
        selectedSchoolId = cboSchool.val() || 0;

        reloadFieldTable();
    }

    function bindFilterSchoolDropdown() {
        cboSchool.empty();
        cboSchool.append("<option value=''>Select School</option>");

        schoolList.forEach(function (item) {
            cboSchool.append(
                "<option value='" + item["schoolId"] + "'>" +
                item["schoolName"] +
                "</option>"
            );
        });

        cboSchool.val("");
    }

    function bindModalSchoolDropdown() {
        const cboSchoolModal = $("#field_SchoolId");

        cboSchoolModal.empty();
        cboSchoolModal.append("<option value=''>Select School</option>");

        schoolList.forEach(function (item) {
            cboSchoolModal.append(
                "<option value='" + item["schoolId"] + "'>" +
                item["schoolName"] +
                "</option>"
            );
        });

        cboSchoolModal.val("");
    }

    function bindModalDegreeDropdown() {
        const cboDegree = $("#field_DegreeId");

        cboDegree.empty();
        cboDegree.append("<option value=''>Select Degree</option>");

        degreeList.forEach(function (item) {
            cboDegree.append(
                "<option value='" + item["degreeId"] + "'>" +
                item["degreeName"] +
                "</option>"
            );
        });

        cboDegree.val("");
    }

    function initFieldTable() {
        fieldTable = tblField.DataTable({
            paging: true,
            lengthChange: true,
            searching: true,
            ordering: true,
            info: true,
            responsive: true,
            processing: true,
            serverSide: true,
            ajax: {
                url: "/Field/get-fields",
                type: "POST",
                data: function (d) {
                    d.degreeId = selectedDegreeId || 0;
                    d.schoolId = selectedSchoolId || 0;
                }
            },
            columns: [
                { data: "fieldId" },
                { data: "fieldName" },
                { data: "fieldNameInKhmer" },
                { data: "degreeName" },
                { data: "degreeNameInKhmer" },
                {
                    data: "type",
                    render: function (data) {
                        return data
                            ? '<span class="badge badge-info">ACADEMIC</span>'
                            : '<span class="badge badge-warning">PROFESSIONAL</span>';
                    }
                },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function () {
                        return `
                            <button type="button" class="btn btn-success btn-sm btnEditField">
                                <i class="fas fa-edit"></i> Edit
                            </button>
                        `;
                    }
                }
            ]
        });
    }

    function reloadFieldTable() {
        if (fieldTable) {
            fieldTable.ajax.reload();
        }
    }

    function openAddField() {
        modalField.find(".modal-title").text("Add Field");

        formField[0].reset();

        bindModalDegreeDropdown();
        bindModalSchoolDropdown();

        $("#field_FieldId").val(0);
        $("#field_DegreeId").val("");
        $("#field_SchoolId").val("");
        $("#field_Type").prop("checked", false);
        $("#rdoAcademic").prop("checked", false);
        $("#rdoProffesional").prop("checked", true);

        modalField.modal("show");
    }

    function openEditField(button) {
        let rowElement = $(button).closest("tr");

        if (rowElement.hasClass("child")) {
            rowElement = rowElement.prev();
        }

        const row = fieldTable.row(rowElement).data();

        if (!row) {
            ShowToastError("Cannot get selected field data.");
            return;
        }

        bindModalDegreeDropdown();
        bindModalSchoolDropdown();

        $("#field_FieldId").val(row["fieldId"]);
        $("#field_DegreeId").val(row["degreeId"]);
        $("#field_SchoolId").val(row["schoolId"]);

        $("#field_DegreeName").val(row["degreeName"] || "");
        $("#field_DegreeNameInKhmer").val(row["degreeNameInKhmer"] || "");

        $("#field_FieldName").val(row["fieldName"] || "");
        $("#field_FieldNameInKhmer").val(row["fieldNameInKhmer"] || "");

        const isAcademic = row["type"] === true || row["type"] === 1 || row["type"] === "true";

        $("#field_Type").prop("checked", isAcademic);
        $("#rdoAcademic").prop("checked", isAcademic);
        $("#rdoProffesional").prop("checked", !isAcademic);

        modalField.find(".modal-title").text("Edit Field");
        modalField.modal("show");
    }

    function saveField() {
        
        $("#field_Type").val($("#rdoAcademic").is(":checked") ? "true" : "false");

        const formData = formField.serialize();
        const fieldId = $("#field_FieldId").val();

        $.ajax({
            url: "/Field/save-change",
            type: "POST",
            data: formData,
            success: function (response) {
                const code = response.status?.code;
                const message = response.status?.message;

                if (code === "200" || code === 200) {
                    ShowToastSuccess(
                        message ||
                        (fieldId && fieldId !== "0"
                            ? "Updated successfully!"
                            : "Saved successfully!")
                    );

                    formField[0].reset();
                    $("#field_FieldId").val(0);
                    modalField.modal("hide");
                    reloadFieldTable();
                } else {
                    ShowToastError(message || "Save failed.");
                }
            },
            error: function () {
                ShowToastError("Server error.");
            }
        });
    }
</script>
}