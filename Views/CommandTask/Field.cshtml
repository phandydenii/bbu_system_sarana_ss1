@{
    ViewData["OpenMenu"] = "CommandTask";
    ViewData["Action"] = "Field"; 
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <div class="row">
                    <div class="col-6">
                        <label>Degree</label>
                        <div class="margin" id="rangeButtons">
                            <button type="button" class="btn btn-primary" onclick="setActive(this)" value="0">All
                            </button> 
                        </div>
                    </div>
                    <div class="col-4">
                        <label>School</label>
                        <select id="cboSchool" class="form-control select2"></select>
                    </div>
                    <div class="col-2">
                        <label>#</label>
                        <button type="button" id="btnAddNew"
                                class="form-control btn btn-primary float-right">Add New
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <table id="tblField" class="table table-sm table-bordered table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Name Khmer</th> 
                        <th>Degree Name</th>
                        <th>Degree Name Khmer</th>
                        <th>Type</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_FieldModal"/>

@section Scripts{
    <script src="~/function/Degree.js"></script>
    <script src="~/function/School.js"></script>
    <script src="~/function/Field.js"></script>
    <script src="~/function/Promotion.js"></script>
    <script src="~/function/Stage.js"></script>
    <script src="~/function/Term.js"></script>
    <script src="~/function/Group.js"></script>
    <script>
        const tblField = $("#tblField");
        const cboSchool = $("#cboSchool");
        const modalField = $("#modalField");
        const formField = $("#formField");
        const degrees = [
            {DegreeId: 1, DegreeName: "Associate"},
            {DegreeId: 2, DegreeName: "Bachelor"},
            {DegreeId: 3, DegreeName: "Diploma"},
            {DegreeId: 4, DegreeName: "Master"},
            {DegreeId: 5, DegreeName: "Doctor"},
        ];
        
        $(document).ready(function () {
            const container = document.getElementById("rangeButtons");
            container.classList.add("margin");
            degrees.forEach(function (degree) {
                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = "btn btn-outline-primary";
                btn.value = degree.DegreeId;
                btn.innerText = degree.DegreeName;
                btn.onclick = function () {
                    setActive(this);
                };
                container.appendChild(btn);
            });
            GetSchool();
            fetchField(0,0);

            GetDegree();
            GetSchool1();
        });
        async function GetSchool() {
            cboSchool.empty();
            cboSchool.append("<option value='' disabled>Select School</option>");
            const schools = await School.GetSchool()
            schools.forEach(function (item) {
                cboSchool.append(`<option value='${item.schoolId}'>${item.schoolName}</option>`);
            });
            cboSchool.val('').trigger("change");
        }
        function setActive(button) {
            const buttons = document.querySelectorAll('#rangeButtons .btn-primary');
            buttons.forEach(btn => btn.classList.remove('btn-primary'));
            buttons.forEach(btn => btn.classList.add('btn-outline-primary'));
            button.classList.remove("btn-outline-primary");
            button.classList.add("btn-primary");
            console.log(parseInt(button.value));
            if (parseInt(button.value) === 0) {
                cboSchool.val(0)
                fetchField(button.value, 0);
            } else {
                const school_id = cboSchool.val();
                fetchField(button.value, school_id);
            }
        }

        cboSchool.on("change", function (event) {
            const degree_id = $('#rangeButtons .btn-primary').val();
            const school_id = cboSchool.val();
            fetchField(degree_id, school_id);
        });

        function fetchField(degreeId, schoolId) {
            tblField.DataTable().clear().destroy();
            tblField.DataTable({
                paging: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                responsive: true,
                processing: true,
                serverSide: true,
                ajax: {
                    url: "/Field/get-fields",
                    type: "POST",
                    data: function (d) {
                        d.degreeId = degreeId;
                        d.schoolId = schoolId;
                    },
                },
                columns: [
                    {data: "fieldId"},
                    {data: "fieldName"},
                    {data: "fieldNameInKhmer"},
                    {data: "degreeName"},
                    {data: "degreeNameInKhmer"},
                    {
                        data: "type",
                        render: function (data, type, row) {
                            return data ? `<span class="badge badge-info">ACADEMIC</span>` : `<span class="badge badge-warning">PROFESSIONAL</span>`;
                        }
                    },
                    {
                        data: null,
                        render: function (data, type, row) { 
                            return `<a id="btnEdit" class="btn btn-success btn-sm"><i class="fas fa-edit"></i> Edit</a>`;
                        }
                    }
                ]
            });
        }

        document.getElementById("btnAddNew").addEventListener("click", function (event) {
            event.preventDefault();

            GetDegree();
            GetSchool1();

            modalField.find(".modal-title").text("Add Field");

            formField[0].reset();

            $("#field_FieldId").val(0);
            $("#field_DegreeId").val("").trigger("change");
            $("#field_SchoolId").val("").trigger("change");
            $("#field_Type").prop("checked", false);
            $("#rdoAcademic").prop("checked", false);
            $("#rdoProffesional").prop("checked", true);

            modalField.modal("show");
        });

        tblField.on("click", "#btnEdit", function (event) {
            event.preventDefault();

            let $row = $(this).closest("tr");

            if ($row.hasClass("child")) {
                $row = $row.prev();
            }

            const row = tblField.DataTable().row($row).data();

            console.log("Selected Field:", row);

            if (!row) {
                ShowToastError("Cannot get selected field data.");
                return;
            }

            $("#field_FieldId").val(row.fieldId);
            $("#field_DegreeId").val(row.degreeId).trigger("change");
            $("#field_SchoolId").val(row.schoolId).trigger("change");

            $("#field_DegreeName").val(row.degreeName || "");
            $("#field_DegreeNameInKhmer").val(row.degreeNameInKhmer || "");

            $("#field_FieldName").val(row.fieldName || "");
            $("#field_FieldNameInKhmer").val(row.fieldNameInKhmer || "");

            const isAcademic = row.type === true || row.type === 1 || row.type === "true";

            $("#field_Type").prop("checked", isAcademic);
            $("#rdoAcademic").prop("checked", isAcademic);
            $("#rdoProffesional").prop("checked", !isAcademic);

            modalField.find(".modal-title").text("Edit Field");
            modalField.modal("show");
        });
        async function GetDegree() {
            const cboDegree = $("#field_DegreeId")
            cboDegree.empty();
            cboDegree.append(`<option value='' disabled>Select Degree</option>`);
            const degrees = await Degree.GetAllDegree();
            degrees.forEach(item => {
                cboDegree.append(`<option value='${item.degreeId}'>${item.degreeName}</option>`);
            });
            cboDegree.val('').trigger("change");
        }

        async function GetSchool1() {
            const cboSchool = $("#field_SchoolId")
            cboSchool.empty();
            cboSchool.append("<option value='' disabled>Select School</option>");
            const schools = await School.GetSchool()
            schools.forEach(function (item) {
                cboSchool.append(`<option value='${item.schoolId}'>${item.schoolName}</option>`);
            });
            cboSchool.val('').trigger("change");
        }

        $("#rdoAcademic").on("change", function (event) {
            $("#field_Type").prop("checked", event.target.checked);
        });

        $("#rdoProffesional").on("change", function (event) {
            $("#field_Type").prop("checked", !event.target.checked);
        });

        $(document).on("submit", "#formField", function (event) {
            event.preventDefault();

            const degreeId = $("#field_DegreeId").val();
            const schoolId = $("#field_SchoolId").val();
            const fieldName = ($("#field_FieldName").val() || "").trim();
            const fieldNameKhmer = ($("#field_FieldNameInKhmer").val() || "").trim();
            const degreeName = ($("#field_DegreeName").val() || "").trim();
            const degreeNameKhmer = ($("#field_DegreeNameInKhmer").val() || "").trim();

            if (!degreeId || degreeId === "") {
                ShowToastError("Degree is required.");
                return;
            }

            if (!schoolId || schoolId === "") {
                ShowToastError("School is required.");
                return;
            }

            if (fieldName === "") {
                ShowToastError("Field name is required.");
                return;
            }

            if (fieldNameKhmer === "") {
                ShowToastError("Field name in Khmer is required.");
                return;
            }

            if (degreeName === "") {
                ShowToastError("Degree name is required.");
                return;
            }

            if (degreeNameKhmer === "") {
                ShowToastError("Degree name in Khmer is required.");
                return;
            }

            $("#field_Type").val($("#rdoAcademic").is(":checked") ? "true" : "false");

            const formData = $(this).serialize();
            const fieldId = $("#field_FieldId").val();

            $.ajax({
                url: "/Field/save-change",
                method: "POST",
                data: formData,
                success: function (response) {
                    const code = response.code || response.status?.code;
                    const message = response.message || response.status?.message;

                    if (code === "200" || code === 200) {
                        ShowToastSuccess(message || (fieldId && fieldId !== "0"
                            ? "Updated successfully!"
                            : "Saved successfully!"));

                        $("#formField")[0].reset();
                        $("#field_FieldId").val(0);
                        $("#modalField").modal("hide");
                        $("#tblField").DataTable().ajax.reload(null, false);
                    } else {
                        ShowToastError(message || "Save failed.");
                    }
                },
                error: function (error) {
                    ShowToastError(
                        error.responseJSON?.message ||
                        error.responseJSON?.status?.message ||
                        error.responseText ||
                        "Server error."
                    );
                }
            });
        });
    </script>
}