@using BBU_SYSTEM.DTOs
@{
    var faculty = new FacultyDto();
}

<div class="modal fade" id="FacultyModal" data-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h4 class="modal-title">Faculty</h4>
                <button type="button" class="close" data-dismiss="modal">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <form id="facultyForm">
                    <input asp-for="@faculty.FacultyId" hidden readonly class="form-control" value="0" />

                    <div class="form-group">
                        <label class="required">Faculty Name</label>
                        <input type="text" asp-for="@faculty.FacultyName" class="form-control"
                               placeholder="Enter faculty name" required>
                    </div>

                    <div class="form-group">
                        <label class="required">Faculty Name Khmer</label>
                        <input type="text" asp-for="@faculty.FacultyNameInKhmer" class="form-control"
                               placeholder="Enter faculty name khmer" required>
                    </div>
                </form>
            </div>

            <div class="modal-footer justify-content-between">
                <button type="submit" form="facultyForm" class="btn btn-primary">
                    <i class="fas fa-save"></i>
                    Save changes
                </button>

                <button type="button" class="btn btn-danger" id="btnClose">
                    <i class="fas fa-close"></i>
                    Close
                </button>
            </div>

        </div>
    </div>
</div>