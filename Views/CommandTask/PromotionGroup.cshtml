@model Dictionary<int, string>
@{
    ViewData["OpenMenu"] = "CommandTask";
    ViewData["Action"] = "PromotionGroup";  
    var degrees = Model;
}

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <!--------------------------------- header filter --------------------------------->
                <div class="row">
                    <div class="col-6">
                        <label>Degree</label>
                        <div id="rangeButtons"> 
                            @foreach (var data in degrees)
                            {
                                <button class="btn btn-outline-primary" value="@data.Key">@data.Value</button>
                            }
                        </div>
                    </div>
                    <div class="col-6">
                        <label>School</label>
                        <select id="cboSchool" onchange="SchoolChange()" class="form-control select2"></select>
                    </div>
                </div>
                <br/> 
                <!--------------------------------- table display content --------------------------------->
                <div class="row">
                    <!--------------------------------- promotion section --------------------------------->
                    <div class="col-md-4">
                        <div class="card card-outline card-primary">
                            <div class="card-header d-flex p-0">
                                <h3 class="card-title p-3">Promotion</h3>
                                <ul class="nav nav-pills ml-auto p-2">
                                    <li class="nav-item dropdown" id="btnPromotion">
                                        <a class="btn btn-default dropdown-toggle btn-sm" data-toggle="dropdown" type="button"
                                           href="#" aria-expanded="false">
                                            <i class="fa-solid fa-gear"></i><span class="caret"></span>
                                        </a>
                                        <div class="dropdown-menu" style="min-width: 8rem;">
                                            <div class="col-md-12">
                                                <a id="btnNewPromotion" class="btn btn-primary btn-sm"
                                                   style="display: block;margin:.2rem 0"><i class="fas fa-plus"></i>
                                                    New</a>
                                                <a id="btnEditPromotion" class="btn btn-success btn-sm"
                                                   style="display: block;margin:.2rem 0">
                                                    <i
                                                        class="fa-solid fa-edit"></i> Edit</a>
                                                <a class="btn btn-danger btn-sm"
                                                   style="display: block;margin:.2rem 0">
                                                    <i
                                                        class="fa-solid fa-trash"></i> Delete</a>
                                            </div>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                            <div>
                                <div class="card-body table-responsive p-0" style="height: 500px;">
                                    <table id="tblPromotion"
                                           class="table table-sm table-bordered table-hover dataTable dtr-inline"
                                           style="width: 100%;">
                                        <thead>
                                        <tr>
                                            <th>id</th>
                                            <th>no</th>
                                            <th>start_date</th>
                                            <th>end_date</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--------------------------------- stage section ---------------------------------> 
                    <div class="col-md-2">
                        <div class="card card-outline card-success">
                            <div class="card-header d-flex p-0">
                                <h3 class="card-title p-3">Stage</h3>
                                <ul class="nav nav-pills ml-auto p-2">
                                    <li class="nav-item dropdown">
                                        <a class="btn btn-default dropdown-toggle btn-sm" data-toggle="dropdown"
                                           href="#" aria-expanded="false">
                                            <i class="fa-solid fa-gear"></i><span class="caret"></span>
                                        </a>
                                        <div class="dropdown-menu" style="min-width: 6rem;">
                                            <div class="col-md-12">
                                                <a id="btnNewStage" class="btn btn-primary btn-sm"
                                                   style="display: block;margin:.2rem 0"><i class="fas fa-plus"></i>
                                                    New</a>
                                                <a id="btnEditStage" class="btn btn-success btn-sm"
                                                   style="display: block;margin:.2rem 0">
                                                    <i class="fas fa-edit"></i>
                                                    Edit
                                                </a>
                                                <a id="btnDeleteStage" class="btn btn-danger btn-sm"
                                                   style="display: block;margin:.2rem 0">
                                                    <i class="fa-solid fa-trash"></i> Delete</a>
                                            </div>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                            <div>
                                <div class="card-body table-responsive p-0" style="height: 500px;">
                                    <table id="tblStage"
                                           class="table table-sm table-bordered table-hover dataTable dtr-inline"
                                           style="width: 100%;">
                                        <thead>
                                        <tr>
                                            <th>id</th>
                                            <th>no</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--------------------------------- term section ---------------------------------> 
                    <div class="col-md-2">
                        <div class="card card-outline card-warning">
                            <div class="card-header d-flex p-0">
                                <h3 class="card-title p-3">Term</h3>
                                <ul class="nav nav-pills ml-auto p-2">
                                    <li class="nav-item dropdown">
                                        <a class="btn btn-default dropdown-toggle btn-sm" data-toggle="dropdown"
                                           href="#" aria-expanded="false">
                                            <i class="fa-solid fa-gear"></i><span class="caret"></span>
                                        </a>
                                        <div class="dropdown-menu" style="min-width: 10rem">
                                            <div class="col-md-12">
                                                <a onclick="OnPromoteNew()" class="btn btn-success btn-sm"
                                                   style="display: block;margin:.2rem 0"><i class="fas fa-plus"></i>
                                                    Promote / New</a>
                                                <a onclick="OnEditTerm()" class="btn btn-warning btn-sm"
                                                   style="display: block;margin:.2rem 0"><i class="fas fa-edit"></i>
                                                    Edit</a>
                                                <a onclick="DeleteTerm()" class="btn btn-danger btn-sm"
                                                   style="display: block;margin:.2rem 0">
                                                    <i class="fa-solid fa-trash"></i> Delete</a>
                                            </div>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                            <div>
                                <div class="card-body table-responsive p-0" style="height: 500px;">
                                    <table id="tblTerm"
                                           class="table table-sm table-bordered table-hover dataTable dtr-inline"
                                           style="width: 100%;">
                                        <thead>
                                        <tr>
                                            <th>id</th>
                                            <th>no</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>

                            </div>
                        </div>
                    </div>
                    <!--------------------------------- group section ---------------------------------> 
                    <div class="col-md-4">
                        <div class="card card-outline card-danger">
                            <div class="card-header d-flex p-0">
                                <h3 class="card-title p-3">Group</h3>
                                <ul class="nav nav-pills ml-auto p-2">
                                    <li class="nav-item dropdown">
                                        <a class="btn btn-default dropdown-toggle btn-sm" data-toggle="dropdown"
                                           href="#" aria-expanded="false">
                                            <i class="fa-solid fa-gear"></i><span class="caret"></span>
                                        </a>
                                        <div class="dropdown-menu dropdown-menu-right" style="min-width: 8rem;">
                                            <div class="col-md-12">
                                                <a id="btnNewGroup" class="btn btn-success btn-sm"
                                                   style="display: block;margin:.2rem 0"><i class="fas fa-plus"></i>
                                                    New</a>
                                                <a id="btnEditGroup" class="btn btn-warning btn-sm"
                                                   style="display: block;margin:.2rem 0"><i class="fas fa-edit"></i>
                                                    Edit</a>
                                                <a onclick="OnTransfer()" class="btn btn-info btn-sm"
                                                   style="display: block;margin:.2rem 0">
                                                    <i class="fas fa-exchange"></i> 
                                                    Transfer
                                                </a>
                                                <a class="btn btn-danger btn-sm"
                                                   style="display: block;margin:.2rem 0">
                                                    <i class="fa-solid fa-trash"></i>Delete</a>
                                            </div>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                            <div>
                                <div class="card-body table-responsive p-0" style="height: 500px;">
                                    <table id="tblGroup"
                                           class="table table-sm table-bordered table-hover dataTable dtr-inline"
                                           style="width: 100%;">
                                        <thead>
                                        <tr>
                                            <th>id</th>
                                            <th>name</th>
                                            <th>study time</th>
                                            <th>start_pay</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="/AdminLTE/plugins/jquery/jquery.min.js"></script>
<script src="/AdminLTE/plugins/datatables/jquery.dataTables.min.js"></script>
<partial name="_SettingModal"/>
<partial name="_TermModal"/>
<partial name="_GroupModal"/>
<partial name="_TransferModal"/>
<partial name="_StageModal"/>
<partial name="_PromotionModal"/>

@section Scripts
{
    <script src="~/function/Degree.js"></script>
    <script src="~/function/School.js"></script>
    <script src="~/function/Field.js"></script>
    <script src="~/function/Promotion.js"></script>
    <script src="~/function/Stage.js"></script>
    <script src="~/function/Term.js"></script>
    <script src="~/function/Group.js"></script>
    <script>
        const cboSchool = $("#cboSchool");
        const cboField = $("#group_FieldId");
        const btnEditGroup = $("#btnEditGroup");
        const cboStudyTime = $("#group_StudyTime");
        const btnNewGroup = $("#btnNewGroup");
        const cboRoom = $("#groupRoom_RoomName");
        const btnDegrees = $('#rangeButtons'); 
        
        $(document).ready(() => {
            GetSchool();
        });
        async function GetSchool() {
            cboSchool.empty();
            cboSchool.append("<option value='' disabled>Select School</option>");
            const schools = await School.GetSchool()
            schools.forEach(function (item) {
                cboSchool.append(`<option value='${item.schoolId}'>${item.schoolName}</option>`);
            });
            cboSchool.val('').trigger("change");
        } 
        btnDegrees.on("click", "button", function (e) {
            // remove active style from all buttons
            btnDegrees.find("button").removeClass("btn-primary").addClass("btn-outline-primary");
            // add active style to clicked button
            $(this).removeClass("btn-outline-primary").addClass("btn-primary");
            if(cboSchool.val() !== ""){
                fetchPromotion();
            }
        }); 
        function SchoolChange() {
            fetchPromotion(); 
         }  
        //#region =====Promotion====
        const tblPromotion = $("#tblPromotion");
        const modalPromotion = $("#modalPromotion");
        const formPromotion = $("#formPromotion");
        const promotionAcademicYearStart = $("#promotion_AcademicYearStart"); 
        function fetchPromotion() {
            const degreeId = $('#rangeButtons button.btn-primary').val();
            const schoolId = cboSchool.val();
            tblPromotion.DataTable().clear().destroy();
            if(!degreeId || !schoolId){
                tblPromotion.DataTable({
                    paging: true,
                    lengthChange: false,
                    searching: false,
                    ordering: true,
                    info: false,
                    responsive: true,
                    autoWidth: true, 
                });
                return;
            }
            tblPromotion.DataTable({
                paging: true,
                lengthChange: false,
                searching: false,
                ordering: true,
                info: false,
                responsive: true,
                autoWidth: true,
                processing: true,
                serverSide: true,
                ajax: {
                    url: "/Promotion/get-promotions",
                    type: "POST",
                    data: function (d) {
                        d.degreeId = degreeId;
                        d.schoolId = schoolId;
                    },
                },
                columns: [
                    {data: "promotionId"},
                    {data: "promotionNo"},
                    {data: "academicYearStart"},
                    {data: "academicYearEnd"}
                ],
                order: [[0, 'desc']]
            });
        } 
        tblPromotion.on('click', 'tbody tr', function () {
            tblPromotion.find('tbody tr').removeClass('highlight');
            $(this).addClass('highlight');
            fetchStage();
            tblTerm.DataTable().clear().destroy();
            tblGroup.DataTable().clear().destroy(); 
        }); 
        $("#btnNewPromotion").on("click",async function () {
            const lastPromotion =await fetchLastPromotion();
            $("#promotion_PromotionNo").val(lastPromotion.promotionNo + 1);
            $("#promotion_AcademicYearStart").val(lastPromotion.academicYearStart + 1);
            $("#promotion_AcademicYearEnd").val(lastPromotion.academicYearStart + 1 + 4);
            modalPromotion.modal("show");
        });
        async function fetchLastPromotion() {
            try {
                const response = await $.ajax({
                    url: "/promotion/get-last-promotion",
                    method: "POST", 
                });
                if (response.status.code === "200") {
                    return response.data;
                }
            }catch(error) {
                ShowToastError(error.responseText);
            }
        }
        promotionAcademicYearStart.on("click", function (e) {
            $("#promotion_AcademicYearEnd").val(new Date(e.target.value).getFullYear() + 4);
        });
        $("#ClosePromotion").on("click", function () {
            formPromotion[0].reset();
            modalPromotion.modal("hide");
        })
        $("#btnEditPromotion").on("click", function (event) {
            const $row = tblPromotion.find('tbody tr.highlight'); // select highlighted row
            const selectedRow = tblPromotion.DataTable().row($row).data();
            if (selectedRow) {
                $("#promotion_DegreeId").val(selectedRow.degreeId);
                $("#promotion_SchoolId").val(selectedRow.schoolId);
                $("#promotion_PromotionId").val(selectedRow.promotionId);
                $("#promotion_PromotionNo").val(selectedRow.promotionNo);
                promotionAcademicYearStart.val(selectedRow.academicYearStart);
                $("#promotion_AcademicYearEnd").val(selectedRow.academicYearEnd);
                $("#promotion_GraduateDate1").val(new Date(selectedRow.graduateDate1).toISOString().split('T')[0]);
                $("#promotion_GraduateDate2").val(new Date(selectedRow.graduateDate2).toISOString().split('T')[0]);
                modalPromotion.modal("show");
                fetchStage();
                fetchTerm();
                fetchGroup();
            }
        });
        formPromotion.on("submit", function (e) {
            e.preventDefault();
            const form = $(this);
            const formData = form.serialize();
            $.ajax({
                url: '/promotion/save-change',
                method: 'POST',
                data: formData,
                success: function (response) { 
                    if (response.status.code === "200") {
                        ShowToastSuccess("Saved successfully!");
                        formPromotion[0].reset();
                        modalPromotion.modal("hide");
                        tblPromotion.DataTable().ajax.reload();
                    } else {
                        ShowToastError(response.status.message); 
                    }
                },
                error: function (error) {
                    ShowToastError(error.responseText); 
                }
            });  
        })
        //#endregion ====Promotion====

        //#region ==Stage==
        const tblStage = $("#tblStage");
        const formStage = $("#formStage");
        const modalStage = $("#modalStage");
        function fetchStage() {
            const $row = tblPromotion.find('tbody tr.highlight');
            const promotion = tblPromotion.DataTable().row($row).data();
            tblStage.DataTable().clear().destroy();
            if (!promotion){
                tblStage.DataTable({
                    paging: false,
                    lengthChange: false,
                    searching: false,
                    ordering: true,
                    info: false,
                    responsive: true,
                    autoWidth: true, 
                });
                return;
            }
            tblStage.DataTable({
                paging: false,
                lengthChange: false,
                searching: false,
                ordering: true,
                info: false,
                responsive: true,
                autoWidth: true,
                processing: true,
                serverSide: true,
                ajax: {
                    url: "/stage/get-stages",
                    type: "POST",
                    data: function (d) {
                        d.promotionId = promotion.promotionId;
                    },
                    error: function (xhr) {
                        console.error(xhr.responseText);
                        ShowToastError(xhr.responseText);
                    }
                },
                columns: [
                    {data: "stageId"},
                    {data: "stageNo"},
                ]
            })
        } 
        tblStage.on("click", "tbody tr", function () {
             $('#tblStage tbody tr').removeClass('highlight');
            $(this).addClass('highlight'); 
            fetchTerm();
            tblGroup.DataTable().clear().destroy();
         });
        $("#btnNewStage").on("click", function () {
            const $rowPro = tblPromotion.find('tbody tr.highlight');
            const promotion = tblPromotion.DataTable().row($rowPro).data();
            const $rowSt = tblStage.find('tbody tr.highlight');
            const stage = tblStage.DataTable().row($rowSt).data(); 
            if (promotion || stage){
                $("#stage_PromotionId").val(promotion.promotionId);
            }
            modalStage.find(".modal-title").text("Create New Stage");
            modalStage.modal("show");
        });
        $("#btnEditStage").on("click", function () {
            const $rowPro = tblPromotion.find('tbody tr.highlight');
            const promotion = tblPromotion.DataTable().row($rowPro).data();
            const $rowSt = tblStage.find('tbody tr.highlight');
            const stage = tblStage.DataTable().row($rowSt).data();
            if (!promotion) {
                return ShowToastInfo("No Promotion selected!");
            }
            if (!stage){
                return ShowToastInfo("No Stage selected!");
            }    
            $("#stage_PromotionId").val(promotion.promotionId);
            $("#stage_StageId").val(stage.stageId);
            $("#stage_StageNo").val(stage.stageNo); 
            modalStage.find(".modal-title").text("Update Stage");
            modalStage.modal("show");
        });
        $("#btnDeleteStage").on("click", function () {
            const $rowSt = tblStage.find('tbody tr.highlight');
            const stage = tblStage.DataTable().row($rowSt).data();
            if(!stage){
                return ShowToastInfo("Please select stage"); 
            }
            ShowBoxConfirm("Are you sure you want to delete this stage?", function () {
                    $.ajax({
                        url: '/stage/delete/' + stage.stageId,
                        method: 'DELETE',
                        success: function (response) {
                            if (response.code === "200") {
                                ShowToastSuccess(`Stage ${stage.stageNo} remove successfully!`);
                                tblStage.DataTable().ajax.reload();
                            } else {
                                ShowToastError(response.message);
                            }
                        },
                        error: function (error) {
                            ShowToastError(error.responseText);
                        }
                    });
                    fetchStage();
            });
        });
        formStage.on("submit", function (e) {
            e.preventDefault();
            const form = $(this);
            const formData = form.serialize();
            $.ajax({
                url: '/stage/save-change',
                method: 'POST',
                data: formData,
                success: function (response) {
                    if (response.status.code === "200") {
                        ShowToastSuccess("Stage saved successfully!");
                        formStage[0].reset();
                        $("#stage_StageId").val(0);
                        modalStage.modal("hide");
                        tblStage.DataTable().ajax.reload();
                    } else {
                        ShowToastError(response.status.message);
                    }
                },
                error: function (error) {
                    ShowToastError(error.responseText);
                }
            }); 
        });
        $("#closeStage").on("click", function () {
            modalStage.modal("hide");
            formStage[0].reset();
        })
        //#endregion ==Stage==

        //#region ====Term====
        const tblTerm = $("#tblTerm");
        const formTerm = $("#formTerm");
        const modalTerm = $("#modalTerm"); 
        const termAcademicYearStart = $("#term_AcademicYearStart");
        const termStartDate = $("#term_StartDate");
        const termEndDate = $("#term_EndDate");
        function fetchTerm() {
            const $row = tblStage.find('tbody tr.highlight');
            const stage = tblStage.DataTable().row($row).data();
            tblTerm.DataTable().clear().destroy();
            if (!stage){
                tblTerm.DataTable({
                    paging: false,
                    lengthChange: false,
                    searching: false,
                    ordering: true,
                    info: false,
                    responsive: true,
                    autoWidth: true,
                });
                return;
            }
            tblTerm.DataTable({
                paging: false,
                lengthChange: false,
                searching: false,
                ordering: true,
                info: false,
                responsive: true,
                autoWidth: true,
                processing: true,
                serverSide: true,
                ajax: {
                    url: "/term/get-terms",
                    type: "POST",
                    data: function (d) {
                        d.stageId = stage.stageId;
                    },
                    error: function (xhr) {
                        ShowToastError(xhr.responseText);
                    }
                },
                columns: [
                    {data: "termId"},
                    {data: "termNo"},
                ]
            });
        } 
        tblTerm.on('click', 'tbody tr', function () {
            tblTerm.find('tbody tr').removeClass('highlight');
            $(this).addClass('highlight');
            fetchGroup();
         });
        async function OnPromoteNew() {
            const $rowSt = tblStage.find('tbody tr.highlight');
            const stage = tblStage.DataTable().row($rowSt).data(); 
            if (!stage){
               return ShowToastInfo("Please select stage");
            }
            const lastTerm = await getLastTerm(stage.stageId); 
            if (!lastTerm) {
                $("#term_TermNo").val(1);
                modalTerm.find(".modal-title").text("Create New Term");
            }else{
                $("#term_TermNo").val(parseInt(lastTerm.termNo + 1));
                modalTerm.find(".modal-title").text("Promote New Term");
            }
            if (stage){
                $("#term_StageId").val(stage.stageId);
            }
            $("#term_TermId").val(0);
            termStartDate.val(new Date(Date.now()).toISOString().split('T')[0]);
            termEndDate.val(new Date(Date.now()).toISOString().split('T')[0]);
            modalTerm.modal("show"); 
        }
        formTerm.off("submit").on("submit", function (e) {
            e.preventDefault();
            e.stopImmediatePropagation(); 
            const form = $(this);
            const formData = form.serialize(); 
            $.ajax({
                url: '/term/save-change',
                method: 'POST',
                data: formData,
                success: function (response) {
                    if (response.status.code === "200") {
                        ShowToastSuccess("Term saved successfully!");
                        formTerm[0].reset();
                        modalTerm.modal("hide");
                        tblTerm.DataTable().ajax.reload();
                    } else {
                        ShowToastError(response.status.message);
                    }
                },
                error: function (error) {
                    ShowToastError(error.responseText);
                }
            }); 
            return false;
        });
        function  DeleteTerm(){
            const $rowSt = tblTerm.find('tbody tr.highlight');
            const term = tblTerm.DataTable().row($rowSt).data();
            if(!term){
                return ShowToastInfo("Please select term"); 
            } 
            ShowBoxConfirm("Are you sure you want to delete this term?",function (){
                $.ajax({
                    url: '/term/delete/' + term.termId,
                    method: 'DELETE',
                    success: function (response) {
                        if (response.code === "200") {
                            ShowToastSuccess("Saved successfully!");
                            tblTerm.DataTable().ajax.reload();
                        } else {
                            ShowToastError(response.message);
                        }
                    },
                    error: function (error) {
                        ShowToastError(error.responseText);
                    }
                }); 
                fetchGroup();
            });
        } 
        $("#CloseTerm").on("click", function () {
            modalTerm.modal("hide");
            formTerm[0].reset();
            tblTerm.DataTable().ajax.reload();
        })
        async function getLastTerm(stageId) {
            try {
                const response = await $.ajax({
                    url: "/term/get-last-term/"+stageId,
                    method: "POST",
                });
                if (response.status.code === "200") {
                    return response.data;
                }
            }catch(error) {
                @* console.log(error.responseText); *@
            }
        } 
        termAcademicYearStart.on("input", function (e) {
            $("#term_AcademicYearEnd").val(parseInt(e.target.value) + 1);
        });
        termStartDate.on("input", function (e) {
            const d = new Date(e.target.value);
            d.setMonth(d.getMonth() + 4);
            $("#term_EndDate").val(d.toISOString().split('T')[0]);
        }); 
        function OnEditTerm() {
            const $row = tblTerm.find('tbody tr.highlight');
            const selectedRow = tblTerm.DataTable().row($row).data();
            if (!selectedRow) return;
            $("#term_StageId").val(selectedRow.stageId);
            $("#term_TermId").val(selectedRow.termId);
            $("#term_TermNo").val(selectedRow.termNo);
            termAcademicYearStart.val(selectedRow.academicYearStart);
            $("#term_AcademicYearEnd").val(selectedRow.academicYearEnd);
            termStartDate.val(new Date(selectedRow.startDate).toISOString().split('T')[0]);
            $("#term_EndDate").val(new Date(selectedRow.endDate).toISOString().split('T')[0]);
            modalTerm.modal("show");
        }
        //#endregion ====Term====

        //#region  ======Group====== 
        const tblGroup = $("#tblGroup");
        const modalGroup = $('#modalGroup');
        const formGroup = $("#formGroup");
        const modalTransfer = $("#TransferModal");
        const tblTransferStudent = $("#tblTransferStudent");
        const tblTransferGroup = $("#tblTransferGroup");
        const checkBoxAllStudent = $(".chkTransferStudentAll");
        function fetchGroup() {
            const $rowStage = tblStage.find('tbody tr.highlight');
            const stage = tblStage.DataTable().row($rowStage).data();
            const $rowTerm = tblTerm.find('tbody tr.highlight');
            const term = tblTerm.DataTable().row($rowTerm).data();
            tblGroup.DataTable().clear().destroy();
            if (!stage || !term){
                tblGroup.DataTable({
                    paging: false,
                    lengthChange: false,
                    searching: false,
                    ordering: true,
                    info: false,
                    responsive: true,
                    autoWidth: true,
                });
                return;
            }
            tblGroup.DataTable({
                paging: false,
                lengthChange: false,
                searching: false,
                ordering: true,
                info: false,
                responsive: true,
                autoWidth: true,
                processing: true,
                serverSide: true,
                ajax: {
                    url: "/group/get-groups",
                    type: "POST",
                    data: function (d) {
                        d.stageId = stage.stageId;
                    },
                    dataSrc: function (json) {
                        return json.data.filter(x => x.createdInTermNo <= term.termNo);
                    },
                    error: function (xhr) {
                        ShowToastError(xhr.responseText);
                    }
                },
                columns: [
                    {data: "groupId"},
                    {data: "groupName"},
                    {data: "studyTime"},
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `${formatDate(row.startPayment)}`
                        }
                    },
                ]
            });
        } 
        tblGroup.on('click', 'tbody tr', function () {
            tblGroup.find('tbody tr').removeClass('highlight');
            $(this).addClass('highlight');
        }); 
        btnNewGroup.on("click", function (e) {
            e.preventDefault();
            const $rowSt = tblStage.find('tbody tr.highlight');
            const stage = tblStage.DataTable().row($rowSt).data(); 
            const $rowTerm = tblTerm.find('tbody tr.highlight');
            const term = tblTerm.DataTable().row($rowTerm).data(); 
            if(!stage || !term) return; 
            if (formGroup) {
                $("#group_StageId").val(stage.stageId);
                $("#groupRoom_TermNo").val(term.termNo);
                GetField();
                GetRoom();
                GetStudyTime();
            }
            modalGroup.find(".modal-title").text("Create New Group");
            modalGroup.modal("show"); 
        });  
        btnEditGroup.on("click", async function () {
            const $row = tblGroup.find('tbody tr.highlight');
            const selectedRow = tblGroup.DataTable().row($row).data();
            if (!selectedRow) return;
            await GetStudyTime();
            await GetField();
            await GetRoom();
            $("#group_GroupId").val(selectedRow.groupId);
            $("#group_StageId").val(selectedRow.stageId);
            $("#group_GroupName").val(selectedRow.groupName);
            $("#group_CreatedInTermNo").val(selectedRow.createdInTermNo);
            $("#group_Note").val(selectedRow.note);
            cboStudyTime.val(selectedRow.studyTime).trigger("change");
            cboField.val(selectedRow.fieldId).trigger("change"); 
            await GetGroupRoom(selectedRow.groupId);
            modalGroup.find(".modal-title").text("Update Group");
            modalGroup.modal("show");
        }); 
        $("#CloseGroup").on("click", function () {
            formGroup[0].reset();
            modalGroup.modal("hide");
        });
        formGroup.off("submit").on("submit", function (e) {
            e.preventDefault();
            e.stopImmediatePropagation();
            const form = $(this);
            const formData = form.serialize(); 
            $.ajax({
                url: '/group/save-change',
                method: 'POST',
                data: formData,
                success: function (response) {
                    if (response.status.code === "200") {
                        ShowToastSuccess("Group saved successfully!");
                        formGroup[0].reset();
                        modalGroup.modal("hide");
                        tblGroup.DataTable().ajax.reload();
                    } else {
                        ShowToastError(response.status.message);
                    }
                },
                error: function (error) {
                    ShowToastError(error.responseText);
                }
            });
        });
        // transfer section
        $("#btnToggleTransferFullScreen").on("click", function () {
            const dialog = $("#TransferModal .transfer-modal-dialog");
            const icon = $(this).find("i");
            dialog.toggleClass("modal-fullscreen-custom");
            if (dialog.hasClass("modal-fullscreen-custom")) {
                icon.removeClass("fa-expand").addClass("fa-compress");
            } else {
                icon.removeClass("fa-compress").addClass("fa-expand");
            }
        });
        function OnTransfer() {
            const degreeId = $('#rangeButtons button.btn-primary').val();
            const schoolId = cboSchool.val();
            const promotion = tblPromotion.DataTable().row(tblPromotion.find('tbody tr.highlight')).data();
            const term = tblTerm.DataTable().row(tblTerm.find('tbody tr.highlight')).data();
            const group = tblGroup.DataTable().row(tblGroup.find('tbody tr.highlight')).data(); 
            if (!degreeId || !schoolId || !promotion || !term || !group) return ShowToastInfo("Please select data for transfer!"); 
            // group side
            const tblTransferGroup = $("#tblTransferGroup");
            tblTransferGroup.DataTable().clear().destroy();
            tblTransferGroup.DataTable({
                paging: true,
                lengthChange: false,
                searching: false,
                ordering: false,
                info: false,
                responsive: true,
                autoWidth: true,
                processing: true,
                serverSide: true,
                ajax: {
                    url: "/group/getgroups/promotion",
                    type: "POST",
                    data: function (d) {
                        d.promotionId = promotion.promotionId;
                    },
                },
                columns: [
                    {data: "groupId"},
                    {data: "groupName"},
                    {data: "fieldId"},
                    {data: "fieldName"},
                    {data: "stageId"},
                    {data: "stageNo"},
                ]
            }); 
            // student side
            tblTransferStudent.DataTable().clear().destroy();
            tblTransferStudent.DataTable({
                paging: true,
                lengthChange: false,
                pageLength: 100,
                searching: false,
                ordering: false,
                info: false,
                responsive: true,
                autoWidth: true,
                processing: true,
                serverSide: true,
                columnDefs: [
                    {
                        targets: 0,
                        orderable: false,
                        searchable: false,
                        className: "text-center no-sort"
                    }
                ],
                headerCallback: function (thead) {
                    $(thead).find("th").eq(0)
                        .removeClass("sorting sorting_asc sorting_desc")
                        .addClass("no-sort text-center")
                        .html(`<input type="checkbox" class="chkTransferStudentAll" style="width:16px;height:16px;cursor:pointer;">`);
                },
                ajax: {
                    url: "/student/GetStudents",
                    type: "POST",
                    data: function (d) {
                        d.degreeId = degreeId;
                        d.schoolid = schoolId;
                        d.termno = term.termNo;
                        d.groupid = group.groupId;
                    },
                },
                columns: [
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        className: "text-center",
                        render: function (data, type, row) {
                            return `<input type="checkbox" class="chkTransferStudentRow" value="${row.studentId}">`;
                        }
                    },
                    {data: "studentId"},
                    {data: "studentName"},
                    {data: "sex"},
                    {
                        data: null,
                        render: function (data, type, row) {
                            const dt = formatDate(row.dateOfBirth);
                            return `${dt}`
                        }
                    },
                ],
                drawCallback: function () {
                    $("#chkTransferStudentAll").prop("checked", false);
                    $("#countStudent").text(0);
                }
            });
            modalTransfer.modal("show");
        }
        // select group for transfer
        tblTransferGroup.on('click', 'tbody tr', function () {
            tblTransferGroup.find('tbody tr').removeClass('highlight');
            $(this).addClass('highlight'); 
        });
        // select all student
        $(document).off("change", ".chkTransferStudentAll")
            .on("change", ".chkTransferStudentAll", function () {
                const isChecked = $(this).prop("checked");
                const tableRows = tblTransferStudent.find("tbody tr"); 
                tableRows.find(".chkTransferStudentRow").prop("checked", isChecked); 
                if (isChecked) {
                    tableRows.addClass("highlight");
                } else {
                    tableRows.removeClass("highlight");
                } 
                updateTransferStudentCount();
            });
        // select one student
        $(document).off("change.transferStudentRow", ".chkTransferStudentRow")
            .on("change.transferStudentRow", ".chkTransferStudentRow", function () {
                const row = $(this).closest("tr"); 
                if ($(this).is(":checked")) {
                    row.addClass("highlight");
                } else {
                    row.removeClass("highlight");
                } 
                updateTransferStudentSelectAll();
                updateTransferStudentCount();
            });

        // Helper for Select student
        function updateTransferStudentCount() {
            const tb = tblTransferStudent.DataTable();
            let count = 0;
            $(tb.rows({ page: "current" }).nodes()).each(function () {
                if ($(this).find(".chkTransferStudentRow").prop("checked")) {
                    count++;
                }
            });
            $("#countStudent").text(count);
        } 
        function updateTransferStudentSelectAll() {
            const tb = tblTransferStudent.DataTable();
            const rows = $(tb.rows({ page: "current" }).nodes()); 
            const total = rows.length;
            const checked = rows.find(".chkTransferStudentRow:checked").length;
            checkBoxAllStudent.prop("checked", total > 0 && total === checked);
        }

        // Reset data states on close
        modalTransfer.on("hidden.bs.modal", function () {
            checkBoxAllStudent.prop("checked", false);
        }); 
        function getSelectedTransferStudentIds() {
            const ids = [];
            tblTransferStudent.find("tbody .chkTransferStudentRow:checked").each(function () {
                ids.push($(this).val());
            });
            return ids;
        }

        $("#btnTransfer").on("click", function () { 
            const idList = getSelectedTransferStudentIds();  
            const targetGroup = tblTransferGroup.DataTable().row(tblTransferGroup.find("tbody tr.highlight")).data(); 
            const fromGroup = tblGroup.DataTable().row(tblGroup.find("tbody tr.highlight")).data();
            const fromTerm = tblTerm.DataTable().row(tblTerm.find("tbody tr.highlight")).data();
            if (idList.length === 0) {
                return ShowToastInfo("Please select at least one student to transfer.");
            }
            if (!targetGroup) {
                return ShowToastInfo("Please select a target group from the table to transfer students into.");
            }
            showLoading();
            $.ajax({
                url: '/student/transfer/' + targetGroup.groupId + '/' + fromGroup.groupId + '/' +fromTerm.termNo,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(idList),
                success: function (res) { 
                    if (res.status.code === "200"){ 
                        modalTransfer.modal("hide");
                        ShowToastSuccess(`Students succeed transferred from ${fromGroup.groupName} to ${targetGroup.groupName}!`);
                        return;
                    }
                    ShowToastInfo("Fails to transferred students!") 
                },
                error: function (err) {
                    ShowToastError("Error handling student transfer execution.");
                },
                complete: function () {
                    hideLoading();
                }
            });  
        });
        //#endregion  ======Group====== 
 
        
        //#region Bind Select2 Data
        async function GetField() {
            const degreeId = parseInt(btnDegrees.find('button.btn-primary').val());
            const schoolId = parseInt(cboSchool.val());
            if (!degreeId || !schoolId) {
                ShowToastInfo("Missing degree or school ID");
                return;
            }
            const fields = await Field.GetFields({isAll: true, degreeId, schoolId});
            cboField.empty();
            cboField.append("<option value='' disabled selected>Select Field</option>");
            fields.forEach(item => {
                cboField.append(`<option value='${item.fieldId}'>${item.fieldName}</option>`);
            });
            cboField.trigger('change.select2');
        }

        async function GetStudyTime() {
            try {
                const response = await $.ajax({
                    url: "/group/get-study-time",
                    method: 'GET',
                    dataType: "json",
                }); 
                if (response.status.code === "200" && response.data !== "") {
                    cboStudyTime.empty();
                    cboStudyTime.append("<option value='' disabled selected>Select study time</option>");
                    response.data.forEach(item => {
                        cboStudyTime.append(`<option value='${item.studyTimeValue}'>${item.studyTimeValue}</option>`);
                    });
                    cboStudyTime.trigger('change.select2');
                } else {
                    ShowToastError(response.status.message);
                }
            } catch (err) {
                ShowToastError(err);
            }
        }

        async function GetRoom() {
            try {
                const response = await $.ajax({
                    url: "/room/get-rooms",
                    method: 'POST',
                    data: {
                        isAll: true,
                    },
                    dataType: "json",
                    error: function (data) {
                        @* console.log(data.responseText); *@
                    }
                }); 
                 if (response.code === "200" && response.data !== "") {
                    cboRoom.empty();
                    cboRoom.append("<option value='' disabled selected>Select study time</option>");
                    response.data.forEach(item => {
                        cboRoom.append(`<option value='${item.roomName}'>${item.roomName}</option>`);
                    });
                    cboRoom.trigger('change.select2');
                } else {
                    ShowToastError(response.message);
                }
            } catch (err) {
                ShowToastError(err);
            }
        }

        async function GetGroupRoom(groupId) {
            try {
                const $rowTerm = tblTerm.find('tbody tr.highlight');
                const term = tblTerm.DataTable().row($rowTerm).data(); 
                const $rowGroup = tblTerm.find('tbody tr.highlight');
                const group = tblTerm.DataTable().row($rowGroup).data();
                const response = await $.ajax({
                    url: "/group/get-group-rooms",
                    method: 'POST',
                    data: {
                        groupId: group.groupId,
                        termNo: term.termNo,
                        isAll: true,
                    },
                    dataType: "json",
                    error: function (data) {
                         console.log(data.responseText); 
                    }
                }); 
                if (response.status.code === "200") {
                    const data = response.data; 
                    $("#groupRoom_GroupRoomId").val(data.groupRoomId);
                    $("#groupRoom_TermNo").val(data.termNo);
                    cboRoom.val(data.roomName).trigger("change");
                    $("#groupRoom_StartPayment").val(data.startPayment ?? new Date().toLocaleString());

                } else {
                    ShowToastError(response.status.message);
                }
            } catch (err) {
                ShowToastError(err);
            }
        }
        //#endregion Bind Selec2 Data
    </script>
}

