        tblTransferStudent.on('click', 'tbody tr', function () {
            const row = $(this);
            // If already highlighted → remove highlight and stop
            if (row.hasClass('highlight')) {
                row.removeClass('highlight');
            } else {
                // Add highlight to clicked row
                row.addClass('highlight'); 
            }
            let count = tblTransferStudent.find('tbody tr.highlight').length;
            $("#countStudent").text(count);
        });
        
        $("#btnTransfer").on("click", async function () {
            let idList = [];

            tblTransferStudent.find("tbody tr.highlight").each(function () {
                const row = $(this);
                const id = row.find("td").eq(0).text().trim();
                idList.push(id);
            });

            console.log("Sending ID List:", idList);
            
            // === POST to Controller ===
            $.ajax({
                url: '/student/transfer/'+2336,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(idList),
                success: function (res) {
                    console.log("Success:", res);
                },
                error: function (err) {
                    console.log("Error:", err);
                }
            });
        });
        //==============End Group======

        //==============
        async function GetField() {
            const degreeId = parseInt(btnDegrees.find('button.btn-primary').val());
            const schoolId = parseInt(cboSchool.val());
            if (!degreeId || !schoolId) {
                console.warn("Missing degree or school ID");
                return;
            }
            const fields = await Field.GetFields({isAll: true, degreeId, schoolId});
            cboField.empty();
            cboField.append("<option value='' disabled selected>Select Field</option>");
            fields.forEach(item => {
                cboField.append(`<option value='${item.fieldId}'>${item.fieldName}</option>`);
            });
            cboField.trigger('change.select2');
        }

        async function GetStudyTime() {
            try {
                const response = await $.ajax({
                    url: "/group/get-study-time",
                    method: 'GET',
                    dataType: "json",
                });
                if (response.code === "200" && response.data !== "") {
                    cboStudyTime.empty();
                    cboStudyTime.append("<option value='' disabled selected>Select study time</option>");
                    response.data.forEach(item => {
                        cboStudyTime.append(`<option value='${item.studyTimeValue}'>${item.studyTimeValue}</option>`);
                    });
                    cboStudyTime.trigger('change.select2');
                } else {
                    ShowToastError(response.message);
                }
            } catch (err) {
                ShowToastError(err);
            }
        }

        async function GetRoom() {
            try {
                const response = await $.ajax({
                    url: "/room/get-rooms",
                    method: 'POST',
                    data: {
                        isAll: true,
                    },
                    dataType: "json",
                    error: function (data) {
                        console.log(data.responseText);
                    }
                });
                 if (response.code === "200" && response.data !== "") {
                    cboRoom.empty();
                    cboRoom.append("<option value='' disabled selected>Select study time</option>");
                    response.data.forEach(item => {
                        cboRoom.append(`<option value='${item.roomName}'>${item.roomName}</option>`);
                    });
                    cboRoom.trigger('change.select2');
                } else {
                    ShowToastError(response.message);
                }
            } catch (err) {
                ShowToastError(err);
            }
        }

        async function GetGroupRoom(groupId) {
            try {
                const $rowTerm = tblTerm.find('tbody tr.highlight');
                const term = tblTerm.DataTable().row($rowTerm).data();

                const $rowGroup = tblTerm.find('tbody tr.highlight');
                const group = tblTerm.DataTable().row($rowGroup).data();
                const response = await $.ajax({
                    url: "/group/get-group-rooms",
                    method: 'POST',
                    data: {
                        groupId: group.groupId,
                        termNo: term.termNo,
                        isAll: true,
                    },
                    dataType: "json",
                    error: function (data) {
                        console.log(data.responseText);
                    }
                });
                if (response.status.code === "200") {
                    const data = response.data; 
                    $("#groupRoom_GroupRoomId").val(data.groupRoomId);
                    $("#groupRoom_TermNo").val(data.termNo);
                    cboRoom.val(data.roomName).trigger("change");
                    $("#groupRoom_StartPayment").val(data.startPayment ?? new Date().toLocaleString());

                } else {
                    ShowToastError(response.message);
                }
            } catch (err) {
                ShowToastError(err);
            }
        }
    </script>
