@using BBU_SYSTEM.DTOs
@{
    var nationality = new NationalityDto();
}
<div class="modal fade" id="nationalityModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Nationality</h4>
            </div>
            <div class="modal-body">
                <form id="nationalityForm">
                    <input asp-for="@nationality.NationalityId" hidden readonly class="form-control" value="0"/>
                    <div class="form-group">
                        <label>Name</label>
                        <input type="text" asp-for="@nationality.NationalityName" class="form-control"
                               placeholder="Enter name" required>
                    </div>
                    <div class="form-group">
                        <label>Name Khmer</label>
                        <input type="text" asp-for="@nationality.NationalityInKhmer" class="form-control"
                               placeholder="Enter name khmer" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <div class="modal-footer">
                    <button type="submit" form="nationalityForm" class="btn btn-success">
                        <i class="fas fa-save"></i> Save
                    </button>

                    <button id="btnClose" type="button" class="btn btn-danger">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>