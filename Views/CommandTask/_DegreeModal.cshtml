@using BBU_SYSTEM.DTOs
@{
    var degree = new DegreeDto();
}
<div class="modal fade" id="DegreeModal" data-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Degree</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="degreeForm">
                    <input asp-for="@degree.DegreeId" hidden readonly class="form-control" value="0"/>
                    <div class="form-group">
                        <label>Degree Name</label>
                        <input type="text" asp-for="@degree.DegreeName" class="form-control"
                               placeholder="Enter name" required>
                    </div>
                    <div class="form-group">
                        <label>Degree Name Khmer</label>
                        <input type="text" asp-for="@degree.DegreeInKhmer" class="form-control"
                               placeholder="Enter name khmer" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="submit" form="degreeForm" class="btn btn-primary"><i class="fas fa-save"></i> Save changes
                </button>
                <button type="button" class="btn btn-danger" id="btnClose"><i class="fas fa-close"></i> Close
                </button>
            </div>
        </div>
    </div>
</div>