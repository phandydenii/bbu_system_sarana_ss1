@{
    ViewData["OpenMenu"] = "CommandTask";
    ViewData["Action"] = "Disability";
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Disability</h3>
                <button type="button" id="btnNewDisability" class="btn btn-success btn-sm float-right">
                    <i class="fas fa-plus"></i>
                    Add New
                </button>
            </div>
            <div class="card-body">
                <table id="tblDisability" class="table table-sm table-bordered table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name English</th>
                        <th>Name Khmer</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_DisabilityModal"/>
<script>
    $(document).ready(function () {
        fetchDisability();

        $("#btnNewDisability").on("click", function (e) {
            e.preventDefault();

            clearDisabilityForm();

            $("#disabilityModal").find(".modal-title").text("Add Disability");
            $("#disabilityModal").modal("show");
        });

        $(document).on("click", ".btnCloseDisability", function () {
            clearDisabilityForm();
            $("#disabilityModal").modal("hide");
        });
    });

    function fetchDisability() {
        if ($.fn.DataTable.isDataTable("#tblDisability")) {
            $("#tblDisability").DataTable().clear().destroy();
        }

        $("#tblDisability").DataTable({
            paging: true,
            lengthChange: true,
            searching: true,
            ordering: true,
            info: true,
            responsive: true,
            processing: true,
            serverSide: true,
            ajax: {
                url: "/Disability/get-disabilities",
                type: "POST"
            },
            columns: [
                { data: "id" },
                { data: "disabilityName" },
                { data: "disabilityNameKh" },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function () {
                        return `
                        <a href="javascript:void(0)" class="btnEdit btn btn-success btn-sm">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                    `;
                    }
                }
            ]
        });
    }

    function clearDisabilityForm() {
        $("#formDisability")[0].reset();

        $("#disability_Id").val(0);
        $("#disability_DisabilityName").val("");
        $("#disability_DisabilityNameKh").val("");
    }

    $("#tblDisability").on("click", ".btnEdit", function () {
        let row = $(this).closest("tr");

        if (row.hasClass("child")) {
            row = row.prev();
        }

        const selectedRow = $("#tblDisability").DataTable().row(row).data();

        $("#disability_Id").val(selectedRow.id);
        $("#disability_DisabilityName").val(selectedRow.disabilityName);
        $("#disability_DisabilityNameKh").val(selectedRow.disabilityNameKh);

        $("#disabilityModal").find(".modal-title").text("Edit Disability");
        $("#disabilityModal").modal("show");
    });

    $("#formDisability").on("submit", function (e) {
        e.preventDefault();

        const id = $("#disability_Id").val() || "0";
        const disabilityName = ($("#disability_DisabilityName").val() || "").trim();
        const disabilityNameKh = ($("#disability_DisabilityNameKh").val() || "").trim();

        if (disabilityName === "") {
            ShowToastError("Disability name is required.");
            $("#disability_DisabilityName").focus();
            return;
        }

        if (disabilityNameKh === "") {
            ShowToastError("Disability name Khmer is required.");
            $("#disability_DisabilityNameKh").focus();
            return;
        }

        $.ajax({
            url: "/Disability/SaveChange",
            method: "POST",
            data: {
                Id: id,
                DisabilityName: disabilityName,
                DisabilityNameKh: disabilityNameKh
            },
            success: function (response) {
                const code = response.status?.code;
                const message = response.status?.message;

                if (code === "200" || code === 200) {
                    if (id !== "0") {
                        ShowToastSuccess(message || "Updated successfully!");
                    } else {
                        ShowToastSuccess(message || "Saved successfully!");
                    }

                    clearDisabilityForm();
                    $("#disabilityModal").modal("hide");
                    $("#tblDisability").DataTable().ajax.reload();
                } else {
                    ShowToastError(message || "Save failed.");
                }
            },
            error: function (xhr) {
                const message =
                    xhr["responseJSON"]?.["status"]?.["message"] ||
                    xhr["responseJSON"]?.["message"] ||
                    "Server error.";

                ShowToastError(message);
            }
        });
    });
</script>