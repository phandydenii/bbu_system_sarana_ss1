@{
    ViewData["OpenMenu"] = "CommandTask";
    ViewData["Action"] = "Disability";
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Disability</h3>
                <button type="button" class="btn btn-success btn-sm float-right" data-toggle="modal"
                        data-target="#disabilityModal">
                    <i class="fas fa-plus"></i>
                    Add New
                </button>
            </div>
            <div class="card-body">
                <table id="tblDisability" class="table table-sm table-bordered table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name English</th>
                        <th>Name Khmer</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_DisabilityModal"/>

@section Scripts
{
    <script src="~/function/Disability.js"></script>
    <script>
        const tblDisability = $("#tblDisability");
        const btnClose = $("#btnClose");
        $(document).ready(function () {
            fetchDisability();

            function fetchDisability() {
                tblDisability.DataTable().clear().destroy();
                tblDisability.DataTable({
                    paging: true,
                    lengthChange: true,
                    searching: true,
                    ordering: true,
                    info: true,
                    responsive: true,
                    processing: true,
                    serverSide: true,
                    order: [[0, "desc"]],
                    ajax: {
                        url: "/Disability/get-disabilities",
                        type: "POST"
                    },
                    columns: [
                        {data: "id"},
                        {data: "disabilityName"},
                        {data: "disabilityNameKh"},
                        {
                            data: null,
                            render: function () {
                                return `
                        <a id="btnEdit" class="btn btn-success btn-sm">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                    `;
                            }
                        }
                    ],
                    initComplete: function () {
                        MyApp.utils.dataTableDebounceSearch("#tblDisability", 500);
                    }
                });
            }

            tblDisability.on("click", "#btnEdit", function () {
                let row = $(this).closest("tr");
                if (row.hasClass("child")) {
                    row = row.prev();
                }
                const selectedRow = tblDisability.DataTable().row(row).data();
                const disability = new Disability(selectedRow);
                
                $("#Id").val(disability.id);
                $("#DisabilityName").val(disability.disabilityName);
                $("#DisabilityNameKh").val(disability.disabilityNameKh);
                $("#disabilityModal").modal("show");
            });

            $("#disabilityForm").on("submit", function (e) {
                e.preventDefault();
                const form = $(this);
                const formData = $(form).serialize();
                console.log(formData);
                $.ajax({
                    url: "/Disability/SaveChange",
                    method: "POST",
                    data: formData,
                    success: function (response) {
                        if (response.status.code === "200") {
                            ShowToastSuccess("Saved successfully!");
                            $("#disabilityForm")[0].reset();
                            $("#disabilityModal").modal("hide");
                            $("#tblDisability").DataTable().ajax.reload();
                        } else {
                            ShowToastError(response.message);
                        }
                    },
                    error: function (error) {
                        if (error.responseJSON && error.responseJSON.message) {
                            ShowToastError(error.responseJSON.message);
                        }
                    }
                });
            });
        });


        btnClose.on("click", function (e) {
            e.preventDefault();
            $("#disabilityForm")[0].reset();
            $("#disabilityModal").modal("hide");
        });
    </script>
}
