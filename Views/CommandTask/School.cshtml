@{
    ViewData["OpenMenu"] = "CommandTask";
    ViewData["Action"] = "School";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">School</h3>
                <button type="button" class="btn btn-success btn-sm float-right" onclick="openAddSchool()">
                    <i class="fas fa-plus"></i>
                    Add New
                </button>
            </div>
            <div class="card-body">
                <table id="tblSchool" class="table table-sm table-bordered table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Name Khmer</th>
                        <th>Code</th>
                        <th>Faculty</th>
                        <th>Is Foundation</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_SchoolModal"/>
<script>
    let schoolTable = null;
    let facultyDropdownRequest = null;

    $(document).ready(function () {
        fetchSchool();
        
        facultyDropdownRequest = fetchFacultyDropdown();

        $("#btnCloseSchool").on("click", function (e) {
            e.preventDefault();
            clearSchoolForm();
            $("#SchoolModal").modal("hide");
        });
        
    });
    

    function reloadSchoolTable() {
        if (schoolTable) {
            schoolTable.ajax.reload();
        }
    }

    function fetchSchool() {
        const tblSchool = $("#tblSchool");

        if ($.fn.DataTable.isDataTable("#tblSchool")) {
            tblSchool.DataTable().clear().destroy();
        }

        schoolTable = tblSchool.DataTable({
            paging: true,
            lengthChange: true,
            searching: true,
            ordering: true,
            info: true,
            responsive: true,
            processing: true,
            serverSide: true,
            ajax: {
                url: "/School/get-schools",
                type: "POST"
            },
            columns: [
                { data: "schoolId" },
                { data: "schoolName" },
                { data: "schoolNameInKhmer" },
                { data: "schoolCode" },
                { data: "facultyId" },
                {
                    data: "isFoundationSchool",
                    render: function (data) {
                        return Number(data) === 1 ? "Yes" : "No";
                    }
                },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function () {
                        return `
                            <div class="text-center">
                                <button type="button" class="btn btn-success btn-sm btnEditSchool">
                                    <i class="fas fa-edit"></i> Edit
                                </button>
                                <button type="button" class="btn btn-danger btn-sm btnDeleteSchool">
                                    <i class="fa-solid fa-trash"></i> Delete
                                </button>
                            </div>
                        `;
                    }
                }
            ]
        });
    }

    function clearSchoolForm() {
        const formElement = $("#schoolForm")[0];

        if (formElement) {
            formElement.reset();
        }

        $("#school_SchoolId").val(0);
        $("#school_SchoolName").val("");
        $("#school_SchoolNameInKhmer").val("");
        $("#school_SchoolCode").val("");
        $("#school_FacultyId").val("").trigger("change");
        $("#school_IsFoundationSchool").val(0);
        $("#chkFoundation").prop("checked", false);
    }

    function openAddSchool() {
        clearSchoolForm();

        if (facultyDropdownRequest) {
            facultyDropdownRequest.done(function () {
                $("#school_FacultyId").val("").trigger("change");
            });
        }

        $("#SchoolModal").modal("show");
    }

    $("#tblSchool").on("click", ".btnEditSchool", function () {
        let rowElement = $(this).closest("tr");

        if (rowElement.hasClass("child")) {
            rowElement = rowElement.prev();
        }

        const selectedRow = schoolTable.row(rowElement).data();

        if (!selectedRow) {
            ShowToastError("Cannot get selected school data.");
            return;
        }

        $("#school_SchoolId").val(selectedRow["schoolId"]);
        $("#school_SchoolName").val(selectedRow["schoolName"]);
        $("#school_SchoolNameInKhmer").val(selectedRow["schoolNameInKhmer"]);
        $("#school_SchoolCode").val(selectedRow["schoolCode"]);

        const isFoundation = Number(selectedRow["isFoundationSchool"]) === 1;

        $("#school_IsFoundationSchool").val(isFoundation ? 1 : 0);
        $("#chkFoundation").prop("checked", isFoundation);

        const selectedFacultyId = selectedRow["facultyId"];

        if (facultyDropdownRequest) {
            facultyDropdownRequest.done(function () {
                setSelectedFaculty(selectedFacultyId);
            });
        } else {
            setSelectedFaculty(selectedFacultyId);
        }

        $("#SchoolModal").modal("show");
    });

    function setSelectedFaculty(facultyId) {
        const facultySelect = $("#school_FacultyId");

        if (facultyId === null || facultyId === undefined || facultyId === "") {
            facultySelect.val("").trigger("change");
            return;
        }

        const value = String(facultyId);

        facultySelect.val(value).trigger("change");

    }

    $("#tblSchool").on("click", ".btnDeleteSchool", function () {
        let rowElement = $(this).closest("tr");

        if (rowElement.hasClass("child")) {
            rowElement = rowElement.prev();
        }

        const selectedRow = schoolTable.row(rowElement).data();

        if (!selectedRow) {
            ShowToastError("Cannot get selected school data.");
            return;
        }

        if (!confirm("Are you sure you want to delete this school?")) {
            return;
        }

        $.ajax({
            url: "/School/delete/" + selectedRow["schoolId"],
            type: "DELETE",
            success: function (response) {
                const code = response.status?.code;
                const message = response.status?.message;

                if (code === "200" || code === 200) {
                    ShowToastSuccess(message || "Deleted successfully!");
                    reloadSchoolTable();
                } else {
                    ShowToastError(message || "Delete failed.");
                }
            },
            error: function () {
                ShowToastError("Delete failed.");
            }
        });
    });

    function fetchFacultyDropdown() {
        return $.ajax({
            url: "/Faculty/get-faculties?isAll=true",
            type: "POST",
            success: function (response) {
                const facultySelect = $("#school_FacultyId");

                facultySelect.empty();
                facultySelect.append('<option value="">Select Faculty</option>');

                const faculties = response && response["data"] ? response["data"] : [];

                faculties.forEach(function (faculty) {
                    const facultyId = faculty["facultyId"];
                    const facultyName = faculty["facultyName"];

                    facultySelect.append(
                        '<option value="' + facultyId + '">' + facultyName + '</option>'
                    );
                });

                console.log("Faculty dropdown loaded.");
            },
            error: function () {
                ShowToastError("Cannot load faculty dropdown.");
            }
        });
    }

    $("#schoolForm").on("submit", function (e) {
        e.preventDefault();

        const schoolId = $("#school_SchoolId").val() || "0";
        const isFoundation = $("#chkFoundation").is(":checked") ? 1 : 0;

        $("#school_IsFoundationSchool").val(isFoundation);

        const formData = $("#schoolForm").serialize();

        $.ajax({
            url: "/School/SaveChange",
            type: "POST",
            data: formData,
            success: function (response) {
                const code = response.status?.code;
                const message = response.status?.message;

                if (code === "200" || code === 200) {
                    if (schoolId !== "0") {
                        ShowToastSuccess(message || "Updated successfully!");
                    } else {
                        ShowToastSuccess(message || "Saved successfully!");
                    }

                    clearSchoolForm();
                    $("#SchoolModal").modal("hide");
                    reloadSchoolTable();
                } else {
                    ShowToastError(message || "Save failed.");
                }
            },
            error: function (xhr) {
                if (xhr.status === 401) {
                    ShowToastError("Unauthorized. Please login again.");
                    return;
                }

                const message =
                    xhr["responseJSON"]?.["status"]?.["message"] ||
                    xhr["responseJSON"]?.["message"] ||
                    "Server error.";

                ShowToastError(message);
            }
        });
    });
</script>