@{
    ViewData["OpenMenu"] = "CommandTask";
    ViewData["Action"] = "School";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">School</h3>
                <button type="button" class="btn btn-success btn-sm float-right" data-toggle="modal"
                        data-target="#SchoolModal">
                    <i class="fas fa-plus"></i>
                    Add New
                </button>
            </div>
            <div class="card-body">
                <table id="tblSchool" class="table table-sm table-bordered table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Name Khmer</th>
                        <th>Code</th>
                        <th>Faculty</th>
                        <th>Foundation</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_SchoolModal"/>
@section Scripts{
    <script src="~/function/School.js"></script>
    <script>
        const tblSchool = $("#tblSchool");
        const schoolForm = $("#schoolForm");
        const facultyId = $("#FacultyId");

        $(document).ready(function () {
            fetchSchool();
            fetchFaculties();
        });

        function fetchSchool() {
            if ($.fn.DataTable.isDataTable("#tblSchool")) {
                tblSchool.DataTable().clear().destroy();
            }
            tblSchool.DataTable({
                paging: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                responsive: true,
                processing: true,
                serverSide: true,
                order: [[0, "desc"]],
                ajax: {
                    url: "/School/get-schools",
                    type: "POST",
                },
                columns: [
                    {data: "schoolId"},
                    {data: "schoolName"},
                    {data: "schoolNameInKhmer"},
                    {data: "schoolCode"},
                    {data: "facultyId"},
                    {
                        data: "isFoundationSchool",
                        render: function (data) {
                            return data === 1 ? "Yes" : "No";
                        }

                    },
                    {
                        data: null,
                        render: function () {
                            return `
                            <div class="text-center">
                                <button id="btnEdit" type="button" class="btn btn-success btn-sm">
                                    <i class="fas fa-edit"></i> Edit
                                </button>
                                <button id="btnDelete" type="button" class="btn btn-danger btn-sm btnDeleteSchool">
                                    <i class="fa-solid fa-trash"></i> Delete
                                </button>
                            </div>
                            `;
                        }
                    }
                ],
                initComplete: function () {
                    MyApp.utils.dataTableDebounceSearch("#tblSchool", 500);
                }
            });
        }

        function fetchFaculties(selectedId = null) {
            $.ajax({
                url: "/school/get-faculties",
                type: "GET",
                success: function (response) {
                    facultyId.empty();
                    facultyId.append('<option value="">Select Faculty</option>');

                    $.each(response.data, function (i, item) {
                        let selected = item.id === selectedId ? 'selected' : '';
                        $("#FacultyId").append(
                            `<option value="${item.id}" ${selected}> ${item.name}</option>
                            `
                        );
                    });
                },
                error: function (error) {
                    if(error.responseJSON && error.responseJSON.message) {
                        ShowToastError(error.responseJSON.message);
                    }
                }
            });
        }
        
        tblSchool.on("click", "#btnEdit", function () {
            let $row = $(this).closest('tr');
            if ($row.hasClass('child')) {
                $row = $row.prev();
            }
            const selectedRow = tblSchool.DataTable().row($row).data();
            console.log(selectedRow);
            
            const school = new School(selectedRow);
            $("#SchoolId").val(school.schoolId);
            $("#SchoolName").val(school.schoolName);
            $("#SchoolNameInKhmer").val(school.schoolNameInKhmer);
            $("#SchoolCode").val(school.schoolCode);
            $("#FacultyId").val(school.facultyId);
            $("#chkFoundation").prop("checked", school.isFoundationSchool === 1);
            $("#IsFoundationSchool").val(school.isFoundationSchool);

            $("#SchoolModal").modal("show");
        });

        tblSchool.on("click", "#btnDelete", function () {
            const $row = $(this).closest('tr');
            const selectedRow = tblSchool.DataTable().row($row).data();
            if (!confirm("Are you sure you want to delete this school?")) return;

            $.ajax({
                url: "/School/delete/" + selectedRow.schoolId,
                type: "DELETE",
                success: function (response) {
                    if (response.status.code === "200") {
                        ShowToastSuccess("Delete successfully!");
                        $("#tblSchool").DataTable().ajax.reload();
                    } else {
                        ShowToastError(response.message);
                    }
                },
                error: function (error) {
                    if (error.responseJSON && error.responseJSON.message) {
                        ShowToastError(error.responseJSON.message);
                    }
                }

            });
        });

        schoolForm.on("submit", function (e) {
            e.preventDefault();
            
            $("#IsFoundationSchool").val($("#chkFoundation").is(":checked")?1:0);
            const form = $(this);
            const formData = $(form).serialize();

            $.ajax({
                url: "/School/SaveChange",
                type: "POST",
                data: formData,
                success: function (response) {
                    if (response.status.code === "200") {
                        ShowToastSuccess("Saved successfully!");
                        $("#schoolForm")[0].reset();
                        $("#SchoolModal").modal("hide");
                        $("#tblSchool").DataTable().ajax.reload();
                    } else {
                        ShowToastError(response.message);
                    }
                },
                error: function (error) {
                    if (error.responseJSON && error.responseJSON.message) {
                        ShowToastError(error.responseJSON.message);
                    }
                }
            });
        });

        $(document).on("click", "#btnClose", function () {
            $("#schoolForm")[0].reset();
            $("#SchoolModal").modal("hide");
        });
    </script>
}
    