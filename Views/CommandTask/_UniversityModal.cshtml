@using BBU_SYSTEM.DTOs
@{
    var university = new UniversityDto();
}
<div class="modal fade" id="UniversityModal" data-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">University</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="universityForm">
                    <input asp-for="@university.UniversityId" hidden readonly class="form-control" value="0"/>
                    <input type="hidden" id="nationality_NationalityId" name="NationalityId" value="0"/>
                    <div class="form-group">
                        <label>Name</label>
                        <input type="text"
                               asp-for="@university.UniversityName"
                               class="form-control"
                               placeholder="Enter name" required>
                    </div>

                    <div class="form-group">
                        <label>Name Khmer</label>
                        <input type="text"
                               asp-for="@university.UniversityNameInKhmer"
                               class="form-control"
                               placeholder="Enter name khmer" required>
                    </div>
                    <label>Abbreviation Name</label>
                    <input type="text"
                           asp-for="@university.AbbreviationName"
                           class="form-control"
                           placeholder="Enter abbreviation" required/>
                </form>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="submit" form="universityForm" class="btn btn-success">
                    <i class="fas fa-save"></i> Save
                </button>

                <button id="btnClose" type="button" class="btn btn-danger">
                    <i class="fas fa-close"></i> Close
                </button>
            </div>
        </div>
    </div>
</div>