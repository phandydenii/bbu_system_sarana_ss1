@{
    ViewData["OpenMenu"] = "CommandTask";
    ViewData["Action"] = "University";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">University</h3>
                <button type="button" class="btn btn-success btn-sm float-right" data-toggle="modal" data-target="#UniversityModal">
                    <i class="fas fa-plus"></i>
                    Add New
                </button>
            </div>
            <div class="card-body">
                <table id="tblUniversity" class="table table-sm table-bordered table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Name Khmer</th>
                        <th>Short Name</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_UniversityModal"/>

@section Scripts{
    <script src="~/function/University.js"></script>
    <script>
    const tblUniversity = $("#tblUniversity");
    const btnClose = $("#btnClose");
    
    $(document).ready(async function () {
        fetchUniversity();
    });

    function fetchUniversity() {
        tblUniversity.DataTable().clear().destroy();
        tblUniversity.DataTable({
            paging: true,
            lengthChange: true,
            searching: true,
            ordering: true,
            info: true,
            responsive: true,
            processing: true,
            serverSide: true,
            order: [[0, "desc"]],
            ajax: {
                url: "/university/get-universities",
                type: "POST"
            },
            columns: [
                { data: "universityId" },
                { data: "universityName" },
                { data: "universityNameInKhmer" },
                { data: "abbreviationName" },
                {
                    data: null,
                    render: function () {
                        return `
                            <a id="btnEdit" class="btn btn-success btn-sm">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                        `;
                    }
                }
            ],
            initComplete: function(){
                MyApp.utils.dataTableDebounceSearch("#tblUniversity", 500);
            }
        });
    }
    
    tblUniversity.on("click", "#btnEdit", function (e) {
        e.preventDefault();

        let $row = $(this).closest('tr');
        if($row.hasClass('child')){
            $row = $row.prev();
        }
        const selectedRow = tblUniversity.DataTable().row($row).data();
        console.log(selectedRow);
        
        const university = new University(selectedRow);
        $("#university_UniversityId").val(university.universityId);
        $("#university_UniversityName").val(university.universityName);
        $("#university_UniversityNameInKhmer").val(university.universityNameInKhmer);
        $("#university_AbbreviationName").val(university.abbreviationName);
        
        $("#UniversityModal").modal("show");
      
    });

    
    $(document).on("click", "#btnClose", function (e) {
        e.preventDefault();
        $("#universityForm")[0].reset();
        $("#UniversityModal").modal("hide");
    });

    $(document).on("submit", "#universityForm", function (event) {
        event.preventDefault();

        if (!this.checkValidity()) {
            this.reportValidity();
            return;
        }
        const form = $(this);
        const formData = $(form).serialize();
        $("#university_id").val();
        $.ajax({
            url: "/university/SaveChange",
            method: "POST",
            data: formData,
            success: function (response) {
                if(response.status.code === "200"){
                    ShowToastSuccess("Saved successfully!");
                    $("#universityForm")[0].reset();
                    $("#UniversityModal").modal("hide");
                    $("#tblUniversity").DataTable().ajax.reload();
                } else {
                    ShowToastError(response.message);
                }
            },
            error: function (error) {
                if (error.responseJSON && error.responseJSON.message) {
                    ShowToastError(error.responseJSON.message);
                }
            }
        });
    });

    </script>
}
