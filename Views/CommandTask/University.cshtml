@{
    ViewData["OpenMenu"] = "CommandTask";
    ViewData["Action"] = "University";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">University</h3>
                <button type="button" id="btnNewUniversity" class="btn btn-success btn-sm float-right" >
                    <i class="fas fa-plus"></i>
                    Add New
                </button>
            </div>
            <div class="card-body">
                <table id="tblUniversity" class="table table-sm table-bordered table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Name Khmer</th>
                        <th>Short Name</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_UniversityModal"/>

@section Scripts{

    <script>
    const tblUniversity = $("#tblUniversity");
    const universityModal = $("#universityModal");
    const formUniversity = $("#formUniversity");

    const universityIdInput = $("#university_UniversityId");
    const universityNameInput = $("#university_UniversityName");
    const universityNameKhmerInput = $("#university_UniversityNameInKhmer");
    const abbreviationNameInput = $("#university_AbbreviationName");

    $(document).ready(function () {
        fetchUniversity();

        $("#btnNewUniversity").on("click", function (e) {
            e.preventDefault();

            clearUniversityForm();

            universityModal.find(".modal-title").text("Add University");
            universityModal.modal("show");
        });
    });

    function truncateText(data, maxLength = 30) {
        if (data === null || data === undefined) return "";

        let text = data.toString();

        return text.length > maxLength
            ? text.substring(0, maxLength) + "..."
            : text;
    }

    function renderTruncate(data) {
        if (data === null || data === undefined) return "";

        let text = data.toString();

        return `<span title="${text}">${truncateText(text, 30)}</span>`;
    }

    function fetchUniversity() {
        if ($.fn.DataTable.isDataTable("#tblUniversity")) {
            tblUniversity.DataTable().clear().destroy();
            tblUniversity.empty();
        }

        universityTable = tblUniversity.DataTable({
            destroy: true,
            paging: true,
            lengthChange: true,
            searching: true,
            ordering: true,
            info: true,

            responsive: false,
            autoWidth: false,
            scrollX: true,
            scrollCollapse: true,

            processing: true,
            serverSide: true,
            ajax: {
                url: "/university/get-universities",
                type: "POST",
                error: function (xhr) {
                    console.log(xhr.responseText);
                    ShowToastError("Cannot load university data.");
                }
            },

            columns: [
                {
                    title: "ID",
                    data: "universityId",
                    width: "70px"
                },
                {
                    title: "University Name",
                    data: "universityName",
                    width: "300px",
                    render: function (data) {
                        return renderTruncate(data);
                    }
                },
                {
                    title: "University Name Khmer",
                    data: "universityNameInKhmer",
                    width: "320px",
                    render: function (data) {
                        return renderTruncate(data);
                    }
                },
                {
                    title: "Abbreviation",
                    data: "abbreviationName",
                    width: "150px",
                    render: function (data) {
                        return renderTruncate(data);
                    }
                },
                {
                    title: "Action",
                    data: null,
                    width: "100px",
                    className: "text-center",
                    orderable: false,
                    searchable: false,
                    render: function () {
                        return `
                        <a href="javascript:void(0)" class="btnEdit btn btn-success btn-sm">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                    `;
                    }
                }
            ],

            initComplete: function () {
                let api = this.api();
                MyApp.utils.dataTableDebounceSearch("#tblUniversity", 500);

                setTimeout(function () {
                    api.columns.adjust();
                }, 500);
            },

            drawCallback: function () {
                this.api().columns.adjust();
            }
        });

        setTimeout(function () {
            universityTable.columns.adjust();
        }, 1000);
    }

    function adjustDataTables() {
        setTimeout(function () {
            $.fn.dataTable
                .tables({ visible: true, api: true })
                .columns.adjust();
        }, 300);

        setTimeout(function () {
            $.fn.dataTable
                .tables({ visible: true, api: true })
                .columns.adjust();
        }, 700);
    }
    

    function clearUniversityForm() {
        formUniversity[0].reset();

        universityIdInput.val(0);
        universityNameInput.val("");
        universityNameKhmerInput.val("");
        abbreviationNameInput.val("");
    }

    tblUniversity.on("click", ".btnEdit", function (e) {
        e.preventDefault();

        let row = $(this).closest("tr");

        if (row.hasClass("child")) {
            row = row.prev();
        }

        const selectedRow = tblUniversity.DataTable().row(row).data();

        if (!selectedRow) {
            ShowToastError("Cannot get selected university data.");
            return;
        }

        universityIdInput.val(selectedRow["universityId"]);
        universityNameInput.val(selectedRow["universityName"]);
        universityNameKhmerInput.val(selectedRow["universityNameInKhmer"]);
        abbreviationNameInput.val(selectedRow["abbreviationName"] || "");

        universityModal.find(".modal-title").text("Edit University");
        universityModal.modal("show");
    });

    $(document).on("click", ".btnCloseUniversity", function (e) {
        e.preventDefault();

        clearUniversityForm();
        universityModal.modal("hide");
    });

    $(document).on("submit", "#formUniversity", function (e) {
        e.preventDefault();

        const universityId = universityIdInput.val() || "0";
        const universityName = (universityNameInput.val() || "").trim();
        const universityNameKhmer = (universityNameKhmerInput.val() || "").trim();
        const abbreviationName = (abbreviationNameInput.val() || "").trim();

        $.ajax({
            url: "/university/SaveChange",
            method: "POST",
            data: {
                UniversityId: universityId,
                UniversityName: universityName,
                UniversityNameInKhmer: universityNameKhmer,
                AbbreviationName: abbreviationName
            },
            success: function (response) {
                const code = response.status?.code;
                const message = response.status?.message;

                if (code === "200" || code === 200) {
                    ShowToastSuccess(
                        message ||
                        (universityId !== "0" ? "Updated successfully!" : "Saved successfully!")
                    );

                    clearUniversityForm();
                    universityModal.modal("hide");
                    tblUniversity.DataTable().ajax.reload();
                } else {
                    ShowToastError(message || "Save failed.");
                }
            },
            error: function (xhr) {
                const message =
                    xhr["responseJSON"]?.["status"]?.["message"] ||
                    xhr["responseJSON"]?.["message"] ||
                    "Server error.";

                ShowToastError(message);
            }
        });
    });
</script>
}
