@{
    ViewData["OpenMenu"] = "CommandTask";
    ViewData["Action"] = "Degree";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Degree</h3>
                <button type="submit" class="btn btn-success btn-sm float-right" data-toggle="modal"
                        data-target="#DegreeModal">
                    <i class="fas fa-plus"></i>
                    Add New
                </button>
            </div>
            <div class="card-body">
                <table id="tblDegree" class="table table-sm table-bordered table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Name Khmer</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_ValidationScriptsPartial"/>
<partial name="_DegreeModal"/>

@section Scripts
{
    <script src="~/function/Degree.js"></script>
    <script>
        const tblDegree = $("#tblDegree");
        const degreeModal = $("#DegreeModal");
        const btnClose = $("#btnClose");

        $(document).ready(async function () {
            fetchDegree();
        });

        function fetchDegree() {
            tblDegree.DataTable().clear().destroy();
            tblDegree.DataTable({
                paging: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                responsive: true,
                processing: true,
                serverSide: true,
                ajax: {
                    url: "/degree/get-degrees",
                    type: "POST",
                },
                columns: [
                    {data: "degreeId"},
                    {data: "degreeName"},
                    {data: "degreeInKhmer"},
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `
                        <a id="btnEdit" class="btn btn-success btn-sm"><i class='fas fa-edit'></i> Edit</a>
                        <a id="btnDelete" class="btn btn-danger btn-sm"><i class="fa-solid fa-trash"></i> Delete</a>
                    `;
                        }
                    }
                ]
            });
        }

        tblDegree.on("click", "#btnEdit", function (e) {
            e.preventDefault();

            let row = $(this).closest("tr");

            if (row.hasClass("child")) {
                row = row.prev();
            }

            const selectedRow = tblDegree.DataTable().row(row).data();

            if (!selectedRow) {
                ShowToastError("Cannot get selected degree data.");
                return;
            }

            $("#degree_DegreeId").val(selectedRow.degreeId);
            $("#degree_DegreeName").val(selectedRow.degreeName);
            $("#degree_DegreeInKhmer").val(selectedRow.degreeInKhmer);

            $("#DegreeModal").find(".modal-title").text("Edit Degree");
            $("#DegreeModal").modal("show");
        });

        tblDegree.on("click", "#btnDelete", function (e) {
            e.preventDefault();

            let row = $(this).closest("tr");

            if (row.hasClass("child")) {
                row = row.prev();
            }

            const selectedRow = tblDegree.DataTable().row(row).data();

            if (!selectedRow) {
                ShowToastError("Cannot get selected degree data.");
                return;
            }

            if (!confirm("Are you sure you want to delete this degree?")) {
                return;
            }

            $.ajax({
                url: "/degree/delete/" + selectedRow.degreeId,
                method: "DELETE",
                success: function (response) {
                    const code = response.status?.code;
                    const message = response.status?.message;

                    if (code === "200" || code === 200) {
                        ShowToastSuccess(message || "Deleted successfully!");
                        $("#tblDegree").DataTable().ajax.reload();
                    } else {
                        ShowToastError(message || "Delete failed.");
                    }
                },
                error: function (xhr) {
                    const message =
                        xhr["responseJSON"]?.["status"]?.["message"] ||
                        xhr["responseJSON"]?.["message"] ||
                        "Delete failed.";

                    ShowToastError(message);
                }
            });
        });

        $("#degreeForm").on("submit", function (e) {
            e.preventDefault();

            const degreeId = $("#degree_DegreeId").val() || "0";
            const degreeName = ($("#degree_DegreeName").val() || "").trim();
            const degreeKhmer = ($("#degree_DegreeInKhmer").val() || "").trim();

            if (degreeName === "") {
                ShowToastError("Degree name is required.");
                $("#degree_DegreeName").focus();
                return;
            }

            if (degreeKhmer === "") {
                ShowToastError("Degree name Khmer is required.");
                $("#degree_DegreeInKhmer").focus();
                return;
            }

            const formData = $("#degreeForm").serialize();

            $.ajax({
                url: "/Degree/SaveChange",
                method: "POST",
                data: formData,
                success: function (response) {
                    const code = response.status?.code;
                    const message = response.status?.message;

                    if (code === "200" || code === 200) {
                        if (degreeId !== "0") {
                            ShowToastSuccess(message || "Updated successfully!");
                        } else {
                            ShowToastSuccess(message || "Saved successfully!");
                        }

                        $("#degreeForm")[0].reset();
                        $("#degree_DegreeId").val(0);
                        $("#DegreeModal").modal("hide");
                        $("#tblDegree").DataTable().ajax.reload();
                    } else {
                        ShowToastError(message || "Save failed.");
                    }
                },
                error: function (xhr) {
                    const message =
                        xhr["responseJSON"]?.["status"]?.["message"] ||
                        xhr["responseJSON"]?.["message"] ||
                        "Server error.";

                    ShowToastError(message);
                }
            });
        });

        btnClose.on("click", function (e) {
            e.preventDefault();

            $("#degreeForm")[0].reset();
            $("#degree_DegreeId").val(0);
            $("#DegreeModal").modal("hide");
        });
    </script>
}
