<div class="modal fade" id="provinceModal" data-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Province</h4>
            </div>
            <div class="modal-body">
                <form id="formProvince">
                    <div class="form-group">
                        <label>Name</label>
                        <input type="text" class="form-control"
                               placeholder="Enter name">
                    </div>
                    <div class="form-group">
                        <label>Name Khmer</label>
                        <input type="text" class="form-control"
                               placeholder="Enter name khmer">
                    </div>
                    <div class="form-group clearfix">
                        <div class="icheck-primary d-inline">
                            <input type="radio" id="rdoProjectPaper" value="0">
                            <label for="rdoProjectPaper">Is City</label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-success float-right" form="fieldForm"><i class="fas fa-save"></i>
                    Save
                </button>
                <button class="btn btn-danger float-right" data-dismiss="modal"><i class="fas fa-close"></i> Close
                </button>
            </div>
        </div>
    </div>
</div>