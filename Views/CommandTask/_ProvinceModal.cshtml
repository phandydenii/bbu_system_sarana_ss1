@using BBU_SYSTEM.DTOs
@using Province = BBU_SYSTEM.Modelsss.Province
@{
    @model ProvinceDto;
    //var province = new ProvinceDto();
}
<div class="modal fade" id="ProvinceModal" data-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Province</h4>
            </div>
            <div class="modal-body">
                <form id="provinceForm">
                    <input asp-for="ProvinceId" hidden readonly class="form-control" value="0"/>
                    <div class="form-group">
                        <label>Name</label>
                        <input type="text" asp-for="ProvinceName" class="form-control"
                               placeholder="Enter name" required>
                    </div>
                    <div class="form-group">
                        <label>Name Khmer</label>
                        <input type="text" asp-for="ProvinceInKhmer" class="form-control"
                               placeholder="Enter name khmer" required>
                    </div>
                    <div class="form-group">
                        <input type="checkbox" id="chkIsCity"/>
                        <label for="chkIsCity"> City</label>
                        <input hidden id="isCity" name="isCity" value="0" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="submit" form="provinceForm" class="btn btn-success">
                    <i class="fas fa-save"></i> Save
                </button>
                <button type="button" id="btnClose" class="btn btn-danger">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>