@{
ViewData["Title"] = "Payment Items";
ViewData["OpenMenu"] = "Administration";
ViewData["Action"] = "Index";
ViewData["HideHeader"] = true;
}

<style>
    #paymentProductPage .dataTables_wrapper,
    #paymentProductPage .product-table-container {
        width: 100%;
    }

    #tblProduct {
        width: 100% !important;
        min-width: 1600px;
    }

    #tblProductPayOnline {
        width: 100% !important;
        min-width: 1300px;
    }

    #paymentProductPage table.dataTable th,
    #paymentProductPage table.dataTable td {
        white-space: nowrap !important;
        vertical-align: middle !important;
    }

    #paymentProductPage table.dataTable thead th {
        padding-right: 24px !important;
    }

    #paymentProductPage .dataTables_scrollBody {
        overflow-x: auto !important;
    }

    #paymentProductPage .dt-action {
        min-width: 170px !important;
        width: 170px !important;
    }

    #paymentProductPage .dt-action-wrap {
        display: inline-flex;
        gap: 5px;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
    }

    #paymentProductPage .badge {
        padding: 0.35em 0.65em;
    }

    #paymentProductPage #custom-tabs-four-tab {
        gap: 0.65rem;
    }

    #paymentProductPage #custom-tabs-four-tab .product-tab-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0.65rem 1rem;
        border: 1px solid #1b1768 !important;
        border-radius: 0.3rem;
        background: #ffffff !important;
        color: #1b1768 !important;
        font: inherit;
        font-weight: 600;
        line-height: 1.5;
        text-decoration: none;
        white-space: normal;
        cursor: pointer;
        pointer-events: auto;
        box-shadow: 0 1px 3px rgba(27, 23, 104, 0.12);
    }

    #paymentProductPage #custom-tabs-four-tab .product-tab-button:hover {
        background: #f0efff !important;
    }

    #paymentProductPage #custom-tabs-four-tab .product-tab-button.active {
        background: #1b1768 !important;
        color: #ffffff !important;
    }

    #paymentProductPage #custom-tabs-four-tab .product-tab-button:focus-visible {
        outline: 3px solid #a6a2f5;
        outline-offset: 3px;
    }

    @@media (max-width: 575.98px) {
        #paymentProductPage #custom-tabs-four-tab .nav-item {
            width: 100%;
        }

        #paymentProductPage #custom-tabs-four-tab .product-tab-button {
            width: 100%;
        }
    }
</style>

<div id="paymentProductPage" class="container-fluid px-0 pt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="m-0 font-weight-bold text-dark">Payment Items</h3>
            <small class="text-muted">Manage tuition payment products and WeBill payment settings</small>
        </div>
    </div>

    <!-- Keep both original tabs and their existing targets. -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body p-2">
            <ul class="nav nav-pills flex-wrap" id="custom-tabs-four-tab" role="tablist">
                <li class="nav-item">
                    <button type="button"
                            class="nav-link product-tab-button active"
                            id="custom-tabs-four-1-tab"
                            data-product-tab="custom-tabs-four-1"
                            role="tab"
                            aria-controls="custom-tabs-four-1"
                            aria-selected="true"
                            tabindex="0">
                        <i class="fas fa-box mr-2" aria-hidden="true"></i>
                        ផលិតផលបង់ថ្លៃសិក្សា
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button"
                            class="nav-link product-tab-button"
                            id="custom-tabs-four-2-tab"
                            data-product-tab="custom-tabs-four-2"
                            role="tab"
                            aria-controls="custom-tabs-four-2"
                            aria-selected="false"
                            tabindex="-1">
                        <i class="fas fa-globe mr-2" aria-hidden="true"></i>
                        ផលិតផលបង់ថ្លៃសិក្សាលើ WeBill
                    </button>
                </li>
            </ul>
        </div>
    </div>

    <!-- Shared date range; each table keeps its built-in text search. -->
    <div class="card card-outline card-primary shadow-sm mb-4">
        <div class="card-header bg-white py-2">
            <h3 class="card-title font-weight-bold text-secondary" style="font-size: 0.95rem;">
                <i class="fas fa-filter text-primary mr-1"></i>
                Filter Payment Items
            </h3>
            <div class="card-tools">
                <button type="button"
                        class="btn btn-tool"
                        data-card-widget="collapse"
                        aria-label="Collapse product filters">
                    <i class="fas fa-minus"></i>
                </button>
            </div>
        </div>
        <div class="card-body bg-light py-3">
            <form id="frmProductDateFilters">
                <div class="row align-items-end">
                    <div class="col-md-2 col-sm-6 mb-2 mb-md-0">
                        <label for="productFromDate" class="text-secondary small font-weight-bold">
                            From Date
                        </label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-white border-right-0">
                                    <i class="far fa-calendar-alt text-muted"></i>
                                </span>
                            </div>
                            <input type="date"
                                   id="productFromDate"
                                   name="fromDate"
                                   class="form-control border-left-0" />
                        </div>
                    </div>
                    <div class="col-md-2 col-sm-6 mb-2 mb-md-0">
                        <label for="productToDate" class="text-secondary small font-weight-bold">
                            To Date
                        </label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-white border-right-0">
                                    <i class="far fa-calendar-alt text-muted"></i>
                                </span>
                            </div>
                            <input type="date"
                                   id="productToDate"
                                   name="toDate"
                                   class="form-control border-left-0" />
                        </div>
                    </div>
                    <div class="col-md-2 col-sm-12 mb-2 mb-md-0 d-flex">
                        <div class="btn-group shadow-sm" role="group" aria-label="Product date filters">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-search mr-1"></i>
                                Filter
                            </button>
                            <button type="button"
                                    id="btnResetProductDateFilters"
                                    class="btn btn-success border-left"
                                    title="Reset filters"
                                    aria-label="Reset product date filters">
                                <i class="fas fa-redo-alt"></i>
                            </button>
                        </div>
                    </div>
                    <div id="productCreateAction" class="col-md-6 col-sm-12 mt-2 mt-md-0 text-md-right">
                        <button type="button" class="btn btn-primary shadow-sm" id="btnAddNewProduct">
                            <i class="fas fa-plus-circle mr-1"></i>
                            Add New Product
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="tab-content" id="custom-tabs-four-tabContent">
        <div class="tab-pane fade show active"
             id="custom-tabs-four-1"
             role="tabpanel"
             aria-labelledby="custom-tabs-four-1-tab">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="product-table-container">
                        <table id="tblProduct"
                               class="table table-sm table-hover table-bordered table-striped w-100"
                               style="width: 100%;">
                            <thead class="thead-light">
                            <tr>
                                <th>ID</th>
                                <th>Item Name</th>
                                <th>Name Khmer</th>
                                <th>Price KHR</th>
                                <th>Price USD</th>
                                <th>Degree</th>
                                <th>VAT</th>
                                <th>Default Pay</th>
                                <th>Category</th>
                                <th>Card</th>
                                <th>Fee</th>
                                <th>Status</th>
                                <th class="text-center">Action</th>
                            </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade"
             id="custom-tabs-four-2"
             role="tabpanel"
             aria-labelledby="custom-tabs-four-2-tab">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="product-table-container">
                        <table id="tblProductPayOnline"
                               class="table table-sm table-hover table-bordered table-striped w-100 nowrap"
                               style="width: 100%;">
                            <thead class="thead-light">
                            <tr>
                                <th>ID</th>
                                <th>Product</th>
                                <th>Degree</th>
                                <th>School</th>
                                <th>Price USD</th>
                                <th>Price KHR</th>
                                <th>From Promotion</th>
                                <th class="text-center">Action</th>
                            </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Native tab buttons keep working independently of the Bootstrap tab plugin.
    (function () {
        const tabList = document.getElementById("custom-tabs-four-tab");
        if (!tabList) return;

        const buttons = Array.from(
            tabList.querySelectorAll("button[data-product-tab]")
        );
        if (!buttons.length) return;

        function activateProductTab(button, moveFocus) {
            const selectedId = button.getAttribute("data-product-tab");
            if (!document.getElementById(selectedId)) return;

            buttons.forEach(function (item) {
                const isSelected = item === button;
                const pane = document.getElementById(
                    item.getAttribute("data-product-tab")
                );

                item.classList.toggle("active", isSelected);
                item.setAttribute("aria-selected", String(isSelected));
                item.tabIndex = isSelected ? 0 : -1;

                if (pane) {
                    pane.hidden = !isSelected;
                    pane.classList.toggle("active", isSelected);
                    pane.classList.toggle("show", isSelected);
                }
            });

            const createAction = document.getElementById("productCreateAction");
            if (createAction) {
                createAction.classList.toggle(
                    "d-none",
                    selectedId !== "custom-tabs-four-1"
                );
            }

            if (moveFocus) button.focus();

            // Recalculate the visible table after changing tabs, when available.
            const jq = window.jQuery;
            if (typeof jq === "function" && jq.fn?.DataTable?.isDataTable) {
                const tableSelector = selectedId === "custom-tabs-four-1"
                    ? "#tblProduct"
                    : "#tblProductPayOnline";

                window.setTimeout(function () {
                    if (jq.fn.DataTable.isDataTable(tableSelector)) {
                        jq(tableSelector).DataTable().columns.adjust();
                    }
                }, 200);
            }
        }

        tabList.addEventListener("click", function (event) {
            const button = event.target.closest("button[data-product-tab]");
            if (!button || !tabList.contains(button)) return;

            event.preventDefault();
            activateProductTab(button, false);
        });

        tabList.addEventListener("keydown", function (event) {
            const button = event.target.closest("button[data-product-tab]");
            const index = buttons.indexOf(button);
            if (index < 0) return;

            let nextIndex;
            if (event.key === "ArrowRight") {
                nextIndex = (index + 1) % buttons.length;
            } else if (event.key === "ArrowLeft") {
                nextIndex = (index - 1 + buttons.length) % buttons.length;
            } else if (event.key === "Home") {
                nextIndex = 0;
            } else if (event.key === "End") {
                nextIndex = buttons.length - 1;
            } else {
                return;
            }

            event.preventDefault();
            activateProductTab(buttons[nextIndex], true);
        });

        activateProductTab(
            buttons.find(function (button) {
                return button.classList.contains("active");
            }) || buttons[0],
            false
        );
    })();
</script>

<partial name="_ValidationScriptsPartial" />
<partial name="_ProductModal" />
<partial name="_ProductPayOnline" />

@section Scripts {
<script src="~/function/Degree.js"></script>
<script src="~/function/School.js"></script>
<script src="~/js/Components.js"></script>

<script>
    const tblProduct = $("#tblProduct");
    const tblProductPayOnline = $("#tblProductPayOnline");

    const modalProduct = $("#ProductModal");
    const ProductPayOnlineModal = $("#ProductPayOnlineModal");

    const btnAddNewProduct = $("#btnAddNewProduct");
    const btnCloseProduct = $("#btnCloseProduct");
    const btnCloseProductWeBill = $("#btnCloseProductWeBill");

    const frmProduct = $("#frmProduct");
    const frmProductWeBill = $("#frmProductWeBill");

    const cboDegree = $("#productDetail_DegreeId");
    const cboSchool = $("#productDetail_SchoolId");
    const cboProduct = $("#productDetail_ProductId");

    $(document).ready(function () {
        fetchProduct();
        fetchProductPayOnline();

        $("#frmProductDateFilters")
            .off("submit.productDateFilters")
            .on("submit.productDateFilters", function (event) {
                event.preventDefault();
                applyProductDateFilter();
            });

        $("#btnResetProductDateFilters")
            .off("click.productDateFilters")
            .on("click.productDateFilters", function () {
                $("#productFromDate, #productToDate").val("");
                reloadProductDateFilteredTables();
            });

        Components.BindSelectOptions(
            "/product/get-product-category-list",
            "product_CategoryId",
            "categoryId",
            "categoryName"
        );
    });
    function addProductDateParameters(request) {
        // Both list-controller actions must apply these optional parameters
        // to the intended date field before counting and paging their queries.
        request.fromDate = $("#productFromDate").val() || "";
        request.toDate = $("#productToDate").val() || "";
    }

    function applyProductDateFilter() {
        const fromDate = $("#productFromDate").val();
        const toDate = $("#productToDate").val();

        if (fromDate && toDate && fromDate > toDate) {
            const message = "From Date must not be later than To Date.";

            if (typeof ShowToastError === "function") {
                ShowToastError(message);
            } else {
                alert(message);
            }
            return;
        }

        reloadProductDateFilteredTables();
    }

    function reloadProductDateFilteredTables() {
        ["#tblProduct", "#tblProductPayOnline"].forEach(function (selector) {
            if ($.fn.DataTable.isDataTable(selector)) {
                $(selector).DataTable().ajax.reload(null, true);
            }
        });
    }

    function fetchProduct() {
        if ($.fn.DataTable.isDataTable("#tblProduct")) {
            tblProduct.DataTable().clear().destroy();
            tblProduct.find("tbody").empty();
        }

        tblProduct.DataTable({
            paging: true,
            lengthChange: true,
            searching: true,
            ordering: true,
            info: true,

            responsive: false,
            autoWidth: false,
            scrollX: true,
            scrollCollapse: true,

            processing: true,
            serverSide: true,

            order: [[0, "desc"]],

            ajax: {
                url: "/product/get-product-list",
                type: "POST",
                dataType: "json",
                data: addProductDateParameters,
                error: function (xhr) {
                    console.log(xhr.responseText);
                    ShowToastError("Cannot load product list.");
                }
            },

            columns: [
                {
                    title: "ID",
                    data: "productId",
                    width: "60px"
                },
                {
                    title: "Item Name",
                    data: "productName",
                    width: "230px",
                    render: function (data) {
                        return renderTruncate(data);
                    }
                },
                {
                    title: "Name Khmer",
                    data: "productNameInKhmer",
                    width: "260px",
                    render: function (data) {
                        return renderTruncate(data);
                    }
                },
                {
                    title: "Price KHR",
                    data: "priceKhr",
                    width: "120px",
                    render: function (data) {
                        return data ?? 0;
                    }
                },
                {
                    title: "Price USD",
                    data: "price",
                    width: "120px",
                    render: function (data) {
                        return data ?? 0;
                    }
                },
                {
                    title: "Degree",
                    data: "degreeId",
                    width: "120px",
                    render: function (data) {
                        return data ?? "";
                    }
                },
                {
                    title: "VAT",
                    data: "vat",
                    width: "90px",
                    render: function (data) {
                        return data ?? 0;
                    }
                },
                {
                    title: "Default Pay",
                    data: "paymentType",
                    width: "120px",
                    render: function (data) {
                        return data
                            ? '<span class="badge bg-info">KHR</span>'
                            : '<span class="badge bg-success">USD</span>';
                    }
                },
                {
                    title: "Category",
                    data: "categoryId",
                    width: "110px",
                    render: function (data) {
                        return data ?? "";
                    }
                },
                {
                    title: "Card",
                    data: "cardCertificate",
                    width: "90px",
                    render: function (data) {
                        return data
                            ? '<span class="badge badge-success">Yes</span>'
                            : '<span class="badge badge-secondary">No</span>';
                    }
                },
                {
                    title: "Fee",
                    data: "tuitionFees",
                    width: "90px",
                    render: function (data) {
                        return data
                            ? '<span class="badge badge-success">Yes</span>'
                            : '<span class="badge badge-secondary">No</span>';
                    }
                },
                {
                    title: "Status",
                    data: "hidden",
                    width: "100px",
                    render: function (data) {
                        return data
                            ? '<span class="badge badge-danger">Hidden</span>'
                            : '<span class="badge badge-success">Show</span>';
                    }
                },
                {
                    title: "Action",
                    data: null,
                    width: "170px",
                    className: "dt-action text-center",
                    orderable: false,
                    searchable: false,
                    render: function () {
                        return `
                        <div class="dt-action-wrap">
                            <button type="button" class="btn btn-warning btn-sm btnEditProduct">
                                <i class="fas fa-edit"></i> Edit
                            </button>
                            <button type="button" class="btn btn-danger btn-sm btnDeleteProduct">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </div>
                    `;
                    }
                }
            ],

            initComplete: function () {
                const api = this.api();

                MyApp.utils.dataTableDebounceSearch("#tblProduct", 500);

                setTimeout(function () {
                    api.columns.adjust();
                }, 300);
            },

            drawCallback: function () {
                const api = this.api();

                setTimeout(function () {
                    api.columns.adjust();
                }, 100);
            }
        });

        setTimeout(function () {
            tblProduct.DataTable().columns.adjust();
        }, 1000);
    }

    function fetchProductPayOnline() {
        if ($.fn.DataTable.isDataTable("#tblProductPayOnline")) {
            tblProductPayOnline.DataTable().clear().destroy();
        }

        tblProductPayOnline.DataTable({
            paging: true,
            lengthChange: true,
            searching: true,
            ordering: true,
            info: true,

            processing: true,
            serverSide: true,

            responsive: false,
            autoWidth: false,
            scrollX: true,
            scrollCollapse: true,

            order: [[0, "desc"]],

            ajax: {
                url: "/product/get-product-detail-list",
                type: "POST",
                dataType: "json",
                data: addProductDateParameters,

                dataSrc: function (json) {
                    console.log("Product WeBill response:", json);
                    return json.data || [];
                },

                error: function (xhr) {
                    console.log(xhr.responseText);
                    ShowToastError("Cannot load WeBill product list.");
                }
            },

            columns: [
                { data: "productDetailId" },
                { data: "productName" },
                { data: "degreeName" },
                { data: "schoolName" },
                {
                    data: "price",
                    render: function (data) {
                        return data ?? 0;
                    }
                },
                {
                    data: "priceKhr",
                    render: function (data) {
                        return data ?? 0;
                    }
                },
                {
                    data: "fromPromotionNo",
                    render: function (data) {
                        return data ?? "";
                    }
                },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    className: "text-center",
                    render: function () {
                        return `
                        <button type="button" class="btn btn-warning btn-sm btnEditProductWeBill">
                            <i class="fas fa-edit"></i> Edit
                        </button>
                    `;
                    }
                }
            ],

            initComplete: function () {
                const api = this.api();

                MyApp.utils.dataTableDebounceSearch("#tblProductPayOnline", 500);

                setTimeout(function () {
                    api.columns.adjust();
                }, 300);
            },

            drawCallback: function () {
                const api = this.api();

                setTimeout(function () {
                    api.columns.adjust();
                }, 100);
            }
        });
    }

    btnAddNewProduct.off("click").on("click", function () {
        frmProduct[0].reset();

        $("#product_ProductId").val(0);
        $("#radioPrimary2").prop("checked", true);
        $("#product_PaymentType").prop("checked", false);

        modalProduct.find(".modal-title").text("Add New Product");
        modalProduct.modal("show");
    });

    $(document)
        .off("click", "#tblProduct .btnEditProduct")
        .on("click", "#tblProduct .btnEditProduct", function (e) {
            e.preventDefault();

            const table = $("#tblProduct").DataTable();
            let rowElement = $(this).closest("tr");

            if (rowElement.hasClass("child")) {
                rowElement = rowElement.prev();
            }

            const data = table.row(rowElement).data();

            if (!data) {
                ShowToastError("Cannot get selected product.");
                return;
            }

            console.log("Edit product:", data);

            $("#product_ProductId").val(data.productId);
            $("#product_ProductName").val(data.productName);
            $("#product_ProductNameInKhmer").val(data.productNameInKhmer);
            $("#product_PriceKhr").val(data.priceKhr);
            $("#product_Price").val(data.price);
            $("#product_DegreeId").val(data.degreeId);
            $("#product_CategoryId").val(data.categoryId).trigger("change");
            $("#product_FromPromotion").val(data.fromPromotion);
            $("#product_Vat").val(data.vat);
            $("#product_CardCertificate").val(data.cardCertificate);
            $("#product_Type").val(data.type);

            $("#isFee").prop("checked", data.tuitionFees);
            $("#isHidden").prop("checked", data.hidden);

            $("#product_PaymentType").prop("checked", data.paymentType);
            $("#radioPrimary1").prop("checked", data.paymentType);
            $("#radioPrimary2").prop("checked", !data.paymentType);

            modalProduct.find(".modal-title").text("Edit Product");
            modalProduct.modal("show");
        });

    $(document)
        .off("click", "#tblProduct .btnDeleteProduct")
        .on("click", "#tblProduct .btnDeleteProduct", function (e) {
            e.preventDefault();

            const table = $("#tblProduct").DataTable();
            let rowElement = $(this).closest("tr");

            if (rowElement.hasClass("child")) {
                rowElement = rowElement.prev();
            }

            const data = table.row(rowElement).data();

            if (!data) {
                ShowToastError("Cannot get selected product.");
                return;
            }

            console.log("Delete product:", data);

            if (!confirm("Are you sure you want to delete this product?")) {
                return;
            }

            $.ajax({
                url: "/product/delete-product/" + data.productId,
                type: "DELETE",

                success: function (response) {
                    const code = response.status?.code;
                    const message = response.status?.message;

                    if (code === "200" || code === 200) {
                        ShowToastSuccess(message || "Deleted successfully!");
                        tblProduct.DataTable().ajax.reload(null, false);
                    } else {
                        ShowToastError(message || "Delete failed.");
                    }
                },

                error: function (xhr) {
                    console.log(xhr.responseText);
                    ShowToastError("Delete failed.");
                }
            });
        });

    $("#radioPrimary1").off("change").on("change", function (e) {
        $("#product_PaymentType").prop("checked", e.target.checked);
    });

    $("#radioPrimary2").off("change").on("change", function (e) {
        $("#product_PaymentType").prop("checked", !e.target.checked);
    });

    btnCloseProduct.off("click").on("click", function () {
        frmProduct[0].reset();
        modalProduct.modal("hide");
    });

    frmProduct.off("submit").on("submit", function (e) {
        e.preventDefault();

        const form = $(this);
        const formData = form.serialize();

        $.ajax({
            url: "/product/save-change-product",
            method: "POST",
            data: formData,

            success: function (response) {
                const code = response.status?.code;
                const message = response.status?.message;

                if (code === "200" || code === 200) {
                    ShowToastSuccess(message || "Saved successfully!");

                    frmProduct[0].reset();
                    modalProduct.modal("hide");
                    tblProduct.DataTable().ajax.reload(null, false);
                } else {
                    ShowToastError(message || "Save failed.");
                }
            },

            error: function (xhr) {
                console.log(xhr.responseText);
                ShowToastError(xhr.responseText || "Server error.");
            }
        });
    });

    $(document)
        .off("click", "#tblProductPayOnline .btnEditProductWeBill")
        .on("click", "#tblProductPayOnline .btnEditProductWeBill", async function (e) {
            e.preventDefault();
            e.stopPropagation();

            const table = $("#tblProductPayOnline").DataTable();

            let rowElement = $(this).closest("tr");

            if (rowElement.hasClass("child")) {
                rowElement = rowElement.prev();
            }

            const row = table.row(rowElement).data();

            if (!row) {
                ShowToastError("Cannot get selected WeBill product.");
                return;
            }

            console.log("Edit WeBill product:", row);

            await GetDegree();
            await GetSchool();
            await GetProduct();

            $("#productDetail_ProductDetailId").val(row.productDetailId);
            $("#productDetail_ProductId").val(row.productId).trigger("change");
            $("#productDetail_DegreeId").val(row.degreeId).trigger("change");
            $("#productDetail_SchoolId").val(row.schoolId).trigger("change");
            $("#productDetail_FromPromotionNo").val(row.fromPromotionNo);

            ProductPayOnlineModal.find(".modal-title").text("Edit Product WeBill Payment");
            ProductPayOnlineModal.modal("show");
        });

    async function GetDegree() {
        cboDegree.empty();
        cboDegree.append("<option value='' disabled selected>Select Degree</option>");

        try {
            const degrees = await Degree.GetAllDegree();

            degrees.forEach(function (item) {
                cboDegree.append(`
                <option value="${item.degreeId}">
                    ${item.degreeName}
                </option>
            `);
            });

            cboDegree.val("").trigger("change");
        } catch (err) {
            console.log(err);
            ShowToastError("Cannot load degree.");
        }
    }

    async function GetSchool() {
        cboSchool.empty();
        cboSchool.append("<option value='' disabled selected>Select School</option>");

        try {
            const schools = await School.GetSchool();

            schools.forEach(function (item) {
                cboSchool.append(`
                <option value="${item.schoolId}">
                    ${item.schoolName}
                </option>
            `);
            });

            cboSchool.val("").trigger("change");
        } catch (err) {
            console.log(err);
            ShowToastError("Cannot load school.");
        }
    }

    async function GetProduct() {
        cboProduct.empty();
        cboProduct.append("<option value='' disabled selected>Select Product</option>");

        try {
            const response = await $.ajax({
                url: "/product/get-product-list",
                method: "POST",
                data: {
                    isAll: true
                }
            });

            const code = response.status?.code || response.code;
            const data = response.data || [];

            if (code === "200" || code === 200) {
                data.forEach(function (item) {
                    cboProduct.append(`
                    <option value="${item.productId}">
                        ${item.productId} - ${item.productName}
                        (Price USD: ${item.price}, Price KHR: ${item.priceKhr})
                    </option>
                `);
                });

                cboProduct.val("").trigger("change");
            } else {
                ShowToastError(response.status?.message || response.message || "Cannot load product.");
            }
        } catch (err) {
            console.log(err);
            ShowToastError("Cannot load product.");
        }
    }
    frmProductWeBill
        .off("submit")
        .on("submit", function (e) {
            e.preventDefault();

            const formData = frmProductWeBill.serialize();

            console.log("Saving Product WeBill:", formData);

            $.ajax({
                url: "/product/save-change-product-detail",
                type: "POST",
                data: formData,

                success: function (response) {
                    const code = response.status?.code;
                    const message = response.status?.message;

                    if (code === "200" || code === 200) {
                        ShowToastSuccess(message || "Saved successfully!");

                        frmProductWeBill[0].reset();
                        ProductPayOnlineModal.modal("hide");

                        tblProductPayOnline.DataTable().ajax.reload(null, false);
                    } else {
                        ShowToastError(message || "Save failed.");
                    }
                },

                error: function (xhr) {
                    console.log(xhr.responseText);
                    ShowToastError("Server error.");
                }
            });
        });

    btnCloseProductWeBill
        .off("click")
        .on("click", function () {
            frmProductWeBill[0].reset();

            $("#productDetail_ProductDetailId").val(0);
            $("#productDetail_ProductId").val("").trigger("change");
            $("#productDetail_DegreeId").val("").trigger("change");
            $("#productDetail_SchoolId").val("").trigger("change");
            $("#productDetail_FromPromotionNo").val(0);

            ProductPayOnlineModal.modal("hide");
        });
</script>
}
