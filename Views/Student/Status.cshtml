@using System.Text.Json
@{
    ViewData["OpenMenu"] = "AcademicTask";
    ViewData["Action"] = "ManageStudent"; 
} 
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Student List</h3>
            </div>
            <div class="card-body">
                <table id="tblStudent" class="table table-sm table-bordered table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>Student Id</th>
                        <th>Name English</th>
                        <th>Name Khmer</th>
                        <th>Gender</th>
                        <th>DOB</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_Details"/>
@section Scripts
{
    <script src="~/js/Components.js"></script>
    <script src="~/function/Degree.js"></script>
    <script src="~/function/School.js"></script>
    <script src="~/function/Field.js"></script>
    <script src="~/function/Promotion.js"></script>
    <script src="~/function/Stage.js"></script>
    <script src="~/function/Term.js"></script>
    <script src="~/function/Group.js"></script>
    <script src="~/function/AcademicStudentDetail.js"></script>
    <script>
        let dtStudent = null;
        $(document).ready(function () {
            fetchStudent();
            $("#btnToggleStudentFullscreen").on("click", function () {
                const modal = $("#studentDetailModal");
                setStudentFullscreen(!modal.hasClass("fullscreen-modal"));
            });
            $("#studentDetailModal").on("hidden.bs.modal", function () {
                setStudentFullscreen(false);
            });
        });
        
        const StudentStatusBadgeClasses = @Html.Raw(JsonSerializer.Serialize(ViewData["StudentStatusBadgeClasses"])); 
        const StudentStatusDefaultBadgeClass = "@ViewData["StudentStatusDefaultBadgeClass"]"; 
        function renderStudentStatusBadge(status) {
            const badgeClass = StudentStatusBadgeClasses[status] || StudentStatusDefaultBadgeClass;
            return `<span class="badge ${badgeClass}">${status || ""}</span>`;
        }

        function fetchStudent() {
            const currentStatus = "@ViewData["status"]"; 
            if (dtStudent !== null) {
                return;
            } 
            dtStudent = $("#tblStudent").DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                ajax: {
                    url: `/student/academic/student-list/${currentStatus}`,
                    type: "POST",
                    error: function (xhr) {
                        ShowToastError(xhr.responseText);
                    }
                },
                columns: [
                    { data: "studentId" },
                    { data: "studentName" },
                    { data: "studentNameInKhmer" },
                    { data: "sex" },
                    {
                        data: "dateOfBirth",
                        render: function (data) {
                            return formatDate(data);
                        }
                    },
                    { data: "phone" },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return renderStudentStatusBadge(row.status);
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row) {
                            const studId = String(row.studentId).replace(/'/g, "\\'"); 
                            return `
                                <button type="button"
                                        class="btn btn-warning btn-sm"
                                        onclick="OnView('${studId}')">
                                    <i class="fas fa-gear"></i> View
                                </button>
                            `;
                        }
                    }
                ],
                initComplete: function (){
                    MyApp.utils.dataTableDebounceSearch("#tblStudent",500);
                }
            });
        }

        function OnView(id) { 
            $("#txtStudentId").val(id); 
            LoadStudentDetail(id); 
            setStudentFullscreen(true); 
            $("#studentDetailModal").modal("show"); 
            if ($.fn.select2) {
                $("#studentDetailModal .select2").select2({
                    dropdownParent: $("#studentDetailModal")
                });
            }
        }

        function setStudentFullscreen(isFullscreen) {
            const modal = $("#studentDetailModal");
            const icon = $("#studentFullscreenIcon"); 
            if (isFullscreen) {
                modal.addClass("fullscreen-modal");
                icon.removeClass("fa-expand").addClass("fa-compress");
                $("#btnToggleStudentFullscreen").attr("title", "Restore");
            } else {
                modal.removeClass("fullscreen-modal");
                icon.removeClass("fa-compress").addClass("fa-expand");
                $("#btnToggleStudentFullscreen").attr("title", "Fullscreen");
            } 
            setTimeout(function () {
                adjustOnlyStudentModalTables();
            }, 200);
        }

        function adjustOnlyStudentModalTables() {
            $("#studentDetailModal table.dataTable").each(function () {
                if ($.fn.DataTable.isDataTable(this)) {
                    $(this).DataTable().columns.adjust();
                }
            });
        }
    </script>
}