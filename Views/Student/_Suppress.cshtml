<div class="modal fade student-action-modal"  data-backdrop="static" data-keyboard="false" id="modalSuppress" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white py-2">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle mr-1"></i> Suppress
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <form id="frmSuppress">
                <div class="modal-body bg-light">
                    <input type="hidden" id="SuppressId" name="SuppressId" /> 
                    <input type="hidden" id="suppressStudentId" name="StudentId" /> 
                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label font-weight-bold">Term</label>
                        <div class="col-sm-8">
                            <input type="text" id="suppressTermNo" name="TermNo" class="form-control text-center font-weight-bold" readonly />
                        </div>
                    </div> 
                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label font-weight-bold">Suppress Date</label>
                        <div class="col-sm-8">
                            <input type="date" id="suppressFromDate" name="SuppressDate" class="form-control" />
                        </div>
                    </div> 
                    <div class="form-group row" id="expressDateGroup" style="display:none;">
                        <label class="col-sm-4 col-form-label font-weight-bold">Express Date</label>
                        <div class="col-sm-8">
                            <input type="date" id="expressDate" name="ExpressDate" class="form-control" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Reason</label>
                        <textarea id="suppressReason" name="ReasonOfSuppress" class="form-control" rows="4"></textarea>
                    </div>
                </div> 
                <div class="modal-footer py-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-check"></i> OK
                    </button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>