<div class="modal fade student-action-modal" data-backdrop="static" data-keyboard="false" id="modalAdjustGroup" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-info text-white py-2">
                <h5 class="modal-title">
                    <i class="fas fa-sliders-h mr-1"></i> Adjust Group
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>

            <form id="frmAdjustGroup">
                <div class="modal-body bg-light">
                    <input type="hidden" id="adjustStudentId" name="StudentId" />
                    <input type="hidden" id="adjustStudentGroupId" name="StudentGroupId" /> 
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Term</label>
                                <input type="text" id="adjustTermNo" name="TermNo" class="form-control text-center font-weight-bold" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Group</label>
                                <select id="cboAdjustGroupId" name="GroupId" class="form-control select2 w-100">
                                </select>
                            </div>
                        </div>
                    </div>
                    
                    <hr />
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="font-weight-bold mb-0">
                            <i class="fas fa-list mr-1"></i> Student Scores
                        </h6>
                        <small class="text-muted">Scores that belong to this student</small>
                    </div>
                    <div class="table-responsive">
                        <table id="tblAdjustStudentScore" class="table table-bordered table-striped table-sm w-100">
                            <thead class="thead-light">
                                <tr>
                                    <th>ScoreId</th>
                                    <th>StudentGroupId</th>
                                    <th>CourseId</th>
                                    <th>Course</th>
                                    <th>Mid Term</th>
                                    <th>Final</th>
                                    <th>Type</th>
                                    <th>Allow</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="submit" class="btn btn-info">
                        <i class="fas fa-check"></i> Adjust Group
                    </button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>