<div class="modal fade student-action-modal" data-backdrop="static" data-keyboard="false" id="modalQuit" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white py-2">
                <h5 class="modal-title">
                    <i class="fas fa-ban mr-1"></i> Quit
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>

            <form id="frmQuit">
                <div class="modal-body bg-light">
                    <input type="hidden" id="quitStudentId" name="StudentId" />
                    <input type="hidden" id="quitGroupId" name="GroupId" />
                    <input type="hidden" id="quitPromotionId" name="PromotionId" />
                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label font-weight-bold">Term</label>
                        <div class="col-sm-8">
                            <input type="text" id="quitTermNo" name="TermNo" class="form-control text-center font-weight-bold" readonly />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label font-weight-bold">Quit Date</label>
                        <div class="col-sm-8">
                            <input type="date" id="quitFromDate" name="QuitDate" class="form-control" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">Reason</label>
                        <textarea id="quitReason" name="ReasonOfQuit" class="form-control" rows="4"></textarea>
                    </div>
                </div>

                <div class="modal-footer py-2">
                    <button type="submit" class="btn btn-dark">
                        <i class="fas fa-check"></i> OK
                    </button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>