@using BBU_SYSTEM.DTOs
 @{
     var student = new StudentDto();
     var registry = new RegistryDto();
}
<div class="row">
    <div class="col-3">
        <label>Student Id</label>
        <input type="text" class="form-control" asp-for="@student.StudentId" readonly/>
        <input type="hidden" class="form-control" asp-for="@registry.RegistrationId" readonly/>
    </div>
    <div class="col-4">
        <label>Student Name</label>
        <input type="text" class="form-control" asp-for="@student.StudentName" readonly/>
    </div>
    <div class="col-3">
        <label>Student Name Khmer</label>
        <input type="text" class="form-control" asp-for="@student.StudentNameInKhmer"
               readonly/>
    </div>
    <div class="col-2">
        <label>Sex</label>
         <select asp-for="@student.Sex" class="custom-select" style="width: 100%;">
            <option selected="selected" value="Male">Male</option>
            <option value="Female">Female</option>
        </select>
    </div>
</div>
<div class="row">
    <div class="col-3">
        <label>Date Of Birth</label>
        <input type="date" class="form-control" asp-for="@student.DateOfBirth"/>
    </div>
    <div class="col-4">
        <label>Place Of Birth</label>
        <select asp-for="@student.PlaceOfBirthId" class="form-control select2" >  
        </select>
    </div>
    <div class="col-3">
        <label>Nationality</label>
        <select asp-for="@student.NationalityId" class="form-control select2" > 
        </select>
    </div>
    <div class="col-2">
        <label>Table No</label>
        <input type="text" class="form-control" asp-for="@registry.HighSchoolTableNo" >
    </div>
</div>
<div class="row">
    <div class="col-3">
        <label>Material Status</label>
        <select  asp-for="@student.MaritalStatus" class="custom-select" style="width: 100%;"
                 required>
            <option selected="selected" value="Single">Single</option>
            <option value="Marred">Marred</option>
        </select>
    </div>
    <div class="col-4">
        <label>High School</label> 
        <input type="text" class="form-control" asp-for="@student.FromHighSchoolNameInKhmer" readonly/>
    </div>
    @* <div class="col-4">  *@
    @*     <div class="form-group"> *@
    @*         <div class="row"> *@
    @*             <div class="col-6"> *@
