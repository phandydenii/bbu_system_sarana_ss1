    @*                            name="customRadio"> *@
    @*                     <label for="rdoHighSchool" class="custom-control-label">High School</label> *@
    @*                 </div> *@
    @*             </div> *@
    @*             <div class="col-6"> *@
    @*                 <div class="custom-control custom-radio"> *@
    @*                     <input class="custom-control-input" type="radio" id="rdoMasPhD" name="customRadio"> *@
    @*                     <label for="rdoMasPhD" class="custom-control-label">Mass & PhD</label> *@
    @*                 </div> *@
    @*             </div> *@
    @*         </div> *@
    @*     </div> *@
    @*     <select asp-for="@student.FromHighSchoolNameInKhmer" class="form-control select2" required style="width: 100%;"> *@
    @*         <option selected="selected">Select High School</option> *@
    @*     </select> *@
    @* </div> *@
    <div class="col-3">
        <label>Province</label>
        <select asp-for="@student.FromProvinceId" class="form-control select2" >
        </select>
    </div>
    
    <div class="col-2">
        <label>Year</label>
        <input type="text" class="form-control" asp-for="@student.HighSchoolGraduatedYear" >
    </div>
</div>
<div class="row">
    <div class="col-3">
        <label>Race</label>
        <select asp-for="@student.RaceId" class="form-control select2"  >
        </select>
    </div>
    <div class="col-4">
        <label>Job</label>
        <select class="form-control select2" asp-for="@student.JobId" > 
        </select>
    </div>
    <div class="col-3">
        <label>Disability</label>
        <select  asp-for="@student.DisabilityId"  class="form-control select2"  > 
        </select>
    </div>
    <div class="col-2">
        <label>Result</label>
         <select class="custom-select" asp-for="@registry.HighSchoolResult" >
            <option selected="selected" value="P">Pass</option>
            <option value="F">Fail</option>
        </select>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <label>Status</label>
        <input type="text" class="form-control" asp-for="@student.Status"
               style="text-align: center;font-weight:bold" readonly>
    </div>
</div>