<div class="modal fade student-action-modal" data-backdrop="static" data-keyboard="false" id="modalChangeBranch" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-secondary text-white py-2">
                <h5 class="modal-title">
                    <i class="fas fa-sync-alt mr-1"></i> Change Branch
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>

            <form id="frmChangeBranch">
                <div class="modal-body bg-light">
                    <input type="hidden" id="changeBranchStudentId" name="StudentId" />
                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label font-weight-bold">Term</label>
                        <div class="col-sm-8">
                            <input type="text" id="changeBranchTermNo" name="TermNo" class="form-control text-center font-weight-bold" readonly />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label font-weight-bold">To Branch</label>
                        <div class="col-sm-8">
                            <select id="cboChangeBranchId" name="ToBranchId" class="form-control select2 w-100">
                            </select>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label font-weight-bold">From Date</label>
                        <div class="col-sm-8">
                            <input type="date" id="changeBranchFromDate" name="FromDate" class="form-control" />
                        </div>
                    </div>
                </div>

                <div class="modal-footer py-2">
                    <button type="submit" class="btn btn-secondary">
                        <i class="fas fa-check"></i> OK
                    </button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>