@using System.Globalization
@using System.Security.Claims
@{
    var server = User.FindFirst("DataSource")?.Value;
    var database = User.FindFirst("InitialCatalog")?.Value;
}
<nav class="main-header navbar navbar-expand navbar-white navbar-light">
    <!-- Left navbar links -->
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a asp-action="Index" asp-controller="Home" class="nav-link">Home</a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a asp-action="Privacy" asp-controller="Home" class="nav-link">Privacy</a>
        </li>
    </ul>

    <ul class="navbar-nav ml-auto">
        <li class="nav-item dropdown">
            <a class="nav-link" data-toggle="dropdown" href="#" aria-expanded="true">
                <i class="fas fa-plug"></i>
            </a>
            <div class="dropdown-menu dropdown-menu-lg dropdown-menu-right" style="left: inherit; right: 0px;">
                <span class="dropdown-item dropdown-header">Connection</span>
                <div class="dropdown-divider"></div>
                <a href="#" class="dropdown-item">
                    <i class="fas fa-envelope mr-2"></i> ServerName
                    <span class="float-right text-muted text-sm">@server</span>
                </a>
                <div class="dropdown-divider"></div>
                <a href="#" class="dropdown-item">
                    <i class="fas fa-users mr-2"></i> DatabaseName
                    <span class="float-right text-muted text-sm">@database</span>
                </a>
            </div>
        </li>
        <li class="nav-item dropdown">
            <a class="nav-link" data-toggle="dropdown" href="#">
                @* <i class="fas fa-globe"></i>  *@
                @if (CultureInfo.CurrentUICulture.Name == "en")
                {
                    <img src="~/Images/English.jpg" alt="User Avatar"
                         class="img-size-32 mr-3">
                }
                else
                {
                    <img src="~/Images/Khmer.png" alt="User Avatar"
                         class="img-size-32 mr-3">
                }
            </a>
            <div class="dropdown-menu dropdown-menu-md dropdown-menu-right">
                <a class="dropdown-item" asp-controller="Home"
                   asp-action="SwitchLanguage"
                   asp-route-culture="km"
                   asp-route-returnUrl="@Context.Request.Path"> 
                    <div class="media">
                        <img src="~/Images/Khmer.png" alt="User Avatar"
                             class="img-size-32 mr-3">
                        <div class="media-body">
                            <h3 class="dropdown-item-title">
                                Khmer @if (CultureInfo.CurrentUICulture.Name == "km")
                                      {
                                          <i class="fas fa-check ml-2 text-success"></i>
                                      }
                            </h3> 
                        </div>
                    </div>
                </a>
                <div class="dropdown-divider"></div>
                <a class="dropdown-item" asp-controller="Home"
                   asp-action="SwitchLanguage"
                   asp-route-culture="en"
                   asp-route-returnUrl="@Context.Request.Path"> 
                    <div class="media">
                        <img src="~/Images/English.jpg" alt="User Avatar"
                             class="img-size-32 mr-3">
                        <div class="media-body">
                            <h3 class="dropdown-item-title">
                                English
                                @if (CultureInfo.CurrentUICulture.Name == "en")
                                {
                                    <i class="fas fa-check ml-2 text-success"></i>
                                }
                            </h3> 
                        </div>
                    </div>
                </a>
            </div>
        </li>
        <li class="nav-item">
            <form asp-action="Logout" asp-controller="Account" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post">
                <button type="submit" class="nav-link btn btn-link p-0">
                    @* <i class="fas fa-sign-out"></i> *@
                    <img src="~/Images/logout.png" alt="User Avatar"
                         class="img-size-32 mr-3">
                </button>
            </form>
        </li>
    </ul>
</nav>
 