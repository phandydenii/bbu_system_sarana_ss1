@using BBU_SYSTEM.DTOs
@{
    var booking = new BookingTblDto();
}

<style>
    #BookingClothesModal.booking-editor:not(.fullscreen-modal) .modal-dialog {
        width: calc(100% - 2rem);
        max-width: 1140px;
        margin: 1rem auto;
    }

    #BookingClothesModal.booking-editor:not(.fullscreen-modal) .modal-content {
        max-height: calc(100vh - 2rem);
        max-height: calc(100dvh - 2rem);
        border: 1px solid #dee2e6;
        border-radius: .3rem;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal.fullscreen-modal .modal-dialog,
    #BookingClothesModal.fullscreen-modal .modal-content {
        height: 100vh;
        height: 100dvh;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal.fullscreen-modal .modal-dialog {
        width: 100%;
        max-width: none;
        margin: 0;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal.fullscreen-modal .modal-content {
        border: 0;
        border-radius: 0;
    }

    #BookingClothesModal.booking-editor .modal-header,
    #BookingClothesModal.booking-editor .modal-footer {
        flex-shrink: 0;
        min-height: 3.75rem;
        padding: .75rem 1rem;
        border-color: #dee2e6;
        background: #fff;
    }

    #BookingClothesModal .modal-header {
        align-items: center;
        gap: .75rem;
    }

    #BookingClothesModal.booking-editor .modal-title {
        margin: 0;
        color: #343a40;
        font-size: 1.25rem;
        font-weight: 500;
    }

    #BookingClothesModal .booking-header-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: .25rem;
    }

    #BookingClothesModal .booking-header-actions .btn-light {
        min-width: 1.875rem;
        padding-inline: .25rem;
        color: #343a40;
    }

    #BookingClothesModal.booking-editor .modal-body {
        min-height: 0;
        padding: 1rem;
        overflow: auto;
        background: #fff;
        color: #495057;
        font-size: .875rem;
    }

    #BookingClothesModal .booking-detail-context {
        display: grid;
        grid-template-columns: minmax(0, 28rem) minmax(0, 21rem);
        justify-content: space-between;
        align-items: start;
        gap: .5rem 2rem;
        margin-bottom: .75rem;
    }

    #BookingClothesModal .booking-context-fields {
        display: grid;
        gap: .4rem;
        min-width: 0;
    }

    #BookingClothesModal .booking-context-row {
        display: grid;
        grid-template-columns: 6.5rem minmax(0, 1fr);
        align-items: center;
        column-gap: .75rem;
    }

    #BookingClothesModal .booking-context-row > label,
    #BookingClothesModal .booking-context-label,
    #BookingClothesModal .booking-summary-fields label {
        margin: 0;
        font-weight: 400;
    }

    #BookingClothesModal .booking-date-fields .booking-context-row > label,
    #BookingClothesModal .booking-date-fields .booking-context-label {
        text-align: right;
    }

    #BookingClothesModal .booking-student-control {
        flex-wrap: nowrap;
        min-width: 0;
    }

    #BookingClothesModal .booking-context-row .custom-switch {
        grid-column: 2;
    }

    #BookingClothesModal .booking-rate-values {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: .15rem .75rem;
        min-height: 1.8125rem;
        font-variant-numeric: tabular-nums;
    }

    #BookingClothesModal .booking-rate-values strong:empty::after {
        content: "—";
    }

    #BookingClothesModal .booking-detail-context .form-control,
    #BookingClothesModal .booking-details-bottom .form-control,
    #BookingClothesModal .booking-details-bottom .input-group-text {
        border-color: #ced4da;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal .booking-inline-student .select2-selection--single {
        height: calc(1.8125rem + 2px);
        border-color: #bdc8d4;
        border-radius: .3rem;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal .booking-inline-student .select2-selection__rendered {
        font-size: .9375rem;
        line-height: 1.8125rem;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal .booking-inline-student .select2-selection__arrow {
        height: 1.8125rem;
    }

    #BookingClothesModal .booking-detail-scroll {
        max-height: 46vh;
        overflow: auto;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal.fullscreen-modal .booking-detail-scroll {
        max-height: none;
    }

    #BookingClothesModal #tblBookingDetail {
        width: 100%;
        margin-bottom: 0;
        color: #495057;
        font-size: .8125rem;
    }

    #BookingClothesModal #tblBookingDetail th,
    #BookingClothesModal #tblBookingDetail td {
        padding: .2rem .25rem;
        border: 1px solid #dee2e6;
        vertical-align: middle;
        white-space: nowrap;
    }

    #BookingClothesModal #tblBookingDetail thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background: #fff;
        color: #343a40;
        font-weight: 600;
    }

    /* The item editor creates the row controls and Select2 elements. */
    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal #tblBookingDetail .booking-row-number {
        min-width: 1.9rem;
        color: #45576c;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal #tblBookingDetail .booking-item-name {
        width: 100%;
        min-width: 15rem;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal .booking-item-name > .select2-container {
        display: block;
        max-width: 100%;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal .booking-item-name .select2-selection--single {
        display: flex;
        align-items: center;
        height: calc(1.8125rem + 2px);
        border: 1px solid #bdc8d4;
        border-radius: .3rem;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal .booking-item-name .select2-selection__rendered {
        flex: 1 1 auto;
        min-width: 0;
        padding: 0 1.65rem 0 .55rem;
        color: #243348;
        font-size: .9375rem;
        line-height: 1.45;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal .booking-item-name .select2-selection__placeholder {
        color: #53647a;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal .booking-item-name .select2-selection__arrow {
        right: .25rem;
        top: 0;
        height: 100%;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal .booking-item-name .select2-container--open .select2-selection--single,
    #BookingClothesModal .booking-item-name .select2-selection--single:focus-visible {
        border-color: #3384d6;
        outline: 2px solid #3384d626;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal #tblBookingDetail .item-qty {
        min-width: 3.5rem;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal #tblBookingDetail .booking-item-amount {
        min-width: 5.75rem;
        flex-wrap: nowrap;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal #tblBookingDetail .booking-item-amount > .form-control {
        min-width: 0;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal #tblBookingDetail .form-control,
    #BookingClothesModal #tblBookingDetail .input-group-text {
        border-color: #ced4da;
        font-variant-numeric: tabular-nums;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal #tblBookingDetail .line-total-usd,
    #BookingClothesModal #tblBookingDetail .line-total-khr {
        background: #e9ecef;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal #tblBookingDetail .input-group-text {
        min-width: 1.45rem;
        justify-content: center;
        padding-inline: .25rem;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal #tblBookingDetail #btnAddBookingItem,
    #BookingClothesModal #tblBookingDetail .js-remove-booking-item {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        min-width: 1.55rem;
        min-height: 1.55rem;
        padding: .05rem .25rem;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal .booking-item-browse {
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal .booking-catalog-option {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: .65rem;
        line-height: 1.5;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal .booking-catalog-names {
        display: grid;
        gap: .1rem;
        min-width: 0;
        overflow-wrap: anywhere;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal .booking-product-name-khmer,
    #BookingClothesModal .booking-catalog-price {
        color: #45576c;
        font-size: .875rem;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal .booking-product-name-khmer {
        font-family: "Noto Sans Khmer", "Khmer OS System", "Leelawadee UI", sans-serif;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal .booking-catalog-price {
        flex-shrink: 0;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal .select2-results__option--highlighted .booking-product-name-khmer,
    #BookingClothesModal .select2-results__option--highlighted .booking-catalog-price {
        color: inherit;
    }

    #BookingClothesModal #tblBookingDetail tfoot {
        background: #f8f9fa;
        font-variant-numeric: tabular-nums;
    }

    #BookingClothesModal .booking-details-bottom {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(18rem, 22rem);
        align-items: start;
        gap: .75rem clamp(1rem, 5vw, 4rem);
        margin-top: .85rem;
    }

    #BookingClothesModal .booking-notes .nav-link {
        margin-bottom: -1px;
        background: #fff;
        color: #495057;
        font-weight: 600;
    }

    #BookingClothesModal .booking-note-panel {
        padding: .5rem;
        border: 1px solid #dee2e6;
        border-top: 0;
    }

    #BookingClothesModal .booking-note-panel textarea {
        resize: vertical;
    }

    #BookingClothesModal .booking-summary > summary {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        min-height: 2rem;
        padding: .2rem 0;
        list-style: none;
        cursor: pointer;
        color: #343a40;
        font-weight: 600;
    }

    #BookingClothesModal .booking-summary > summary::-webkit-details-marker {
        display: none;
    }

    #BookingClothesModal .booking-summary[open] > summary .fa-chevron-down {
        transform: rotate(180deg);
    }

    #BookingClothesModal .booking-summary-fields {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(7.5rem, 10.25rem);
        align-items: center;
        gap: .3rem .5rem;
    }

    #BookingClothesModal .booking-summary-fields label {
        text-align: right;
    }

    #BookingClothesModal .booking-summary-fields .input-group-text {
        justify-content: center;
        min-width: 1.75rem;
    }

    #BookingClothesModal .booking-summary-fields input {
        font-variant-numeric: tabular-nums;
    }

    /* Created by the booking save handler. */
    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal .booking-save-feedback {
        flex: 0 0 100%;
        min-width: 0;
    }

    @@media (max-width: 767.98px) {
        #BookingClothesModal .booking-detail-context,
        #BookingClothesModal .booking-details-bottom {
            grid-template-columns: minmax(0, 1fr);
        }

        #BookingClothesModal .booking-date-fields .booking-context-row > label,
        #BookingClothesModal .booking-date-fields .booking-context-label {
            text-align: left;
        }
    }
</style>

<div class="modal fade booking-editor" id="BookingClothesModal" tabindex="-1"
     aria-labelledby="bookingModalTitle" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="bookingModalTitle">Booking Details</h4>
                <div class="booking-header-actions">
                    <button type="button" id="btnTogglePaymentFullscreen" class="btn btn-light btn-sm"
                            title="Fullscreen" aria-label="Toggle full screen">
                        <i id="paymentFullscreenIcon" class="fas fa-expand" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="btn btn-light btn-sm" data-dismiss="modal"
                            title="Close" aria-label="Close booking">
                        <i class="fas fa-times" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                <form id="PaymentForm" method="post">
                    <input type="hidden" asp-for="@booking.BookingId" />
                    <input type="hidden" asp-for="@booking.SchoolId" />
                    <input type="hidden" asp-for="@booking.FieldId" />
                    <input type="hidden" asp-for="@booking.TermNo" />
                    <input type="hidden" asp-for="@booking.GroupId" />

                    <section class="booking-detail-context" aria-label="Booking information">
                        <div class="booking-context-fields">
                            <div class="booking-context-row">
                                <label for="booking_StudentId">Student ID<span class="text-danger" aria-hidden="true">*</span></label>
                                <div class="input-group input-group-sm booking-student-control">
                                    <input type="text" class="form-control" asp-for="@booking.StudentId" readonly />
                                    <div class="input-group-append">
                                        <button type="button" id="btnSearchStudent" class="btn btn-outline-info"
                                                title="Search students" aria-label="Search students"
                                                aria-haspopup="dialog" aria-controls="StudentModal">
                                            <i class="fas fa-search" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="booking-context-fields booking-date-fields">
                            <div class="booking-context-row">
                                <label for="booking_BookingNo">Booking No.</label>
                                <input type="text" class="form-control form-control-sm" asp-for="@booking.BookingNo" readonly />
                            </div>
                            <div class="booking-context-row">
                                <label for="booking_BookingDate">Booking Date</label>
                                <input type="text" class="form-control form-control-sm" asp-for="@booking.BookingDate" />
                            </div>
                            <div class="booking-context-row">
                                <div class="custom-control custom-switch">
                                    <input type="checkbox" class="custom-control-input" id="Active" name="Active" />
                                    <label class="custom-control-label" for="Active">Active Status</label>
                                </div>
                            </div>
                            <div class="booking-context-row">
                                <span class="booking-context-label">Exchange Rate</span>
                                <div class="booking-rate-values">
                                    <span>In: <strong id="txtRateIn"></strong></span>
                                    <span>Out: <strong id="txtRateOut"></strong></span>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="payment-table-area" aria-label="Clothing items">
                        <div class="booking-detail-scroll" role="region" aria-label="Clothing items table" tabindex="0">
                            <table id="tblBookingDetail" class="table table-sm table-bordered table-hover">
                                <caption class="sr-only">Booking items</caption>
                                <thead>
                                <tr>
                                    <th scope="col" hidden>BookingDetailId</th>
                                    <th scope="col" hidden>BookingId</th>
                                    <th scope="col" hidden>ClothId</th>
                                    <th scope="col" class="text-center">No.</th>
                                    <th scope="col">Item Description</th>
                                    <th scope="col" class="text-center">Qty</th>
                                    <th scope="col">Unit Price</th>
                                    <th scope="col">Price KHR</th>
                                    <th scope="col">Discount %</th>
                                    <th scope="col">Total USD</th>
                                    <th scope="col">Total KHR</th>
                                    <th scope="col" class="text-center">
                                        <span class="sr-only">Action</span>
                                        <button type="button" id="btnAddBookingItem" class="btn btn-success btn-sm"
                                                title="Add row" aria-label="Add clothing item row">
                                            <i class="fas fa-plus" aria-hidden="true"></i>
                                        </button>
                                    </th>
                                </tr>
                                </thead>
                                <tbody></tbody>
                                <tfoot>
                                <tr class="font-weight-bold">
                                    <td colspan="3" hidden></td>
                                    <th scope="row" colspan="6" class="text-right">Grand Total</th>
                                    <td id="lblGrandTotalUsd" class="text-right">0.00</td>
                                    <td id="lblGrandTotalKhr" class="text-right">0</td>
                                    <td></td>
                                </tr>
                                </tfoot>
                            </table>
                        </div>

                        <div class="booking-details-bottom">
                            <div class="booking-notes">
                                <div class="nav nav-tabs">
                                    <label class="nav-link active" for="booking_Note">Remark / Notes</label>
                                </div>
                                <div class="booking-note-panel">
                                    <textarea class="form-control form-control-sm" asp-for="@booking.Note"
                                              rows="4" placeholder="Enter optional notes"></textarea>
                                </div>
                            </div>

                            <details class="booking-summary" open>
                                <summary>
                                    <span>Summary</span>
                                    <i class="fas fa-chevron-down" aria-hidden="true"></i>
                                </summary>
                                <div class="booking-summary-fields" id="summaryCollapseArea">
                                    <label for="booking_Vat">Subtotal VAT</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" class="form-control text-right" asp-for="@booking.Vat" value="0" readonly />
                                        <div class="input-group-append">
                                            <span class="input-group-text" aria-hidden="true">$</span>
                                        </div>
                                    </div>

                                    <label for="booking_Discount">Total Discount</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" class="form-control text-right" asp-for="@booking.Discount" value="0" readonly />
                                        <div class="input-group-append">
                                            <span class="input-group-text" aria-hidden="true">$</span>
                                        </div>
                                    </div>

                                    <label for="booking_PayDollar">Paid USD</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" class="form-control text-right" asp-for="@booking.PayDollar" value="0" />
                                        <div class="input-group-append">
                                            <span class="input-group-text" aria-hidden="true">$</span>
                                        </div>
                                    </div>

                                    <label for="booking_PayRieal">Paid KHR</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" class="form-control text-right" asp-for="@booking.PayRieal" value="0" />
                                        <div class="input-group-append">
                                            <span class="input-group-text" aria-hidden="true">៛</span>
                                        </div>
                                    </div>

                                    <label for="booking_Total" class="font-weight-bold">Grand Total</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" class="form-control text-right font-weight-bold"
                                               asp-for="@booking.Total" value="0" readonly />
                                        <div class="input-group-append">
                                            <span class="input-group-text" aria-hidden="true">$</span>
                                        </div>
                                    </div>
                                </div>
                            </details>
                        </div>
                    </section>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" id="btnSaveBooking" class="btn btn-success btn-sm">
                    <i class="far fa-save mr-1" aria-hidden="true"></i> <span>Save Booking</span>
                </button>
                <button type="button" id="btnCloseBooking" class="btn btn-danger btn-sm">
                    <i class="fas fa-times mr-1" aria-hidden="true"></i> Close
                </button>
            </div>
        </div>
    </div>
</div>
