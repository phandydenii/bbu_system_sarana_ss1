@using BBU_SYSTEM.DTOs
@{
var invoice = new InvoiceDto();
}
<style>
    #BookingClothesModal.fullscreen-modal .modal-dialog {
        max-width: 100%;
        width: 100%;
        height: 100vh;
        margin: 0;
    }
    #BookingClothesModal.fullscreen-modal .modal-content {
        height: 100vh;
        border-radius: 0;
        display: flex;
        flex-direction: column;
    }
    #BookingClothesModal.fullscreen-modal .modal-header,
    #BookingClothesModal.fullscreen-modal .modal-footer {
        flex: 0 0 auto;
    }
    #BookingClothesModal.fullscreen-modal .modal-body {
        flex: 1 1 auto;
        min-height: 0;
        overflow: hidden;
    }
    /* Form fills modal body */
    #BookingClothesModal.fullscreen-modal #PaymentForm {
        height: 100%;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }
    /* Table area gets all remaining space */
    #BookingClothesModal.fullscreen-modal .payment-table-area {
        flex: 1 1 auto;
        min-height: 0;
    }
    /* Important: col-12 also needs full height */
    #BookingClothesModal.fullscreen-modal .payment-table-area > .col-12 {
        height: 100%;
        min-height: 0;
    }
    /* Only table wrapper scrolls */
    #BookingClothesModal.fullscreen-modal .invoice-detail-scroll {
        height: 100%;
        max-height: none;
        overflow-y: auto;
        overflow-x: auto;
        border: 1px solid #dee2e6;
    }
    /* normal modal fallback */
    #BookingClothesModal .modal-body {
        overflow: hidden;
    }
    .invoice-detail-scroll {
        max-height: 50vh;
        overflow-y: auto;
        overflow-x: auto;
        border: 1px solid #dee2e6;
    }
    /* table style */
    #tblBookingDetail {
        margin-bottom: 0;
        white-space: nowrap;
    }
    #tblBookingDetail thead th {
        position: sticky;
        top: -1px;
        background: #f8f9fa;
        z-index: 2;
    }
    /* summary area */
    #BookingClothesModal.fullscreen-modal .payment-summary-area { /* stays under table */
        flex: 0 0 auto;
    }
    #BookingClothesModal .payment-summary-area label {
        font-size: 12px;
        margin-bottom: 2px;
    }
    #BookingClothesModal .payment-summary-area .form-control {
        height: 30px;
        padding: 3px 6px;
        font-size: 13px;
    }
    #BookingClothesModal .payment-summary-area .row {
        margin-bottom: 4px;
    }
    /* Exchange rate box */
    .rate-box {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 4px 10px;
        border: 1px solid #d6e4f0;
        border-radius: 6px;
        background: #f8fbff;
        color: #2c3e50;
        font-size: 12px;
        line-height: 1.2;
    }
    .rate-icon {
        font-size: 14px;
        color: #007bff;
    }
    .rate-content {
        display: flex;
        flex-direction: column;
    }
    .rate-label {
        font-size: 12px;
        color: #6c757d;
        margin-bottom: 2px;
    }
    .rate-values {
        display: flex;
        align-items: center;
        gap: 5px;
        white-space: nowrap;
    }
    .rate-values strong {
        font-weight: 700;
        color: #212529;
    }
    .rate-divider {
        color: #adb5bd;
    }
</style>

<div class="modal fade" id="BookingClothesModal" data-backdrop="static">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Booking Detail</h4>
                <div class="float-right d-flex align-items-center">
                    <div class="rate-box mr-2">
                        <i class="fas fa-exchange-alt rate-icon"></i>
                        <div class="rate-content">
                            <span class="rate-label">Exchange Rate</span>
                            <div class="rate-values">
                                <span>
                                    In: <strong id="txtRateIn"></strong>
                                </span>
                                <span class="rate-divider">|</span>
                                <span>
                                    Out: <strong id="txtRateOut"></strong>
                                </span>
                            </div>
                        </div>
                    </div>
                    <button id="btnSelectItem" type="button" class="btn btn-primary btn-sm p-2 mr-2" data-toggle="modal" data-target="#ItemModal">
                        <i class="fa-solid fa-sitemap"></i> Select Item
                    </button>
                    <button type="button" id="btnTogglePaymentFullscreen" class="btn btn-tool btn-outline-info py-2 px-2" title="Fullscreen">
                        <i id="paymentFullscreenIcon" class="fas fa-expand"></i>
                    </button>
                </div>
            </div>
            <div class="modal-body">
                <form id="BookingForm" asp-action="CreateBookingClothes" asp-controller="BookingClothes">
                    <input type="hidden" asp-for="@invoice.InvoiceId"/>
                    <input type="hidden" asp-for="@invoice.StudentId"/>
                    <input type="hidden" asp-for="@invoice.SchoolId"/>
                    <input type="hidden" asp-for="@invoice.FieldId"/>
                    <input type="hidden" asp-for="@invoice.DegreeId"/>
                    <input type="hidden" asp-for="@invoice.PromotionId"/>
                    <input type="hidden" asp-for="@invoice.StageId"/>
                    <input type="hidden" asp-for="@invoice.TermNo"/>
                    <input type="hidden" asp-for="@invoice.GroupId"/>
                    <input type="hidden" asp-for="@invoice.ExchangeRateId"/>
                    <div class="row payment-table-area">
                        <div class="col-12">
                            <div class="invoice-detail-scroll">
                                <table id="tblBookingDetail" class="table table-sm table-bordered table-striped" style="width:100%;">

                                    <thead class="bg-light">
                                    <tr>
                                        <th style="display:none;">BookingDetailId</th>
                                        <th style="display:none;">BookingId</th>
                                        <th style="display:none;">ClothId</th>

                                        <th>Item</th>
                                        <th style="width:100px;">Qty</th>
                                        <th style="width:120px;">Price $</th>
                                        <th style="width:130px;">Price KHR</th>
                                        <th style="width:110px;">Discount %</th>
                                        <th style="width:130px;">Total $</th>
                                        <th style="width:140px;">Total KHR</th>
                                        <th style="width:70px;" class="text-center">
                                            Action
                                        </th>
                                    </tr>
                                    </thead>

                                    <tbody></tbody>

                                    <tfoot>
                                    <tr class="font-weight-bold bg-light">
                                        <td colspan="3" style="display:none;"></td>

                                        <td colspan="5" class="text-right">
                                            Grand Total
                                        </td>

                                        <td id="lblGrandTotalUsd" class="text-right">
                                            $0.00
                                        </td>

                                        <td id="lblGrandTotalKhr" class="text-right">
                                            0 ៛
                                        </td>

                                        <td></td>
                                    </tr>
                                    </tfoot>

                                </table>
                            </div>
                        </div>
                    </div>
                    <hr>
                    <div class="row booking-summary-area">
                        <div class="col-12">
                            <div class="row">
                                <div class="col-2">
                                    <label>@nameof(invoice.GrandTotalKhr)</label>
                                    <input type="number" class="form-control edit-mode" asp-for="@invoice.GrandTotalKhr"
                                           readonly value="0"/>
                                </div>

                                <div class="col-2">
                                    <label>total_dis_khr</label>
                                    <input type="number" class="form-control edit-mode"
                                           asp-for="@invoice.TotalDiscountKhr"
                                           readonly value="0"/>
                                </div>
                                <div class="col-2">
                                    <label>total_owe_khr</label>
                                    <input type="number" class="form-control edit-mode" asp-for="@invoice.OweKhr"
                                           readonly
                                           value="0">
                                </div>
                                <div class="col-2">
                                    <label>total_other_khr</label>
                                    <input type="number" class="form-control edit-mode" asp-for="@invoice.TotalOtherKhr"
                                           readonly value="0">
                                </div>
                                <div class="col-2">
                                    <label>total_khr</label>
                                    <input type="number" class="form-control edit-mode" asp-for="@invoice.TotalRiel"
                                           readonly
                                           value="0">
                                </div>
                                <div class="col-2">
                                    <label>pay_khr</label>
                                    <input type="number" class="form-control edit-mode is-warning" asp-for="@invoice.TotalPayKhr" value="0">
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-2">
                                    <label>grand_total_usd</label>
                                    <input type="number" class="form-control edit-mode" asp-for="@invoice.GrandTotalUsd"
                                           readonly value="0"/>
                                </div>

                                <div class="col-2">
                                    <label>total_dis_usd</label>
                                    <input type="number" class="form-control edit-mode"
                                           asp-for="@invoice.TotalDiscountUsd"
                                           readonly value="0"/>
                                </div>
                                <div class="col-2">
                                    <label>total_owe_usd</label>
                                    <input type="number" class="form-control edit-mode" asp-for="@invoice.OweUsd"
                                           readonly
                                           value="0">
                                </div>
                                <div class="col-2">
                                    <label>total_other_usd</label>
                                    <input type="number" class="form-control edit-mode" asp-for="@invoice.TotalOtherUsd"
                                           readonly value="0">
                                </div>
                                <div class="col-2">
                                    <label>total_usd</label>
                                    <input type="number" class="form-control edit-mode" asp-for="@invoice.TotalDollar"
                                           readonly
                                           value="0">
                                </div>
                                <div class="col-2">
                                    <label>pay_usd</label>
                                    <input type="number" class="form-control edit-mode is-warning" asp-for="@invoice.TotalPayUsd" value="0">
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success float-right" id="btnSaveBooking"><i
                        class="fas fa-save"></i> Save Booking
                </button>
                <button type="button" id="btnCloseBooking" class="btn btn-danger float-right"><i
                        class="fas fa-close"></i> Close
                </button>
            </div>
        </div>
    </div>
</div> 
