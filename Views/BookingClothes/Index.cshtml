@{
    ViewData["Title"] = "Booking Clothes";
    ViewData["OpenMenu"] = "Administration";
    ViewData["Action"] = "BookingClothes";
    ViewData["HideHeader"] = true;
}

<style>
    #bookingClothesPage #tblBooking_wrapper {
        width: 100%;
    }

    #tblBooking_wrapper:not(.booking-has-results) .dataTables_length,
    #tblBooking_wrapper:not(.booking-has-results) .dt-length,
    #tblBooking_wrapper:not(.booking-has-pages) .dataTables_paginate,
    #tblBooking_wrapper:not(.booking-has-pages) .dt-paging {
        display: none;
    }

    #bookingClothesPage .booking-table-scroll {
        width: 100%;
        max-width: 100%;
        overflow-x: auto;
    }

    #tblBooking th,
    #tblBooking td {
        vertical-align: middle;
        white-space: nowrap;
    }
</style>

<div id="bookingClothesPage" class="container-fluid px-0 pt-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div class="mr-3">
            <h3 class="m-0 font-weight-bold text-dark">Booking Clothes</h3>
            <small class="text-muted">Manage student clothing bookings and returns</small>
        </div>
        <button type="button"
                id="btnNewBooking"
                class="btn btn-primary shadow-sm text-nowrap ml-auto mt-2 mt-sm-0">
            <i class="fas fa-plus-circle mr-1" aria-hidden="true"></i>
            New Booking
        </button>
    </div>

    <!-- Filter Card Bar -->
    <div class="card card-outline card-primary shadow-sm mb-4">
        <div class="card-header bg-white py-2">
            <h3 class="card-title font-weight-bold text-secondary" style="font-size: 0.95rem;">
                <i class="fas fa-filter text-primary mr-1"></i> Filter Bookings
            </h3>
            <div class="card-tools">
                <button type="button" class="btn btn-tool" data-card-widget="collapse"
                        aria-label="Toggle booking filters">
                    <i class="fas fa-minus" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        <form id="frmBookingDateFilter" class="card-body bg-light py-3" novalidate>
            <div class="row align-items-end">
                <div class="col-sm-6 col-lg-3 col-xl-2 mb-2 mb-xl-0">
                    <label for="bookingDateRange" class="text-secondary small font-weight-bold">Booking Date</label>
                    <select id="bookingDateRange" class="custom-select" aria-controls="bookingCustomDates">
                        <option value="all" selected>All Dates</option>
                        <option value="today">Today</option>
                        <option value="last7">Last 7 Days</option>
                        <option value="month">This Month</option>
                        <option value="custom">Custom Range</option>
                    </select>
                </div>
                <div id="bookingCustomDates" class="col-12 col-lg-6 col-xl-4 mb-2 mb-xl-0">
                    <div class="row">
                        <div class="col-sm-6 mb-2 mb-sm-0">
                            <label for="fromDate" class="text-secondary small font-weight-bold">From Date</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-white border-right-0">
                                        <i class="far fa-calendar-alt text-muted" aria-hidden="true"></i>
                                    </span>
                                </div>
                                <input type="date" id="fromDate" min="0001-01-01" max="9999-12-31"
                                       class="form-control border-left-0" aria-describedby="bookingDateFilterError">
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label for="toDate" class="text-secondary small font-weight-bold">To Date</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-white border-right-0">
                                        <i class="far fa-calendar-alt text-muted" aria-hidden="true"></i>
                                    </span>
                                </div>
                                <input type="date" id="toDate" min="0001-01-01" max="9999-12-31"
                                       class="form-control border-left-0" aria-describedby="bookingDateFilterError">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-auto d-flex mb-2 mb-xl-0">
                    <div class="btn-group shadow-sm" role="group" aria-label="Booking date filters">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-search mr-1" aria-hidden="true"></i>
                            Filter
                        </button>
                        <button type="button" id="btnResetBookingDates" class="btn btn-success border-left"
                                title="Reset Booking Dates" aria-label="Reset booking dates">
                            <i class="fas fa-redo-alt" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            </div>
            <p id="bookingDateFilterError" class="text-danger small mt-2 mb-0" role="alert" hidden></p>
            <p id="bookingDateFilterSummary" class="small text-secondary mt-3 mb-0" role="status">
                Applied booking dates: All Dates
            </p>
        </form>
    </div>

    <!-- Data Table Card -->
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <table id="tblBooking"
                   class="table table-sm table-hover table-bordered table-striped"
                   style="width: 100%;">
                <thead class="thead-light">
                    <tr>
                        <th>ID</th>
                        <th>Booking Date</th>
                        <th>Booking No.</th>
                        <th>Student ID</th>
                        <th>Pay (USD)</th>
                        <th>Pay (KHR)</th>
                        <th>Status</th>
                        <th class="text-center" style="width: 100px;">Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_BookingClothesModal"/>
<partial name="_ItemModal"/>
<partial name="_StudentModal"/>

@section scripts{ 
    <script>
        const tblBooking = $("#tblBooking");
        const tblBookingDetail = $("#tblBookingDetail");
        const btnNewBooking = $("#btnNewBooking");
        const BookingClothesModal = $("#BookingClothesModal");
        const tblItem = $("#tblItem");
        const selectItem = $("#btnSelectItem");
        const ItemModal = $("#ItemModal");
        const modalStudent = $("#StudentModal");
        const btnChooseItem = $("#btnChooseItem");
        const btnCloseBooking = $("#btnCloseBooking");
        const btnCloseItem = $("#btnCloseItem");
        const stateSelect = $("#stateSelect");
        const btnAssignItem = $("#btnAssignItem");
        const btnSearchStudent = $("#btnSearchStudent");
        const tblSearchStudent = $("#tblSearchStudent");
        let selectedItems = [];
        let bookingItems = [];
        const bookingDateRange = $("#bookingDateRange");
        const fromDate = $("#fromDate");
        const toDate = $("#toDate");
        const bookingDateInputs = fromDate.add(toDate);
        const bookingDateFilterError = $("#bookingDateFilterError");
        const bookingDateFilterSummary = $("#bookingDateFilterSummary");
        const bookingDatePresetLabels = {
            all: "All Dates",
            today: "Today",
            last7: "Last 7 Days",
            month: "This Month",
            custom: "Custom Range"
        };
        const bookingCalendarDate = new Intl.DateTimeFormat("en-GB", {
            timeZone: "Asia/Phnom_Penh",
            year: "numeric",
            month: "2-digit",
            day: "2-digit"
        });
        let appliedBookingDates = { preset: "all", from: "", to: "" };
        let bookingListRequest = null;
        let bookingCountUnavailable = false;
        const bookingSearchPrompt = "Search bookings or apply a booking date range.";
        const bookingNoMatches = "No bookings match your search or booking date range.";
        let bookingEmptyMessage = bookingSearchPrompt;

        $(document).ready(function () {
            $("#frmBookingDateFilter").on("submit", applyBookingDateFilter);
            $("#btnResetBookingDates").on("click", resetBookingDateFilter);
            bookingDateRange.on("change", syncBookingDateInputs);
            bookingDateInputs.on("input change", function () {
                bookingDateRange.val("custom");
                showBookingDateFilterError("");
            });
            syncBookingDateInputs();
            fetchBooking();
        }); 

        function fetchBooking() {
            if ($.fn.DataTable.isDataTable('#tblBooking')) {
                tblBooking.DataTable().destroy();
            }
            tblBooking.DataTable({
                processing: true,
                serverSide: true,
                paging: true,
                pageLength: 10,
                lengthChange: true,
                searching: true,
                info: true,
                stateSave: false,
                responsive: false,
                autoWidth: false,
                scrollX: false,
                scrollY: "",
                ajax: loadBookingRows,
                columns: [
                    { data: "bookingId" },
                    {
                        data: "bookingDate",
                        render: function (data) {
                            return `${formatDate(data)}`;
                        }
                    },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `<span class="font-weight-bold text-dark">${row.yearNumber}-${row.bookingNo}</span>`;
                        }
                    },
                    { data: "studentId" },
                    { data: "payDollar" },
                    { data: "payRieal" },
                    {
                        data: null,
                        className: "text-center",
                        render: function (data, type, row) {
                            if (row.returnAlready === false) 
                                return `<span class="badge badge-danger px-2 py-1"><i class="fas fa-unlock mr-1"></i> Not Returned</span>`; 
                            return `<span class="badge badge-success px-2 py-1"><i class="fas fa-check mr-1"></i> Returned</span>`;
                        }
                    },
                    {
                        data: null,
                        className: "text-center",
                        render: function (data, type, row) {
                            return `
                                <button type="button"
                                        class="btn btn-warning btn-sm btnEditBooking"
                                        data-id="${row.bookingId}">
                                    <i class="fas fa-pencil"></i> Edit
                                </button>
                            `;
                        }
                    }
                ],
                language: {
                    processing: "Loading...",
                    searchPlaceholder: "Search bookings",
                    info: "Showing _START_ to _END_ of _TOTAL_ entries",
                    infoEmpty: "Showing 0 to 0 of _MAX_ entries",
                    infoFiltered: "",
                    thousands: ",",
                    emptyTable: bookingSearchPrompt,
                    zeroRecords: bookingNoMatches
                },
                infoCallback: function (_settings, _start, _end, _max, _total, text) {
                    return bookingCountUnavailable ? "Total entries unavailable" : text;
                },
                initComplete: function () {
                    const table = $(this.api().table().node());
                    if (!table.parent().hasClass("booking-table-scroll")) {
                        table.wrap('<div class="booking-table-scroll" role="region" aria-label="Booking Clothes table" tabindex="0"></div>');
                    }
                    if (typeof MyApp !== "undefined" &&
                        typeof MyApp.utils?.dataTableDebounceSearch === "function") {
                        MyApp.utils.dataTableDebounceSearch("#tblBooking", 500);
                    }
                },
                drawCallback: function () {
                    const api = this.api();
                    const page = api.page.info();
                    const hasResults = page.recordsDisplay > 0;

                    $(api.table().container())
                        .toggleClass("booking-has-results", hasResults)
                        .toggleClass("booking-has-pages", hasResults && page.pages > 1);

                    if (!hasResults) {
                        $(api.table().body()).find("td.dataTables_empty, td.dt-empty").text(bookingEmptyMessage);
                    }
                }
            });
        }

        function loadBookingRows(request, complete) {
            if (bookingListRequest) {
                const previousRequest = bookingListRequest;
                bookingListRequest = null;
                previousRequest.abort();
            }

            const search = String(request.search?.value ?? "").trim();
            const { from, to } = appliedBookingDates;
            const summaryOnly = !search && !from && !to;
            const emptyResponse = { draw: request.draw, recordsTotal: 0, recordsFiltered: 0, data: [] };
            bookingEmptyMessage = summaryOnly ? bookingSearchPrompt : bookingNoMatches;

            const pending = $.ajax({
                url: "/booking-clothes/get-booking-clothes",
                type: "POST",
                dataType: "json",
                data: {
                    ...request,
                    // Read the total from the existing endpoint without displaying its row.
                    ...(summaryOnly ? { start: 0, length: 1 } : {}),
                    search: { ...request.search, value: search },
                    fromDate: from,
                    toDate: to
                }
            });
            bookingListRequest = pending;

            function showLoadError(reason, message) {
                if (bookingListRequest !== pending) return;

                bookingCountUnavailable = true;
                if (!summaryOnly) {
                    bookingEmptyMessage = "Unable to load bookings. Try searching again.";
                }
                console.error("Cannot load bookings:", reason);
                complete(emptyResponse);
                if (!summaryOnly && typeof ShowToastError === "function") {
                    ShowToastError(message || "Cannot load bookings.");
                }
            }

            return pending.done(function (response) {
                if (bookingListRequest !== pending) return;

                const recordsTotal = Number(response?.recordsTotal ?? NaN);
                const recordsFiltered = Number(response?.recordsFiltered ?? NaN);
                const rows = response?.data ?? (recordsFiltered === 0 ? [] : null);
                if (!Number.isSafeInteger(recordsTotal) || recordsTotal < 0 ||
                    (!summaryOnly && (!Array.isArray(rows) ||
                        !Number.isSafeInteger(recordsFiltered) || recordsFiltered < 0))) {
                    showLoadError("Unexpected list response.");
                    return;
                }

                bookingCountUnavailable = false;
                complete(summaryOnly
                    ? { ...emptyResponse, recordsTotal }
                    : { draw: request.draw, recordsTotal, recordsFiltered, data: rows });
            }).fail(function (xhr, status) {
                if (status !== "abort") {
                    showLoadError(xhr.status || status, xhr.responseJSON?.status?.message || xhr.responseJSON?.message);
                }
            }).always(function () {
                if (bookingListRequest === pending) {
                    bookingListRequest = null;
                }
            });
        }

        function getBookingPresetDates(preset, now = new Date()) {
            if (!["today", "last7", "month"].includes(preset)) {
                return { preset: "all", from: "", to: "" };
            }

            // Use the campus calendar day, even when the browser is in another timezone.
            const parts = Object.fromEntries(
                bookingCalendarDate.formatToParts(now).map(part => [part.type, part.value])
            );
            const year = Number(parts.year);
            const month = Number(parts.month) - 1;
            const day = Number(parts.day);
            const isoDay = timestamp => new Date(timestamp).toISOString().slice(0, 10);
            const startDay = preset === "month" ? 1 : day - (preset === "last7" ? 6 : 0);

            return {
                preset,
                from: isoDay(Date.UTC(year, month, startDay)),
                to: isoDay(preset === "month" ? Date.UTC(year, month + 1, 0) : Date.UTC(year, month, day))
            };
        }

        function setBookingDateInputs(dates) {
            fromDate.val(dates.from);
            toDate.val(dates.to);
        }

        function syncBookingDateInputs() {
            const preset = bookingDateRange.val();
            if (preset !== "custom") {
                setBookingDateInputs(getBookingPresetDates(preset));
            }
            showBookingDateFilterError("");
        }

        function showBookingDateFilterError(message, field) {
            bookingDateFilterError.text(message).prop("hidden", !message);
            bookingDateInputs.removeAttr("aria-invalid");
            if (field) {
                field.attr("aria-invalid", "true").trigger("focus");
            }
        }

        function applyBookingDateFilter(event) {
            event.preventDefault();

            const preset = bookingDateRange.val();
            let dates;
            if (preset === "custom") {
                const fromInput = fromDate[0];
                const toInput = toDate[0];
                if (!fromInput.validity.valid) {
                    showBookingDateFilterError("Enter a valid From Date.", fromDate);
                    return;
                }
                if (!toInput.validity.valid) {
                    showBookingDateFilterError("Enter a valid To Date.", toDate);
                    return;
                }

                const from = fromInput.value;
                const to = toInput.value;
                if (!from || !to) {
                    showBookingDateFilterError("Enter both dates, or choose All Dates.", from ? toDate : fromDate);
                    return;
                }
                if (from > to) {
                    showBookingDateFilterError("To Date must be on or after From Date.", toDate);
                    return;
                }
                dates = { preset, from, to };
            } else {
                dates = getBookingPresetDates(preset);
                setBookingDateInputs(dates);
            }

            appliedBookingDates = dates;
            showBookingDateFilterError("");
            updateBookingDateFilterSummary();
            tblBooking.DataTable().ajax.reload(null, true);
        }

        function resetBookingDateFilter() {
            bookingDateRange.val("all");
            appliedBookingDates = { preset: "all", from: "", to: "" };
            syncBookingDateInputs();
            updateBookingDateFilterSummary();
            tblBooking.DataTable().ajax.reload(null, true);
        }

        function updateBookingDateFilterSummary() {
            const { preset, from, to } = appliedBookingDates;
            const displayDate = value => value.split("-").reverse().join("/");
            let summary = "Applied booking dates: " + bookingDatePresetLabels[preset];
            if (from && to) {
                summary += " (" + displayDate(from) + (from === to ? "" : " – " + displayDate(to)) + ")";
            }
            bookingDateFilterSummary.text(summary);
        }
        
        function fetchBookingDetail(bookingId) {
            $.ajax({
                url: `/booking-clothes/details-booking-clothes/${bookingId}`,
                type: "GET",  
                success: function (response) { 
                    console.log(response); 
                    const data = response.data; 
                    if (!data) {
                        ShowToastInfo("Booking data not found.");
                        return;
                    }  
                    const booking = data.booking;
                    const items = data.item || []; 
                    $("#booking_bookingId").val(booking.bookingId);
                    $("#booking_StudentId").val(booking.studentId);
                    $("#booking_BookingNo").val(booking.bookingNo);
                    $("#booking_BookingDate").val(formatDateForInput(booking.bookingDate)); 
                    $("#booking_Note").val(booking.note || "");
                    $("#booking_PayDollar").val(booking.payDollar || 0);
                    $("#booking_PayRieal").val(booking.payRieal || 0); 

                    bookingItems = items.map(function (x) {
                        return {
                            bookingDetailId: x.bookingDetailId,
                            bookingId: x.bookingId,
                            clothId: x.clothId,
                            itemName: x.itemName || "",
                            nameKhmer: x.itemNameKhmer || "",
                            qty: Number(x.qty || 0),
                            price: Number(x.price || 0),
                            priceKhr: Number(x.priceKhr || 0),
                            discountPercent: Number(x.discountPercent || 0)
                        };

                    });
                    renderBookingItems(); 
                    
                    selectedItems = [];
                    stateSelect.empty().trigger("change"); 
                    $("#BookingClothesModal .modal-title").text("Edit Booking"); 
                    BookingClothesModal.modal("show");
                },
                error: function () { 
                    ShowToastInfo("Unable to load booking details.");
                }
            });
        } 

        //---------------------------------------------------- Event Trigger ----------------------------------------------------
        btnNewBooking.on("click", function () {
            BookingClothesModal.modal("show");
            tblItem.DataTable();
            $("#BookingClothesModal .modal-title").text("New Booking");
            setPaymentFullscreen(true);
        });
        
        btnCloseBooking.on("click", function () {
            BookingClothesModal.modal("hide");
        });

        btnCloseItem.on("click", function () {
            ItemModal.modal("hide");
        });

        btnAssignItem.on("click", function () {
            if (selectedItems.length === 0) {
                ShowToastInfo("Please select at least one item.");
                return;
            }
            selectedItems.forEach(function (item) {
                addBookingItem(item);
            });
            selectedItems = [];
            stateSelect.empty().trigger("change");
            ItemModal.modal("hide");
        });
        
        selectItem.on("click", function () {
            tblItem.DataTable().clear().destroy();
            tblItem.DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                ajax: {
                    url: "/booking-clothes/get-items",
                    type: "POST"
                },
                columns: [
                    { data: "id" },
                    { data: "name" },
                    { data: "nameKhmer" },
                    { data: "price" },
                    {
                        data: null,
                        render: function () {
                            return `
                                <button type="button"
                                        class="btn btn-default btn-xs btn-block btnChooseItem">
                                    <i class="fas fa-check mr-1"></i>
                                    Select
                                </button>
                            `;
                        }
                    }
                ]
            });
            ItemModal.modal("show");
        });

        tblItem.on("click", ".btnChooseItem", function () {
            const $button = $(this);
            const $row = $button.closest("tr");
            const selectedRow = tblItem.DataTable().row($row).data();

            if (!selectedRow) return;

            const exists = selectedItems.some(function (x) {
                return String(x.id) === String(selectedRow.id);
            });
            if (exists) return;
            selectedItems.push(selectedRow);
            const text =
                `${selectedRow.name} (${formatUsd(selectedRow.price)} $)`;

            const newOption = new Option(
                text,
                selectedRow.id,
                true,
                true
            );

            stateSelect
                .append(newOption)
                .trigger("change");

            $button
                .removeClass("btn-default")
                .addClass("btn-success")
                .html('<i class="fas fa-check mr-1"></i> Selected')
                .prop("disabled", true);
        });

        tblBooking.on("click", ".btnEditBooking", function () {

            const bookingId = $(this).data("id");

            if (!bookingId) return;

            fetchBookingDetail(bookingId);
        });
        
        btnSearchStudent.on("click", function (e) {
            e.preventDefault();
            tblSearchStudent.DataTable().clear().destroy();
            tblSearchStudent.DataTable({
                processing: true,
                serverSide: true,
                paging: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                responsive: true,
                autoWidth: true,
                scrollCollapse: true,
                ajax: {
                    url: "/student/academic/student-list/all",
                    type: "POST",
                    error: function (error) {
                        console.log(error.responseText);
                    }
                },
                columns: [
                    {data: "studentId"},
                    {data: "studentName"},
                    {data: "studentNameInKhmer"},
                    {data: "sex"},
                    {
                        data: null,
                        render: function (data, type, row) {
                            if (row.status === "REGISTER") {
                                return ` <span class="badge badge-warning">${row.status}</span>`;
                            } else if (row.status === "ACTIVE") {
                                return ` <span class="badge badge-primary">${row.status}</span>`;
                            } else if (row.status === "QUIT") {
                                return ` <span class="badge badge-danger">${row.status}</span>`;
                            } else {
                                return `<span class="badge badge-secondary">${row.status}</span>`;
                            }
                        },
                    },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `<a id="btnSelectStudent" class="btn btn-success btn-xs btn-block">Select</a>`;
                        },
                    },
                ],
                initComplete: function () {
                    MyApp.utils.dataTableDebounceSearch("#tblSearchStudent", 500);
                }
            });
            modalStudent.modal("show");
        })
        
        tblSearchStudent.on("click", "#btnSelectStudent", function () {
            const $row = $(this).closest('tr');
            const selectedRow = tblSearchStudent.DataTable().row($row).data();
            if (selectedRow) {
                $("#booking_StudentId").val(selectedRow.studentId);
                modalStudent.modal("hide");
            }
        });
        //---------------------------------------------------- Event Trigger ----------------------------------------------------
        
        // ---------------------------------------------------- Booking Item Section ---------------------------------------------------- 
        function getExchangeRate() { 
            let rate = $('#txtRateOut').text(); 
            rate = parseFloat(
                String(rate).replace(/,/g, '')
            );

            return rate || 4100;
        }
        
        // ADD SELECTED ITEM
        function addBookingItem(item) {
            let clothId = item.id; 
            let exists = bookingItems.some(x =>
                String(x.clothId) === String(clothId)
            );
            if (exists) return;
            let priceUsd = parseFloat(item.price || 0);
            let priceKhr = parseFloat(
                item.priceKhr || 0
            );
            if (priceKhr === 0) {
                priceKhr = priceUsd * getExchangeRate();
            }
            bookingItems.push({
                bookingDetailId: 0,
                bookingId: 0,
                clothId: clothId,
                itemName: item.name || item.namekhmer || '',
                nameKhmer: item.nameKhmer || '',
                qty: 1,
                price: priceUsd,
                priceKhr: priceKhr,
                discountPercent: 0
            });
            renderBookingItems();
        }
        
        // RENDER TABLE 
        function renderBookingItems() {
            let tbody = $('#tblBookingDetail tbody'); 
            tbody.empty(); 
            $.each(bookingItems, function(index, item) { 
                let totalUsd = calculateLineUsd(item);
                let totalKhr = calculateLineKhr(item); 
                let row = `<tr data-index="${index}"> 
                    <td style="display:none;">${item.bookingDetailId}</td>
                    <td style="display:none;">${item.bookingId}</td>
                    <td style="display:none;">${item.clothId}</td>
                    <td>
                        <strong>${item.itemName}</strong>
                        ${item.nameKhmer ? `<div class="small text-muted"> ${item.nameKhmer} </div>` : ''}
                    </td>
                    <td>
                        <input type="number" class="form-control form-control-sm text-right item-qty"
                               min="1"
                               step="1"
                               value="${item.qty}"
                               data-index="${index}">
                    </td> 
                    <td>
                        <input type="number" class="form-control form-control-sm text-right item-price-usd"
                               min="0"
                               step="0.01"
                               value="${item.price.toFixed(2)}"
                               data-index="${index}">
                    </td> 
                    <td>
                        <input type="number" class="form-control form-control-sm text-right item-price-khr"
                               min="0"
                               step="100"
                               value="${item.priceKhr.toFixed(0)}"
                               data-index="${index}">
                    </td> 
                    <td>
                        <div class="input-group input-group-sm">
                            <input type="number" class="form-control text-right item-discount"
                                   min="0"
                                   max="100"
                                   step="1"
                                   value="${item.discountPercent}"
                                   data-index="${index}">
                            <div class="input-group-append">
                                <span class="input-group-text">
                                    %
                                </span>
                            </div>
                        </div>
                    </td> 
                    <td class="text-right font-weight-bold line-total-usd">
                        ${formatUsd(totalUsd)}
                    </td> 
                    <td class="text-right font-weight-bold line-total-khr">
                        ${formatKhr(totalKhr)}
                    </td> 
                    <td class="text-center"> 
                        <button type="button" class="btn btn-danger btn-sm"
                                onclick="removeBookingItem(${index})"
                                title="Remove"> 
                            <i class="fas fa-trash"></i> 
                        </button> 
                    </td> 
                </tr>
            `; 
                tbody.append(row);
            }); 
            calculateGrandTotal();
        }

 
        // CALCULATE USD 
        function calculateLineUsd(item) {
            let qty = parseFloat(item.qty || 0);
            let price = parseFloat(item.price || 0);
            let discount = parseFloat(item.discountPercent || 0);
            let subTotal = qty * price;
            let discountAmount = subTotal * discount / 100;
            return subTotal - discountAmount;
        }
        
        // CALCULATE KHR 
        function calculateLineKhr(item) { 
            let qty = parseFloat(item.qty || 0);
            let price = parseFloat(item.priceKhr || 0);
            let discount = parseFloat(item.discountPercent || 0); 
            let subTotal = qty * price;
            let discountAmount = subTotal * discount / 100;
            return subTotal - discountAmount;
        }
        
        // CHANGE QTY 
        $(document).on('input','.item-qty',function () { 
                let index = $(this).data('index');
                bookingItems[index].qty = parseFloat($(this).val()) || 0;
                updateRowTotal(index);
            }
        );
        
        // CHANGE USD PRICE 
        $(document).on('input','.item-price-usd',function () {
                let index = $(this).data('index');
                let usd = parseFloat($(this).val()) || 0;
                bookingItems[index].price = usd;
                // automatically update KHR
                bookingItems[index].priceKhr = usd * getExchangeRate();
                let row = $('#tblBookingDetail tbody tr').eq(index);
                row.find('.item-price-khr').val(bookingItems[index].priceKhr.toFixed(0));
                updateRowTotal(index);
            }
        );

        // CHANGE KHR PRICE 
        $(document).on('input','.item-price-khr',function () {
                let index = $(this).data('index');
                bookingItems[index].priceKhr = parseFloat($(this).val()) || 0;
                updateRowTotal(index);
            }
        );
        
        // CHANGE DISCOUNT
        $(document).on('input','.item-discount',function () {
                let index = $(this).data('index');
                let discount = parseFloat($(this).val()) || 0;
                if (discount > 100) {
                    discount = 100;
                    $(this).val(100);
                }
                bookingItems[index].discountPercent = discount;
                updateRowTotal(index);
            }
        );
        
        // UPDATE ONLY CURRENT ROW
        function updateRowTotal(index) {
            let item = bookingItems[index];
            let usd = calculateLineUsd(item);
            let khr = calculateLineKhr(item);
            let row = $('#tblBookingDetail tbody tr').eq(index);
            row.find('.line-total-usd').text('$' + formatUsd(usd));
            row.find('.line-total-khr').text(formatKhr(khr) + ' ៛');
            calculateGrandTotal();
        }
        
        // CALCULATE TOTAL 
        function calculateGrandTotal() {
            let grandUsd = 0;
            let grandKhr = 0;
            $.each(bookingItems, function(_, item) {
                grandUsd += calculateLineUsd(item);
                grandKhr += calculateLineKhr(item);
            });
            $('#lblGrandTotalUsd').text(formatUsd(grandUsd));
            $('#lblGrandTotalKhr').text(formatKhr(grandKhr));
            $('#invoice_GrandTotalUsd').val(grandUsd.toFixed(2));
            $('#invoice_GrandTotalKhr').val(grandKhr.toFixed(0));
        }
        
        // REMOVE 
        function removeBookingItem(index) {
            bookingItems.splice(index, 1);
            renderBookingItems();
        } 
        // ---------------------------------------------------- Booking Item Section ----------------------------------------------------
        
        
        // toggle modal fullscreen or minimize screen
        $(document).on('click','.btnEditBooking',function () {
            setPaymentFullscreen(true);
        })
        $("#btnTogglePaymentFullscreen").on("click", function () {
            const modal = $("#BookingClothesModal");
            setPaymentFullscreen(!modal.hasClass("fullscreen-modal"));
        });
        function setPaymentFullscreen(isFullscreen) {
            const modal = $("#BookingClothesModal");
            const icon = $("#paymentFullscreenIcon");
            if (isFullscreen) {
                modal.addClass("fullscreen-modal");
                icon.removeClass("fa-expand").addClass("fa-compress");
                $("#btnTogglePaymentFullscreen").attr("title", "Restore");
            } else {
                modal.removeClass("fullscreen-modal");
                icon.removeClass("fa-compress").addClass("fa-expand");
                $("#btnTogglePaymentFullscreen").attr("title", "Fullscreen");
            }
            setTimeout(function () {
                if ($.fn.DataTable && $.fn.DataTable.isDataTable("#tblBookingDetail")) {
                    $("#tblBookingDetail").DataTable().columns.adjust().draw(false);
                }
            }, 200);
        }
    </script>
}
