@{
ViewData["Title"] = "Booking Clothes";
ViewData["OpenMenu"] = "Administration";
ViewData["Action"] = "BookingClothes";
ViewData["HideHeader"] = true;
}

<style>
    /* DataTables, Select2, and booking modal markup supply the generated selectors. */
    #bookingClothesPage h1 {
        margin: 0;
        color: #222d43;
        font-size: clamp(1.4rem, 2.5vw, 1.75rem);
        font-weight: 700;
        line-height: 1.2;
    }

    #bookingClothesPage .booking-page-subtitle,
    #BookingDateFilterModal .booking-filter-intro {
        color: #56637a;
        font-size: .875rem;
    }

    #bookingClothesPage .booking-page-subtitle {
        margin: .2rem 0 0;
    }

    #bookingClothesPage .booking-page-actions {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
    }

    #bookingClothesPage .booking-page-actions .btn {
        min-height: 2.5rem;
        border-radius: .4rem;
        padding-inline: .95rem;
        font-weight: 600;
    }

    #bookingClothesPage .booking-date-summary {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: .4rem .6rem;
        padding: .8rem 1rem;
        border-bottom-color: #dce2ed;
    }

    /*noinspection CssUnusedSymbol*/
    #bookingClothesPage .booking-date-chip {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .24rem .55rem;
        border-radius: 1rem;
        background: #eef0fa;
        color: #25296b;
        font-size: .78rem;
        font-weight: 600;
    }

    /*noinspection CssUnusedSymbol*/
    #bookingClothesPage #tblBooking_wrapper {
        width: 100%;
    }

    /*noinspection CssUnusedSymbol*/
    #bookingClothesPage #tblBooking_wrapper:not(.booking-has-results) .dataTables_length,
    #bookingClothesPage #tblBooking_wrapper:not(.booking-has-results) .dt-length,
    #bookingClothesPage #tblBooking_wrapper:not(.booking-has-pages) .dataTables_paginate,
    #bookingClothesPage #tblBooking_wrapper:not(.booking-has-pages) .dt-paging {
        display: none;
    }

    /*noinspection CssUnusedSymbol*/
    #bookingClothesPage .booking-table-scroll {
        width: 100%;
        max-width: 100%;
        overflow-x: auto;
    }

    #bookingClothesPage #tblBooking th,
    #bookingClothesPage #tblBooking td {
        vertical-align: middle !important;
        white-space: nowrap;
    }

    /*noinspection CssUnusedSymbol*/
    #bookingClothesPage #tblBooking .badge {
        min-width: 75px;
        padding: 6px 8px;
    }

    /*noinspection CssUnusedSymbol*/
    #bookingClothesPage #tblBooking td.dataTables_empty,
    #bookingClothesPage #tblBooking td.dt-empty {
        white-space: normal;
    }

    #bookingClothesPage #tblBooking .booking-money {
        text-align: left;
    }

    /*noinspection CssUnusedSymbol*/
    #bookingClothesPage .booking-number,
    #bookingClothesPage .booking-money {
        font-variant-numeric: tabular-nums;
    }

    /*noinspection CssUnusedSymbol*/
    #bookingClothesPage .btnEditBooking[aria-busy="true"] {
        cursor: progress;
    }

    #BookingDateFilterModal .modal-dialog {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        width: 460px;
        max-width: 100%;
        height: 100%;
        margin: 0;
    }

    #BookingDateFilterModal.fade .modal-dialog {
        transform: translateX(100%);
        transition: transform .3s ease;
    }

    #BookingDateFilterModal.show .modal-dialog {
        transform: translateX(0);
    }

    #BookingDateFilterModal .modal-content {
        height: 100%;
        border: 0;
        border-radius: 0;
        box-shadow: -8px 0 30px rgba(0, 0, 0, .12);
    }

    #BookingDateFilterModal .modal-header {
        flex-shrink: 0;
        padding: 20px 24px;
        border-bottom-color: #dce2ed;
        color: #222d43;
    }

    #BookingDateFilterModal .modal-body {
        min-height: 0;
        overflow-y: auto;
        padding: 24px;
        background: #f7f8fc;
    }

    #BookingDateFilterModal label {
        color: #222d43;
        font-size: .875rem;
    }

    #BookingDateFilterModal .form-control,
    #BookingDateFilterModal .custom-select {
        border-color: #c7d0df;
        border-radius: .4rem;
    }

    #BookingDateFilterModal .modal-footer {
        flex-shrink: 0;
        padding: 16px 24px;
        border-top-color: #dce2ed;
        background: #fff;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal.booking-inline-editor:not(.fullscreen-modal) .modal-dialog {
        width: calc(100% - 2rem);
        max-width: 1320px;
        margin: 1rem auto;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal.booking-inline-editor:not(.fullscreen-modal) .modal-content {
        max-height: calc(100vh - 2rem);
        border: 1px solid #dce2ed;
        border-radius: .7rem;
        box-shadow: 0 12px 38px rgba(20, 28, 49, .2);
    }

    #BookingClothesModal.booking-inline-editor .modal-content > form {
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    #BookingClothesModal.booking-inline-editor .modal-body {
        min-height: 0;
        overflow: auto;
        padding: 1rem 1.25rem;
    }

    #BookingClothesModal.booking-inline-editor .modal-header,
    #BookingClothesModal.booking-inline-editor .modal-footer {
        flex-shrink: 0;
        padding: .75rem 1.25rem;
        border-color: #dce2ed;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal.booking-inline-editor .modal-title {
        font-size: 1.15rem;
        font-weight: 700;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal .booking-save-feedback {
        flex: 0 0 100%;
        min-width: 0;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal .booking-inline-student {
        position: relative;
        flex: 1 1 100%;
        min-width: 0;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal .booking-inline-student > .select2-container {
        display: block;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal .booking-student-icon {
        position: absolute;
        z-index: 1;
        top: 50%;
        left: .75rem;
        color: #56637a;
        font-size: .85rem;
        transform: translateY(-50%);
        pointer-events: none;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal .booking-inline-student .select2-selection--single {
        height: calc(2.25rem + 2px);
        padding: 0;
        border: 1px solid #c7d0df;
        border-radius: .4rem;
        background: #fff;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal .booking-inline-student .select2-selection__rendered {
        padding: 0 2rem 0 .75rem;
        color: #222d43;
        line-height: 2.25rem;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal .booking-inline-student .select2-selection__rendered {
        padding-left: 2.15rem;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal .booking-inline-student .select2-selection__arrow {
        right: .45rem;
        height: 2.25rem;
    }

    /*noinspection CssUnusedSymbol*/
    #BookingClothesModal .booking-inline-student .select2-selection--single:focus-visible {
        outline: 2px solid #5365b0;
        outline-offset: 1px;
    }

    @@media (max-width: 575px) {
        #bookingClothesPage .booking-page-actions {
            width: 100%;
        }

        #bookingClothesPage .booking-page-actions .btn {
            flex: 1 1 auto;
        }

        /*noinspection CssUnusedSymbol*/
        #BookingClothesModal.booking-inline-editor:not(.fullscreen-modal) .modal-dialog {
            width: calc(100% - 1rem);
            margin: .5rem auto;
        }

        /*noinspection CssUnusedSymbol*/
        #BookingClothesModal.booking-inline-editor:not(.fullscreen-modal) .modal-content {
            max-height: calc(100vh - 1rem);
        }

        #bookingClothesPage .booking-date-summary,
        #BookingClothesModal.booking-inline-editor .modal-header,
        #BookingClothesModal.booking-inline-editor .modal-body,
        #BookingClothesModal.booking-inline-editor .modal-footer,
        #BookingDateFilterModal .modal-header,
        #BookingDateFilterModal .modal-body,
        #BookingDateFilterModal .modal-footer {
            padding-inline: .85rem;
        }
    }

    /* Keep the viewport-height fallback outside this feature query. */
    @@supports (height: 100dvh) {
        /*noinspection CssUnusedSymbol*/
        #BookingClothesModal.booking-inline-editor:not(.fullscreen-modal) .modal-content {
            max-height: calc(100dvh - 2rem);
        }

        @@media (max-width: 575px) {
            /*noinspection CssUnusedSymbol*/
            #BookingClothesModal.booking-inline-editor:not(.fullscreen-modal) .modal-content {
                max-height: calc(100dvh - 1rem);
            }
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        #BookingDateFilterModal.fade .modal-dialog {
            transition: none;
        }
    }
</style>

<div id="bookingClothesPage" class="container-fluid px-0 pt-3">
    <header class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div class="mr-3">
            <h1>Booking Clothes</h1>
            <p class="booking-page-subtitle">Manage student clothing bookings and returns</p>
        </div>
        <div class="booking-page-actions ml-auto mt-2 mt-sm-0">
            <button type="button"
                    id="btnOpenBookingDateFilter"
                    class="btn btn-outline-primary text-nowrap"
                    data-toggle="modal"
                    data-target="#BookingDateFilterModal"
                    aria-haspopup="dialog"
                    aria-controls="BookingDateFilterModal">
                <i class="fas fa-filter mr-1" aria-hidden="true"></i>
                Filter
            </button>
            <button type="button"
                    id="btnNewBooking"
                    class="btn btn-primary shadow-sm text-nowrap"
                    aria-haspopup="dialog"
                    aria-controls="BookingClothesModal">
                <i class="fas fa-plus-circle mr-1" aria-hidden="true"></i>
                New Booking
            </button>
        </div>
    </header>

    <section class="card shadow-sm border-0" aria-label="Booking records">
        <div id="bookingDateFilterSummary" class="card-header bg-white booking-date-summary d-none">
            <span class="booking-date-chip">
                <i class="far fa-calendar-alt" aria-hidden="true"></i>
                <span id="bookingActiveDateLabel" role="status"></span>
            </span>
            <button type="button" id="btnClearBookingDates" class="btn btn-link btn-sm px-1"
                    aria-label="Clear booking date filter">
                Clear
            </button>
        </div>
        <div class="card-body">
            <table id="tblBooking"
                   class="table table-sm table-hover table-bordered table-striped"
                   style="width: 100%;">
                <caption class="sr-only">Clothing bookings</caption>
                <thead class="thead-light">
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Booking Date</th>
                    <th scope="col">Booking No.</th>
                    <th scope="col">Student ID</th>
                    <th scope="col" class="booking-money">Pay (USD)</th>
                    <th scope="col" class="booking-money">Pay (KHR)</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-center" style="width: 100px;">Action</th>
                </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </section>
</div>

<div class="modal fade"
     id="BookingDateFilterModal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="bookingDateFilterTitle"
     aria-hidden="true">
    <div class="modal-dialog" role="document">
        <form id="frmBookingDateFilter" class="modal-content" novalidate>
            <div class="modal-header">
                <h5 class="modal-title font-weight-bold" id="bookingDateFilterTitle">
                    <i class="fas fa-filter mr-2 text-primary" aria-hidden="true"></i>Filter Bookings
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <p class="booking-filter-intro mb-3">
                    Choose a preset or enter both dates for a custom range.
                </p>
                <div class="form-group">
                    <label for="bookingDateRange">Booking Date</label>
                    <select id="bookingDateRange" class="custom-select">
                        <option value="all" selected>All Dates</option>
                        <option value="today">Today</option>
                        <option value="last7">Last 7 Days</option>
                        <option value="month">This Month</option>
                        <option value="custom">Custom Range</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="fromDate">From Date</label>
                    <input type="date" id="fromDate" min="0001-01-01" max="9999-12-31"
                           class="form-control" aria-describedby="bookingDateFilterError">
                </div>

                <div class="form-group">
                    <label for="toDate">To Date</label>
                    <input type="date" id="toDate" min="0001-01-01" max="9999-12-31"
                           class="form-control" aria-describedby="bookingDateFilterError">
                </div>

                <p id="bookingDateFilterError" class="text-danger small mb-0" role="alert" hidden></p>
            </div>

            <div class="modal-footer">
                <button type="button" id="btnResetBookingDates" class="btn btn-outline-secondary mr-auto"
                        aria-label="Reset booking dates">
                    <i class="fas fa-redo-alt mr-1" aria-hidden="true"></i> Reset
                </button>
                <button type="button" class="btn btn-light" data-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-check mr-1" aria-hidden="true"></i> Apply Filter
                </button>
            </div>
        </form>
    </div>
</div>

<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<div id="bookingSaveToken" hidden>@Html.AntiForgeryToken()</div>
<partial name="_BookingClothesModal"/>
<partial name="_ItemModal"/>
<partial name="_StudentModal"/>

@section scripts {
<script>
    // Shapes used by the existing JSON endpoints and the local editor.
    /** @@typedef {string|number} BookingKey */
    /** @@typedef {number|string|null} BookingAmount */

    /**
     * @@typedef {{
     *   recordsTotal?: BookingAmount,
     *   recordsFiltered?: BookingAmount,
     *   data?: (BookingRecord | BookingStudent | BookingCatalogItem)[]
     * }} BookingGridResponse
     */

    /**
     * @@typedef {{
     *   status?: {code?: BookingKey, message?: string},
     *   message?: string,
     *   title?: string
     * }} BookingServerStatus
     */

    /** @@typedef {{status: number, responseJSON?: BookingServerStatus}} BookingAjaxError */

    /**
     * @@typedef {{
     *   studentId?: BookingKey,
     *   studentName?: string,
     *   studentNameInKhmer?: string,
     *   status?: string
     * }} BookingStudent
     */

    // The server uses the legacy KHR payment field in this record.
    //noinspection SpellCheckingInspection
    /**
     * @@typedef {{
     *   bookingId: BookingKey,
     *   bookingDate: string,
     *   yearNumber?: BookingKey,
     *   bookingNo?: BookingKey,
     *   note?: string,
     *   payDollar?: BookingAmount,
     *   'payRieal'?: BookingAmount,
     *   total?: BookingAmount,
     *   vat?: BookingAmount,
     *   discount?: BookingAmount,
     *   active?: boolean|null,
     *   schoolId?: BookingAmount,
     *   fieldId?: BookingAmount,
     *   termNo?: BookingAmount,
     *   groupId?: BookingAmount,
     *   returnAlready?: boolean
     * } & BookingStudent} BookingRecord
     */

    /**
     * @@typedef {{
     *   id: BookingKey,
     *   name?: string,
     *   nameKhmer?: string,
     *   namekhmer?: string,
     *   price?: BookingAmount,
     *   priceKhr?: BookingAmount
     * }} BookingCatalogItem
     */

    /**
     * @@typedef {{
     *   bookingDetailId: BookingKey,
     *   bookingId: BookingKey,
     *   clothId: BookingKey|null,
     *   itemName?: string,
     *   nameKhmer?: string,
     *   qty: number,
     *   price: number
     * }} BookingLine
     */

    /**
     * @@typedef {{
     *   bookingDetailId: BookingKey,
     *   bookingId: BookingKey,
     *   clothId: BookingKey|null,
     *   itemName?: string,
     *   nameKhmer?: string,
     *   itemNameKhmer?: string,
     *   qty: BookingAmount,
     *   price: BookingAmount
     * }} SavedBookingLine
     */

    /**
     * @@typedef {{
     *   data?: {
     *     booking: BookingRecord,
     *     item?: SavedBookingLine[],
     *     student?: BookingStudent,
     *     editorItemSaveSupported?: boolean
     *   }
     * }} BookingDetailResponse
     */

    /**
     * @@typedef {{
     *   status?: {code?: BookingKey, message?: string},
     *   data?: {bookingId?: BookingKey, itemCount?: BookingAmount}
     * }} BookingSaveResponse
     */

        // The controller expects this JSON key for the KHR amount.
        //noinspection SpellCheckingInspection
    const bookingKhrPaymentKey = "payRieal";

    const bookingTableSelector = "#tblBooking";
    const bookingDetailTableSelector = "#tblBookingDetail";
    const bookingSaveButtonSelector = "#btnSaveBooking";
    const bookingFormSelector = "#PaymentForm";
    const tblBooking = $(bookingTableSelector);
    const tblBookingDetail = $(bookingDetailTableSelector);
    const btnNewBooking = $("#btnNewBooking");
    const BookingClothesModal = $("#BookingClothesModal");
    const tblItem = $("#tblItem");
    const ItemModal = $("#ItemModal");
    const modalStudent = $("#StudentModal");
    const btnCloseBooking = $("#btnCloseBooking");
    const btnCloseItem = $("#btnCloseItem");
    const stateSelect = $("#stateSelect");
    const btnAssignItem = $("#btnAssignItem");
    const btnSearchStudent = $("#btnSearchStudent");
    const tblSearchStudent = $("#tblSearchStudent");
    const bookingStudentField = BookingClothesModal.find("#booking_StudentId");
    /** @@type {BookingCatalogItem[]} */
    let selectedItems = [];
    /** @@type {(BookingLine|null)[]} */
    let bookingRows = [];
    let bookingBrowseRow = null;
    const defaultBookingRowCount = 4;
    const bookingItemRequests = new Map();
    /** @@type {{bookingDetailId: number, clothId: number|null, qty: number|null, price: number|null}[]} */
    let originalBookingItems = [];
    /** @@type {BookingRecord|null} */
    let editingBooking = null;
    let editingBookingSupportsItemSave = false;
    let bookingSaveInProgress = false;
    let bookingSaveReady = false;
    let bookingDetailRequest = null;
    let bookingExchangeRateRequest = null;
    let bookingInlineStudent = null;
    const bookingLookupPageSize = 20;
    const bookingDateRange = $("#bookingDateRange");
    const fromDate = $("#fromDate");
    const toDate = $("#toDate");
    const bookingDateInputs = fromDate.add(toDate);
    const bookingDateFilterError = $("#bookingDateFilterError");
    const bookingDateFilterModal = $("#BookingDateFilterModal");
    const bookingDateFilterSummary = $("#bookingDateFilterSummary");
    const bookingActiveDateLabel = $("#bookingActiveDateLabel");
    const bookingDatePresetLabels = {
        all: "All Dates",
        today: "Today",
        last7: "Last 7 Days",
        month: "This Month",
        custom: "Custom Range"
    };
    // Use the campus's IANA time zone.
    //noinspection SpellCheckingInspection
    const bookingCalendarDate = new Intl.DateTimeFormat("en-GB", {
        timeZone: "Asia/Phnom_Penh",
        year: "numeric",
        month: "2-digit",
        day: "2-digit"
    });
    let appliedBookingDates = { preset: "all", from: "", to: "" };
    let bookingListRequest = null;
    let bookingCountUnavailable = false;
    const bookingSearchPrompt = "Search above or filter by booking date to see bookings.";
    const bookingNoMatches = "No matching bookings. Try a different search or date range.";
    let bookingEmptyMessage = bookingSearchPrompt;

    $(document).ready(function () {
        initializeBookingSave();
        $("#frmBookingDateFilter").on("submit", applyBookingDateFilter);
        $("#btnResetBookingDates").on("click", resetBookingDateFilter);
        $("#btnClearBookingDates").on("click", function () {
            resetBookingDateFilter();
            $("#btnOpenBookingDateFilter").trigger("focus");
        });
        bookingDateFilterModal
            .on("show.bs.modal", restoreAppliedBookingDates)
            .on("shown.bs.modal", function () {
                bookingDateRange.trigger("focus");
            });
        bookingDateRange.on("change", syncBookingDateInputs);
        bookingDateInputs.on("input change", function () {
            bookingDateRange.val("custom");
            showBookingDateFilterError("");
        });
        restoreAppliedBookingDates();
        updateBookingDateFilterSummary();
        fetchBooking();
    });

    function fetchBooking() {
        if ($.fn.DataTable.isDataTable(bookingTableSelector)) {
            tblBooking.DataTable().destroy();
        }
        tblBooking.DataTable({
            processing: true,
            serverSide: true,
            paging: true,
            pageLength: 10,
            lengthChange: true,
            searching: true,
            info: true,
            stateSave: false,
            responsive: false,
            autoWidth: false,
            scrollX: false,
            scrollY: "",
            ajax: loadBookingRows,
            columns: [
                { data: "bookingId" },
                {
                    data: "bookingDate",
                    render: function (data) {
                        return `${formatDate(data)}`;
                    }
                },
                {
                    data: null,
                    /** @@param {BookingRecord} row */
                    render: function (row) {
                        const number = [row.yearNumber, row.bookingNo]
                            .filter(value => value != null && value !== "").join("-");
                        return `<span class="booking-number">${escapeBookingHtml(number || "—")}</span>`;
                    }
                },
                { data: "studentId" },
                { data: "payDollar", className: "booking-money" },
                { data: bookingKhrPaymentKey, className: "booking-money" },
                {
                    data: null,
                    className: "text-center",
                    /** @@param {BookingRecord} row */
                    render: function (row) {
                        if (row.returnAlready === false)
                            return '<span class="badge badge-warning px-2 py-1"><i class="far fa-clock mr-1" aria-hidden="true"></i>Not Returned</span>';
                        return '<span class="badge badge-success px-2 py-1"><i class="fas fa-check mr-1" aria-hidden="true"></i>Returned</span>';
                    }
                },
                {
                    data: null,
                    className: "text-center",
                    /** @@param {BookingRecord} row */
                    render: function (row) {
                        return `
                            <button type="button"
                                    class="btn btn-warning btn-sm btnEditBooking"
                                    aria-haspopup="dialog"
                                    aria-controls="BookingClothesModal"
                                    data-id="${escapeBookingHtml(row.bookingId)}">
                                <i class="fas fa-pen mr-1" aria-hidden="true"></i>Edit
                            </button>
                        `;
                    }
                }
            ],
            language: {
                processing: "Loading...",
                searchPlaceholder: "Search bookings",
                info: "Showing _START_ to _END_ of _TOTAL_ entries",
                infoEmpty: "Showing 0 to 0 of _MAX_ entries",
                infoFiltered: "",
                thousands: ",",
                emptyTable: bookingSearchPrompt,
                zeroRecords: bookingNoMatches
            },
            infoCallback: function (_settings, _start, _end, _max, _total, text) {
                return bookingCountUnavailable ? "Total entries unavailable" : text;
            },
            initComplete: function () {
                const table = $(this.api().table().node());
                if (!table.parent().hasClass("booking-table-scroll")) {
                    table.wrap('<div class="booking-table-scroll" role="region" aria-label="Booking Clothes table" tabindex="0"></div>');
                }
                if (typeof MyApp !== "undefined" &&
                    typeof MyApp.utils?.dataTableDebounceSearch === "function") {
                    MyApp.utils.dataTableDebounceSearch(bookingTableSelector, 500);
                }
            },
            drawCallback: function () {
                const api = this.api();
                const page = api.page.info();
                const hasResults = page.recordsDisplay > 0;

                $(api.table().container())
                    .toggleClass("booking-has-results", hasResults)
                    .toggleClass("booking-has-pages", hasResults && page.pages > 1);

                if (!hasResults) {
                    $(api.table().body()).find("td.dataTables_empty, td.dt-empty").text(bookingEmptyMessage);
                }
            }
        });
    }

    function loadBookingRows(request, complete) {
        if (bookingListRequest) {
            const previousRequest = bookingListRequest;
            bookingListRequest = null;
            previousRequest.abort();
        }

        const search = String(request.search?.value ?? "").trim();
        const { from, to } = appliedBookingDates;
        const summaryOnly = !search && !from && !to;
        const emptyResponse = { draw: request.draw, recordsTotal: 0, recordsFiltered: 0, data: [] };
        bookingEmptyMessage = summaryOnly ? bookingSearchPrompt : bookingNoMatches;

        const pending = $.ajax({
            url: "/booking-clothes/get-booking-clothes",
            type: "POST",
            dataType: "json",
            data: {
                ...request,
                // Read the total from the existing endpoint without displaying its row.
                ...(summaryOnly ? { start: 0, length: 1 } : {}),
                search: { ...request.search, value: search },
                fromDate: from,
                toDate: to
            }
        });
        bookingListRequest = pending;

        function showLoadError(reason, message) {
            if (bookingListRequest !== pending) return;

            bookingCountUnavailable = true;
            if (!summaryOnly) {
                bookingEmptyMessage = "Unable to load bookings. Try searching again.";
            }
            console.error("Cannot load bookings:", reason);
            complete(emptyResponse);
            if (!summaryOnly && typeof ShowToastError === "function") {
                ShowToastError(message || "Cannot load bookings.");
            }
        }

        return pending.done(/** @@param {BookingGridResponse|null} response */ function (response) {
            if (bookingListRequest !== pending) return;

            const recordsTotal = Number(response?.recordsTotal ?? NaN);
            const recordsFiltered = Number(response?.recordsFiltered ?? NaN);
            const rows = response?.data ?? (recordsFiltered === 0 ? [] : null);
            if (!Number.isSafeInteger(recordsTotal) || recordsTotal < 0 ||
                (!summaryOnly && (!Array.isArray(rows) ||
                    !Number.isSafeInteger(recordsFiltered) || recordsFiltered < 0))) {
                showLoadError("Unexpected list response.");
                return;
            }

            bookingCountUnavailable = false;
            complete(summaryOnly
                ? { ...emptyResponse, recordsTotal }
                : { draw: request.draw, recordsTotal, recordsFiltered, data: rows });
        }).fail(/** @@param {BookingAjaxError} xhr */ function (xhr, status) {
            if (status !== "abort") {
                const error = xhr.responseJSON;
                showLoadError(xhr.status || status, error?.status?.message || error?.message);
            }
        }).always(function () {
            if (bookingListRequest === pending) {
                bookingListRequest = null;
            }
        });
    }

    function getBookingPresetDates(preset, now = new Date()) {
        if (!["today", "last7", "month"].includes(preset)) {
            return { preset: "all", from: "", to: "" };
        }

        // Use the campus calendar day, even when the browser is in another timezone.
        const parts = Object.fromEntries(
            bookingCalendarDate.formatToParts(now).map(part => [part.type, part.value])
        );
        const year = Number(parts.year);
        const month = Number(parts.month) - 1;
        const day = Number(parts.day);
        const isoDay = timestamp => new Date(timestamp).toISOString().slice(0, 10);
        const startDay = preset === "month" ? 1 : day - (preset === "last7" ? 6 : 0);

        return {
            preset,
            from: isoDay(Date.UTC(year, month, startDay)),
            to: isoDay(preset === "month" ? Date.UTC(year, month + 1, 0) : Date.UTC(year, month, day))
        };
    }

