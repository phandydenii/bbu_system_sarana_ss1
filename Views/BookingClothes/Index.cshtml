    //---------------------------------------------------- Event Trigger ----------------------------------------------------

    // ---------------------------------------------------- Booking Item Section ----------------------------------------------------
    function loadBookingExchangeRate() {
        if (bookingExchangeRateRequest) return;

        bookingExchangeRateRequest = $.ajax({
            url: "/exchange-rates/get-exchange-rates",
            method: "POST",
            dataType: "json",
            data: { isAll: true },
            timeout: 20000
        });
        bookingExchangeRateRequest.done(function (response) {
            if (String(response?.status?.code) !== "200" || !response.data) return;

            const rateIn = bookingNumber(String(response.data.rateIn ?? "").replace(/,/g, ""));
            const rateOut = bookingNumber(String(response.data.rateOut ?? "").replace(/,/g, ""));
            if (rateIn > 0) BookingClothesModal.find("#txtRateIn").text(rateIn);
            if (rateOut <= 0) return;

            BookingClothesModal.find("#txtRateOut").text(rateOut);
            tblBookingDetail.find("tbody tr").each(function () {
                const item = bookingRows[Number(this.dataset.bookingRowIndex)];
                if (item) updateBookingRowAmounts(this, item);
            });
            calculateGrandTotal();
        }).always(function () {
            bookingExchangeRateRequest = null;
        });
    }

    function getExchangeRate() {
        const rate = Number(BookingClothesModal.find("#txtRateOut").text().replace(/,/g, "").trim());
        return Number.isFinite(rate) && rate > 0 ? rate : 4100;
    }

    function bookingNumber(value) {
        const number = Number(value);
        return Number.isFinite(number) ? number : 0;
    }

    function fitsBookingDetailNumber(value) {
        return Number.isFinite(value) && Number(value.toFixed(3)) === value;
    }

    function readBookingDetailNumber(input) {
        const value = String($(input).val() ?? "").trim();
        return value === "" ? NaN : Number(value);
    }

    function escapeBookingHtml(value) {
        return String(value ?? "").replace(/[&<>"']/g, character => ({
            "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
        })[character]);
    }

    function bookingClothKey(value) {
        const id = Number(value);
        return Number.isSafeInteger(id) && id > 0 ? String(id) : "";
    }

    /** @@returns {BookingLine[]} */
    function getBookingItems() {
        return bookingRows.filter(item => item !== null);
    }

    function selectedBookingClothIds() {
        return new Set(getBookingItems().map(item => bookingClothKey(item.clothId)).filter(Boolean));
    }

    function bookingLineValue(item) {
        if (!item) return "";
        return bookingClothKey(item.clothId) || "legacy";
    }

    /** @@param {number} index @@param {BookingCatalogItem} item */
    function setBookingRowItem(index, item) {
        const clothId = bookingClothKey(item.id);
        if (!clothId || selectedBookingClothIds().has(clothId)) return false;

        const previous = bookingRows[index];
        // A change of catalog item replaces the old detail through the existing save action.
        bookingRows[index] = {
            bookingDetailId: 0,
            bookingId: 0,
            clothId,
            itemName: item.name || item.nameKhmer || item.namekhmer || "",
            nameKhmer: item.name ? (item.nameKhmer || item.namekhmer || "") : "",
            qty: previous?.qty > 0 ? previous.qty : 1,
            price: bookingNumber(item.price)
        };
        return true;
    }

    function initializeBookingItemPicker(row, item) {
        const picker = row.find(".booking-item-select");
        const browse = row.find(".booking-item-browse");
        if (item) {
            const names = bookingProductNames(item.itemName, item.nameKhmer, "Item " + (item.clothId ?? ""));
            const label = [names.primary, names.secondary].filter(Boolean).join(" · ");
            picker.append(new Option(label, bookingLineValue(item), true, true));
            browse.text(label);
        }
        if (!$.fn.select2) return;

        try {
            picker.removeClass("d-none").select2({
                width: "100%",
                dropdownParent: BookingClothesModal,
                placeholder: "Search clothing items",
                minimumResultsForSearch: 0,
                templateResult: renderBookingItemOption,
                language: { noResults: () => "No available clothing items found." },
                ajax: bookingLookupAjax({
                    url: "/booking-clothes/get-items",
                    columns: ["id", "name", "nameKhmer", "price", null],
                    idFor: record => bookingClothKey(record?.id),
                    labelFor: bookingItemLabel,
                    browseButton: browse,
                    excludedIds: selectedBookingClothIds,
                    picker: picker[0]
                })
            });
            browse.addClass("d-none");
        } catch (error) {
            picker.addClass("d-none");
            console.warn("Clothing item dropdown unavailable.", error);
        }
    }

    function closeBookingItemLookups() {
        if (!$.fn.select2) return;
        tblBookingDetail.find(".booking-item-select.select2-hidden-accessible").select2("close");
        const requests = Array.from(bookingItemRequests.values());
        bookingItemRequests.clear();
        requests.forEach(request => request.abort());
    }

    function destroyBookingItemPickers(container) {
        container.find(".booking-item-select.select2-hidden-accessible").each(function () {
            const request = bookingItemRequests.get(this);
            bookingItemRequests.delete(this);
            $(this).select2("close").select2("destroy");
            request?.abort();
        });
    }

    function renderBookingItems() {
        const tbody = tblBookingDetail.find("tbody");
        destroyBookingItemPickers(tbody);
        tbody.empty();
        bookingRows.forEach((_item, index) => renderBookingItemRow(index));
        calculateGrandTotal();
    }

    function renderBookingItemRow(index, target) {
        const item = bookingRows[index];
        const quantity = Number.isFinite(item?.qty) ? item.qty : (item ? "" : 0);
        let price = item ? "" : 0;
        if (Number.isFinite(item?.price)) {
            price = item.price.toFixed(Number(item.price.toFixed(2)) === item.price ? 2 : 3);
        }
        const priceKhr = (bookingNumber(item?.price) * getExchangeRate()).toFixed(0);
        const locked = item ? "" : "readonly";
        const usdUnit = item ? "$" : "—";
        const khrUnit = item ? "៛" : "—";
        const row = target ? $(target) : $("<tr>").appendTo(tblBookingDetail.find("tbody"));

        destroyBookingItemPickers(row);
        row.attr("data-booking-row-index", index).html(`
                <td hidden>${escapeBookingHtml(item?.bookingDetailId ?? 0)}</td>
                <td hidden>${escapeBookingHtml(item?.bookingId ?? 0)}</td>
                <td hidden>${escapeBookingHtml(item?.clothId ?? "")}</td>
                <td class="text-center booking-row-number">${index + 1}</td>
                <td class="booking-item-name">
                    <select class="form-control form-control-sm booking-item-select d-none"
                            aria-label="Clothing item for row ${index + 1}">
                        <option value=""></option>
                    </select>
                    <button type="button" class="btn btn-outline-secondary btn-sm booking-item-browse"
                            aria-controls="ItemModal" aria-haspopup="dialog">
                        Search clothing items
                    </button>
                </td>
                <td>
                    <input type="number" class="form-control form-control-sm text-right item-qty"
                           aria-label="Quantity"
                           min="0.001"
                           step="0.001"
                           value="${quantity}" ${locked}>
                </td>
                <td>
                    <div class="input-group input-group-sm booking-item-amount">
                        <input type="number" class="form-control text-right item-price-usd"
                               aria-label="Unit price in USD" min="0" step="0.001" value="${price}" ${locked}>
                        <div class="input-group-append">
                            <span class="input-group-text" aria-hidden="true">${usdUnit}</span>
                        </div>
                    </div>
                </td>
                <td>
                    <div class="input-group input-group-sm booking-item-amount">
                        <input type="number" class="form-control text-right item-price-khr"
                               aria-label="Unit price in KHR (converted from USD)" value="${priceKhr}" readonly>
                        <div class="input-group-append">
                            <span class="input-group-text" aria-hidden="true">${khrUnit}</span>
                        </div>
                    </div>
                </td>
                <td>
                    <div class="input-group input-group-sm booking-item-amount">
                        <input type="number" class="form-control text-right item-discount"
                               aria-label="Per-item discount is not stored"
                               title="The booking detail table has no per-item discount column."
                               value="0"
                               readonly>
                        <div class="input-group-append">
                            <span class="input-group-text" aria-hidden="true">%</span>
                        </div>
                    </div>
                </td>
                <td>
                    <div class="input-group input-group-sm booking-item-amount">
                        <output class="form-control text-right font-weight-bold line-total-usd"
                                aria-label="Line total in USD">${formatUsd(item ? calculateLineUsd(item) : 0)}</output>
                        <div class="input-group-append">
                            <span class="input-group-text" aria-hidden="true">$</span>
                        </div>
                    </div>
                </td>
                <td>
                    <div class="input-group input-group-sm booking-item-amount">
                        <output class="form-control text-right font-weight-bold line-total-khr"
                                aria-label="Line total in KHR">${formatKhr(item ? calculateLineKhr(item) : 0)}</output>
                        <div class="input-group-append">
                            <span class="input-group-text" aria-hidden="true">៛</span>
                        </div>
                    </div>
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-outline-danger btn-sm js-remove-booking-item"
                            title="Remove row" aria-label="Remove row ${index + 1}">
                        <i class="fas fa-times" aria-hidden="true"></i>
                    </button>
                </td>
        `);
        initializeBookingItemPicker(row, item);
        return row;
    }

    tblBookingDetail.on("click", "#btnAddBookingItem", function () {
        if (bookingSaveInProgress) return;
        closeBookingItemLookups();
        const index = bookingRows.push(null) - 1;
        const row = renderBookingItemRow(index);
        row[0].scrollIntoView({ block: "nearest", inline: "nearest" });
        const picker = row.find(".booking-item-select");
        if (picker.hasClass("select2-hidden-accessible")) {
            picker.select2("open");
        } else {
            row.find(".booking-item-browse").trigger("click");
        }
    });

    tblBookingDetail.on("select2:open.bookingItems", ".booking-item-select", function () {
        const search = BookingClothesModal.find(".select2-container--open .select2-search__field").last();
        search.attr("aria-label", "Search clothing items")
            .attr("placeholder", "Search clothing items")
            .trigger("focus");
    });

    tblBookingDetail.on("select2:select.bookingItems", ".booking-item-select", function (event) {
        const row = this.closest("tr");
        const index = Number(row.dataset.bookingRowIndex);
        const item = (/** @@type {{params?: {data?: {record?: BookingCatalogItem}}}} */ (event))
            .params?.data?.record;
        $(this).val(bookingLineValue(bookingRows[index])).trigger("change.select2");
        if (!item || bookingSaveInProgress) return;

        // Let Select2 finish the selection before replacing its row controls.
        window.setTimeout(() => {
            if (!this.isConnected || bookingSaveInProgress || !BookingClothesModal.hasClass("show")) return;
            if (!setBookingRowItem(index, item)) {
                ShowToastInfo("This item is already in the booking. Change the quantity in its row.");
                return;
            }
            renderBookingItemRow(index, row).find(".item-qty").trigger("focus");
            calculateGrandTotal();
        }, 0);
    });

    // CALCULATE USD
    /** @@param {BookingLine} item */
    function calculateLineUsd(item) {
        return bookingNumber(item.qty) * bookingNumber(item.price);
    }

    // CALCULATE KHR
    /** @@param {BookingLine} item */
    function calculateLineKhr(item) {
        return calculateLineUsd(item) * getExchangeRate();
    }

    // CHANGE QTY
    tblBookingDetail.on("input", ".item-qty", function () {
        const row = this.closest("tr");
        const item = bookingRows[Number(row.dataset.bookingRowIndex)];
        if (!item || bookingSaveInProgress) return;
        item.qty = readBookingDetailNumber(this);
        updateBookingRowAmounts(row, item);
        calculateGrandTotal();
    });

    // CHANGE USD PRICE
    tblBookingDetail.on("input", ".item-price-usd", function () {
        const row = this.closest("tr");
        const item = bookingRows[Number(row.dataset.bookingRowIndex)];
        if (!item || bookingSaveInProgress) return;
        item.price = readBookingDetailNumber(this);
        updateBookingRowAmounts(row, item);
        calculateGrandTotal();
    });

    function updateBookingRowAmounts(row, item) {
        const itemRow = $(row);
        itemRow.find(".item-price-khr").val((bookingNumber(item.price) * getExchangeRate()).toFixed(0));
        itemRow.find(".line-total-usd").text(formatUsd(calculateLineUsd(item)));
        itemRow.find(".line-total-khr").text(formatKhr(calculateLineKhr(item)));
    }

    function hasBookingItemChanges(bookingItems) {
        if (bookingItems.length !== originalBookingItems.length) return true;
        const originalById = new Map(originalBookingItems.map(item => [item.bookingDetailId, item]));
        return bookingItems.some(item => {
            const original = originalById.get(Number(item.bookingDetailId));
            return !original || original.clothId !== Number(item.clothId) ||
                original.qty !== item.qty || bookingNumber(original.price) !== item.price;
        });
    }

    // CALCULATE TOTAL
    function calculateGrandTotal() {
        const bookingItems = getBookingItems();
        let grandUsd = 0;
        let grandKhr = 0;
        bookingItems.forEach(function (item) {
            grandUsd += calculateLineUsd(item);
            grandKhr += calculateLineKhr(item);
        });
        $('#lblGrandTotalUsd').text(formatUsd(grandUsd));
        $('#lblGrandTotalKhr').text(formatKhr(grandKhr));
        $('#invoice_GrandTotalUsd').val(grandUsd.toFixed(2));
        $('#invoice_GrandTotalKhr').val(grandKhr.toFixed(0));
        const preserveSavedTotal = editingBooking && (!hasBookingItemChanges(bookingItems) ||
            bookingNumber(editingBooking.vat) !== 0 || bookingNumber(editingBooking.discount) !== 0);
        getBookingEditorFields().total.val(preserveSavedTotal ? (editingBooking.total ?? 0) : grandUsd.toFixed(2));
    }

    // REMOVE
    tblBookingDetail.on("click", ".js-remove-booking-item", function () {
        if (bookingSaveInProgress) return;
        const index = Number(this.closest("tr").dataset.bookingRowIndex);
        bookingRows.splice(index, 1);
        if (!bookingRows.length) bookingRows.push(null);
        renderBookingItems();
        tblBookingDetail.find("tbody tr").eq(Math.min(index, bookingRows.length - 1))
            .find(".js-remove-booking-item").trigger("focus");
    });
    // ---------------------------------------------------- Booking Item Section ----------------------------------------------------


    // toggle modal fullscreen or minimize screen
    const bookingFullscreenToggle = $("#btnTogglePaymentFullscreen");
    bookingFullscreenToggle.on("click", function () {
        setPaymentFullscreen(!BookingClothesModal.hasClass("fullscreen-modal"));
    });
    function setPaymentFullscreen(isFullscreen) {
        const icon = $("#paymentFullscreenIcon");
        if (isFullscreen) {
            BookingClothesModal.addClass("fullscreen-modal");
            icon.removeClass("fa-expand").addClass("fa-compress");
        } else {
            BookingClothesModal.removeClass("fullscreen-modal");
            icon.removeClass("fa-compress").addClass("fa-expand");
        }
        bookingFullscreenToggle.attr("title", isFullscreen ? "Restore" : "Fullscreen");
        setTimeout(function () {
            const DataTable = $.fn.dataTable;
            if (DataTable?.isDataTable(bookingDetailTableSelector)) {
                new DataTable.Api(bookingDetailTableSelector).columns.adjust();
            }
        }, 200);
    }
</script>
}
