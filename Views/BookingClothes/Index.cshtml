@{
    ViewData["OpenMenu"] = "Administration";
    ViewData["Action"] = "BookingClothes";
    ViewData["HideHeader"] = true;
}

<div class="container-fluid px-0 pt-3">
    <!-- Top Action Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="m-0 font-weight-bold text-dark">Booking Clothes</h3>
            <small class="text-muted">Manage student clothing bookings and returns</small>
        </div>
        <button id="btnNewBooking" class="btn btn-primary shadow-sm">
            <i class="fas fa-plus-circle mr-1"></i> New Booking
        </button>
    </div>

    <!-- Filter Card Bar -->
    <div class="card card-outline card-primary shadow-sm mb-4">
        <div class="card-header bg-white py-2">
            <h3 class="card-title font-weight-bold text-secondary" style="font-size: 0.95rem;">
                <i class="fas fa-filter text-primary mr-1"></i> Filter Bookings
            </h3>
            <div class="card-tools">
                <button type="button" class="btn btn-tool" data-card-widget="collapse">
                    <i class="fas fa-minus"></i>
                </button>
            </div>
        </div>
        <div class="card-body bg-light py-3">
            <div class="row align-items-end">
                <div class="col-md-4 col-sm-6 mb-2 mb-md-0">
                    <label for="dtpFrom" class="form-label text-secondary small font-weight-bold">From Date</label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-white border-right-0"><i class="far fa-calendar-alt text-muted"></i></span>
                        </div>
                        <input type="date" id="dtpFrom" class="form-control border-left-0">
                    </div>
                </div>
                
                <div class="col-md-4 col-sm-6 mb-2 mb-md-0">
                    <label for="dtpTo" class="form-label text-secondary small font-weight-bold">To Date</label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-white border-right-0"><i class="far fa-calendar-alt text-muted"></i></span>
                        </div>
                        <input type="date" id="dtpTo" class="form-control border-left-0">
                    </div>
                </div>
                
                <div class="col-md-4 col-sm-12 d-flex">
                    <button onclick="OnSearch()" class="btn btn-success mr-2 flex-fill shadow-sm">
                        <i class="fas fa-search mr-1"></i> Filter
                    </button>
                    <button onclick="OnResetFilter()" class="btn btn-outline-secondary shadow-sm" title="Reset Filters">
                        <i class="fas fa-redo-alt"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <table id="tblBooking" class="table table-hover table-striped w-100">
                <thead class="thead-light">
                    <tr>
                        <th>ID</th>
                        <th>Date</th>
                        <th>Booking No.</th>
                        <th>Student ID</th>
                        <th>Pay (USD)</th>
                        <th>Pay (KHR)</th>
                        <th>Status</th>
                        <th class="text-center" style="width: 100px;">Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_BookingClothesModal"/>
<partial name="_ItemModal"/>

@section scripts{
    <script>
        const tblBooking = $("#tblBooking");
        const tblBookingDetail = $("#tblBookingDetail");
        const btnNewBooking = $("#btnNewBooking");
        const BookingClothesModal = $("#BookingClothesModal");
        const tblItem = $("#tblItem");
        const selectItem = $("#btnSelectItem");
        const ItemModal = $("#ItemModal");
        const btnChooseItem = $("#btnChooseItem");
        const btnCloseBooking = $("#btnCloseBooking");
        const btnCloseItem = $("#btnCloseItem");
        const stateSelect = $("#stateSelect");
        const btnAssignItem = $("#btnAssignItem");

        $(document).ready(function () {
            fetchBooking();
        });

        btnNewBooking.on("click", function () {
            BookingClothesModal.modal("show");
            tblItem.DataTable();
            $("#BookingClothesModal .modal-title").text("New Booking");
            $("#BookingClothesModal").attr("action", "/BookingClothes/PostBookingClothes");
        });

        function fetchBooking() {
            if ($.fn.DataTable.isDataTable('#tblBooking')) {
                tblBooking.DataTable().destroy();
            }
            tblBooking.DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                ajax: {
                    url: "/booking-clothes/get-booking-clothes",
                    type: "POST",
                    data: function (d) {
                        d.fromDate = $("#dtpFrom").val();
                        d.toDate = $("#dtpTo").val();
                    }
                },
                columns: [
                    { data: "bookingId" },
                    {
                        data: "bookingDate",
                        render: function (data) {
                            return `${formatDate(data)}`;
                        }
                    },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `<span class="font-weight-bold text-dark">${row.yearNumber}-${row.bookingNo}</span>`;
                        }
                    },
                    { data: "studentId" },
                    { data: "payDollar" },
                    { data: "payRieal" },
                    {
                        data: null,
                        render: function (data, type, row) {
                            if (row.returnAlready === false) 
                                return `<span class="badge badge-danger px-2 py-1"><i class="fas fa-unlock mr-1"></i> Not Returned</span>`; 
                            return `<span class="badge badge-success px-2 py-1"><i class="fas fa-check mr-1"></i> Returned</span>`;
                        }
                    },
                    {
                        data: null,
                        className: "text-center",
                        render: function () {
                            return `<a class="btn btn-outline-primary btn-xs font-weight-bold btn-block">Manage</a>`;
                        }
                    }
                ]
            });
        }

        function OnSearch() {
            tblBooking.DataTable().ajax.reload();
        }

        function OnResetFilter() {
            $("#dtpFrom").val("");
            $("#dtpTo").val("");
            tblBooking.DataTable().ajax.reload();
        }

        selectItem.on("click", function () {
            tblItem.DataTable().clear().destroy();
            tblItem.DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                ajax: {
                    url: "/BookingClothes/get-items",
                    type: "POST"
                },
                columns: [
                    { data: "bookingItemId" },
                    { data: "itemName" },
                    { data: "price" },
                    {
                        data: null,
                        render: function () {
                            return `<a id="btnChooseItem" class="btn btn-default btn-xs btn-block">Select</a>`;
                        }
                    },
                ]
            });
            ItemModal.modal("show");
        });

        tblItem.on("click", "#btnChooseItem", function () {
            const $row = $(this).closest('tr');
            const selectedRow = tblItem.DataTable().row($row).data();
            if (selectedRow) {
                const json = selectedRow;
                const value = json.bookingItemId;
                const text = `${value}-${json.itemName} (${json.price} $)`;

                if ($('#stateSelect option[value="' + value + '"]').length === 0) {
                    const newOption = new Option(text, value, true, true);
                    $('#stateSelect').append(newOption).trigger('change');
                }
            }
        });

        btnCloseBooking.on("click", function () {
            BookingClothesModal.modal("hide");
        });

        btnCloseItem.on("click", function () {
            ItemModal.modal("hide");
        });

        btnAssignItem.on("click", function () {
            const ids = $('#stateSelect').val();
        });
    </script>
}