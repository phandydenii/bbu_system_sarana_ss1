
@{
    ViewData["OpenMenu"] = "Administration";
    ViewData["Action"] = "BookingClothes";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Booking Clothes</h3>
                <a id="btnNewBooking" class="btn btn-primary float-right"><i class="fas fa-add"></i> New Booking</a>
                <div class="row">
                    <div class="form-group">
                        <label>From Date:</label>
                        <input type="date" id="dtpFrom" class="form-control">
                    </div>
                    <div class="form-group">
                        <label>To Date:</label>
                        <input type="date" id="dtpTo" class="form-control">
                    </div>
                    <div class="form-group">
                        <label>#</label>
                        <button onclick="OnSearch()" class="btn form-control btn-success">Search</button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <table id="tblBooking" class="table table-bordered table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>id</th>
                        <th>date</th>
                        <th>no</th>
                        <th>student</th>
                        <th>pay_khr</th>
                        <th>pay_usd</th>
                        <th>return</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_BookingClothesModal"/>
<partial name="_ItemModal"/>

@section scripts{
    <script>
        const tblBooking = $("#tblBooking");
        const tblBookingDetail = $("#tblBookingDetail");
        const btnNewBooking = $("#btnNewBooking");
        const BookingClothesModal = $("#BookingClothesModal");
        const tblItem = $("#tblItem");
        const selectItem = $("#btnSelectItem");
        const ItemModal = $("#ItemModal");
        const btnChooseItem = $("#btnChooseItem");
        const btnCloseBooking = $("#btnCloseBooking");
        const btnCloseItem = $("#btnCloseItem");
        const stateSelect = $("#stateSelect");
        const btnAssignItem = $("#btnAssignItem");

        $(document).ready(function () {
            fetchStudent();
        });

        btnNewBooking.on("click", function () {
            BookingClothesModal.modal("show");
            tblItem.DataTable();
            $("#BookingClothesModal .modal-title").text("New Booking");
            $("#BookingClothesModal").attr("action", "/BookingClothes/PostBookingClothes");
        });

        function fetchStudent() {
            tblBookingDetail.DataTable().clear().destroy();
            tblBooking.DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                ajax: {
                    url: "/booking-clothes/get-clothes",
                    type: "POST"
                },
                columns: [
                    {data: "bookingId"},
                    {
                        data: "bookingDate",
                        render: function (data, type, row) {
                            return `${formatDate(data)}`;
                        }
                    },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `${row.yearNumber}-${row.bookingNo}`;
                        }
                    },
                    {data: "studentId"},
                    {data: "payDollar"},
                    {data: "payRieal"},
                    {
                        data: null,
                        render: function (data, type, row) {
                            if (row.returnAlready === "0") {
                                return `<span class="badge bg-danger"><i class="fas fa-unlock"></i> Not Return</span>`;
                            } else {
                                return `<span class="badge bg-primary"><i class="fas fa-check"></i> Return</span>`;
                            }
                        }
                    },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `<a class="btn btn-success btn-sm" style="display: block;margin:.2rem 0">Manage</a>`;
                        }
                    }
                ]
            })
        }

        selectItem.on("click", function () {
            tblItem.DataTable().clear().destroy();
            tblItem.DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                ajax: {
                    url: "/BookingClothes/get-items",
                    type: "POST"
                },
                columns: [
                    {data: "bookingItemId"},
                    {data: "itemName"},
                    {data: "price"},
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `<a id="btnChooseItem" class="btn btn-default btn-xs" style="display: block;margin:.2rem 0">Select</a>`;
                        }
                    },
                ]
            })
            ItemModal.modal("show");
        })

        tblItem.on("click", "#btnChooseItem", function () {
            const $row = $(this).closest('tr');
            const selectedRow = tblItem.DataTable().row($row).data();
            console.log(selectedRow);
            if (selectedRow) {
                const json = selectedRow;
                const value = json.bookingItemId;
                const text = value + "-" + json.itemName + "(" + json.price + " $)";

                if ($('#stateSelect option[value="' + value + '"]').length === 0) {
                    const newOption = new Option(text, value, true, true);
                    $('#stateSelect').append(newOption).trigger('change');
                }
            }
        })

        btnCloseBooking.on("click", function () {
            BookingClothesModal.modal("hide");
        })

        btnCloseItem.on("click", function () {
            ItemModal.modal("hide");
        })

        btnassignItem.on("click", function () {
            const ids = $('#stateSelect').val();
        })
    </script>
}
