    function fetchBookingDetail(bookingId, button) {
        if (bookingSaveInProgress) return;
        cancelBookingDetailRequest();
        button.prop("disabled", true).attr("aria-busy", "true");

        const pending = $.ajax({
            url: "/booking-clothes/details-booking-clothes/" + encodeURIComponent(bookingId),
            type: "GET",
            dataType: "json",
            timeout: 20000
        });
        bookingDetailRequest = pending;

        return pending.done(/** @@param {BookingDetailResponse|null} response */ function (response) {
            if (bookingDetailRequest !== pending) return;

            const data = response?.data;
            const booking = data?.booking;
            const items = data?.item ?? [];
            if (!booking || String(booking.bookingId) !== String(bookingId) || !Array.isArray(items)) {
                ShowToastInfo("Unable to load the selected booking.");
                return;
            }

            editingBooking = booking;
            editingBookingSupportsItemSave = data?.editorItemSaveSupported === true;
            const fields = getBookingEditorFields();
            fields.id.val(booking.bookingId);
            bookingStudentField.val(booking.studentId ?? "");
            fields.number.val(booking.bookingNo ?? "");
            fields.date.val(formatDateForInput(booking.bookingDate));
            fields.note.val(booking.note || "");
            fields.paidUsd.val(booking.payDollar ?? 0);
            fields.paidKhr.val(booking[bookingKhrPaymentKey] ?? 0);
            fields.vat.val(booking.vat ?? 0);
            fields.discount.val(booking.discount ?? 0);
            fields.total.val(booking.total ?? 0);
            fields.active.prop("checked", booking.active === true);
            fields.schoolId.val(booking.schoolId ?? "");
            fields.fieldId.val(booking.fieldId ?? "");
            fields.termNo.val(booking.termNo ?? "");
            fields.groupId.val(booking.groupId ?? "");

            // Keep raw saved values for the controller's stale-edit check.
            originalBookingItems = items.map(x => ({
                bookingDetailId: Number(x.bookingDetailId),
                clothId: x.clothId == null ? null : Number(x.clothId),
                qty: x.qty == null ? null : Number(x.qty),
                price: x.price == null ? null : Number(x.price)
            }));
            bookingRows = items.map(x => ({
                bookingDetailId: x.bookingDetailId,
                bookingId: x.bookingId,
                clothId: x.clothId,
                itemName: x.itemName || "",
                nameKhmer: x.nameKhmer || x.itemNameKhmer || "",
                qty: bookingNumber(x.qty),
                price: bookingNumber(x.price)
            }));
            while (bookingRows.length < defaultBookingRowCount) bookingRows.push(null);

            resetBookingItemSelection();
            showBookingEditor("Edit Booking", data?.student ?? booking);
        }).fail(function (_xhr, status) {
            if (bookingDetailRequest === pending && status !== "abort") {
                ShowToastInfo("Unable to load booking details. Please try again.");
            }
        }).always(function () {
            button.prop("disabled", false).removeAttr("aria-busy");
            if (bookingDetailRequest === pending) bookingDetailRequest = null;
        });
    }

    function initializeBookingSave() {
        const form = BookingClothesModal.find(bookingFormSelector);
        const saveButton = BookingClothesModal.find(bookingSaveButtonSelector);
        if (saveButton.length !== 1) {
            console.error("Booking Save: expected one #btnSaveBooking in the booking modal.");
            return;
        }

        saveButton.before(`
            <div class="booking-save-feedback" id="bookingSaveFeedback" hidden>
                <p id="bookingSaveMessage" class="alert alert-info py-2 px-3 small mb-1"
                   role="status" aria-live="polite" aria-atomic="true"></p>
            </div>
        `);
        saveButton.prop("disabled", true);

        if (form.length !== 1 || !form.is("form")) {
            showBookingSaveFeedback("Save can't find the booking form. Check that the modal contains one form with ID PaymentForm.", "danger");
            return;
        }

        // The footer button is outside the form in the existing modal partial.
        form.attr("method", "post").prop("noValidate", true);
        form.on("submit.bookingSave", function (event) {
            event.preventDefault();
            return saveBooking();
        });
        saveButton.attr("type", "submit")
            .attr("form", "PaymentForm")
            .attr("aria-describedby", "bookingSaveMessage");

        if (saveButton[0].form !== form[0]) {
            showBookingSaveFeedback("Save is not connected to the booking form. Check for duplicate PaymentForm IDs on the page.", "danger");
            return;
        }

        bookingSaveReady = true;
        saveButton.prop("disabled", false);
    }

    function showBookingSaveFeedback(message, tone = "info") {
        const feedback = BookingClothesModal.find("#bookingSaveFeedback");
        feedback.prop("hidden", !message);
        feedback.find("#bookingSaveMessage")
            .removeClass("alert-info alert-warning alert-danger")
            .addClass("alert-" + tone)
            .text(message);
    }

    function showBookingSaveError(message) {
        showBookingSaveFeedback(message, "danger");
    }

    function saveBooking() {
        if (!bookingSaveReady || bookingSaveInProgress) return;
        if (bookingDetailRequest) {
            showBookingSaveFeedback("Wait for the booking details to finish loading, then try Save again.", "warning");
            return;
        }

        const fields = getBookingEditorFields();
        const bookingId = editingBooking ? Number(editingBooking.bookingId) : 0;
        if (!Number.isSafeInteger(bookingId) || (editingBooking && bookingId <= 0)) {
            showBookingSaveError("The booking ID is missing or invalid. Reopen the booking and try again.");
            return;
        }
        if (editingBooking && !editingBookingSupportsItemSave) {
            showBookingSaveError("Update BookingClothesController.cs to the version that saves clothing items. The booking was not changed.");
            return;
        }

        const studentId = String(bookingStudentField.val() ?? "").trim();
        if (!studentId) {
            showBookingSaveError("Select a student before saving the booking.");
            return;
        }

        const bookingDate = String(fields.date.val() ?? "").trim();
        const date = new Date(bookingDate + "T00:00:00Z");
        if (!/^\d{4}-\d{2}-\d{2}$/.test(bookingDate) ||
            !Number.isFinite(date.getTime()) || date.toISOString().slice(0, 10) !== bookingDate) {
            showBookingSaveError("Enter a valid booking date in YYYY-MM-DD format.");
            fields.date.trigger("focus");
            return;
        }

        const payDollar = Number(fields.paidUsd.val() ?? 0);
        const paidKhr = Number(fields.paidKhr.val() ?? 0);
        if (!Number.isFinite(payDollar) || payDollar < 0 ||
            !Number.isFinite(paidKhr) || paidKhr < 0) {
            showBookingSaveError("Enter non-negative USD and KHR payment amounts.");
            return;
        }

        const bookingItems = getBookingItems();
        if (!bookingItems.length && (!editingBooking || originalBookingItems.length > 0)) {
            showBookingSaveError("Keep at least one clothing item on the booking before saving.");
            return;
        }

        const items = bookingItems.map(item => ({
            bookingDetailId: Number(item.bookingDetailId),
            clothId: Number(item.clothId),
            qty: item.qty,
            price: item.price
        }));
        if (items.some(item => !Number.isSafeInteger(item.bookingDetailId) || item.bookingDetailId < 0 ||
            !Number.isSafeInteger(item.clothId) || item.clothId <= 0 ||
            item.qty <= 0 || !fitsBookingDetailNumber(item.qty) ||
            item.price < 0 || !fitsBookingDetailNumber(item.price))) {
            showBookingSaveError("Each clothing item needs a positive quantity and a non-negative USD price, with at most three decimal places.");
            return;
        }

        const token = $("#bookingSaveToken").find('input[name="__RequestVerificationToken"]').val();
        if (!token) {
            showBookingSaveError("Save verification is missing. Reload the booking page before trying again.");
            return;
        }

        /** @@type {BookingRecord} */
        const booking = {
            bookingId,
            studentId,
            bookingDate,
            note: String(fields.note.val() ?? ""),
            payDollar,
            [bookingKhrPaymentKey]: paidKhr,
            active: fields.active.prop("checked") === true
        };

        if (!editingBooking) {
            const number = Number(fields.number.val());
            if (Number.isSafeInteger(number) && number > 0) booking.bookingNo = number;
            for (const key of ["schoolId", "fieldId", "termNo", "groupId"]) {
                const value = Number(fields[key].val());
                if (Number.isSafeInteger(value) && value > 0) booking[key] = value;
            }
        }

        const saveButton = BookingClothesModal.find(bookingSaveButtonSelector);
        const label = saveButton.find("span").first();
        const originalLabel = label.text();
        const itemControls = tblBookingDetail.find("button, select, input");
        bookingSaveInProgress = true;
        closeBookingItemLookups();
        itemControls.prop("disabled", true);
        saveButton.prop("disabled", true).attr("aria-busy", "true");
        btnCloseBooking.prop("disabled", true);
        label.text("Saving…");
        showBookingSaveFeedback("Saving the booking and its clothing items…");

        return $.ajax({
            url: "/booking-clothes/save-booking-with-items",
            type: "POST",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            headers: { RequestVerificationToken: token },
            data: JSON.stringify({ booking, items, originalItems: originalBookingItems }),
            timeout: 20000
        }).done(/** @@param {BookingSaveResponse|null} response */ function (response) {
            if (String(response?.status?.code) !== "200") {
                showBookingSaveError(response?.status?.message || "Unable to save the booking.");
                return;
            }

            const savedBookingId = Number(response?.data?.bookingId);
            if (!Number.isSafeInteger(savedBookingId) || savedBookingId <= 0 ||
                Number(response?.data?.itemCount) !== items.length) {
                showBookingSaveError("The server did not confirm all clothing items. Search for the booking before retrying.");
                return;
            }

            const message = response?.status?.message || "Booking and clothing items saved successfully.";
            bookingSaveInProgress = false;
            BookingClothesModal.modal("hide");
            tblBooking.DataTable().ajax.reload();
            if (typeof ShowToastSuccess === "function") {
                ShowToastSuccess(message);
            } else {
                ShowToastInfo(message);
            }
        }).fail(/** @@param {BookingAjaxError} xhr */ function (xhr, status) {
            const error = xhr.responseJSON;
            const message = error?.status?.message || error?.message || error?.title;
            if (status === "timeout" || xhr.status === 0) {
                showBookingSaveError("The save result could not be confirmed. Search for the booking before retrying.");
            } else if (xhr.status === 401 || xhr.status === 403 || status === "parsererror") {
                showBookingSaveError("The server did not return a save confirmation. Check that you are signed in.");
            } else if (xhr.status === 404 && !message) {
                showBookingSaveError("The clothing save action was not found. Install the matching BookingClothesController.cs.");
            } else if (xhr.status === 400 && !message) {
                showBookingSaveError("The server rejected the request. Reload the page to refresh Save verification, then try again.");
            } else {
                showBookingSaveError(message || "Unable to save the booking. Please try again.");
            }
        }).always(function () {
            bookingSaveInProgress = false;
            itemControls.prop("disabled", false);
            saveButton.prop("disabled", false).removeAttr("aria-busy");
            btnCloseBooking.prop("disabled", false);
            label.text(originalLabel);
        });
    }

    //---------------------------------------------------- Event Trigger ----------------------------------------------------
    btnNewBooking.on("click", function () {
        if (bookingSaveInProgress) return;
        cancelBookingDetailRequest();
        resetNewBooking();
        showBookingEditor("New Booking");
    });

    BookingClothesModal.on("hide.bs.modal.bookingInline", function (event) {
        if (bookingSaveInProgress) {
            event.preventDefault();
            return;
        }
        bookingInlineStudent?.select2("close");
        closeBookingItemLookups();
    });

    btnCloseBooking.on("click", function () {
        BookingClothesModal.modal("hide");
    });

    btnCloseItem.on("click", function () {
        ItemModal.modal("hide");
    });

    ItemModal.on("hidden.bs.modal.bookingBrowse", resetBookingItemSelection);

    btnAssignItem.on("click", function () {
        if (bookingSaveInProgress || !bookingBrowseRow?.isConnected) return;
        if (selectedItems.length === 0) {
            ShowToastInfo("Please select at least one item.");
            return;
        }
        let index = Number(bookingBrowseRow.dataset.bookingRowIndex);
        for (const item of selectedItems) {
            if (setBookingRowItem(index, item)) {
                const blankIndex = bookingRows.indexOf(null);
                index = blankIndex < 0 ? bookingRows.length : blankIndex;
            }
        }
        renderBookingItems();
        ItemModal.modal("hide");
    });

    tblBookingDetail.on("click", ".booking-item-browse", function () {
        if (bookingSaveInProgress) return;
        if (!ItemModal.length || !tblItem.length) {
            ShowToastInfo("Clothing item search is unavailable. Reload the page and try again.");
            return;
        }
        closeBookingItemLookups();
        resetBookingItemSelection();
        bookingBrowseRow = this.closest("tr");
        tblItem.DataTable().clear().destroy();
        tblItem.DataTable({
            processing: true,
            serverSide: true,
            responsive: true,
            ajax: {
                url: "/booking-clothes/get-items",
                type: "POST"
            },
            columns: [
                { data: "id" },
                { data: "name" },
                { data: "nameKhmer" },
                { data: "price" },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function (_data, _type, item) {
                        const used = selectedBookingClothIds().has(bookingClothKey(item?.id));
                        return `
                            <button type="button"
                                    class="btn ${used ? "btn-success" : "btn-default"} btn-xs btn-block btnChooseItem"
                                    ${used ? "disabled" : ""}>
                                <i class="fas fa-check mr-1"></i>
                                ${used ? "Selected" : "Select"}
                            </button>
                        `;
                    }
                }
            ]
        });
        ItemModal.modal("show");
    });

    tblItem.on("click", ".btnChooseItem", function () {
        const $button = $(this);
        const $row = $button.closest("tr");
        /** @@type {BookingCatalogItem|undefined} */
        const selectedRow = tblItem.DataTable().row($row).data();

        const id = bookingClothKey(selectedRow?.id);
        if (!id || selectedBookingClothIds().has(id)) return;

        const exists = selectedItems.some(function (x) {
            return bookingClothKey(x.id) === id;
        });
        if (exists) return;
        selectedItems.push(selectedRow);
        const text =
            `${selectedRow.name} (${formatUsd(selectedRow.price)} $)`;

        const newOption = new Option(
            text,
            id,
            true,
            true
        );

        stateSelect
            .append(newOption)
            .trigger("change");

        $button
            .removeClass("btn-default")
            .addClass("btn-success")
            .html('<i class="fas fa-check mr-1"></i> Selected')
            .prop("disabled", true);
    });

    tblBooking.on("click", ".btnEditBooking", function () {
        const button = $(this);
        const bookingId = button.data("id");
        if (!bookingId) return;

        fetchBookingDetail(bookingId, button);
    });

    btnSearchStudent.on("click", function (e) {
        e.preventDefault();
        tblSearchStudent.DataTable().clear().destroy();
        tblSearchStudent.DataTable({
            processing: true,
            serverSide: true,
            paging: true,
            lengthChange: true,
            searching: true,
            ordering: true,
            info: true,
            responsive: true,
            autoWidth: true,
            scrollCollapse: true,
            ajax: {
                url: "/student/academic/student-list/all",
                type: "POST",
                error: function (error) {
                    console.log(error.responseText);
                }
            },
            columns: [
                {data: "studentId"},
                {data: "studentName"},
                {data: "studentNameInKhmer"},
                {data: "sex"},
                {
                    data: null,
                    /** @@param {BookingStudent} row */
                    render: function (row) {
                        if (row.status === "REGISTER") {
                            return ` <span class="badge badge-warning">${row.status}</span>`;
                        } else if (row.status === "ACTIVE") {
                            return ` <span class="badge badge-primary">${row.status}</span>`;
                        } else if (row.status === "QUIT") {
                            return ` <span class="badge badge-danger">${row.status}</span>`;
                        } else {
                            return `<span class="badge badge-secondary">${row.status}</span>`;
                        }
                    },
                },
                {
                    data: null,
                    render: function () {
                        return `<a id="btnSelectStudent" class="btn btn-success btn-xs btn-block">Select</a>`;
                    },
                },
