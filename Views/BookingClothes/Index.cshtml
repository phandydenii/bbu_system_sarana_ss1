                .insertBefore(bookingStudentField);
            wrapper.append('<i class="fas fa-search booking-student-icon" aria-hidden="true"></i>');
            const picker = $('<select id="bookingInlineStudent" aria-label="Search for a student"></select>')
                .append(new Option("", ""))
                .appendTo(wrapper);

            try {
                picker.select2({
                    width: "100%",
                    dropdownParent: BookingClothesModal,
                    placeholder: "Search student ID or name",
                    minimumInputLength: 1,
                    allowClear: true,
                    ajax: bookingLookupAjax({
                        url: "/student/academic/student-list/all",
                        columns: ["studentId", "studentName", "studentNameInKhmer", "sex", null, null],
                        idFor: row => String(row?.studentId ?? "").trim(),
                        labelFor: bookingStudentLabel,
                        browseButton: btnSearchStudent
                    })
                }).on("change.bookingInline", function () {
                    bookingStudentField.val(picker.val() || "");
