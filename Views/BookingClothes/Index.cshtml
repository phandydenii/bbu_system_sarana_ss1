        const displayDate = value => value.split("-").reverse().join("/");
        const range = displayDate(from) + (from === to ? "" : " – " + displayDate(to));
        bookingActiveDateLabel.text(bookingDatePresetLabels[preset] + ": " + range);
    }

    function bookingLookupAjax({ url, columns, idFor, labelFor, browseButton, excludedIds, picker }) {
        return {
            url,
            type: "POST",
            dataType: "json",
            delay: 250,
            data: function (params) {
                const page = Number(params.page) || 1;
                // Request room for rows that the item picker will filter out.
                const length = params.bookingPageLength ?? (bookingLookupPageSize + (excludedIds?.().size ?? 0));
                params.bookingPageLength = length;
                return {
                    draw: page,
                    start: (page - 1) * length,
                    length,
                    search: { value: String(params.term || "").trim(), regex: false },
                    order: [{ column: 0, dir: "asc" }],
                    columns: columns.map(data => ({
                        data: data ?? "",
                        name: "",
                        searchable: data != null,
                        orderable: data != null,
                        search: { value: "", regex: false }
                    }))
                };
            },
            /** @@param {BookingGridResponse|null} response */
            processResults: function (response, params) {
                if (!Array.isArray(response?.data)) {
                    browseButton.removeClass("d-none");
                    return { results: [], pagination: { more: false } };
                }

                const page = Number(params.page) || 1;
                const length = params.bookingPageLength ?? bookingLookupPageSize;
                const total = Number(response.recordsFiltered ?? response.recordsTotal ?? NaN);
                const excluded = excludedIds?.();
                const results = [];
                for (const row of response.data) {
                    const id = idFor(row);
                    if (id && !excluded?.has(id)) results.push({ id, text: labelFor(row), record: row });
                }

                return {
                    results,
                    pagination: {
                        more: response.data.length > 0 &&
                            (Number.isFinite(total)
                                ? page * length < total
                                : response.data.length === length)
                    }
                };
            },
            transport: function (params, success, failure) {
                if (picker && (!picker.isConnected || bookingSaveInProgress || !BookingClothesModal.hasClass("show") ||
                    !picker.nextElementSibling?.classList.contains("select2-container--open"))) return;

                const request = $.ajax(params);
                if (picker) bookingItemRequests.set(picker, request);
                const isCurrent = () => !picker || (picker.isConnected && bookingItemRequests.get(picker) === request);
                request.done(function (response) {
                    if (isCurrent()) success(response);
                }).fail(function (xhr, status) {
                    if (status === "abort" || !isCurrent()) return;
                    browseButton.removeClass("d-none");
                    failure(xhr);
                }).always(function () {
                    if (picker && bookingItemRequests.get(picker) === request) bookingItemRequests.delete(picker);
                });
                return request;
            }
        };
    }

    /** @@param {BookingStudent} row */
    function bookingStudentLabel(row) {
        return [row.studentId, row.studentName, row.studentNameInKhmer]
            .map(value => String(value ?? "").trim())
            .filter(Boolean)
            .join(" · ");
    }

    function bookingProductNames(english, khmer, fallback) {
        const englishName = String(english ?? "").trim();
        const khmerName = String(khmer ?? "").trim();
        return {
            primary: englishName || khmerName || fallback,
            secondary: englishName && khmerName !== englishName ? khmerName : ""
        };
    }

    /** @@param {BookingCatalogItem} row */
    function bookingItemPriceLabel(row) {
        const prices = [];
        if (row.price != null) prices.push(formatUsd(bookingNumber(row.price)) + " USD");
        if (bookingNumber(row.priceKhr) > 0) prices.push(formatKhr(bookingNumber(row.priceKhr)) + " KHR");
        return prices.join(" / ");
    }

    /** @@param {BookingCatalogItem} row */
    function bookingItemLabel(row) {
        const names = bookingProductNames(row.name, row.nameKhmer || row.namekhmer, "Item " + row.id);
        return [names.primary, names.secondary].filter(Boolean).join(" · ");
    }

    /** @@param {{text?: string, record?: BookingCatalogItem}} option */
    function renderBookingItemOption(option) {
        if (!option.record) return option.text || "";

        const row = option.record;
        const names = bookingProductNames(row.name, row.nameKhmer || row.namekhmer, "Item " + row.id);
        const namesLabel = [names.primary, names.secondary].filter(Boolean).join(" · ");
        const title = $('<span class="booking-catalog-names">')
            .attr("title", namesLabel)
            .append($("<strong>").text(names.primary));
        if (names.secondary) {
            title.append($('<span class="booking-product-name-khmer" lang="km">').text(names.secondary));
        }

        const result = $('<span class="booking-catalog-option">').append(title);
        const prices = bookingItemPriceLabel(row);
        if (prices) {
            result.append($('<span class="booking-catalog-price">').text(prices));
        }
        return result;
    }

    function initializeBookingStudentPicker() {
        if (!$.fn.select2) return;

        if (!bookingInlineStudent && bookingStudentField.length) {
