@{
    var product = new Product();
}
<div class="modal fade" id="ItemModal" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Item</h4>
            </div>
            <div class="modal-body">
                <div class="select2-primary" data-select2-id="51">
                    <select id="stateSelect" class="select2 select2-hidden-accessible" multiple=""
                            data-placeholder="Select a State" data-dropdown-css-class="select2-purple"
                            style="width: 100%;" data-select2-id="15" tabindex="-1" aria-hidden="true">
                    </select>
                </div>
                <br>
                <table id="tblItem" class="table table-bordered table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>id</th>
                        <th>name</th>
                        <th>price_khr</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnAssignItem" class="btn btn-success"><i class="fas fa-check"></i> Assign
                </button>
                <button type="button" id="btnCloseItem" class="btn btn-danger float-right"><i class="fas fa-close"></i>
                    Close
                </button>
            </div>
        </div>
    </div>
</div>