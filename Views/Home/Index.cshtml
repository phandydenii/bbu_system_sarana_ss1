    // Print Chart function
    function printChart($card) {
        const canvas = $card.find(".chartCanvas")[0];
        const chartTitle = $card.find(".card-title").text();

        setTimeout(() => {
            const imgData = canvas.toDataURL();
            const win = window.open("", "_blank");
            win.document.write(`
            <html>
                <head>
                    <title>${chartTitle}</title>
                    <style>
                        body { text-align:center; font-family:Arial; }
                        h3 { margin-bottom:20px; }
                        img { max-width:100%; height:auto; }
                    </style>
                </head>
                <body>
                    <h3>${chartTitle}</h3>
                    <img src="${imgData}" />
                </body>
            </html>
        `);
            win.document.close();
            win.focus();
            win.print();
            win.close();
        }, 200);
    }


