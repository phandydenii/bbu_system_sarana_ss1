    function getRandomColor() {
        return "#" + Math.floor(Math.random() * 16777215).toString(16).padStart(6, "0");
    }

    function drawChart(canvas, query, chartType = "bar") {
        $.ajax({
            url: "/Report/RunQuery",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify({ query }),
            success: function (data) {

                const labels = data.map(x => x.faculty);

                const dataset1 = data.map(x => x.col1);
                const dataset2 = data.map(x => x.col2);
                const dataset3 = data.map(x => x.col3);

                new Chart(canvas, {
                    type: chartType,
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: "Column 1",
                                data: dataset1,
                                backgroundColor: "#007bff"
                            },
                            {
                                label: "Column 2",
                                data: dataset2,
                                backgroundColor: "#28a745"
                            },
                            {
                                label: "Column 3",
                                data: dataset3,
                                backgroundColor: "#ffc107"
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { precision: 0 }
                            }
                        },
                        plugins: {
                            legend: {
                                position: "top"
                            },
                            datalabels: {
                                anchor: 'end',
                                align: 'end',
                                font: { weight: 'bold' }
                            }
                        }
                    },
                    plugins: [ChartDataLabels]
                });
            },
            error: function (err) {
                console.error("RunQuery error:", err.responseText);
            }
        });
    }

