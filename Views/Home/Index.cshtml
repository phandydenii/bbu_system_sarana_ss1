<script>
    Chart.register(ChartDataLabels);
    $(document).ready(function () {
        showLoading()
         fetchSummaryReport();
        hideLoading(1)
     });

    async function fetchSummaryReport() {
        const localize = `@CultureInfo.CurrentCulture.Name`;
        // console.log(localize);
        try {
            const response = await fetch("/summary-report/gets?isAll=true", {
                method: "POST"
            });
            if (!response.ok) throw new Error("Request failed "+response.statusText);

            const result = await response.json();
            if (!result || !result.data) return;
            result.data.forEach(r => {
                if(r.query.trim() !== "") {
                    const title = localize.startsWith("en") ? r.title : (r.titleKm || r.title);
                    // if(localize ==="en"){
                    //     title = r.title;
                    // }else{
                    //     if(r.titleKm){
                    //         title = r.titleKm;
                    //     }else {
                    //         title = r.title;
                    //     }
                    // }
                    const html = `
                    <div class="col-md-6 mb-4">
                        <div class="card card-outline card-primary query-block" data-chart="${r.chartType || 'bar'}">
                            <div class="card-header">
                                <h3 class="card-title">${title}</h3>
                                <div class="card-tools">
                                    <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                        <i class="fas fa-minus"></i>
                                    </button>
                                    <button type="button" class="btn btn-tool btnPrint">
                                        <i class="fas fa-print"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="chart">
                                    <canvas class="chartCanvas" height="250"></canvas>
                                </div>
                                <textarea class="txtQuery d-none">${r.query}</textarea>
                            </div>
                        </div>
                    </div>`;
                    const $block = $(html);
                    $("#reportContainer").append($block);
                    runQueryAndDrawChart1($block.find(".query-block"));

                    // // Add print event
                    // $block.find(".btnPrint").click(function () {
                    //     // printChart($block);
                    //     printDiv($block)
                    // });

                    // // Draw chart after DOM appended
                    // drawChart($block.find(".chartCanvas")[0], r.query, r.chartType || 'bar');
                    //
                    // // Bind print after chart drawn
                    // $block.find(".btnPrint").click(() => printChart($block));
                }
            });
        } catch (e) {
            console.error("Fetch summary report error:", e);
        }
    }

    function runQueryAndDrawChart1($block) {
        const query = $block.find(".txtQuery").val();
        let chartType = $block.data("chart");

        const validTypes = ["bar", "line", "pie", "doughnut", "radar", "polarArea"];
        if (!validTypes.includes(chartType)) chartType = "bar";

        const canvas = $block.find(".chartCanvas")[0];
        if (!query || !canvas) return;

        const ctx = canvas.getContext("2d");

        $.ajax({
            url: "/report/run-query",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify({query}),
            success: function (data) {
                if (!data || data.length === 0) return;

                const labels = data.map(x => x.label);
                const values = data.map(x => Number(x.value));

                if ($block.data("chartInstance")) {
                    $block.data("chartInstance").destroy();
                }

                const chart = new Chart(ctx, {
                    type: chartType,
                    data: {
                        labels,
                        datasets: [
                            {
                                label: 'Result',
                                data: values,
                                backgroundColor: labels.map(() => getRandomColor()),
                                maxBarThickness: 80,
                                barPercentage: 0.8,
                                categoryPercentage: 0.6
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                max: Math.max(...values) * 1.1,
                                ticks: {precision: 0}
                            }
                        },
                        plugins: {
                            datalabels: {
                                anchor: 'end',
                                align: 'end',
                                color: '#000',
                                font: {weight: 'bold', size: 12},
                                formatter: value => value
                            }
                        }
                    },
                    plugins: [ChartDataLabels]
                });

                $block.data("chartInstance", chart);
            },
            error: function (err) {
                console.error("RunQuery error:", err.responseText);
            }
        });
    }

