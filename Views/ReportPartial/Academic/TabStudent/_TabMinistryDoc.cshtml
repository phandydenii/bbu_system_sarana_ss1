@using BBU_SYSTEM.ViewModel
@{
    var req = new QueryReportViewModel();
}
<div class="row">
    <div class="col-3">
        <label aria-required="true" class="required">Degree</label>
        <select asp-for="@req.DegreeId" class="form-control select2"></select>
    
        <label class="required">School</label>
        <select asp-for="@req.SchoolId" class="form-control select2"></select>
        
        <label>Field</label>
        <select asp-for="@req.FieldId" class="form-control select2"></select>
    
        <div class="row">
            <div class="col-4">
                <label>Promotion</label>
                <select asp-for="@req.PromotionId" class="form-control select2"></select>
            </div>
            <div class="col-4">
                <label>Stage</label>
                <select asp-for="@req.StageId" class="form-control select2"></select>
            </div>
            <div class="col-4">
                <label>Term</label>
                <select asp-for="@req.TermNo" class="form-control select2"></select>
            </div>
        </div>
        
        <label>Group</label>
        <select asp-for="@req.GroupId" class="form-control select2"></select>
        
        <label>Type</label>
        <select asp-for="@req.Filter" class="form-control select2">
            <option value="all">All</option>
            <option value="document_in">Document In</option>
            <option value="document_out">Document Out</option>
            <option value="authenticated">High School Clarification</option>
        </select>
        <label>&nbsp;</label>
        <button onclick="Print()" class="form-control btn btn-success">Filter
            <i class="fas fa-filter"></i></button>
    </div>
    <div class="col-9">
        <iframe src="" width="100%" height="800px" id="reportContainer"></iframe>
    </div>
</div>
