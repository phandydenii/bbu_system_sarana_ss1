@using BBU_SYSTEM.ViewModel.Report
@{
    var registeredStudent = new RegisteredViewModel();
}
<div class="col-12">
    <div class="row">
        <div class="col-3">
            <form id="form1"> 
                <div class="row">
                    <div class="col-4">
                        <label aria-required="true" class="required">Promotion</label>
                        <input type="text" asp-for="@registeredStudent.Receiver" class="form-control form-control-sm">
                    </div>
                    <div class="col-4">
                        <label aria-required="true" class="required">Term</label>
                        <input type="text" asp-for="@registeredStudent.Receiver" class="form-control form-control-sm">
                    </div>
                    <div class="col-4">
                        <label>&nbsp;</label>
                        <button type="submit" class="form-control btn btn-primary btn-xs">Preview</button>
                    </div>
                </div> 
            </form>
            <form id="form2">
                <div class="row">
                    <div class="col-4">
                        <label aria-required="true" class="required">Promotion</label>
                        <input type="text" asp-for="@registeredStudent.Receiver" class="form-control form-control-sm">
                    </div>
                    <div class="col-8">
                        <label>#</label>
                        <button type="submit" class="form-control btn-sm btn btn-primary">Not Yet Certificate</button>
                    </div>
                </div>
            </form>
            <form id="form3">
                <div class="row">
                    <div class="col-6">
                        <label>From Date</label>
                        <input type="date" class="form-control form-control-sm">
                    </div>
                    <div class="col-6">
                        <label>To Date</label>
                        <input type="date" class="form-control form-control-sm">
                    </div>
                </div>
                <br>
                <div class="row">
                    <div class="col-6">
                        <button type="submit" class="form-control btn-sm btn btn-primary">Already Certificate</button>
                    </div>
                </div>
            </form>
        </div>
        <div class="col-9">
            <div class="row">
                <iframe src="" width="95%" height="700px" id="printFrame"></iframe>
            </div>
        </div>
    </div>
</div>
