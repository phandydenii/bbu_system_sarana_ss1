@using BBU_SYSTEM.ViewModel.Report.Others
@{
    var graduateStudent = new GraduateStudentViewModel();
}
<div class="col-12">
    <div class="row">
        <div class="col-3">
            <form id="frmReportRegistered">
                <div class="row">
                    <div class="col-12">
                        <label aria-required="true" class="required">Degree</label>
                        <select asp-for="@graduateStudent.DegreeId" class="form-control select2"></select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <label aria-required="true" class="required">School</label>
                        <select asp-for="@graduateStudent.SchoolId" class="form-control select2"></select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <label aria-required="true" class="required">Field</label>
                        <select asp-for="@graduateStudent.FieldId" class="form-control select2"></select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <label aria-required="true" class="required">Promotion</label>
                        <select asp-for="@graduateStudent.PromotionNo" class="form-control select2"></select>
                    </div>
                </div>
                <br>
                <div class="row">
                    <div class="col-12">
                        <button type="submit" class="form-control btn btn-primary">Preview</button>
                    </div>
                </div>
            </form>
        </div>
        <div class="col-9">
            <div class="row">
                <iframe src="" width="95%" height="700px" id="printFrame"></iframe>
            </div>
        </div>
    </div>
</div>