@using BBU_SYSTEM.ViewModel.Report
@{
    var registeredProvince = new RegisteredByProvinceViewModel();
}
<div class="col-12">
    <div class="row">
        <div class="col-3">
            <form id="frmRegistredByProvince">
                <div class="row">
                    <div class="col-12">
                        <label aria-required="true" class="required">Degree</label>
                        <select asp-for="@registeredProvince.DegreeId" class="form-control select2"></select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6">
                        <label>Promotion</label>
                        <input type="number" asp-for="@registeredProvince.PromotionNo" class="form-control">
                    </div>
                    <div class="col-6">
                        <label>Sex</label>
                        <input type="number" asp-for="@registeredProvince.Sex" class="form-control">
                    </div>
                </div>
            
                <br>
                <div class="row">
                    <div class="col-12">
                        <button class="form-control btn btn-primary">Preview</button>
                    </div>
                </div>
            </form>
        </div>
        <div class="col-9">
            <div class="row">
                <iframe src="" width="95%" height="700px" id="reportContainer"></iframe>
            </div>
        </div>
    </div>
</div>