@using BBU_SYSTEM.ViewModel.Report
@{
    var registerScholarship = new ScholarshipViewModel();
}
<div class="col-12">
    <div class="row">
        <div class="col-3">
            <form id="frmScholarship">
                <div class="row">
                    <div class="col-12">
                        <label aria-required="true" class="required">Degree</label>
                        <select asp-for="@registerScholarship.DegreeId" class="form-control select2"></select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6">
                        <label>Promotion</label>
                        <input type="number" asp-for="@registerScholarship.PromotionNo" class="form-control">
                    </div>
                    <div class="col-6">
                        <label>Stage</label>
                        <input type="number" asp-for="@registerScholarship.StageNo" class="form-control">
                    </div>
                </div>
                <div class="row">
                    <div class="col-6">
                        <label>From Date</label>
                        <input type="date" asp-for="@registerScholarship.FromDate" class="form-control">
                    </div>
                    <div class="col-6">
                        <label>To Date</label>
                        <input type="date" asp-for="@registerScholarship.ToDate" class="form-control">
                    </div>
                </div>
                <div class="row">
                    <div class="col-6">
                        <label>Reporter</label>
                        <input type="text" asp-for="@registerScholarship.Reporter" class="form-control">
                    </div>
                    <div class="col-6">
                        <label>Receiver</label>
                        <input type="text" asp-for="@registerScholarship.Receiver" class="form-control">
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <label aria-required="true" class="required">status</label>
                        <select asp-for="@registerScholarship.Status" class="form-control select2"></select>
                    </div>
                </div>
                <br>
                <div class="row">
                    <div class="col-12">
                        <button class="form-control btn btn-primary">Preview</button>
                    </div>
                </div>
            </form>
        </div>
        <div class="col-9">
            <div class="row">
                <iframe src="" width="95%" height="700px" id="reportContainer"></iframe>
            </div>
        </div>
    </div>
</div>