@using BBU_SYSTEM.ViewModel
@{
    ViewData["Title"] = "Skill Student List";
    ViewData["OpenMenu"] = "Report";
    ViewData["OpenSubMenu"] = "AcademicReport";
    ViewData["Action"] = "StudentReport";

    var req = new QueryReportViewModel();
}

<style>
    .skill-report-page .card-body {
        padding: 10px;
    }

    .skill-report-page .filter-card {
        border: 1px solid #dee2e6;
        border-radius: 6px;
        background: #fff;
        padding: 10px;
    }

    .skill-report-page .form-group {
        margin-bottom: 8px;
    }

    .skill-report-page label {
        margin-bottom: 3px;
        font-size: 13px;
        font-weight: 600;
        color: #343a40;
    }

    .skill-report-page .form-control {
        min-height: 36px;
        font-size: 13px;
    }

    .skill-report-page .group-box {
        min-height: 180px;
        max-height: 260px;
        overflow-y: auto;
        border: 1px solid #ced4da;
        border-radius: 4px;
        background: #fff;
        padding: 6px;
    }

    .skill-report-page .group-item {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 5px 6px;
        margin-bottom: 3px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 13px;
    }

    .skill-report-page .group-item:hover {
        background: #f4f6f9;
    }

    .skill-report-page .group-item input {
        margin: 0;
    }

    .skill-report-page .report-actions {
        display: flex;
        gap: 6px;
        margin-top: 8px;
    }

    .skill-report-page .preview-panel {
        border: 1px solid #dee2e6;
        border-radius: 6px;
        overflow: hidden;
        background: #f8f9fa;
        min-height: 600px;
    }

    .skill-report-page .preview-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 7px 10px;
        border-bottom: 1px solid #dee2e6;
        background: #f4f6f9;
        font-size: 13px;
        font-weight: 600;
    }

    .skill-report-page .preview-empty {
        min-height: 550px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #6c757d;
        text-align: center;
        padding: 20px;
    }

    .skill-report-page .preview-empty i {
        font-size: 42px;
        margin-bottom: 10px;
        opacity: .45;
    }

    .skill-report-page #reportContainer {
        display: none;
        width: 100%;
        height: 780px;
        border: 0;
        background: #fff;
    }

    @@media (max-width: 991.98px) {
        .skill-report-page .preview-panel {
            margin-top: 10px;
            min-height: 450px;
        }

        .skill-report-page #reportContainer {
            height: 650px;
        }
    }

    @@media (max-width: 767.98px) {
        .skill-report-page .report-actions {
            flex-direction: column;
        }

        .skill-report-page .report-actions .btn {
            width: 100%;
        }
    }
</style>

<div class="card skill-report-page">
    <div class="card-header">
        <div class="margin">
            <a asp-controller="Report" asp-action="Student" class="btn btn-outline-primary btn-sm"> 
                Student List
            </a>
            <a asp-controller="Report"
               asp-action="StudentSkillList"
               class="btn btn-primary btn-sm">
                <i class="fas fa-check mr-1"></i>
                Skill Student List
            </a>
            <a asp-controller="Report"
               asp-action="StudentScoreList"
               class="btn btn-outline-primary btn-sm">
                Student Score List
            </a>
            <a asp-controller="Report"
               asp-action="StudentMinistryDoc"
               class="btn btn-outline-primary btn-sm">
                MoEYS Student
            </a>
        </div>
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-12 col-md-4 col-lg-3 mb-2 mb-md-0">
                <div class="filter-card">
                    <div class="form-group">
                        <label class="required">Degree</label>
                        <select asp-for="@req.DegreeId" id="cboDegree" class="form-control select2">
                            <option value="">Select Degree</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="required">School</label>
                        <select asp-for="@req.SchoolId" id="cboSchool" class="form-control select2">
                            <option value="">Select School</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="required">Field</label>
                        <select asp-for="@req.FieldId" id="cboField" class="form-control select2">
                            <option value="">Select Field</option>
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-6 pr-1">
                            <div class="form-group">
                                <label class="required">Promotion</label>
                                <select asp-for="@req.PromotionId" id="cboPromotion" class="form-control select2">
                                    <option value="">Select Promotion</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-6 pl-1">
                            <div class="form-group">
                                <label class="required">Stage</label>
                                <select asp-for="@req.StageId" id="cboStage" class="form-control select2">
                                    <option value="">Select Stage</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-6 pr-1">
                            <div class="form-group">
                                <label>Year</label>
                                <input type="text"
                                       id="txtYear"
                                       class="form-control"
                                       readonly
                                       placeholder="Year" />
                            </div>
                        </div>

                        <div class="col-6 pl-1">
                            <div class="form-group">
                                <label>Semester</label>
                                <input type="text"
                                       id="txtSemester"
                                       class="form-control"
                                       readonly
                                       placeholder="Semester" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="d-flex justify-content-between align-items-center">
                            <label>Groups</label>

                            <div>
                                <button type="button" id="btnSelectAllGroups" class="btn btn-link btn-sm p-0 mr-2">
                                    Select all
                                </button> 
                                <button type="button" id="btnClearGroups" class="btn btn-link btn-sm p-0 text-danger">
                                    Clear
                                </button>
                            </div>
                        </div>

                        <div id="groupList" class="group-box">
                            <div class="text-muted text-center py-4">
                                Select field and stage.
                            </div>
                        </div>
                    </div>

                    <div class="report-actions">
                        <button type="button" id="btnPreview" class="btn btn-primary flex-fill">
                            <i class="fas fa-eye mr-1"></i>
                            Preview
                        </button>  
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-8 col-lg-9">
                <div class="preview-panel">
                    <div class="preview-header">
                        <span>
                            <i class="fas fa-file-pdf mr-1"></i>
                            Skilled Student Report Preview
                        </span>

                        <button type="button" id="btnOpenNewTab" class="btn btn-outline-primary btn-sm" style="display:none;">
                            <i class="fas fa-external-link-alt mr-1"></i>
                            Open
                        </button>
                    </div>

                    <div id="previewEmpty" class="preview-empty">
                        <i class="far fa-file-pdf"></i>
                        <strong>No report generated</strong>
                        <span>Select the filters and click Preview.</span>
                    </div>

                    <iframe id="reportContainer"></iframe>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/function/Degree.js"></script>
    <script src="~/function/School.js"></script>
    <script src="~/function/Field.js"></script>
    <script src="~/function/Promotion.js"></script>
    <script src="~/function/Stage.js"></script>
    <script src="~/function/Group.js"></script>

    <script>
        const cboDegree = $("#cboDegree");
        const cboSchool = $("#cboSchool");
        const cboField = $("#cboField");
        const cboPromotion = $("#cboPromotion");
        const cboStage = $("#cboStage");
        const txtYear = $("#txtYear");
        const txtSemester = $("#txtSemester");
        const groupList = $("#groupList");
        const reportContainer = $("#reportContainer");
        const previewEmpty = $("#previewEmpty");
        const btnOpenNewTab = $("#btnOpenNewTab");

        let skillStudentPdfUrl = null;

        $(document).ready(async function () {
            $(".select2").select2({
                width: "100%",
                placeholder: "Select an option",
                allowClear: true
            });

            bindEvents();

            await getDegree();
            await getSchool();

            clearSelect(cboField, "Select Field");
            clearSelect(cboPromotion, "Select Promotion");
            clearSelect(cboStage, "Select Stage");
        });

        function bindEvents() {
            cboDegree.on("change", async function () {
                await getField();
                await getPromotion();

                clearSelect(cboStage, "Select Stage");
                clearGroups();
                clearStageInformation();
            });

            cboSchool.on("change", async function () {
                await getField();
                await getPromotion();

                clearSelect(cboStage, "Select Stage");
                clearGroups();
                clearStageInformation();
            });

            cboField.on("change", async function () {
                await getGroups();
            });

            cboPromotion.on("change", async function () {
                await getStage();
                clearGroups();
                clearStageInformation();
            });

            cboStage.on("change", async function () {
                setStageInformation();
                await getGroups();
            });

            $("#btnSelectAllGroups").on("click", function () {
                groupList.find(".group-checkbox").prop("checked", true);
            });

            $("#btnClearGroups").on("click", function () {
                groupList.find(".group-checkbox").prop("checked", false);
            });

            $("#btnPreview").on("click", function () {
                previewReport();
            });

            $("#btnReset").on("click", function () {
                resetFilters();
            });

            btnOpenNewTab.on("click", function () {
                if (skillStudentPdfUrl) window.open(skillStudentPdfUrl, "_blank");
            });
        }

        async function getDegree() {
            cboDegree.empty().append("<option value=''>Select Degree</option>");

            try {
                const degrees = await Degree.GetAllDegree();

                degrees.forEach(function (item) {
                    cboDegree.append(`<option value="${item.degreeId}">${item.degreeName}</option>`);
                });

                cboDegree.val("").trigger("change.select2");
            } catch (error) {
                console.error("Degree API error:", error);
            }
        }

        async function getSchool() {
            cboSchool.empty().append("<option value=''>Select School</option>");

            try {
                const schools = await School.GetSchool();

                schools.forEach(function (item) {
                    cboSchool.append(`<option value="${item.schoolId}">${item.schoolName}</option>`);
                });

                cboSchool.val("").trigger("change.select2");
            } catch (error) {
                console.error("School API error:", error);
            }
        }

        async function getField() {
            const degreeId = parseInt(cboDegree.val());
            const schoolId = parseInt(cboSchool.val());

            clearSelect(cboField, "Select Field");

            if (!degreeId || !schoolId) return;

            try {
                const fields = await Field.GetFields({
                    isAll: true,
                    degreeId: degreeId,
                    schoolId: schoolId
                });

                fields.forEach(function (item) {
                    cboField.append(`<option value="${item.fieldId}">${item.fieldName}</option>`);
                });

                cboField.val("").trigger("change.select2");
            } catch (error) {
                console.error("Field API error:", error);
            }
        }

        async function getPromotion() {
            const degreeId = parseInt(cboDegree.val());
            const schoolId = parseInt(cboSchool.val());

            clearSelect(cboPromotion, "Select Promotion");

            if (!degreeId || !schoolId) return;

            try {
                const promotions = await Promotion.GetPromotions({
                    degreeId: degreeId,
                    schoolId: schoolId
                });

                if (!promotions || promotions.length === 0) {
                    cboPromotion.empty().append("<option value=''>No promotion available</option>");
                    cboPromotion.val("").trigger("change.select2");
                    return;
                }

                promotions.forEach(function (item) {
                    cboPromotion.append(`<option value="${item.promotionId}">${item.promotionNo}</option>`);
                });

                cboPromotion.val("").trigger("change.select2");
            } catch (error) {
                console.error("Promotion API error:", error);
            }
        }

        async function getStage() {
            const promotionId = parseInt(cboPromotion.val());

            clearSelect(cboStage, "Select Stage");

            if (!promotionId) return;

            try {
                const stages = await Stage.GetStages({
                    promotionId: promotionId
                });

                stages.forEach(function (item) {
                    cboStage.append(
                        `<option value="${item.stageId}"
                                 data-year="${item.year ?? ""}"
                                 data-semester="${item.semester ?? item.stageNo ?? ""}">
                            ${item.stageNo}
                         </option>`
                    );
                });

                cboStage.val("").trigger("change.select2");
            } catch (error) {
                console.error("Stage API error:", error);
            }
        }

        async function getGroups() {
            const stageId = parseInt(cboStage.val());
            const fieldId = parseInt(cboField.val());

            clearGroups();

            if (!stageId || !fieldId) return;

            try {
                const groups = await Group.GetGroups({
                    stageId: stageId,
                    fieldId: fieldId
                });

                groupList.empty();

                if (!groups || groups.length === 0) {
                    groupList.html('<div class="text-muted text-center py-4">No groups available.</div>');
                    return;
                }

                groups.forEach(function (item) {
                    groupList.append(`
                        <label class="group-item">
                            <input type="checkbox"
                                   class="group-checkbox"
                                   value="${item.groupId}" />
                            <span>${item.groupName}</span>
                        </label>
                    `);
                });
            } catch (error) {
                console.error("Group API error:", error);
            }
        }

        function setStageInformation() {
            const selectedOption = cboStage.find("option:selected");

            txtYear.val(selectedOption.data("year") || "");
            txtSemester.val(selectedOption.data("semester") || "");
        }

        function clearStageInformation() {
            txtYear.val("");
            txtSemester.val("");
        }

        function clearGroups() {
            groupList.html('<div class="text-muted text-center py-4">Select field and stage.</div>');
        }

        function clearSelect(select, text) {
            select.empty().append(`<option value="">${text}</option>`);
            select.val("").trigger("change.select2");
        }

        function getSelectedGroupIds() {
            return groupList.find(".group-checkbox:checked").map(function () {
                return parseInt($(this).val());
            }).get();
        }

        function resetFilters() {
            cboDegree.val("").trigger("change");
            cboSchool.val("").trigger("change");

            clearSelect(cboField, "Select Field");
            clearSelect(cboPromotion, "Select Promotion");
            clearSelect(cboStage, "Select Stage");

            clearStageInformation();
            clearGroups();

            if (skillStudentPdfUrl) {
                URL.revokeObjectURL(skillStudentPdfUrl);
                skillStudentPdfUrl = null;
            }

            reportContainer.attr("src", "").hide();
            previewEmpty.show();
            btnOpenNewTab.hide();
        }

        function previewReport() {
            const degreeId = cboDegree.val();
            const schoolId = cboSchool.val();
            const fieldId = cboField.val();
            const promotionId = cboPromotion.val();
            const stageId = cboStage.val();
            const groupIds = getSelectedGroupIds();

            if (!degreeId) {
                alert("Please select Degree.");
                return;
            }

            if (!schoolId) {
                alert("Please select School.");
                return;
            }

            if (!fieldId) {
                alert("Please select Field.");
                return;
            }

            if (!promotionId) {
                alert("Please select Promotion.");
                return;
            }

            if (!stageId) {
                alert("Please select Stage.");
                return;
            }

            if (groupIds.length === 0) {
                alert("Please select at least one Group.");
                return;
            }

            showLoading();

            $.ajax({
                url: "/report/student-skill-list/pdf",
                type: "POST",
                traditional: true,
                data: {
                    degreeId: degreeId,
                    schoolId: schoolId,
                    fieldId: fieldId,
                    promotionId: promotionId,
                    stageId: stageId,
                    groupIds: groupIds
                },
                xhrFields: {
                    responseType: "blob"
                },
                success: function (blob) {
                    if (skillStudentPdfUrl) URL.revokeObjectURL(skillStudentPdfUrl);

                    skillStudentPdfUrl = URL.createObjectURL(blob);

                    previewEmpty.hide();
                    reportContainer.attr("src", skillStudentPdfUrl).show();
                    btnOpenNewTab.show();
                },
                error: function (xhr) {
                    console.error("Skill report error:", xhr);
                    alert("Unable to generate the skilled student report.");
                },
                complete: function () {
                    hideLoading(1);
                }
            });
        }

        $(window).on("beforeunload", function () {
            if (skillStudentPdfUrl) URL.revokeObjectURL(skillStudentPdfUrl);
        });
    </script>
}