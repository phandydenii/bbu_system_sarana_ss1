@using BBU_SYSTEM.ViewModel
@{
    ViewData["Title"] = "MoEYS Student";
    ViewData["OpenMenu"] = "Report";
    ViewData["OpenSubMenu"] = "AcademicReport";
    ViewData["Action"] = "StudentReport";
    var req = new QueryReportViewModel();
}
<div class="card">
    <div class="card-header">
        <div class="margin">
            <a asp-controller="Report"
               asp-action="StudentSkillList"
               class="btn btn-outline-primary btn-sm">
                Skill Student List
            </a>

            <a asp-controller="Report"
               asp-action="StudentScoreList"
               class="btn btn-outline-primary btn-sm">
                Student Score List
            </a>

            <a asp-controller="Report"
               asp-action="StudentMinistryDoc"
               class="btn btn-primary btn-sm">
                <i class="fas fa-check mr-1"></i>
                MoEYS Student
            </a>
        </div>
    </div>
</div>

<div id="studentMoeysTab">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">MoEYS Student Report</h5>
        <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#studentMoeysFilterModal">
            <i class="fas fa-filter mr-1"></i>
            Filter
        </button>
    </div>
    <div class="row">
        <div class="col-12">
            <iframe src="" width="100%" height="850px" id="reportContainer" frameborder="1"></iframe>
        </div>
    </div>
</div>

<div class="modal fade" id="studentMoeysFilterModal" tabindex="-1" role="dialog" aria-labelledby="studentMoeysFilterModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="studentMoeysFilterModalLabel">MoEYS Report Filter</h5>

                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="required">Degree</label>
                            <select asp-for="@req.DegreeId" id="cboDegree" class="form-control select2">
                                <option value="">Select Degree</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="required">School</label>
                            <select asp-for="@req.SchoolId" id="cboSchool" class="form-control select2">
                                <option value="">Select School</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Field</label>
                            <select asp-for="@req.FieldId" id="cboField" class="form-control select2">
                                <option value="">Select Field</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Promotion</label>
                            <select asp-for="@req.PromotionId" id="cboPromotion" class="form-control select2">
                                <option value="">Select Promotion</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Stage</label>
                            <select asp-for="@req.StageId" id="cboStage" class="form-control select2">
                                <option value="">Select Stage</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Term</label>
                            <select asp-for="@req.TermNo" id="cboTerm" class="form-control select2">
                                <option value="">Select Term</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Group</label>
                            <select asp-for="@req.GroupId" id="cboGroup" class="form-control select2">
                                <option value="">Select Group</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="form-group">
                            <label>Type</label>
                            <select asp-for="@req.Filter" id="cboFilter" class="form-control select2">
                                <option value="official">Official</option>
                                <option value="document_in">Document In</option>
                                <option value="document_out">Document Out</option>
                                <option value="authenticated">High School Clarification</option>
                                <option value="no_document_in">No Document In</option>
                                <option value="no_document_out">No Document Out</option>
                                <option value="no_official">No Official</option>
                                <option value="no_authenticated">No High School Clarification</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">
                    Cancel
                </button>

                <button type="button" id="btnApplyStudentMoeysFilter" class="btn btn-success" onclick="loadStudentMoeys()">
                    <i class="fas fa-check mr-1"></i>
                    Apply Filter
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(async function () { 
        $(".select2").select2({
            width: "100%",
            placeholder: "Select an option",
            allowClear: true
        });
        bindStudentMoeysEvents();

        await getDegree();
        await getSchool();
    });

    function bindStudentMoeysEvents() {
        var root = $("#studentMoeysTab");

        root.off(".studentMoeys");

        $("#cboDegree", async function () {
            await getField();
            await getPromotion();
        });

        root.on("change.studentMoeys", "#cboSchool", async function () {
            await getField();
            await getPromotion();

            clearSelect("#cboStage", "Select Stage");
            clearSelect("#cboTerm", "Select Term");
            clearSelect("#cboGroup", "Select Group");
        });

        root.on("change.studentMoeys", "#cboField", async function () {
            await getGroup();
        });

        root.on("change.studentMoeys", "#cboPromotion", async function () {
            await getStage();

            clearSelect("#cboTerm", "Select Term");
            clearSelect("#cboGroup", "Select Group");
        });

        root.on("change.studentMoeys", "#cboStage", async function () {
            await getTerm();
            await getGroup();
        });
    }

    async function getDegree() {
        var cboDegree = $("#studentMoeysTab #cboDegree");

        cboDegree.empty();
        cboDegree.append("<option value=''>Select Degree</option>");

        try {
            console.log("Calling degree API");

            var degrees = await Degree.GetAllDegree();

            degrees.forEach(function (item) {
                cboDegree.append(
                    `<option value="${item.degreeId}">
                        ${item.degreeName}
                    </option>`
                );
            });

            cboDegree.val("").trigger("change.select2");
        } catch (error) {
            console.error("Degree API error:", error);
        }
    }

    async function getSchool() {
        var cboSchool = $("#studentMoeysTab #cboSchool");

        cboSchool.empty();
        cboSchool.append("<option value=''>Select School</option>");

        try {
            var schools = await School.GetSchool();

            schools.forEach(function (item) {
                cboSchool.append(
                    `<option value="${item.schoolId}">
                        ${item.schoolName}
                    </option>`
                );
            });

            cboSchool.val("").trigger("change.select2");
        } catch (error) {
            console.error("School API error:", error);
        }
    }

    async function getField() {
        var degreeId = parseInt(
            $("#studentMoeysTab #cboDegree").val()
        );

        var schoolId = parseInt(
            $("#studentMoeysTab #cboSchool").val()
        );

        var cboField = $("#studentMoeysTab #cboField");

        cboField.empty();
        cboField.append("<option value=''>Select Field</option>");

        if (!degreeId || !schoolId) {
            cboField.val("").trigger("change.select2");
            return;
        }

        try {
            var fields = await Field.GetFields({
                isAll: true,
                degreeId: degreeId,
                schoolId: schoolId
            });

            fields.forEach(function (item) {
                cboField.append(
                    `<option value="${item.fieldId}">
                        ${item.fieldName}
                    </option>`
                );
            });

            cboField.val("").trigger("change.select2");
        } catch (error) {
            console.error("Field API error:", error);
        }
    }

    async function getPromotion() {
        var degreeId = parseInt(
            $("#studentMoeysTab #cboDegree").val()
        );

        var schoolId = parseInt(
            $("#studentMoeysTab #cboSchool").val()
        );

        var cboPromotion = $("#studentMoeysTab #cboPromotion");

        cboPromotion.empty();
        cboPromotion.append(
            "<option value=''>Select Promotion</option>"
        );

        if (!degreeId || !schoolId) {
            cboPromotion.val("").trigger("change.select2");
            return;
        }

        try {
            var promotions = await Promotion.GetPromotions({
                schoolId: schoolId,
                degreeId: degreeId
            });

            promotions.forEach(function (item) {
                cboPromotion.append(
                    `<option value="${item.promotionId}">
                        ${item.promotionNo}
                    </option>`
                );
            });

            cboPromotion.val("").trigger("change.select2");
        } catch (error) {
            console.error("Promotion API error:", error);
        }
    }

    async function getStage() {
        var promotionId = parseInt(
            $("#studentMoeysTab #cboPromotion").val()
        );

        var cboStage = $("#studentMoeysTab #cboStage");

        cboStage.empty();
        cboStage.append("<option value=''>Select Stage</option>");

        if (!promotionId) {
            cboStage.val("").trigger("change.select2");
            return;
        }

        try {
            var stages = await Stage.GetStages({
                promotionId: promotionId
            });

            stages.forEach(function (item) {
                cboStage.append(
                    `<option value="${item.stageId}">
                        ${item.stageNo}
                    </option>`
                );
            });

            cboStage.val("").trigger("change.select2");
        } catch (error) {
            console.error("Stage API error:", error);
        }
    }

    async function getTerm() {
        const stageId = $("#cboStage").val();
        const cboTerm = $("#cboTerm");
        cboTerm.empty();
        cboTerm.append("<option value=''>Select Term</option>");
        if (!stageId) {
            cboTerm.val("").trigger("change.select2");
            return;
        }

        try {
            const terms = await Term.GetTerms({stageId: stageId});
            terms.forEach(function (item) {
                cboTerm.append(
                    `<option value="${item.termNo}">
                        ${item.termNo}
                    </option>`
                );
            });
            cboTerm.val("").trigger("change.select2");
        } catch (error) {
            console.error("Term API error:", error);
        }
    }

    async function getGroup() {
        const stageId = $("#cboStage").val();
        const fieldId = $("#cboField").val(); 
        const cboGroup = $("#cboGroup");
        cboGroup.empty();
        cboGroup.append("<option value=''>Select Group</option>");
        if (!stageId || !fieldId) {
            cboGroup.val("").trigger("change.select2");
            return;
        }
        try {
            const groups = await Group.GetGroups({
                stageId: stageId,
                fieldId: fieldId
            });

            groups.forEach(function (item) {
                cboGroup.append(
                    `<option value="${item.groupId}">
                        ${item.groupName}
                    </option>`
                );
            });
            cboGroup.val("").trigger("change.select2");
        } catch (error) {
            console.error("Group API error:", error);
        }
    }

    function loadStudentMoeys() {
        // var degreeId = $("#studentMoeysTab #cboDegree").val();
        // var schoolId = $("#studentMoeysTab #cboSchool").val();
        // var fieldId = $("#studentMoeysTab #cboField").val();
        // var promotionId = $("#studentMoeysTab #cboPromotion").val();
        // var filter = $("#studentMoeysTab #cboFilter").val();

        // if (!degreeId || !schoolId || !fieldId || !promotionId) {
        //     alert(
        //         "Please select Degree, School, Field and Promotion."
        //     );
        //
        //     return;
        // }

        showLoading();

        $.ajax({
            url: "/report/student-moeys",
            type: "POST",
            // data: {
            //     degreeId: degreeId,
            //     schoolId: schoolId,
            //     fieldId: fieldId,
            //     promotionId: promotionId,
            //     filter: filter
            // },
            data: {
                degreeId: 2,
                schoolId: 2,
                fieldId: 18,
                promotionId: 368,
                filter: "document_in"
            },
            xhrFields: {
                responseType: "blob"
            },
            success: function (blob) {
                if (window.studentMoeysPdfUrl) {
                    URL.revokeObjectURL(window.studentMoeysPdfUrl);
                }
                window.studentMoeysPdfUrl = URL.createObjectURL(blob);
                $("#reportContainer").attr("src",window.studentMoeysPdfUrl);
            },
            error: function (xhr) {
                console.error("Report error:", xhr);
                alert("Unable to generate report.");
            },
            complete: function () {
                hideLoading(1);
                $("#studentMoeysFilterModal").modal("hide");
            }
        });
    }
</script>