@{
    ViewData["Title"] = "Student Score List";
    ViewData["OpenMenu"] = "Report";
    ViewData["OpenSubMenu"] = "AcademicReport";
    ViewData["Action"] = "StudentReport";
}

<style>
    .score-page .card-body {
        padding: 10px;
    }

    .score-page .section-card {
        border: 1px solid #dee2e6;
        border-radius: 6px;
        background: #fff;
        overflow: hidden;
    }

    .score-page .section-header {
        padding: 7px 10px;
        background: #f4f6f9;
        border-bottom: 1px solid #dee2e6;
        font-size: 14px;
        font-weight: 600;
        color: #343a40;
    }

    .score-page .search-panel {
        padding: 8px;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        background: #f8f9fa;
    }

    .score-page .form-group {
        margin-bottom: 0;
    }

    .score-page label {
        margin-bottom: 3px;
        font-size: 14px;
        font-weight: 600;
        color: #343a40;
    }

    .score-page .search-panel .form-control {
        height: 32px;
        font-size: 13px;
    }

    .score-page .search-panel .input-group-text,
    .score-page .search-panel .btn {
        height: 32px;
    }

    .score-page .search-panel .btn {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 38px;
        padding: 0 10px;
    }

    .score-page .table {
        margin-bottom: 0;
        font-size: 13px;
    }

    .score-page .table thead th {
        padding: 7px 8px;
        background: #f4f6f9;
        border-bottom: 1px solid #dee2e6;
        font-weight: 600;
        white-space: nowrap;
        vertical-align: middle;
    }

    .score-page .table tbody td {
        padding: 6px 8px;
        vertical-align: middle;
    }

    .score-page .table-container {
        min-height: 220px;
        max-height: 380px;
        overflow: auto;
    }

    .score-page .history-container {
        min-height: 135px;
        max-height: 220px;
        overflow: auto;
    }

    .score-page .reexam-container {
        min-height: 250px;
        max-height: 330px;
        overflow: auto;
    }

    .score-page .empty-message {
        padding: 16px 6px !important;
        text-align: center;
        color: #6c757d;
    }

    .score-page .content-row {
        margin-top: 8px;
    }

    .score-page .action-bar {
        display: flex;
        justify-content: flex-end;
        gap: 6px;
        margin-top: 8px;
    }

    @@media (max-width: 991.98px) {
        .score-page .reexam-container {
            min-height: 150px;
            max-height: 240px;
        }
    }

    @@media (max-width: 767.98px) {
        .score-page .search-panel .form-group {
            margin-bottom: 8px;
        }

        .score-page .search-panel .col-12:last-child .form-group {
            margin-bottom: 0;
        }

        .score-page .action-bar {
            flex-direction: column;
        }

        .score-page .action-bar .btn {
            width: 100%;
        }

        .score-page .table-container,
        .score-page .history-container,
        .score-page .reexam-container {
            min-height: auto;
        }
    }
</style>

<div class="card score-page">
    <div class="card-header">
        <div class="margin">
            <a asp-controller="Report"
               asp-action="Student"
               class="btn btn-outline-primary btn-sm">
                Student List
            </a> 
            <a asp-controller="Report"
               asp-action="StudentSkillList"
               class="btn btn-outline-primary btn-sm">
                Skill Student List
            </a> 
            <a asp-controller="Report"
               asp-action="StudentScoreList"
               class="btn btn-primary btn-sm">
                <i class="fas fa-check mr-1"></i>
                Student Score List
            </a> 
            <a asp-controller="Report"
               asp-action="StudentMinistryDoc"
               class="btn btn-outline-primary btn-sm">
                MoEYS Student
            </a>
        </div>
    </div>

    <div class="card-body">
        <div class="search-panel">
            <input type="hidden" id="studentId" /> 
            <div class="row">
                <div class="col-12 col-md-4">
                    <div class="form-group">
                        <label class="required" for="txtStudentId">Student ID</label> 
                        <div class="input-group input-group-sm">
                            <input type="text" id="txtStudentId" class="form-control" readonly placeholder="Select student" /> 
                            <div class="input-group-append">
                                <button type="button"
                                        id="btnSearchStudent"
                                        class="btn btn-primary"
                                        title="Search student">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="form-group">
                        <label for="txtStudentName">Student Name</label>
                        <input type="text"
                               id="txtStudentName"
                               class="form-control form-control-sm"
                               readonly
                               placeholder="English name" />
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="form-group">
                        <label for="txtStudentNameKhmer">Student Name Khmer</label>
                        <input type="text"
                               id="txtStudentNameKhmer"
                               class="form-control form-control-sm"
                               readonly
                               placeholder="Khmer name" />
                    </div>
                </div>
            </div>
        </div>
        
        <div class="row content-row">
            <div class="col-lg-7 mb-2 mb-lg-0">
                @* Examination *@ 
                <div class="section-card mb-2">
                    <div class="section-header">
                        <i class="fas fa-graduation-cap mr-1"></i>
                        Student Examination Result
                    </div>
                    <div class="table-responsive table-container">
                        <table id="tblStudentResult"
                               class="table table-bordered table-hover">
                            <thead>
                            <tr>
                                <th style="width: 90px;">Term</th>
                                <th>Course</th>
                                <th style="width: 100px;">Mid</th>
                                <th style="width: 100px;">Final</th>
                                <th style="width: 100px;">Total</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td colspan="5" class="empty-message">
                                    Select a student to view examination results.
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                @* Exam history *@ 
                <div class="section-card mb-2">
                    <div class="section-header">
                        <i class="fas fa-history mr-1"></i>
                        Exam Score History
                    </div>
                    <div class="table-responsive history-container">
                        <table id="tblExamHistory"
                               class="table table-bordered table-hover">
                            <thead>
                            <tr>
                                <th>Course Name</th>
                                <th style="width: 120px;">Mid Term</th>
                                <th style="width: 120px;">Final</th>
                                <th style="width: 120px;">Total</th>
                                <th style="width: 120px;">Attempt</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td colspan="5" class="empty-message">
                                    No examination history available.
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                @* Re-Study history *@
                <div class="section-card">
                    <div class="section-header">
                        <i class="fas fa-book-reader mr-1"></i>
                        Restudy Score History
                    </div>
                    <div class="table-responsive history-container">
                        <table id="tblRestudyHistory"
                               class="table table-bordered table-hover">
                            <thead>
                            <tr>
                                <th style="width: 90px;">Term</th>
                                <th>Course</th>
                                <th style="width: 100px;">Mid</th>
                                <th style="width: 100px;">Final</th>
                                <th style="width: 100px;">Total</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td colspan="5" class="empty-message">
                                    No restudy history available.
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            
            @* Re-Exam 1 *@
            <div class="col-lg-5">
                <div class="section-card mb-2">
                    <div class="section-header">
                        <i class="fas fa-redo-alt mr-1"></i>
                        Re-Exam 1
                    </div>
                    <div class="table-responsive reexam-container">
                        <table id="tblReExam1"
                               class="table table-bordered table-hover">
                            <thead>
                            <tr>
                                <th style="width: 70px;">No.</th>
                                <th>Course</th>
                                <th style="width: 100px;">Score</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td colspan="3" class="empty-message">
                                    No data available.
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                
                @* Re-Exam 2 *@ 
                <div class="section-card">
                    <div class="section-header">
                        <i class="fas fa-redo-alt mr-1"></i>
                        Re-Exam 2
                    </div>
                    <div class="table-responsive reexam-container">
                        <table id="tblReExam2"
                               class="table table-bordered table-hover">
                            <thead>
                            <tr>
                                <th style="width: 70px;">No.</th>
                                <th>Course</th>
                                <th style="width: 100px;">Score</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td colspan="3" class="empty-message">
                                    No data available.
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="action-bar">
            <button type="button" id="btnViewContract" class="btn btn-outline-primary">
                <i class="fas fa-file-contract mr-1"></i>
                Contract
            </button> 
            <button type="button" id="btnPrintScore" class="btn btn-success">
                <i class="fas fa-print mr-1"></i>
                Print
            </button>
        </div>
    </div>
</div>
<partial name="Academic/_StudentModal"/>
@section Scripts
{
    <script>
        const studentId = $("#studentId");
        const txtStudentId = $("#txtStudentId");
        const txtStudentName = $("#txtStudentName");
        const txtStudentNameKhmer = $("#txtStudentNameKhmer");
        const btnSearchStudent = $("#btnSearchStudent");

        const tblStudentResult = $("#tblStudentResult tbody");
        const tblReExam1 = $("#tblReExam1 tbody");
        const tblReExam2 = $("#tblReExam2 tbody");
        const tblExamHistory = $("#tblExamHistory tbody");
        const tblRestudyHistory = $("#tblRestudyHistory tbody");

        $(document).ready(function () {
            bindEvents();
        });

        function bindEvents() { 

            $("#btnPrintScore").on("click", function () {
                printStudentScore();
            });

            $("#btnViewContract").on("click", function () {
                viewStudentContract();
            });
        }
 
        function loadStudentScore() {
            const selectedStudentId = studentId.val();
            if (!selectedStudentId) {
                ShowToastInfo("Please select a student.");
                return;
            } 
            showLoading(); 
            $.ajax({
                url: "/report/student-score-detail",
                type: "GET",
                data: {
                    studentId: selectedStudentId
                },
                success: function (response) { 
                    bindExamResults(response.examResults);
                    bindReExam1(response.reExam1);
                    bindReExam2(response.reExam2);
                    bindExamHistory(response.examHistory);
                    bindRestudyHistory(response.restudyHistory);
                },
                error: function (xhr) {
                    console.error("Student score error:", xhr);
                    ShowToastError("Unable to load student scores.");
                },
                complete: function () {
                    hideLoading(1);
                }
            });
        }

        function bindExamResults(items) {
            tblStudentResult.empty();
            if (!items || items.length === 0) {
                tblStudentResult.append(`
                    <tr>
                        <td colspan="5" class="empty-message">
                            No examination result found.
                        </td>
                    </tr>
                `);
                return;
            }
            items.forEach(function (item) {
                tblStudentResult.append(`
                    <tr>
                        <td>${item.termNo ?? ""}</td>
                        <td>${item.courseName ?? ""}</td>
                        <td>${item.midScore ?? ""}</td>
                        <td>${item.finalScore ?? ""}</td>
                        <td>${item.totalScore ?? ""}</td>
                    </tr>
                `);
            });
        }

        function bindReExam1(items) {
            tblReExam1.empty();

            if (!items || items.length === 0) {
                tblReExam1.append(`
                    <tr>
                        <td colspan="3" class="empty-message">
                            No Re-Exam 1 data.
                        </td>
                    </tr>
                `);

                return;
            }

            items.forEach(function (item, index) {
                tblReExam1.append(`
                    <tr>
                        <td>${index + 1}</td>
                        <td>${item.courseName ?? ""}</td>
                        <td>${item.score ?? ""}</td>
                    </tr>
                `);
            });
        }

        function bindReExam2(items) {
            tblReExam2.empty(); 
            if (!items || items.length === 0) {
                tblReExam2.append(`
                    <tr>
                        <td colspan="3" class="empty-message">
                            No Re-Exam 2 data.
                        </td>
                    </tr>
                `);

                return;
            }

            items.forEach(function (item, index) {
                tblReExam2.append(`
                    <tr>
                        <td>${index + 1}</td>
                        <td>${item.courseName ?? ""}</td>
                        <td>${item.score ?? ""}</td>
                    </tr>
                `);
            });
        }

        function bindExamHistory(items) {
            tblExamHistory.empty();

            if (!items || items.length === 0) {
                tblExamHistory.append(`
                    <tr>
                        <td colspan="5" class="empty-message">
                            No examination history found.
                        </td>
                    </tr>
                `);

                return;
            }

            items.forEach(function (item) {
                tblExamHistory.append(`
                    <tr>
                        <td>${item.courseName ?? ""}</td>
                        <td>${item.midScore ?? ""}</td>
                        <td>${item.finalScore ?? ""}</td>
                        <td>${item.totalScore ?? ""}</td>
                        <td>${item.attemptNo ?? ""}</td>
                    </tr>
                `);
            });
        }

        function bindRestudyHistory(items) {
            tblRestudyHistory.empty();

            if (!items || items.length === 0) {
                tblRestudyHistory.append(`
                    <tr>
                        <td colspan="5" class="empty-message">
                            No restudy history found.
                        </td>
                    </tr>
                `);

                return;
            }

            items.forEach(function (item) {
                tblRestudyHistory.append(`
                    <tr>
                        <td>${item.termNo ?? ""}</td>
                        <td>${item.courseName ?? ""}</td>
                        <td>${item.midScore ?? ""}</td>
                        <td>${item.finalScore ?? ""}</td>
                        <td>${item.totalScore ?? ""}</td>
                    </tr>
                `);
            });
        }

        function printStudentScore() {
            const selectedStudentId = studentId.val();

            if (!selectedStudentId) {
                alert("Please select a student.");
                return;
            }

            window.open(
                `/report/student-score/print?studentId=${selectedStudentId}`,
                "_blank"
            );
        }

        function viewStudentContract() {
            const selectedStudentId = studentId.val();

            if (!selectedStudentId) {
                alert("Please select a student.");
                return;
            }

            window.open(
                `/report/student-contract?studentId=${selectedStudentId}`,
                "_blank"
            );
        }
        
        function OnSelectStudent(e) {
            const $input = $(e);
            const $row = $input.closest('tr');
            const selectedRow = $("#tblSearchStudent").DataTable().row($row).data();
            if (!selectedRow) {
                clearSelectedStudent();
                return;
            }
            if (selectedRow) { 
                studentId.val(selectedRow.studentId);
                txtStudentId.val(selectedRow.studentId);
                txtStudentName.val(selectedRow.studentName);
                txtStudentNameKhmer.val(selectedRow.studentNameInKhmer);
                $("#StudentModal").modal("hide");
                loadStudentScore();
            }
        } 
        
        btnSearchStudent.on("click", function (e) {
            e.preventDefault();
            $("#StudentModal").modal("show");
            const tblSearchStudent = $("#tblSearchStudent");
            tblSearchStudent.DataTable().clear().destroy();
            tblSearchStudent.DataTable({
                processing: true,
                serverSide: true,
                paging: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                responsive: true,
                autoWidth: true,
                scrollCollapse: true,
                ajax: {
                    url: "/student/academic/student-list/all",
                    type: "POST",
                },
                columns: [
                    {data: "studentId"},
                    {data: "studentName"},
                    {data: "studentNameInKhmer"},
                    {data: "sex"},
                    {
                        data: null,
                        render: function (data, type, row) {
                            if (row.status === "REGISTER") {
                                return ` <span class="badge badge-warning">${row.status}</span>`;
                            } else if (row.status === "ACTIVE") {
                                return ` <span class="badge badge-primary">${row.status}</span>`;
                            } else if (row.status === "QUIT") {
                                return ` <span class="badge badge-danger">${row.status}</span>`;
                            } else {
                                return `<span class="badge badge-secondary">${row.status}</span>`;
                            }
                        },
                    },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `<a onclick="OnSelectStudent(this)"  class="btn btn-success btn-xs">Select</a>`;
                        },
                    },
                ],
                initComplete: function () {
                    MyApp.utils.dataTableDebounceSearch("#tblSearchStudent",500);
                }
            });
        });

        // clear ui data
        function clearSelectedStudent() {
            studentId.val("");
            txtStudentId.val("");
            txtStudentName.val("");
            txtStudentNameKhmer.val("");
            clearScoreTables();
        }
        function clearScoreTables() {
            tblStudentResult.html(`
                <tr>
                    <td colspan="5" class="empty-message">
                        Select a student to view examination results.
                    </td>
                </tr>
            `);

            tblExamHistory.html(`
                <tr>
                    <td colspan="5" class="empty-message">
                        No examination history available.
                    </td>
                </tr>
            `);

            tblRestudyHistory.html(`
                <tr>
                    <td colspan="5" class="empty-message">
                        No restudy history available.
                    </td>
                </tr>
            `);

            tblReExam1.html(`
                <tr>
                    <td colspan="3" class="empty-message">
                        No data available.
                    </td>
                </tr>
            `);

            tblReExam2.html(`
                <tr>
                    <td colspan="3" class="empty-message">
                        No data available.
                    </td>
                </tr>
            `);
        }
    </script>
}