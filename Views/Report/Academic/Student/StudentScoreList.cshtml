@{
    ViewData["Title"] = "Student Score List";
    ViewData["OpenMenu"] = "Report";
    ViewData["OpenSubMenu"] = "AcademicReport";
    ViewData["Action"] = "StudentReport";
}

<div class="card">
    <div class="card-header">
        <div class="margin">
            <a asp-controller="Report"
               asp-action="StudentSkillList"
               class="btn btn-outline-primary btn-sm">
                Skill Student List
            </a>

            <a asp-controller="Report"
               asp-action="StudentScoreList"
               class="btn btn-primary btn-sm">
                <i class="fas fa-check mr-1"></i>
                Student Score List
            </a>

            <a asp-controller="Report"
               asp-action="StudentMinistryDoc"
               class="btn btn-outline-primary btn-sm">
                MoEYS Student
            </a>
        </div>
    </div>

    <div class="card-body">
        <!-- Student Score List UI -->
    </div>
</div>

@section Scripts
{
    <script>
        $(document).ready(function () {
            console.log("Student Score List loaded");
        });
    </script>
}