@{
    ViewData["Title"] = "Return Clothes";
    ViewData["OpenMenu"] = "Report";
    ViewData["OpenSubMenu"] = "AdminReport";
    ViewData["Action"] = "BookClothesReport";

    ViewContext.RouteData.Values["action"] = "Return Clothes";
}

<style>
    .clothes-report-page .card-body {
        padding: 10px;
    }

    .clothes-report-page .report-navigation {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .clothes-report-page .filter-panel {
        min-height: 200px;
        height: 100%;
        padding: 12px;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        background: #f8f9fa;
    }

    .clothes-report-page .filter-title {
        margin-bottom: 12px;
        padding-bottom: 8px;
        border-bottom: 1px solid #dee2e6;
        color: #343a40;
        font-size: 14px;
        font-weight: 600;
    }

    .clothes-report-page .report-panel {
        overflow: hidden;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        background: #fff;
    }

    .clothes-report-page .report-header {
        padding: 8px 10px;
        border-bottom: 1px solid #dee2e6;
        background: #f4f6f9;
        color: #343a40;
        font-size: 14px;
        font-weight: 600;
    }

    .clothes-report-page .report-frame {
        display: block;
        width: 100%;
        height: 700px;
        border: 0;
        background: #fff;
    }

    @@media (max-width: 991.98px) {
        .clothes-report-page .filter-panel {
            margin-bottom: 10px;
        }

        .clothes-report-page .report-frame {
            height: 550px;
        }
    }

    @@media (max-width: 767.98px) {
        .clothes-report-page .report-navigation .btn {
            width: 100%;
        }

        .clothes-report-page .report-frame {
            height: 450px;
        }
    }
</style>

<div class="card clothes-report-page">
    <div class="card-header">
        <div class="report-navigation">
            <a asp-controller="Report"
               asp-action="BookClothes"
               class="btn btn-outline-primary btn-sm">
                Book Clothes
            </a>

            <a asp-controller="Report"
               asp-action="ReturnClothes"
               class="btn btn-primary btn-sm">
                <i class="fas fa-check mr-1"></i>
                Return Clothes
            </a>
        </div>
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-12 col-md-4 col-lg-3">
                <div class="filter-panel">
                    <div class="filter-title">
                        <i class="fas fa-filter mr-1"></i>
                        Report Filters
                    </div>

                    @* Add the Return Clothes filters here later. *@
                </div>
            </div>

            <div class="col-12 col-md-8 col-lg-9">
                <div class="report-panel">
                    <div class="report-header">
                        <i class="fas fa-undo-alt mr-1"></i>
                        Return Clothes Report
                    </div>

                    <iframe id="printFrame"
                            title="Return Clothes Report"
                            src="about:blank"
                            class="report-frame">
                    </iframe>
                </div>
            </div>
        </div>
    </div>
</div>