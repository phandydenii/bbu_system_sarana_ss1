@{
    ViewData["Title"] = "Student Insurance";
    ViewData["OpenMenu"] = "Report";
    ViewData["OpenSubMenu"] = "AdminReport";
    ViewData["Action"] = "PaymentReport";

    ViewContext.RouteData.Values["action"] = "Student Insurance";
}

<style>
    .insurance-page .card-body {
        padding: 10px;
    }

    .insurance-page .payment-navigation {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .insurance-page .filter-panel {
        height: 100%;
        padding: 12px;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        background: #f8f9fa;
    }

    .insurance-page .filter-title {
        margin-bottom: 12px;
        padding-bottom: 8px;
        border-bottom: 1px solid #dee2e6;
        color: #343a40;
        font-size: 14px;
        font-weight: 600;
    }

    .insurance-page .form-group {
        margin-bottom: 10px;
    }

    .insurance-page label {
        margin-bottom: 3px;
        color: #343a40;
        font-size: 13px;
        font-weight: 600;
    }

    .insurance-page .form-control {
        height: 34px;
        font-size: 13px;
    }

    .insurance-page .report-panel {
        overflow: hidden;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        background: #fff;
    }

    .insurance-page .report-header {
        padding: 8px 10px;
        border-bottom: 1px solid #dee2e6;
        background: #f4f6f9;
        color: #343a40;
        font-size: 14px;
        font-weight: 600;
    }

    .insurance-page .report-frame {
        display: block;
        width: 100%;
        height: 700px;
        border: 0;
        background: #fff;
    }

    .insurance-page .report-loading {
        height: 700px;
        padding-top: 100px;
        text-align: center;
    }

    @@media (max-width: 991.98px) {
        .insurance-page .filter-panel {
            margin-bottom: 10px;
        }

        .insurance-page .report-frame,
        .insurance-page .report-loading {
            height: 550px;
        }
    }

    @@media (max-width: 767.98px) {
        .insurance-page .payment-navigation .btn {
            width: 100%;
        }

        .insurance-page .report-frame,
        .insurance-page .report-loading {
            height: 450px;
        }
    }
</style>

<div class="card insurance-page">
    <div class="card-header">
        <div class="payment-navigation">
            <a asp-controller="Report"
               asp-action="Payment"
               class="btn btn-outline-primary btn-sm">
                Payment Summary
            </a>

            <a asp-controller="Report"
               asp-action="Income"
               class="btn btn-outline-primary btn-sm">
                Income
            </a>

            <a asp-controller="Report"
               asp-action="PaymentByDate"
               class="btn btn-outline-primary btn-sm">
                Payment By Date
            </a>

            <a asp-controller="Report"
               asp-action="PaymentByGroup"
               class="btn btn-outline-primary btn-sm">
                Payment By Group
            </a>

            <a asp-controller="Report"
               asp-action="NotPayment"
               class="btn btn-outline-primary btn-sm">
                Not Payment
            </a>

            <a asp-controller="Report"
               asp-action="ReExamPayment"
               class="btn btn-outline-primary btn-sm">
                Re-Exam Payment
            </a>

            <a asp-controller="Report"
               asp-action="Owe"
               class="btn btn-outline-primary btn-sm">
                Student Owe
            </a>

            <a asp-controller="Report"
               asp-action="Insurance"
               class="btn btn-primary btn-sm">
                <i class="fas fa-check mr-1"></i>
                Insurance
            </a>
        </div>
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-12 col-md-4 col-lg-3">
                <div class="filter-panel">
                    <div class="filter-title">
                        <i class="fas fa-filter mr-1"></i>
                        Report Filters
                    </div>

                    <div class="form-group">
                        <label for="cboDegree" class="required">
                            Degree
                        </label>

                        <select id="cboDegree"
                                class="form-control select2">
                            <option value="">Select degree</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="cboSchool" class="required">
                            School
                        </label>

                        <select id="cboSchool"
                                class="form-control select2">
                            <option value="">Select school</option>
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-4">
                            <div class="form-group">
                                <label for="cboPromotion"
                                       class="required">
                                    Promotion
                                </label>

                                <select id="cboPromotion"
                                        class="form-control select2">
                                    <option value="">Select</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-4">
                            <div class="form-group">
                                <label for="cboStage"
                                       class="required">
                                    Stage
                                </label>

                                <select id="cboStage"
                                        class="form-control select2">
                                    <option value="">Select</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-4">
                            <div class="form-group">
                                <label for="TermNo">
                                    Term
                                </label>

                                <input type="number"
                                       id="TermNo"
                                       class="form-control"
                                       min="1"
                                       value="1" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="InsuranceStatus">
                            Status
                        </label>

                        <select id="InsuranceStatus"
                                class="form-control select2">
                            <option value="">All statuses</option>
                            <option value="PAID">Paid</option>
                            <option value="UNPAID">Unpaid</option>
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-6">
                            <div class="form-group">
                                <label for="FromDate">
                                    From Date
                                </label>

                                <input type="date"
                                       id="FromDate"
                                       class="form-control" />
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="form-group">
                                <label for="ToDate">
                                    To Date
                                </label>

                                <input type="date"
                                       id="ToDate"
                                       class="form-control" />
                            </div>
                        </div>
                    </div>

                    <button type="button"
                            id="btnPreview"
                            class="btn btn-primary btn-block">
                        <i class="fas fa-eye mr-1"></i>
                        Preview
                    </button>
                </div>
            </div>

            <div class="col-12 col-md-8 col-lg-9">
                <div class="report-panel">
                    <div class="report-header">
                        <i class="fas fa-shield-alt mr-1"></i>
                        Student Insurance Report
                    </div>

                    <div id="reportLoading"
                         class="report-loading d-none">
                        <i class="fas fa-spinner fa-spin fa-2x text-primary"></i>

                        <div class="mt-2">
                            Loading report...
                        </div>
                    </div>

                    <iframe id="reportContainer"
                            title="Student Insurance Report"
                            src="about:blank"
                            class="report-frame">
                    </iframe>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        const degreeId = $("#cboDegree");
        const schoolId = $("#cboSchool");
        const promotionNo = $("#cboPromotion");
        const stageNo = $("#cboStage");
        const termNo = $("#TermNo");
        const insuranceStatus = $("#InsuranceStatus");
        const fromDate = $("#FromDate");
        const toDate = $("#ToDate");

        const btnPreview = $("#btnPreview");
        const reportLoading = $("#reportLoading");
        const reportContainer = $("#reportContainer");

        let currentPdfUrl = null;

        $(document).ready(function () {
            $(".select2").select2({
                width: "100%",
                allowClear: true
            });

            btnPreview.on("click", function () {
                previewInsuranceReport();
            });
        });

        function previewInsuranceReport() {
            if (!degreeId.val()) {
                ShowToastInfo("Please select a degree.");
                degreeId.select2("open");
                return;
            }

            if (!schoolId.val()) {
                ShowToastInfo("Please select a school.");
                schoolId.select2("open");
                return;
            }

            if (!promotionNo.val()) {
                ShowToastInfo("Please select a promotion.");
                promotionNo.select2("open");
                return;
            }

            if (!stageNo.val()) {
                ShowToastInfo("Please select a stage.");
                stageNo.select2("open");
                return;
            }

            if (
                fromDate.val() &&
                toDate.val() &&
                new Date(toDate.val()) < new Date(fromDate.val())
            ) {
                ShowToastInfo(
                    "To Date must be later than From Date."
                );

                return;
            }

            showReportLoading();

            $.ajax({
                url: '@Url.Action("InsurancePreview", "Report")',
                type: "GET",

                data: {
                    DegreeId: degreeId.val(),
                    SchoolId: schoolId.val(),
                    PromotionNo: promotionNo.val(),
                    StageNo: stageNo.val(),
                    TermNo: termNo.val() || 1,
                    Status: insuranceStatus.val() || "",
                    FromDate: fromDate.val() || "",
                    ToDate: toDate.val() || ""
                },

                xhrFields: {
                    responseType: "blob"
                },

                success: function (response, textStatus, xhr) {
                    const contentType =
                        xhr.getResponseHeader("Content-Type")
                        || "application/pdf";

                    if (currentPdfUrl) {
                        URL.revokeObjectURL(currentPdfUrl);
                    }

                    const pdfBlob = new Blob(
                        [response],
                        {
                            type: contentType
                        }
                    );

                    currentPdfUrl =
                        URL.createObjectURL(pdfBlob);

                    reportContainer
                        .off("load.insuranceReport")
                        .one("load.insuranceReport", function () {
                            hideReportLoading();
                        })
                        .attr("src", currentPdfUrl);
                },

                error: function (xhr) {
                    hideReportLoading();

                    const response = xhr.response;

                    if (response instanceof Blob) {
                        response.text().then(function (message) {
                            ShowToastError(
                                message ||
                                "Unable to generate insurance report."
                            );
                        });

                        return;
                    }

                    ShowToastError(
                        xhr.responseText ||
                        "Unable to generate insurance report."
                    );
                }
            });
        }

        function showReportLoading() {
            reportContainer.addClass("d-none");
            reportLoading.removeClass("d-none");

            btnPreview
                .prop("disabled", true)
                .html(
                    '<i class="fas fa-spinner fa-spin mr-1"></i> Loading...'
                );
        }

        function hideReportLoading() {
            reportLoading.addClass("d-none");
            reportContainer.removeClass("d-none");

            btnPreview
                .prop("disabled", false)
                .html(
                    '<i class="fas fa-eye mr-1"></i> Preview'
                );
        }

        $(window).on("beforeunload", function () {
            if (currentPdfUrl) {
                URL.revokeObjectURL(currentPdfUrl);
            }
        });
    </script>
}