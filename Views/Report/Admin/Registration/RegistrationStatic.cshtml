@model BBU_SYSTEM.ViewModel.Report.RegisteredStatisticViewModel

@{
    ViewData["Title"] = "Registration Statistic";
    ViewData["OpenMenu"] = "Report";
    ViewData["OpenSubMenu"] = "AdminReport";
    ViewData["Action"] = "RegistrationReport";
}

<style>
    .registration-static-page .card-body {
        padding: 10px;
    }

    .registration-static-page .filter-panel {
        height: 100%;
        padding: 12px;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        background: #f8f9fa;
    }

    .registration-static-page .filter-title {
        margin-bottom: 12px;
        padding-bottom: 8px;
        border-bottom: 1px solid #dee2e6;
        color: #343a40;
        font-size: 14px;
        font-weight: 600;
    }

    .registration-static-page .form-group {
        margin-bottom: 10px;
    }

    .registration-static-page label {
        margin-bottom: 3px;
        color: #343a40;
        font-size: 13px;
        font-weight: 600;
    }

    .registration-static-page .form-control {
        height: 34px;
        font-size: 13px;
    }

    .registration-static-page .report-panel {
        overflow: hidden;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        background: #fff;
    }

    .registration-static-page .report-header {
        padding: 8px 10px;
        border-bottom: 1px solid #dee2e6;
        background: #f4f6f9;
        color: #343a40;
        font-size: 14px;
        font-weight: 600;
    }

    .registration-static-page .report-frame {
        display: block;
        width: 100%;
        height: 700px;
        border: 0;
        background: #fff;
    }

    .registration-static-page .report-loading {
        height: 700px;
        padding-top: 100px;
        text-align: center;
    }

    @@media (max-width: 991.98px) {
        .registration-static-page .filter-panel {
            margin-bottom: 10px;
        }

        .registration-static-page .report-frame,
        .registration-static-page .report-loading {
            height: 550px;
        }
    }
</style>

<div class="card registration-static-page">
    <div class="card-header">
        <div class="margin">
            <a asp-controller="Report"
               asp-action="Registration"
               class="btn btn-outline-primary btn-sm">
                Registered Students
            </a>

            <a asp-controller="Report"
               asp-action="RegistrationStatic"
               class="btn btn-primary btn-sm">
                <i class="fas fa-check mr-1"></i>
                Registration Static
            </a>

            <a asp-controller="Report"
               asp-action="RegistrationByProvince"
               class="btn btn-outline-primary btn-sm">
                Registration By Province
            </a>

            <a asp-controller="Report"
               asp-action="Scholarship"
               class="btn btn-outline-primary btn-sm">
                Scholarship
            </a>
        </div>
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-12 col-md-4 col-lg-3">
                <div id="registrationStaticFilters"
                     class="filter-panel">

                    <div class="filter-title">
                        <i class="fas fa-filter mr-1"></i>
                        Report Filters
                    </div>

                    <div class="row">
                        <div class="col-6">
                            <div class="form-group">
                                <label asp-for="PromotionNo">
                                    Promotion
                                </label>

                                <input asp-for="PromotionNo"
                                       type="number"
                                       class="form-control"
                                       min="1"
                                       value="1" />
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="form-group">
                                <label asp-for="StageNo">Stage</label>
                                <input asp-for="StageNo"
                                       type="number"
                                       class="form-control"
                                       min="1"
                                       value="1" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="StartDate">Start Date</label>
                        <input asp-for="StartDate"
                               type="date"
                               class="form-control" />
                    </div>

                    <div class="row">
                        <div class="col-6">
                            <div class="form-group">
                                <label asp-for="Signature">Signature</label>
                                <input asp-for="Signature"
                                       type="text"
                                       class="form-control"
                                       autocomplete="off"
                                       placeholder="Signature name" />
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="form-group">
                                <label asp-for="Position">Position</label>
                                <label asp-for="Position">Position</label>
                                <input asp-for="Position"
                                       type="text"
                                       class="form-control"
                                       autocomplete="off"
                                       placeholder="Position" />
                            </div>
                        </div>
                    </div>

                    <button type="button"
                            id="btnPreview"
                            class="btn btn-primary btn-block">
                        <i class="fas fa-eye mr-1"></i>
                        Preview
                    </button>
                </div>
            </div>

            <div class="col-12 col-md-8 col-lg-9">
                <div class="report-panel">
                    <div class="report-header">
                        <i class="fas fa-file-pdf mr-1"></i>
                        Registration Statistic Report
                    </div>

                    <div id="reportLoading"
                         class="report-loading d-none">
                        <i class="fas fa-spinner fa-spin fa-2x text-primary"></i>

                        <div class="mt-2">
                            Loading report...
                        </div>
                    </div>

                    <iframe id="reportContainer"
                            title="Registration Statistic Report"
                            src="about:blank"
                            class="report-frame">
                    </iframe>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts
{
    <script>
        const promotionNo = $("#PromotionNo");
        const stageNo = $("#StageNo");
        const startDate = $("#StartDate");
        const signature = $("#Signature");
        const position = $("#Position");

        const btnPreview = $("#btnPreview");
        const reportLoading = $("#reportLoading");
        const reportContainer = $("#reportContainer");

        let currentPdfUrl = null;

        $(document).ready(function () {
            btnPreview.on("click", function () {
                previewRegistrationStatic();
            });
        });

        function previewRegistrationStatic() {
            showReportLoading();

            $.ajax({
                url: '@Url.Action("RegistrationStaticPreview", "Report")',
                type: "GET",

                data: {
                    PromotionNo: promotionNo.val() || 1,
                    StageNo: stageNo.val() || 1,
                    StartDate: startDate.val() || "",
                    Signature: signature.val() || "",
                    Position: position.val() || ""
                },

                xhrFields: {
                    responseType: "blob"
                },

                success: function (response, textStatus, xhr) {
                    const contentType =
                        xhr.getResponseHeader("Content-Type")
                        || "application/pdf";

                    if (currentPdfUrl) {
                        URL.revokeObjectURL(currentPdfUrl);
                    }

                    const pdfBlob = new Blob(
                        [response],
                        {
                            type: contentType
                        }
                    );

                    currentPdfUrl = URL.createObjectURL(pdfBlob);

                    reportContainer
                        .off("load.registrationStatic")
                        .one("load.registrationStatic", function () {
                            hideReportLoading();
                        })
                        .attr("src", currentPdfUrl);
                },

                error: function (xhr) {
                    hideReportLoading();

                    const response = xhr.response;

                    if (response instanceof Blob) {
                        response.text().then(function (message) {
                            ShowToastError(
                                message ||
                                "Unable to generate registration statistic report."
                            );
                        });

                        return;
                    }

                    ShowToastError(
                        xhr.responseText ||
                        "Unable to generate registration statistic report."
                    );
                }
            });
        }

        function showReportLoading() {
            reportContainer.addClass("d-none");
            reportLoading.removeClass("d-none");

            btnPreview
                .prop("disabled", true)
                .html(
                    '<i class="fas fa-spinner fa-spin mr-1"></i> Loading...'
                );
        }

        function hideReportLoading() {
            reportLoading.addClass("d-none");
            reportContainer.removeClass("d-none");

            btnPreview
                .prop("disabled", false)
                .html(
                    '<i class="fas fa-eye mr-1"></i> Preview'
                );
        }

        $(window).on("beforeunload", function () {
            if (currentPdfUrl) {
                URL.revokeObjectURL(currentPdfUrl);
            }
        });
    </script>
}