@model BBU_SYSTEM.ViewModel.Report.RegisteredViewModel

@{
    ViewData["Title"] = "Student Fee Collection";
    ViewData["OpenMenu"] = "Report";
    ViewData["OpenSubMenu"] = "AdminReport";
    ViewData["Action"] = "OtherReport"; 
    ViewContext.RouteData.Values["action"] = "Student Fee Collection";
}

<style>
    .student-fee-page .card-body {
        padding: 10px;
    }

    .student-fee-page .report-navigation {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .student-fee-page .filter-panel {
        height: 100%;
        padding: 12px;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        background: #f8f9fa;
    }

    .student-fee-page .filter-title {
        margin-bottom: 12px;
        padding-bottom: 8px;
        border-bottom: 1px solid #dee2e6;
        color: #343a40;
        font-size: 14px;
        font-weight: 600;
    }

    .student-fee-page .form-group {
        margin-bottom: 10px;
    }

    .student-fee-page label {
        margin-bottom: 3px;
        color: #343a40;
        font-size: 13px;
        font-weight: 600;
    }

    .student-fee-page .form-control {
        height: 34px;
        font-size: 13px;
    }

    .student-fee-page .report-panel {
        overflow: hidden;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        background: #fff;
    }

    .student-fee-page .report-header {
        padding: 8px 10px;
        border-bottom: 1px solid #dee2e6;
        background: #f4f6f9;
        color: #343a40;
        font-size: 14px;
        font-weight: 600;
    }

    .student-fee-page .report-frame {
        display: block;
        width: 100%;
        height: 700px;
        border: 0;
        background: #fff;
    }

    .student-fee-page .report-loading {
        height: 700px;
        padding-top: 100px;
        text-align: center;
    }

    @@media (max-width: 991.98px) {
        .student-fee-page .filter-panel {
            margin-bottom: 10px;
        }

        .student-fee-page .report-frame,
        .student-fee-page .report-loading {
            height: 550px;
        }
    }

    @@media (max-width: 767.98px) {
        .student-fee-page .report-navigation .btn {
            width: 100%;
        }

        .student-fee-page .report-frame,
        .student-fee-page .report-loading {
            height: 450px;
        }
    }
</style>

<div class="card student-fee-page">
    <div class="card-header">
        <div class="report-navigation">
            <a asp-controller="Report"
               asp-action="Other"
               class="btn btn-outline-primary btn-sm">
                Graduate Student
            </a>

            <a asp-controller="Report"
               asp-action="StudentStatistic"
               class="btn btn-outline-primary btn-sm">
                Student Statistic
            </a>

            <a asp-controller="Report"
               asp-action="StudentLetterList"
               class="btn btn-outline-primary btn-sm">
                Student Letter List
            </a>

            <a asp-controller="Report"
               asp-action="StudentAcceptCertificate"
               class="btn btn-outline-primary btn-sm">
                Accept Certificate
            </a>

            <a asp-controller="Report"
               asp-action="StudentFeeCollection"
               class="btn btn-primary btn-sm">
                <i class="fas fa-check mr-1"></i>
                Student Fee Collection
            </a>
        </div>
    </div>

    <div class="card-body">
        <div class="row">

            <!-- Filters -->
            <div class="col-12 col-md-4 col-lg-3">
                <div class="filter-panel">
                    <div class="filter-title">
                        <i class="fas fa-filter mr-1"></i>
                        Report Filters
                    </div>

                    <div class="form-group">
                        <label asp-for="DegreeId"
                               class="required">
                            Degree
                        </label>

                        <select asp-for="DegreeId"
                                class="form-control select2">
                            <option value="">Select degree</option>
                        </select>

                        <span asp-validation-for="DegreeId"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="row">
                        <div class="col-4">
                            <div class="form-group">
                                <label asp-for="PromotionNo">
                                    Promotion
                                </label>

                                <input asp-for="PromotionNo"
                                       type="number"
                                       class="form-control"
                                       min="1"
                                       value="1" />
                            </div>
                        </div>

                        <div class="col-4">
                            <div class="form-group">
                                <label asp-for="StageNo">
                                    Stage
                                </label>

                                <input asp-for="StageNo"
                                       type="number"
                                       class="form-control"
                                       min="1"
                                       value="1" />
                            </div>
                        </div>

                        <div class="col-4">
                            <div class="form-group">
                                <label for="TermNo">
                                    Term
                                </label>

                                <input type="number"
                                       id="TermNo"
                                       class="form-control"
                                       min="1"
                                       value="1" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-6">
                            <div class="form-group">
                                <label asp-for="FromDate">
                                    From Date
                                </label>

                                <input asp-for="FromDate"
                                       type="date"
                                       class="form-control" />
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="form-group">
                                <label asp-for="ToDate">
                                    To Date
                                </label>

                                <input asp-for="ToDate"
                                       type="date"
                                       class="form-control" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="GroupId"
                               class="required">
                            Group
                        </label>

                        <select id="GroupId"
                                class="form-control select2">
                            <option value="">Select group</option>
                        </select>
                    </div>

                    <button type="button"
                            id="btnPreview"
                            class="btn btn-primary btn-block">
                        <i class="fas fa-eye mr-1"></i>
                        Preview
                    </button>
                </div>
            </div>

            <!-- Report preview -->
            <div class="col-12 col-md-8 col-lg-9">
                <div class="report-panel">
                    <div class="report-header">
                        <i class="fas fa-file-invoice-dollar mr-1"></i>
                        Student Fee Collection Report
                    </div>

                    <div id="reportLoading"
                         class="report-loading d-none">
                        <i class="fas fa-spinner fa-spin fa-2x text-primary"></i>

                        <div class="mt-2">
                            Loading report...
                        </div>
                    </div>

                    <iframe id="printFrame"
                            title="Student Fee Collection Report"
                            src="about:blank"
                            class="report-frame">
                    </iframe>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts
{
    <script>
        const degreeId = $("#DegreeId");
        const promotionNo = $("#PromotionNo");
        const stageNo = $("#StageNo");
        const termNo = $("#TermNo");
        const fromDate = $("#FromDate");
        const toDate = $("#ToDate");
        const groupId = $("#GroupId");

        const btnPreview = $("#btnPreview");
        const reportLoading = $("#reportLoading");
        const printFrame = $("#printFrame");

        let currentPdfUrl = null;

        $(document).ready(function () {
            degreeId.select2({
                width: "100%",
                placeholder: "Select degree",
                allowClear: true
            });

            groupId.select2({
                width: "100%",
                placeholder: "Select group",
                allowClear: true
            });

            btnPreview.on("click", function () {
                previewStudentFeeCollection();
            });
        });

        function previewStudentFeeCollection() {
            if (!degreeId.val()) {
                ShowToastInfo("Please select a degree.");
                degreeId.select2("open");
                return;
            }

            if (
                !promotionNo.val()
                || Number(promotionNo.val()) < 1
            ) {
                ShowToastInfo("Please enter a valid promotion.");
                promotionNo.focus();
                return;
            }

            if (
                !stageNo.val()
                || Number(stageNo.val()) < 1
            ) {
                ShowToastInfo("Please enter a valid stage.");
                stageNo.focus();
                return;
            }

            if (
                !termNo.val()
                || Number(termNo.val()) < 1
            ) {
                ShowToastInfo("Please enter a valid term.");
                termNo.focus();
                return;
            }

            if (!groupId.val()) {
                ShowToastInfo("Please select a group.");
                groupId.select2("open");
                return;
            }

            if (
                fromDate.val()
                && toDate.val()
                && new Date(toDate.val()) < new Date(fromDate.val())
            ) {
                ShowToastInfo(
                    "To Date must be later than From Date."
                );

                return;
            }

            const requestData = {
                DegreeId: degreeId.val(),
                PromotionNo: promotionNo.val(),
                StageNo: stageNo.val(),
                TermNo: termNo.val(),
                FromDate: fromDate.val() || "",
                ToDate: toDate.val() || "",
                GroupId: groupId.val()
            };

            showReportLoading();

            /*
            $.ajax({
                url: "YOUR_STUDENT_FEE_COLLECTION_REPORT_URL",
                type: "GET",
                data: requestData,

                xhrFields: {
                    responseType: "blob"
                },

                success: function (
                    response,
                    textStatus,
                    xhr
                ) {
                    const contentType =
                        xhr.getResponseHeader("Content-Type")
                        || "application/pdf";

                    if (currentPdfUrl) {
                        URL.revokeObjectURL(currentPdfUrl);
                    }

                    const pdfBlob = new Blob(
                        [response],
                        {
                            type: contentType
                        }
                    );

                    currentPdfUrl =
                        URL.createObjectURL(pdfBlob);

                    printFrame
                        .off("load.studentFeeCollection")
                        .one(
                            "load.studentFeeCollection",
                            function () {
                                hideReportLoading();
                            }
                        )
                        .attr("src", currentPdfUrl);
                },

                error: function (xhr) {
                    hideReportLoading();

                    const response = xhr.response;

                    if (response instanceof Blob) {
                        response
                            .text()
                            .then(function (message) {
                                ShowToastError(
                                    message ||
                                    "Unable to generate student fee collection report."
                                );
                            });

                        return;
                    }

                    ShowToastError(
                        xhr.responseText ||
                        "Unable to generate student fee collection report."
                    );
                }
            });
            */

            console.log(requestData);

            // Remove this after enabling the AJAX request.
            hideReportLoading();
        }

        function showReportLoading() {
            printFrame.addClass("d-none");
            reportLoading.removeClass("d-none");

            btnPreview
                .prop("disabled", true)
                .html(
                    '<i class="fas fa-spinner fa-spin mr-1"></i> Loading...'
                );
        }

        function hideReportLoading() {
            reportLoading.addClass("d-none");
            printFrame.removeClass("d-none");

            btnPreview
                .prop("disabled", false)
                .html(
                    '<i class="fas fa-eye mr-1"></i> Preview'
                );
        }

        $(window).on("beforeunload", function () {
            if (currentPdfUrl) {
                URL.revokeObjectURL(currentPdfUrl);
            }
        });
    </script>
}