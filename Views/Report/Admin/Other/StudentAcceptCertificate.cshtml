@model BBU_SYSTEM.ViewModel.Report.RegisteredViewModel

@{
    ViewData["Title"] = "Student Accept Certificate";
    ViewData["OpenMenu"] = "Report";
    ViewData["OpenSubMenu"] = "AdminReport";
    ViewData["Action"] = "OtherReport";

    ViewContext.RouteData.Values["action"] =
        "Student Accept Certificate";
}

<style>
    .accept-certificate-page .card-body {
        padding: 10px;
    }

    .accept-certificate-page .report-navigation {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .accept-certificate-page .filter-panel {
        height: 100%;
        padding: 12px;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        background: #f8f9fa;
    }

    .accept-certificate-page .filter-title {
        margin-bottom: 12px;
        padding-bottom: 8px;
        border-bottom: 1px solid #dee2e6;
        color: #343a40;
        font-size: 14px;
        font-weight: 600;
    }

    .accept-certificate-page .form-group {
        margin-bottom: 10px;
    }

    .accept-certificate-page label {
        margin-bottom: 3px;
        color: #343a40;
        font-size: 13px;
        font-weight: 600;
    }

    .accept-certificate-page .form-control {
        height: 34px;
        font-size: 13px;
    }

    .accept-certificate-page .option-panel {
        margin-bottom: 10px;
        padding: 9px 10px;
        border: 1px solid #dee2e6;
        border-radius: 5px;
        background: #fff;
    }

    .accept-certificate-page .option-title {
        margin-bottom: 8px;
        color: #343a40;
        font-size: 13px;
        font-weight: 600;
    }

    .accept-certificate-page .radio-options {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
    }

    .accept-certificate-page .radio-options label {
        font-weight: 400;
    }

    .accept-certificate-page .report-panel {
        overflow: hidden;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        background: #fff;
    }

    .accept-certificate-page .report-header {
        padding: 8px 10px;
        border-bottom: 1px solid #dee2e6;
        background: #f4f6f9;
        color: #343a40;
        font-size: 14px;
        font-weight: 600;
    }

    .accept-certificate-page .report-frame {
        display: block;
        width: 100%;
        height: 700px;
        border: 0;
        background: #fff;
    }

    .accept-certificate-page .report-loading {
        height: 700px;
        padding-top: 100px;
        text-align: center;
    }

    @@media (max-width: 991.98px) {
        .accept-certificate-page .filter-panel {
            margin-bottom: 10px;
        }

        .accept-certificate-page .report-frame,
        .accept-certificate-page .report-loading {
            height: 550px;
        }
    }

    @@media (max-width: 767.98px) {
        .accept-certificate-page .report-navigation .btn {
            width: 100%;
        }

        .accept-certificate-page .report-frame,
        .accept-certificate-page .report-loading {
            height: 450px;
        }
    }
</style>

<div class="card accept-certificate-page">
    <div class="card-header">
        <div class="report-navigation">
            <a asp-controller="Report"
               asp-action="Other"
               class="btn btn-outline-primary btn-sm">
                Graduate Student
            </a>

            <a asp-controller="Report"
               asp-action="StudentStatistic"
               class="btn btn-outline-primary btn-sm">
                Student Statistic
            </a>

            <a asp-controller="Report"
               asp-action="StudentLetterList"
               class="btn btn-outline-primary btn-sm">
                Student Letter List
            </a>

            <a asp-controller="Report"
               asp-action="StudentAcceptCertificate"
               class="btn btn-primary btn-sm">
                <i class="fas fa-check mr-1"></i>
                Accept Certificate
            </a>

            <a asp-controller="Report"
               asp-action="StudentFeeCollection"
               class="btn btn-outline-primary btn-sm">
                Student Fee Collection
            </a>
        </div>
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-12 col-md-4 col-lg-3">
                <div class="filter-panel">
                    <div class="filter-title">
                        <i class="fas fa-filter mr-1"></i>
                        Report Filters
                    </div>

                    <div class="form-group">
                        <label asp-for="DegreeId"
                               class="required">
                            Degree
                        </label>

                        <select asp-for="DegreeId"
                                class="form-control select2">
                            <option value="">Select degree</option>
                        </select>

                        <span asp-validation-for="DegreeId"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="form-group">
                        <label for="SchoolId"
                               class="required">
                            School
                        </label>

                        <select id="SchoolId"
                                class="form-control select2">
                            <option value="">Select school</option>
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-6">
                            <div class="form-group">
                                <label for="FromPromotionNo">
                                    From Promotion
                                </label>

                                <input type="number"
                                       id="FromPromotionNo"
                                       class="form-control"
                                       min="1"
                                       value="1" />
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="form-group">
                                <label for="ToPromotionNo">
                                    To Promotion
                                </label>

                                <input type="number"
                                       id="ToPromotionNo"
                                       class="form-control"
                                       min="1"
                                       value="1" />
                            </div>
                        </div>
                    </div>

                    <div class="option-panel">
                        <div class="option-title">
                            Certificate Acceptance
                        </div>

                        <div class="radio-options">
                            <div class="icheck-primary">
                                <input type="radio"
                                       id="certificateNotAccepted"
                                       name="certificateStatus"
                                       value="NOT_ACCEPTED"
                                       checked />

                                <label for="certificateNotAccepted">
                                    Not Accepted
                                </label>
                            </div>

                            <div class="icheck-primary">
                                <input type="radio"
                                       id="certificateAccepted"
                                       name="certificateStatus"
                                       value="ACCEPTED" />

                                <label for="certificateAccepted">
                                    Accepted
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="option-panel">
                        <div class="option-title">
                            Student Status
                        </div>

                        <div class="radio-options">
                            <div class="icheck-primary">
                                <input type="radio"
                                       id="studentStatusAll"
                                       name="studentStatus"
                                       value="ALL"
                                       checked />

                                <label for="studentStatusAll">
                                    All
                                </label>
                            </div>

                            <div class="icheck-primary">
                                <input type="radio"
                                       id="studentStatusCompleted"
                                       name="studentStatus"
                                       value="COMPLETED" />

                                <label for="studentStatusCompleted">
                                    Completed
                                </label>
                            </div>

                            <div class="icheck-primary">
                                <input type="radio"
                                       id="studentStatusGraduated"
                                       name="studentStatus"
                                       value="GRADUATED" />

                                <label for="studentStatusGraduated">
                                    Graduated
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-6">
                            <div class="form-group">
                                <label asp-for="FromDate">
                                    From Date
                                </label>

                                <input asp-for="FromDate"
                                       type="date"
                                       class="form-control" />
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="form-group">
                                <label asp-for="ToDate">
                                    To Date
                                </label>

                                <input asp-for="ToDate"
                                       type="date"
                                       class="form-control" />
                            </div>
                        </div>
                    </div>

                    <button type="button"
                            id="btnPreview"
                            class="btn btn-primary btn-block">
                        <i class="fas fa-eye mr-1"></i>
                        Preview
                    </button>
                </div>
            </div>

            <div class="col-12 col-md-8 col-lg-9">
                <div class="report-panel">
                    <div class="report-header">
                        <i class="fas fa-certificate mr-1"></i>
                        Student Accept Certificate Report
                    </div>

                    <div id="reportLoading"
                         class="report-loading d-none">
                        <i class="fas fa-spinner fa-spin fa-2x text-primary"></i>

                        <div class="mt-2">
                            Loading report...
                        </div>
                    </div>

                    <iframe id="printFrame"
                            title="Student Accept Certificate Report"
                            src="about:blank"
                            class="report-frame">
                    </iframe>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        const degreeId = $("#DegreeId");
        const schoolId = $("#SchoolId");
        const fromPromotionNo = $("#FromPromotionNo");
        const toPromotionNo = $("#ToPromotionNo");
        const fromDate = $("#FromDate");
        const toDate = $("#ToDate");

        const btnPreview = $("#btnPreview");
        const reportLoading = $("#reportLoading");
        const printFrame = $("#printFrame");

        let currentPdfUrl = null;

        $(document).ready(function () {
            degreeId.select2({
                width: "100%",
                placeholder: "Select degree",
                allowClear: true
            });

            schoolId.select2({
                width: "100%",
                placeholder: "Select school",
                allowClear: true
            });

            btnPreview.on("click", function () {
                previewAcceptCertificate();
            });
        });

        function previewAcceptCertificate() {
            if (!degreeId.val()) {
                ShowToastInfo("Please select a degree.");
                degreeId.select2("open");
                return;
            }

            if (!schoolId.val()) {
                ShowToastInfo("Please select a school.");
                schoolId.select2("open");
                return;
            }

            if (
                !fromPromotionNo.val()
                || Number(fromPromotionNo.val()) < 1
            ) {
                ShowToastInfo(
                    "Please enter a valid From Promotion."
                );

                fromPromotionNo.focus();
                return;
            }

            if (
                !toPromotionNo.val()
                || Number(toPromotionNo.val()) < 1
            ) {
                ShowToastInfo(
                    "Please enter a valid To Promotion."
                );

                toPromotionNo.focus();
                return;
            }

            if (
                Number(toPromotionNo.val())
                < Number(fromPromotionNo.val())
            ) {
                ShowToastInfo(
                    "To Promotion must be greater than or equal to From Promotion."
                );

                return;
            }

            if (
                fromDate.val()
                && toDate.val()
                && new Date(toDate.val()) < new Date(fromDate.val())
            ) {
                ShowToastInfo(
                    "To Date must be later than From Date."
                );

                return;
            }

            const requestData = {
                DegreeId: degreeId.val(),
                SchoolId: schoolId.val(),
                FromPromotionNo: fromPromotionNo.val(),
                ToPromotionNo: toPromotionNo.val(),
                CertificateStatus:
                    $("input[name='certificateStatus']:checked").val(),
                StudentStatus:
                    $("input[name='studentStatus']:checked").val(),
                FromDate: fromDate.val() || "",
                ToDate: toDate.val() || ""
            };

            showReportLoading();

            /*
            $.ajax({
                url: "YOUR_ACCEPT_CERTIFICATE_REPORT_URL",
                type: "GET",
                data: requestData,

                xhrFields: {
                    responseType: "blob"
                },

                success: function (
                    response,
                    textStatus,
                    xhr
                ) {
                    const contentType =
                        xhr.getResponseHeader("Content-Type")
                        || "application/pdf";

                    if (currentPdfUrl) {
                        URL.revokeObjectURL(currentPdfUrl);
                    }

                    const pdfBlob = new Blob(
                        [response],
                        {
                            type: contentType
                        }
                    );

                    currentPdfUrl =
                        URL.createObjectURL(pdfBlob);

                    printFrame
                        .off("load.acceptCertificate")
                        .one(
                            "load.acceptCertificate",
                            function () {
                                hideReportLoading();
                            }
                        )
                        .attr("src", currentPdfUrl);
                },

                error: function (xhr) {
                    hideReportLoading();

                    const response = xhr.response;

                    if (response instanceof Blob) {
                        response.text().then(function (message) {
                            ShowToastError(
                                message ||
                                "Unable to generate certificate report."
                            );
                        });

                        return;
                    }

                    ShowToastError(
                        xhr.responseText ||
                        "Unable to generate certificate report."
                    );
                }
            });
            */

            console.log(requestData);

            // Remove after enabling the AJAX request.
            hideReportLoading();
        }

        function showReportLoading() {
            printFrame.addClass("d-none");
            reportLoading.removeClass("d-none");

            btnPreview
                .prop("disabled", true)
                .html(
                    '<i class="fas fa-spinner fa-spin mr-1"></i> Loading...'
                );
        }

        function hideReportLoading() {
            reportLoading.addClass("d-none");
            printFrame.removeClass("d-none");

            btnPreview
                .prop("disabled", false)
                .html(
                    '<i class="fas fa-eye mr-1"></i> Preview'
                );
        }

        $(window).on("beforeunload", function () {
            if (currentPdfUrl) {
                URL.revokeObjectURL(currentPdfUrl);
            }
        });
    </script>
}