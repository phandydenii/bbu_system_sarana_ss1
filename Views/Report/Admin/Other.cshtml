@{
    ViewData["Title"] = "Index";
    ViewData["OpenMenu"] = "Report";
    ViewData["OpenSubMenu"] = "AdminReport";
    ViewData["Action"] = "OtherReport";
    
    var menus = new Dictionary<string, string>
    {
        // {"graduate_student", "Graduate Student"},
        {"student_statistic", "Student Statistic"},
        {"student_letter_list", "Student Letter List"},
        {"student_accept_certificate", "Student Accept Certificate"},
        {"student_fee_collection", "Student Fee Collection"}
    };
}
<div class="card">
    <div class="card-header">
        <div class="margin" id="rangeButtons">
            <button type="button" class="btn btn-primary btn-sm" value="graduate_student"><i class="fas fa-check mr-1"></i> Graduate Student</button>
            @foreach (var st in menus)
            {
                <button type="button" class="btn btn-outline-primary btn-sm" value="@st.Key">@st.Value</button>
            }
        </div>
    </div>
    <div class="card-body">
        <div id="formContainer"></div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
@section Scripts
{
    <script>
        const formContainer = $("#formContainer");
        const rangeButtons = $("#rangeButtons");
        $(document).ready(async function () {
            renterForm("graduate_student");
        });

        function renterForm(form) {
            formContainer.html("");
            if (!form) return;
            $(".select2").select2();
            formContainer.load("/report-partial/admin/others/" + form, function () {
                $(".select2").select2({
                    width: "100%",
                    placeholder: "Select an option"
                });
            });
        }
        rangeButtons.on("click", "button", function (e) {
            $("#rangeButtons").find("button").removeClass("btn-primary").addClass("btn-outline-primary").find("i").remove();
            $(this).removeClass("btn-outline-primary").addClass("btn-primary");
            $(this).prepend('<i class="fas fa-check mr-1"></i>');
            renterForm(e.target.value);
        });
        
    </script>
}