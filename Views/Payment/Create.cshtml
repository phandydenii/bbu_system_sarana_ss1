    function applyMissingAcademicToPaymentForm(invoiceData) {
        const fallbackValues = {
            degreeId: selectedAcademic.degreeId,
            schoolId: selectedAcademic.schoolId,
            fieldId: selectedAcademic.fieldId,
            promotionId: selectedAcademic.promotionId,
            stageId: selectedAcademic.stageId,
            termNo: selectedAcademic.termNo,
            groupId: selectedAcademic.groupId,
            startDate: selectedAcademic.startDate,
            endDate: selectedAcademic.endDate,
            exchangeRateId: selectedExchangeRateId
        };

        Object.entries(fallbackValues).forEach(([key, fallback]) => {
            const currentValue = invoiceData?.[key];
            if (currentValue !== null &&
                currentValue !== undefined &&
                String(currentValue).trim() !== "") {
                return;
            }

            const pascalKey =
                key.charAt(0).toUpperCase() + key.slice(1);

            formPayment
                .find(`[name='invoice.${pascalKey}']`)
                .val(fallback ?? "");
        });
    }

