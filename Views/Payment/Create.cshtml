    tblInvoiceDetail.on('input', 'input[name*=".OtherUsd"]', function (e) {
        const row = e.target.closest('tr');
        const index = row.rowIndex - 1;

        const input = row.querySelector(`input[name="invoiceDetails[${index}].OtherUsd"]`);
        if (input.value.trim() === "") {
            input.value = 0;
        }

        const otherUsd = parseFloat(input.value);
        const oweUsd = parseFloat(row.querySelector(`input[name="invoiceDetails[${index}].OweUsd"]`).value);
        const discountUsd = parseFloat(row.querySelector(`input[name="invoiceDetails[${index}].DiscountUsd"]`).value);
        const grandTotalUsd = parseFloat(row.querySelector(`input[name="invoiceDetails[${index}].GrandTotalUsd"]`).value);

        if(isNotValid(otherUsd) || isNotValid(oweUsd) || isNotValid(discountUsd) || isNotValid(grandTotalUsd)) return;
        const totalUsd = grandTotalUsd - oweUsd - discountUsd - otherUsd;

        row.querySelector(`input[name="invoiceDetails[${index}].TotalUsd"]`).value = totalUsd.toFixed(0);

        row.querySelector(`input[name="invoiceDetails[${index}].PayUsd"]`).value = totalUsd.toFixed(0);
    });

    tblInvoiceDetail.on('input', 'input[name*=".PayKhr"]', function (e) {
        const row = e.target.closest('tr');
        const index = row.rowIndex - 1;

        const input = row.querySelector(`input[name="invoiceDetails[${index}].PayKhr"]`);
        if (input.value.trim() === "") {
            input.value = 0;
        }
        let payKhr = 0;
        const rateIn = parseFloat(txtRateIn.text());
        const rateOut = parseFloat(txtRateOut.text());

        const totalKhr = row.querySelector(`input[name="invoiceDetails[${index}].TotalKhr"]`);
        const totalUsd = row.querySelector(`input[name="invoiceDetails[${index}].TotalUsd"]`);

        const paymentType = row.querySelector(`input[name="invoiceDetails[${index}].PaymentType"]`).value;
        if(isNotValid(payKhr) || isNotValid(rateIn) || isNotValid(totalKhr.value) || isNotValid(totalUsd.value) || isNotValid(paymentType)) return;

        let payUsd = 0;
        if(paymentType){
            if(parseFloat(input.value) >= totalKhr.value){
                input.value = totalKhr.value;
            }
            payKhr = parseFloat(input.value);
            payUsd = (totalKhr.value - payKhr) / rateIn;
        }else{
            if(parseFloat(input.value) / rateIn >= totalUsd){
                input.value = totalUsd.value * rateIn;
            }
            payKhr = parseFloat(input.value);
            console.log(`Pay Khr=${payKhr}, Pay Khr/Rate In= ${payKhr/rateIn}, pay usd = ${totalUsd.value}`);
            payUsd = (totalUsd.value - (payKhr /rateIn));
            console.log(`Pay Usd=${payUsd}`);
        }
        const roundPayUsd = Math.round(payUsd);
        console.log(`Pay Usd=${roundPayUsd}`);
        row.querySelector(`input[name="invoiceDetails[${index}].PayUsd"]`).value = roundPayUsd.toString();
    });

    tblInvoiceDetail.on('input', 'input[name*=".PayUsd"]', function (e) {
        const row = e.target.closest('tr');
        const index = row.rowIndex - 1;

        const inputPayUsd = row.querySelector(`input[name="invoiceDetails[${index}].PayUsd"]`);
        if (inputPayUsd.value.trim() === "") {
            inputPayUsd.value = 0;
        }
        let payUsd = 0;

        const rateIn = parseFloat(txtRateIn.text());
        const rateOut = parseFloat(txtRateOut.text());

        const totalKhr = row.querySelector(`input[name="invoiceDetails[${index}].TotalKhr"]`);
        const totalUsd = row.querySelector(`input[name="invoiceDetails[${index}].TotalUsd"]`);

        const paymentType = row.querySelector(`input[name="invoiceDetails[${index}].PaymentType"]`).value;

        if(isNotValid(payUsd) || isNotValid(rateIn) || isNotValid(totalKhr.value) || isNotValid(totalUsd.value) || isNotValid(paymentType)) return;

        let payKhr = 0;
        if(paymentType){
            if(parseFloat(inputPayUsd.value) >= (totalKhr.value / rateIn)){
                inputPayUsd.value = totalKhr.value / rateIn
            }
            payUsd = parseFloat(inputPayUsd.value);
            payKhr = (totalUsd.value - (payUsd * rateIn));
        }else{
            if(parseFloat(inputPayUsd.value) >= totalUsd.value){
                inputPayUsd.value = totalUsd.value;
            }
            payUsd = parseFloat(inputPayUsd.value);
            payKhr = (totalUsd.value - payUsd) * rateIn;
        }
        const roundPayKhr = Math.round(payKhr /100) * 100;
        row.querySelector(`input[name="invoiceDetails[${index}].PayKhr"]`).value = roundPayKhr.toString();
    });

    tblInvoiceDetail.on('input', 'input', function () {
        calculateInvoiceTotals();
    });

    function calculateInvoiceTotals() {
        let grandTotalUsd = 0;
        let grandTotalKhr = 0;
        let totalDiscountKhr = 0;
        let totalDiscountUsd = 0;
        let totalOweUsd = 0;
        let totalOweKhr = 0;
        let totalOtherUsd = 0;
        let totalOtherKhr = 0;
        let totalUsd = 0;
        let totalKhr = 0;
        let totalPayUsd = 0;
        let totalPayKhr = 0;
        let invoiceVat = 0;

        const rows = document.querySelectorAll("#tblInvoiceDetail tbody tr");

        rows.forEach((row, i) => {
            const isKhr = toNum(row.querySelector(`input[name="invoiceDetails[${i}].PaymentType"]`)?.value) === 1;

            const qty = toNum(row.querySelector(`input[name="invoiceDetails[${i}].Qty"]`)?.value);
            const priceKhr = toNum(row.querySelector(`input[name="invoiceDetails[${i}].PriceKhr"]`)?.value);
            const priceUsd = toNum(row.querySelector(`input[name="invoiceDetails[${i}].PriceUsd"]`)?.value);
            const discountPercent = toNum(row.querySelector(`input[name="invoiceDetails[${i}].DiscountPercent"]`)?.value);
            const oweKhr = toNum(row.querySelector(`input[name="invoiceDetails[${i}].OweKhr"]`)?.value);
            const oweUsd = toNum(row.querySelector(`input[name="invoiceDetails[${i}].OweUsd"]`)?.value);
            const otherKhr = toNum(row.querySelector(`input[name="invoiceDetails[${i}].OtherKhr"]`)?.value);
            const otherUsd = toNum(row.querySelector(`input[name="invoiceDetails[${i}].OtherUsd"]`)?.value);
            const payKhr = toNum(row.querySelector(`input[name="invoiceDetails[${i}].PayKhr"]`)?.value);
            const payUsd = toNum(row.querySelector(`input[name="invoiceDetails[${i}].PayUsd"]`)?.value);
            const vat = toNum(row.querySelector(`input[name="invoiceDetails[${i}].Vat"]`)?.value);


            // ---- Calculate item totals ----
            const grandKhr = qty * priceKhr;
            const grandUsd = qty * priceUsd;

            const discountKhr = (grandKhr * discountPercent) / 100;
            const discountUsd = (grandUsd * discountPercent) / 100;

            const subTotalKhr = grandKhr - discountKhr - oweKhr - otherKhr;
            const subTotalUsd = grandUsd - discountUsd - oweUsd - otherUsd;

            // ---- Update row fields ----
            const grandKhrInput = row.querySelector(`input[name="invoiceDetails[${i}].GrandTotalKhr"]`);
            const grandUsdInput = row.querySelector(`input[name="invoiceDetails[${i}].GrandTotalUsd"]`);
            const discountKhrInput = row.querySelector(`input[name="invoiceDetails[${i}].DiscountKhr"]`);
            const discountUsdInput = row.querySelector(`input[name="invoiceDetails[${i}].DiscountUsd"]`);
            const totalKhrInput = row.querySelector(`input[name="invoiceDetails[${i}].TotalKhr"]`);
            const totalUsdInput = row.querySelector(`input[name="invoiceDetails[${i}].TotalUsd"]`);
            if (grandKhrInput) grandKhrInput.value = grandKhr.toFixed(0);
            if (grandUsdInput) grandUsdInput.value = grandUsd.toFixed(2);
            if (discountKhrInput) discountKhrInput.value = discountKhr.toFixed(0);
            if (discountUsdInput) discountUsdInput.value = discountUsd.toFixed(2);
            if (totalKhrInput) totalKhrInput.value = subTotalKhr.toFixed(0);
            if (totalUsdInput) totalUsdInput.value = subTotalUsd.toFixed(2);

            // ---- Add to summary totals ----
            grandTotalKhr += grandKhr;
            grandTotalUsd += grandUsd;
            totalDiscountKhr += discountKhr;
            totalDiscountUsd += discountUsd;
            totalOweKhr += oweKhr;
            totalOweUsd += oweUsd;
            totalOtherKhr += otherKhr;
            totalOtherUsd += otherUsd;
            totalKhr +=subTotalKhr;
            totalUsd +=subTotalUsd
            totalPayKhr += payKhr;
            totalPayUsd += payUsd;
            invoiceVat = Math.max(invoiceVat, vat);
        });
        $("#invoice_Vat").val(invoiceVat);
        $("#invoice_GrandTotalKhr").val(grandTotalKhr);
        $("#invoice_TotalDiscountKhr").val(totalDiscountKhr);
        $("#invoice_OweKhr").val(totalOweKhr);
        $("#invoice_TotalOtherKhr").val(totalOtherKhr);
        $("#invoice_TotalRiel").val(totalKhr);
        $("#invoice_TotalPayKhr").val(totalPayKhr);

        $("#invoice_GrandTotalUsd").val(grandTotalUsd);
        $("#invoice_TotalDiscountUsd").val(totalDiscountUsd);
        $("#invoice_OweUsd").val(totalOweUsd);
        $("#invoice_TotalOtherUsd").val(totalOtherUsd);
        $("#invoice_TotalDollar").val(totalUsd);
        $("#invoice_TotalPayUsd").val(totalPayUsd);
    }
    btnClosePayment.on('click', function () {
        modalPayment.modal("hide");
    });
    btnCloseProduct.on("click", function () {
        modalProduct.modal("hide");
        stateSelect.val('');
    })
</script>
}
