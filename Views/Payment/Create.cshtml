    tblInvoiceDetail.on('input', 'input[name*=".Qty"]', function (e) {
        const row = e.target.closest('tr');
        const index = row.rowIndex - 1;
        row.querySelector(`input[name="invoiceDetails[${index}].DiscountPercent"]`).value = 0;
        row.querySelector(`input[name="invoiceDetails[${index}].DiscountKhr"]`).value = 0;
        row.querySelector(`input[name="invoiceDetails[${index}].DiscountUsd"]`).value = 0;
        row.querySelector(`input[name="invoiceDetails[${index}].OweKhr"]`).value = 0;
        row.querySelector(`input[name="invoiceDetails[${index}].OweUsd"]`).value = 0;
        row.querySelector(`input[name="invoiceDetails[${index}].OtherKhr"]`).value = 0;
        row.querySelector(`input[name="invoiceDetails[${index}].OtherUsd"]`).value = 0;

        // Get and validate Qty
        const qtyInput = row.querySelector(`input[name="invoiceDetails[${index}].Qty"]`);
        if (qtyInput.value.trim() === "") {
            qtyInput.value = 1;
        }

        const qty = parseFloat(qtyInput.value);
        if (isNotValid(qty)) return;

        const priceKhr = parseFloat(row.querySelector(`input[name="invoiceDetails[${index}].PriceKhr"]`).value);
        const priceUsd = parseFloat(row.querySelector(`input[name="invoiceDetails[${index}].PriceUsd"]`).value);

        const grandTotalKhr = (qty * priceKhr).toFixed(0);
        const grandTotalUsd = (qty * priceUsd).toFixed(2);

        row.querySelector(`input[name="invoiceDetails[${index}].GrandTotalKhr"]`).value = grandTotalKhr;
        row.querySelector(`input[name="invoiceDetails[${index}].GrandTotalUsd"]`).value = grandTotalUsd;

        row.querySelector(`input[name="invoiceDetails[${index}].TotalKhr"]`).value = grandTotalKhr;
        row.querySelector(`input[name="invoiceDetails[${index}].TotalUsd"]`).value = grandTotalUsd;

        row.querySelector(`input[name="invoiceDetails[${index}].PayKhr"]`).value = grandTotalKhr;
        row.querySelector(`input[name="invoiceDetails[${index}].PayUsd"]`).value = grandTotalUsd;
    });

    tblInvoiceDetail.on('input', 'input[name*=".DiscountPercent"]', function (e) {
        const row = e.target.closest('tr');
        const index = row.rowIndex - 1;

        row.querySelector(`input[name="invoiceDetails[${index}].OweKhr"]`).value = 0;
        row.querySelector(`input[name="invoiceDetails[${index}].OweUsd"]`).value = 0;
        row.querySelector(`input[name="invoiceDetails[${index}].OtherKhr"]`).value = 0;
        row.querySelector(`input[name="invoiceDetails[${index}].OtherUsd"]`).value = 0;

        const input = row.querySelector(`input[name="invoiceDetails[${index}].DiscountPercent"]`);
        if (input.value.trim() === "") {
            input.value = 0;
        }

        const discountPercent = parseFloat(input.value);
        if(isNotValid(discountPercent)) return;

        const grandTotalKhr = parseFloat(row.querySelector(`input[name="invoiceDetails[${index}].GrandTotalKhr"]`).value);
        const grandTotalUsd = parseFloat(row.querySelector(`input[name="invoiceDetails[${index}].GrandTotalUsd"]`).value);

        if(isNotValid(grandTotalKhr) || isNotValid(grandTotalUsd)) return;

        const totalDiscountKhr = (grandTotalKhr * discountPercent) / 100;
        const totalDiscountUsd = (grandTotalUsd * discountPercent) / 100;

        const totalKhr = grandTotalKhr - totalDiscountKhr;
        const totalUsd = grandTotalUsd - totalDiscountUsd;

        row.querySelector(`input[name="invoiceDetails[${index}].DiscountKhr"]`).value = totalDiscountKhr.toFixed(0);
        row.querySelector(`input[name="invoiceDetails[${index}].DiscountUsd"]`).value = totalDiscountUsd.toFixed(2);

        row.querySelector(`input[name="invoiceDetails[${index}].TotalKhr"]`).value = totalKhr.toFixed(0);
        row.querySelector(`input[name="invoiceDetails[${index}].TotalUsd"]`).value = totalUsd.toFixed(2);

        row.querySelector(`input[name="invoiceDetails[${index}].PayKhr"]`).value = totalKhr.toFixed(0);
        row.querySelector(`input[name="invoiceDetails[${index}].PayUsd"]`).value = totalUsd.toFixed(2);
    });

    tblInvoiceDetail.on('input', 'input[name*=".OweKhr"]', function (e) {
