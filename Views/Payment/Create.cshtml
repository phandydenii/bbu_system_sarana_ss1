@model BBU_SYSTEM.ViewModel.PaymentViewModel
@using BBU_SYSTEM.DTOs
@using BBU_SYSTEM.Models.Req
@{
    ViewData["OpenMenu"] = "Administration";
    ViewData["Action"] = "Create";
    var student = new Student();
    var degree = new Degree();
    var school = new School();
    var field = new Field();
    var promotion = new Promotion();
    var stage = new Stage();
    var term = new Term();
    var product = new Product();
    var group = new GroupDto();
    var groupRoom = new GroupRoomDto();
    var invoice = new InvoiceDto();
}

<form id="paymentForm" method="post">
    <div class="card">
        <div class="card-header">
            <label>Create Payment</label>
            <button id="btnCreateNewPayment" type="button" class="btn btn-primary float-right"><i
                    class="fa-solid fa-dollar-sign"></i>
                Create New Payment
            </button>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-5">
                    <div class="row">
                        <div class="col-3">
                            <label class="required">student_id</label>
                            <div class="input-group">
                                <input type="text" class="form-control form-control-sm " asp-for="@invoice.StudentId" readonly/>
                                <div class="input-group-append" style="cursor: pointer;" id="btnSearchStudent">
                                    <span class="input-group-text" style="background-color: green;"><i class="fa-solid fa-magnifying-glass" style="color: white;"></i></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-5">
                            <label>name</label>
                            <input type="text" class="form-control form-control-sm" asp-for="@student.StudentName" readonly/>
                        </div>
                        <div class="col-4">
                            <label>gender</label>
                            <input type="text" class="form-control form-control-sm" asp-for="@student.Sex" readonly/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-3">
                            <label>dob</label>
                            <input type="text" class="form-control form-control-sm" asp-for="@student.DateOfBirth" readonly>
                        </div>
                        <div class="col-5">
                            <label>name_khmer</label>
                            <input type="text" class="form-control form-control-sm" asp-for="@student.StudentNameInKhmer" readonly/>
                        </div>
                        <div class="col-4">
                            <label>phone</label>
                            <input type="text" class="form-control form-control-sm" asp-for="@student.Phone" readonly/>
                        </div>
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="row">
                        <div class="col-2">
                            <label>degree</label>
                            <input type="text" class="form-control form-control-sm" asp-for="@invoice.DegreeId" readonly>
                        </div>
                        <div class="col-4">
                            <label>school</label>
                            <input type="text" class="form-control form-control-sm" asp-for="@invoice.SchoolId" readonly>
                        </div>
                        <div class="col-4">
                            <label>field</label>
                            <input type="text" class="form-control form-control-sm" asp-for="@invoice.FieldId" readonly>
                        </div>
                        <div class="col-2">
                            <label>promotion</label>
                            <input type="text" class="form-control form-control-sm" asp-for="@invoice.PromotionId" readonly>
                        </div>
                    </div>
                    <div class="row">
                        
                        <div class="col-2">
                            <label>stage</label>
                            <input type="number" class="form-control form-control-sm" asp-for="@invoice.StageId" readonly>
                        </div>
                        <div class="col-2">
                            <label>term</label>
                            <input type="number" class="form-control form-control-sm" asp-for="@invoice.TermNo" readonly>
                        </div>
                        <div class="col-2">
                            <label>group</label>
                            <input type="text" class="form-control form-control-sm" asp-for="@invoice.GroupId" readonly>
                        </div>
                        @* <div class="col-2"> *@
                            @* <label>room</label> *@
                            <input type="hidden" class="form-control form-control-sm" asp-for="@groupRoom.RoomName" readonly>
                        @* </div> *@
                        <div class="col-2">
                            <label>study_time</label>
                            <input type="text" class="form-control form-control-sm" asp-for="@group.StudyTime" readonly>
                        </div>
                        <div class="col-2">
                            <label>start_date</label> 
                            <input type="text" class="form-control form-control-sm" asp-for="@invoice.StartDate" readonly>
                        </div>
                        <div class="col-2">
                            <label>end_date</label>
                            <input type="text" class="form-control form-control-sm" asp-for="@invoice.EndDate" readonly>
                        </div>
                    </div> 
                </div>
            </div>
            <hr>
            <table id="tblInvoice" class="table table-sm table-bordered table-striped" style="width: 100%;">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>no</th>
                    <th>invoice_date</th>
                    <th>term</th>
                    <th>grand_total</th>
                    <th>discount</th>
                    <th>vat</th>
                    <th>owe</th>
                    <th>total_pay</th>
                    <th>pay_khr</th>
                    <th>pay_usd</th>
                    <th>action</th>
                </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</form>
<partial name="_PaymentModal"/>
<partial name="_StudentModal"/>
<script src="/AdminLTE/plugins/jquery/jquery.min.js"></script>
<script src="/AdminLTE/plugins/select2/js/select2.full.min.js"></script>

@section Scripts
{
    <script src="~/js/Alert.js"></script>
    <script src="~/function/Product.js"></script>
    <script>
        const btnSearchStudent = $("#btnSearchStudent");
        const btnCreateNewPayment = $("#btnCreateNewPayment");
        const tblSearchStudent = $("#tblSearchStudent");
        const btnSavePayment = $("#btnSavePayment");
        const btnNewItem = $("#btnNewItem");
        const tblInvoice = $("#tblInvoice");
        const tblInvoiceDetail = $("#tblInvoiceDetail");
        const btnSelectItem = $("#btnSelectItem");
        const tblProduct = $("#tblProduct");
        const btnSelect = $("#btnSelect");
        const btnAssignProduct = $("#btnAssignProduct");
        const btnCloseProduct = $("#btnCloseProduct");
        const btnClosePayment = $("#btnClosePayment");
        const stateSelect = $("#stateSelect");

        const modalPayment = $("#PaymentModal");
        const modalStudent = $("#StudentModal");
        const modalProduct = $("#ProductModal");
        const formPayment = $("#PaymentForm");

        const txtRateIn = $("#txtRateIn");
        const txtRateOut = $("#txtRateOut");

        $(document).ready(function () {
            document.getElementById("btnCreateNewPayment").disabled = true;
            tblInvoice.DataTable();
            GetExchangeRate();
        });

        //1=====Search Student====
        btnSearchStudent.on("click", function (e) {
            e.preventDefault();
            tblSearchStudent.DataTable().clear().destroy();
            tblSearchStudent.DataTable({
                processing: true,
                serverSide: true,
                paging: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                responsive: true,
                autoWidth: true,
                scrollCollapse: true,
                ajax: {
                    url: "/student/academic/student-list/all",
                    type: "POST",
                    error: function (error) {
                        console.log(error.responseText);
                    }
                },
                columns: [
                    {data: "studentId"},
                    {data: "studentName"},
                    {data: "studentNameInKhmer"},
                    {data: "sex"},
                    {
                        data: null,
                        render: function (data, type, row) {
                            if (row.status === "REGISTER") {
                                return ` <span class="badge badge-warning">${row.status}</span>`;
                            } else if (row.status === "ACTIVE") {
                                return ` <span class="badge badge-primary">${row.status}</span>`;
                            } else if (row.status === "QUIT") {
                                return ` <span class="badge badge-danger">${row.status}</span>`;
                            } else {
                                return `<span class="badge badge-secondary">${row.status}</span>`;
                            }
                        },
                    },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `<a id="btnSelectStudent" class="btn btn-success btn-xs btn-block">Select</a>`;
                        },
                    },
                ],
                initComplete: function () {
                    MyApp.utils.dataTableDebounceSearch("#tblSearchStudent", 500);
                }
            });
            modalStudent.modal("show"); 
        })

        //2====Select Student====
        tblSearchStudent.on("click", "#btnSelectStudent", function () { 
            const $row = $(this).closest('tr'); 
            const selectedRow = tblSearchStudent.DataTable().row($row).data(); 
            if (selectedRow) {
                document.getElementById("btnCreateNewPayment").disabled = false;
                getStudent(selectedRow.studentId);
                getInvoice(selectedRow.studentId);
                modalStudent.modal("hide");
            } 
        });

        function getStudent(student_id) {
            $.ajax({
                url: "/student/academic/student-id/" + student_id,
                type: "GET",
                data: {student_id: student_id},
                success: function (data) {
                    if (data) { 
                        data = data.data;
                        const student = data["student"];
                        console.log(student);
                        const degree = data["degree"];
                        const school = data["school"];
                        const field = data["field"];
                        const promotion = data["promotion"];
                        const stage = data["stage"];
                        const term = data["term"];
                        const group = data["group"];
                        const groupRoom = data["groupRoom"];
                        const registry = data["registry"];
                        $("#invoice_StudentId").val(student.studentId);
                        $("#student_StudentName").val(`${student.studentName}`);
                        $("#student_StudentNameInKhmer").val(`${student.studentNameInKhmer}`);
                        $("#student_Sex").val(student.sex);
                        $("#student_Phone").val(student.phone);
                        $("#student_DateOfBirth").val(formatDate(student.dateOfBirth, "DD-MMM-YYYY"));
                        $("#invoice_DegreeId").val(degree.degreeName);
                        $("#invoice_SchoolId").val(school.schoolName);

                        $("#invoice_FieldId").val(field.fieldName);
                        if (student.status !== "REGISTER") {
                            $("#invoice_PromotionId").val(promotion.promotionNo);
                            $("#invoice_StageId").val(stage.stageNo);

                            $("#invoice_TermNo").val(term.termNo);
                            $("#group_StudyTime").val(group.studyTime);
                            $("#invoice_StartDate").val(formatDate(term.startDate, "DD-MMM-YYYY"));
                            $("#invoice_EndDate").val(formatDate(term.endDate, "DD-MMM-YYYY"));
                            $("#invoice_GroupId").val(group.groupName);
                            if (groupRoom) {
                                $("#groupRoom_RoomName").val(groupRoom.roomName ?? "");
                            }
                        } else if (student.status === "REGISTER") {
                            $("#invoice_PromotionId").val(registry.promotionNo);
                            $("#invoice_StageId").val(registry.stageNo);
                            $("#invoice_TermNo").val(registry.termNo);
                            $("#group_StudyTime").val(registry.studyTime);
                            $("#invoice_StartDate").val("");
                            $("#invoice_enddate").val("");
                            $("#invoice_EndDate").val("");
                            $("#groupRoom_RoomName").val("");
                        }
                    } else {
                        alert("Student not found.");
                    }
                },
                error: function () {
                    alert("Error fetching student data.");
                }
            });
        }

        function getInvoice(student_id) {
            tblInvoice.DataTable().clear().destroy();
            tblInvoice.DataTable({
                processing: true,
                serverSide: true,
                paging: true,
                lengthChange: true,
                searching: false,
                ordering: false,
                info: false,
                responsive: true,
                autoWidth: true,
                ajax: {
                    url: "/invoice/get-invoice-by-student-id",
                    type: "POST",
                    data: function (d) {
                        d.studentId = student_id;
                    },
                    error: function (xhr, status, error) {
                        console.log(xhr.responseText);
                    }
                },
                columns: [
                    {data: "invoiceId"},
                    {
                        data: null,
                        render: function (data, type, row) {
                            const invoiceId = row.invoiceId ?? 0;
                            const invoiceNo = row.invoiceNo ?? 0;
                            const year = row.yearNumber ?? 0
                            return invoiceNo > 0 ? `${invoiceNo}/${year}` : `${invoiceId}/${formatDate(row.invoiceDate, "YYYY")}`
                        }
                    },
                    {
                        data: null,
                        render: function (data, type, row) {
                            const dt = formatDate(row.invoiceDate, "DD-MMM-YYYY");
                            return `${dt}`
                        }
                    },
                    {data: "termNo"},
                    {
                        data: null,
                        render: function (data, type, row) {
                            const dt = formatDate(row.invoiceDate, "DD-MMM-YYYY");
                            return row.grandTotalUsd ? `<button type="button" class="btn btn-warning btn-sm btn-block">${row.grandTotalUsd} $</button>`
                                : `<button type="button" class="btn btn-success btn-sm btn-block">${row.grandTotalKhr} R</button>`;
                        }
                    },
                    {
                        data: "totalDiscountUsd"
                    },
                    {data: "vat"},
                    {
                        data: null,
                        render: function (data, type, row) {
                            return row.owe > 0 ?
                                row.owe ?
                                    `<button type="button" class="btn btn-danger btn-sm btn-block">${row.oweUsd}$</button>`
                                    : `<button type="button" class="btn btn-default btn-sm btn-block">0 $</button>`
                                : row.oweKhr ?
                                    `<button type="button" class="btn btn-danger btn-sm btn-block">${row.oweKhr} R</button>`
                                    : `<button type="button" class="btn btn-default btn-sm btn-block">0 R</button>`;
                        }
                    },
                    {
                        //total
                        data: null,
                        render: function (data, type, row) {
                            return row.totalRiel > 0 ? `<button type="button" class="btn btn-info btn-sm btn-block">${parseFloat(row.totalRiel).toFixed(0)} R</button>`
                                : `<button type="button" class="btn btn-info btn-sm btn-block">${parseFloat(row.totalDollar).toFixed(0)} $</button>`;
                        }
                    },
                    {
                        //==total pay r
                        data: null,
                        render: function (data, type, row) {
                            return `<button type="button" class="btn btn-default btn-sm btn-block">${parseFloat(row.totalRiel).toFixed(0)} R</button>`;
                        }
                    },
                    {
                        //==total pay $
                        data: null,
                        render: function (data, type, row) {
                            return `<button type="button" class="btn btn-default btn-sm btn-block">${parseFloat(row.totalDollar).toFixed(2)} $</button>`;
                        }
                    },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `
                                <div class="input-group-prepend">
                                    <button type="button" class="btn btn-primary dropdown-toggle btn-sm" data-toggle="dropdown">
                                        Action
                                    </button>
                                        <div class="dropdown-menu dropdown-menu-right" style="min-width: 8rem;">
                                        <div class="col-md-12">
                                            <a class="btn btn-success btn-sm" style="display: block;margin:.2rem 0"><i class='fas fa-edit'></i> Edit</a>
                                            ${row.owe <= 0 ?
                                `<a class="btn btn-warning btn-sm" style="display: block;margin:.2rem 0">Change Student</a>` :
                                `<a class="btn btn-warning btn-sm" style="display: block;margin:.2rem 0">Return</a>`
                            }
                                            <a class="btn btn-danger btn-sm" style="display: block;margin:.2rem 0"><i class="fa-solid fa-trash"></i> Delete</a>
                                        </div>
                                    </div>
                                </div>
                            `;
                        }
                    }
                ]
            });
        }

        ///3=====Create New Payment
        btnCreateNewPayment.on("click", function (e) {
            modalPayment.modal("show");
            formPayment[0].reset();
            tblInvoiceDetail.DataTable().clear().destroy();
            showEmptyInvoiceDetail();
            btnSavePayment.prop("disabled", true);
            setPaymentFullscreen(true); 
        })
        function showEmptyInvoiceDetail() {
            const totalColumns = $("#tblInvoiceDetail thead th").length; 
            $("#tblInvoiceDetail tbody").html(`
                <tr id="emptyInvoiceDetailRow">
                    <td colspan="${totalColumns}" class="text-center text-muted py-4">
                        <i class="fa-solid fa-circle-info mr-1"></i>
                        No item selected. Click <strong>Select Item</strong> to add payment item.
                    </td>
                </tr>
            `);
        }
        function removeEmptyInvoiceDetail() {
            $("#emptyInvoiceDetailRow").remove();
        }
        async function GetExchangeRate() { 
            try {
                const response = await $.ajax({
                    url: `/exchange-rates/get-exchange-rates`,
                    method: 'POST',
                    data: {isAll: true}
                });
                if (response.status.code === "200") {
                    const data = response.data;
                    $("#invoice_ExchangeRateId").val(data.exchangeRateId);
                    txtRateIn.text(data.rateIn);
                    txtRateOut.text(data.rateOut)
                } 
            } catch (error) {
                console.log(error.responseText);
            } 
        }

        function GetInvoiceDetail(invoice_id) {
            tblInvoiceDetail.DataTable().clear().destroy();
            $.ajax({
                url: "/invoice/get-invoice-detail/" + invoice_id,
                type: 'GET',
                dataType: 'json',
                success: function (data) {
                    data.forEach(item => {
                        let list_data = [
                            item.invoiceDetailId, //0
                            item.invoiceId, //1
                            item.productId, //2
                            item.productName, //3
                            item.productNameKhmer, //4
                            item.qty, //5
                            item.priceKhr, //6
                            item.priceUsd, //7
                            item.totalKhr, //8
                            item.totalUsd, //9
                            item.type, //10
                            item.vat, //11
                            item.discountPercent, //12
                            item.discountKhr, //13
                            item.discountUsd, //14
                            item.oweKhr, //15
                            item.oweUsd, //16
                            item.otherKhr, //17
                            item.otherUsd, //18
                            item.grandTotalKhr, //19
                            item.grandTotalUsd, //20
                            item.payKhr, //21
                            item.payUsd, //22
                            item.payBath, //23
                            item.tuitionFees, //24
                            item.cardCertificate, //25
                            item.categoryId, //26

                        ];

                        AddItemPayment(list_data);
                    });
                },
                error: function (xhr, status, error) {
                    console.error('AJAX Error:', error);
                }
            });
        }

        btnSavePayment.on("submit", function (e) {
            e.preventDefault();
            const form = $(this);
            const formData = form.serialize();
            $.ajax({
                url: '/invoice/create-payment',
                method: 'POST',
                data: formData,
                success: function (response) {
                    if (response.status.code === "200") {
                        ShowToastSuccess(response.status.message);
                        tblInvoice.DataTable().ajax.reload();
                        tblInvoiceDetail.DataTable().clear().destroy();
                    } else {
                        ShowToastError(response.status.message);
                    }
                },
                error: function (error) {
                    if (error.responseJSON && error.responseJSON.message) {
                        ShowToastError(error.responseJSON.message);
                    }
                }
            });
        })


        //========Payment Modal=====
        btnSelectItem.on("click", function (e) {
            e.preventDefault();
            tblProduct.DataTable().clear().destroy();
            tblProduct.DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: "/product/get-product-list",
                    type: "POST",
                },
                columns: [
                    {data: "productId"},
                    {data: "productName"},
                    {data: "productNameInKhmer", className: "hide-col"},
                    {data: "priceKhr"},
                    {data: "price"},
                    {data: "degreeId", className: "hide-col"},
                    {data: "vat", className: "hide-col"},
                    {data: "type", className: "hide-col"},
                    {data: "categoryId", className: "hide-col"},
                    {data: "cardCertificate", className: "hide-col"},
                    {data: "tuitionFees", className: "hide-col"},
                    {data: "status", className: "hide-col"},
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `<a class="btn btn-primary btn-xs btn-block" id="btnSelect">Select</a>`;
                        }
                    }
                ],
                initComplete:function (){
                    MyApp.utils.dataTableDebounceSearch("#tblProduct",500);
                }
            });
            modalProduct.modal("show");
        })

        //select product payment
        tblProduct.on("click", "#btnSelect", function () {
            const $row = $(this).closest('tr');
            const data = tblProduct.DataTable().row($row).data();
            if (data) {
                const text = `${data.productId}-${data.productName}-${data.price}`;
                if ($('#stateSelect option[value="' + data.productId + '"]').length === 0) {
                    const newOption = new Option(text, data.productId, true, true);
                    $('#stateSelect').append(newOption).trigger('change');
                }
            }
        });

        //====Assign Product===
        btnAssignProduct.on("click", async function () { 
            const ids = stateSelect.val(); 
            if (!ids || ids.length === 0) return;
            try {
                const response = await $.ajax({
                    url: `/product/get-product-list`,
                    method: 'POST',
                    data: {isAll: true}
                });
                if (response.status.code === "200" && response.data && response.data.length > 0) {
                    const data = await response.data; 
                    ids.forEach(productIdStr => {
                        const productId = parseInt(productIdStr);
                        const row = data.find(item => item.productId === productId); // get single product object
                        if (!row) return;

                        const isPayKhr = row.paymentType ?? false;
                        const isPayUsd = !isPayKhr;

                        const list_data = [
                            0, // invoice_detail_id
                            0, // invoice_id
                            row.productId,
                            row.productName,
                            row.productNameInKhmer,
                            1, // qty
                            isPayKhr ? row.priceKhr : 0,
                            isPayUsd ? row.price : 0,
                            isPayKhr ? row.priceKhr : 0,
                            isPayUsd ? row.price : 0,
                            row.type,
                            row.vat,
                            0, 0, 0, 0, 0, 0, 0,
                            isPayKhr ? row.priceKhr : 0,
                            isPayUsd ? row.price : 0,
                            isPayKhr ? row.priceKhr : 0,
                            isPayUsd ? row.price : 0,
                            0,
                            row.tuitionFees,
                            row.cardCertificate,
                            row.categoryId,
                            isPayKhr
                        ];
                        AddItemPayment(list_data);
                    });
                }
            } catch (err) {
                console.error("Failed to fetch product list:", err);
            }
            stateSelect.innerHTML = "";
            stateSelect.val('').trigger('change');
            modalProduct.modal("hide");
            btnSavePayment.prop("disabled", false); 
        })

        function AddItemPayment(params) {
            removeEmptyInvoiceDetail();
            const tableBody = document.querySelector('#tblInvoiceDetail tbody');
            let i = document.querySelectorAll('#tblInvoiceDetail tbody tr').length;
            const row = document.createElement('tr');
            row.innerHTML = `
                <td class="hide-col"><input type="text" name="invoiceDetails[${i}].InvoiceDetailId" value="${params[0]}" /></td>
                <td class="hide-col"><input type="text" name="invoiceDetails[${i}].InvoiceId" value="${params[1]}" /></td>
                <td class="hide-col"><input type="text" name="invoiceDetails[${i}].ProductId" value="${params[2]}" /></td>
                <td>${params[2]}-${params[3]}-${params[27] ? `<badge class="badge badge-info">KHR</badge>`:`<badge class="badge badge-success">USD</badge>`}</td>
                <td class="hide-col">${params[4]}</td>
                <td> 
                    <input type="number" name="invoiceDetails[${i}].Qty" value="${params[5]}" class="form-control form-control-sm"  min="1"/>
                </td>
                <td>
                    <div class="input-group input-group-sm">
                        <input type="${params[27] ? "number" : "hidden" }" name="invoiceDetails[${i}].PriceKhr" value="${params[6]}" class="form-control form-control-sm"
                           readonly/>
                        <input type="${params[27] ? "hidden" : "number" }" name="invoiceDetails[${i}].PriceUsd" value="${params[7]}" class="form-control form-control-sm"
                           readonly/>
                        <div class="input-group-append"> 
                            <span class="input-group-text">${params[27] ? "៛" : "$"}</span>
                        </div>
                    </div>
                </td>
                <td class="hide-col"> 
                    <input type="number" name="invoiceDetails[${i}].TotalKhr" value="${params[8]}" class="form-control form-control-sm"  readonly/>
                </td>
                <td class="hide-col"> 
                    <input type="number" name="invoiceDetails[${i}].TotalUsd" value="${params[9]}" class="form-control form-control-sm"  readonly/>
                </td>
                <td class="hide-col"> 
                    <input type="number" name="invoiceDetails[${i}].Type" value="${params[10]}" class="form-control form-control-sm"  readonly/>
