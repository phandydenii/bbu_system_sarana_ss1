    //====Assign Product===
    btnAssignProduct.on("click", async function () {
        const ids = stateSelect.val();
        if (!ids || ids.length === 0) return;
        try {
            const response = await $.ajax({
                url: `/product/get-product-list`,
                method: 'POST',
                data: {isAll: true}
            });
            if (response.status.code === "200" && response.data && response.data.length > 0) {
                const data = await response.data;
                ids.forEach(productIdStr => {
                    const productId = parseInt(productIdStr);
                    const row = data.find(item => item.productId === productId); // get single product object
                    if (!row) return;

                    const isPayKhr = row.paymentType ?? false;
                    const isPayUsd = !isPayKhr;

                    const list_data = [
                        0, // invoice_detail_id
                        0, // invoice_id
                        row.productId,
                        row.productName,
                        row.productNameInKhmer,
                        1, // qty
                        isPayKhr ? row.priceKhr : 0,
                        isPayUsd ? row.price : 0,
                        isPayKhr ? row.priceKhr : 0,
                        isPayUsd ? row.price : 0,
                        row.type,
                        row.vat,
                        0, 0, 0, 0, 0, 0, 0,
                        isPayKhr ? row.priceKhr : 0,
                        isPayUsd ? row.price : 0,
                        isPayKhr ? row.priceKhr : 0,
                        isPayUsd ? row.price : 0,
                        0,
                        row.tuitionFees,
                        row.cardCertificate,
                        row.categoryId,
                        isPayKhr
                    ];
                    AddItemPayment(list_data);
                });
            }
        } catch (err) {
            console.error("Failed to fetch product list:", err);
