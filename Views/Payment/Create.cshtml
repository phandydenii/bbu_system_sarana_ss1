@model BBU_SYSTEM.ViewModel.PaymentViewModel
@using BBU_SYSTEM.DTOs
@using System.Text.Json
@{
ViewData["OpenMenu"] = "Administration";
ViewData["Action"] = "Create";
var student = new Student();
var degree = new Degree();
var school = new School();
var field = new Field();
var promotion = new Promotion();
var stage = new Stage();
var term = new Term();
var product = new Product();
var group = new GroupDto();
var groupRoom = new GroupRoomDto();
var invoice = new InvoiceDto();
}

<style>
    #tblInvoiceDetail .item-action-buttons {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .35rem;
        white-space: nowrap;
    }

    #btnSavePayment.is-saving {
        cursor: wait;
        opacity: .9;
    }

    #btnSavePayment.is-saving .saving-spinner {
        display: inline-block;
        margin-right: .35rem;
    }
</style>

<form id="paymentForm" method="post">
    @Html.AntiForgeryToken()
    <div class="card">
        <div class="card-header">
            <label>Create Payment</label>
            <button id="btnCreateNewPayment" type="button" class="btn btn-primary float-right"><i
                    class="fa-solid fa-dollar-sign"></i>
                Create New Payment
            </button>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-5">
                    <div class="row">
                        <div class="col-3">
                            <label class="required">student_id</label>
                            <div class="input-group">
                                <input type="text"
                                       id="selectedStudentId"
                                       name="selectedStudentId"
                                       class="form-control form-control-sm"
                                       readonly/>
                                <div class="input-group-append" style="cursor: pointer;" id="btnSearchStudent">
                                    <span class="input-group-text" style="background-color: green;"><i class="fa-solid fa-magnifying-glass" style="color: white;"></i></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-5">
                            <label>name</label>
                            <input type="text" class="form-control form-control-sm" asp-for="@student.StudentName" readonly/>
                        </div>
                        <div class="col-4">
                            <label>gender</label>
                            <input type="text" class="form-control form-control-sm" asp-for="@student.Sex" readonly/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-3">
                            <label>dob</label>
                            <input type="text" class="form-control form-control-sm" asp-for="@student.DateOfBirth" readonly>
                        </div>
                        <div class="col-5">
                            <label>name_khmer</label>
                            <input type="text" class="form-control form-control-sm" asp-for="@student.StudentNameInKhmer" readonly/>
                        </div>
                        <div class="col-4">
                            <label>phone</label>
                            <input type="text" class="form-control form-control-sm" asp-for="@student.Phone" readonly/>
                        </div>
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="row">
                        <div class="col-2">
                            <label>degree</label>
                            <input type="text" id="displayDegreeName" class="form-control form-control-sm" readonly>
                        </div>
                        <div class="col-4">
                            <label>school</label>
                            <input type="text" id="displaySchoolName" class="form-control form-control-sm" readonly>
                        </div>
                        <div class="col-4">
                            <label>field</label>
                            <input type="text" id="displayFieldName" class="form-control form-control-sm" readonly>
                        </div>
                        <div class="col-2">
                            <label>promotion</label>
                            <input type="text" id="displayPromotionNo" class="form-control form-control-sm" readonly>
                        </div>
                    </div>
                    <div class="row">

                        <div class="col-2">
                            <label>stage</label>
                            <input type="text" id="displayStageNo" class="form-control form-control-sm" readonly>
                        </div>
                        <div class="col-2">
                            <label>term</label>
                            <input type="text" id="displayTermNo" class="form-control form-control-sm" readonly>
                        </div>
                        <div class="col-2">
                            <label>group</label>
                            <input type="text" id="displayGroupName" class="form-control form-control-sm" readonly>
                        </div>
                        @* <div class="col-2"> *@
                        @* <label>room</label> *@
                        <input type="hidden" class="form-control form-control-sm" asp-for="@groupRoom.RoomName" readonly>
                        @* </div> *@
                        <div class="col-2">
                            <label>study_time</label>
                            <input type="text" class="form-control form-control-sm" asp-for="@group.StudyTime" readonly>
                        </div>
                        <div class="col-2">
                            <label>start_date</label>
                            <input type="text" id="displayStartDate" class="form-control form-control-sm" readonly>
                        </div>
                        <div class="col-2">
                            <label>end_date</label>
                            <input type="text" id="displayEndDate" class="form-control form-control-sm" readonly>
                        </div>
                    </div>
                </div>
            </div>
            <hr>
            <table id="tblInvoice" class="table table-sm table-bordered table-striped" style="width: 100%;">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>no</th>
                    <th>invoice_date</th>
                    <th>term</th>
                    <th>grand_total</th>
                    <th>discount</th>
                    <th>vat</th>
                    <th>owe</th>
                    <th>total_pay</th>
                    <th>pay_khr</th>
                    <th>pay_usd</th>
                    <th>action</th>
                </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</form>
<partial name="_PaymentModal"/>
<partial name="_StudentModal"/>
<script src="/AdminLTE/plugins/jquery/jquery.min.js"></script>
<script src="/AdminLTE/plugins/select2/js/select2.full.min.js"></script>

@section Scripts
{
<script src="~/js/Alert.js"></script>
<script src="~/function/Product.js"></script>
<script>
    const StudentStatusBadgeClasses = @Html.Raw(JsonSerializer.Serialize(ViewData["StudentStatusBadgeClasses"]));
    const StudentStatusDefaultBadgeClass = "@ViewData["StudentStatusDefaultBadgeClass"]";
    function renderStudentStatusBadge(status) {
        const badgeClass = StudentStatusBadgeClasses[status] || StudentStatusDefaultBadgeClass;
        return `<span class="badge ${badgeClass}">${status || ""}</span>`;
    }
</script>
<script>
    const btnSearchStudent = $("#btnSearchStudent");
    const btnCreateNewPayment = $("#btnCreateNewPayment");
    const tblSearchStudent = $("#tblSearchStudent");
    const btnSavePayment = $("#btnSavePayment");
    const btnNewItem = $("#btnNewItem");
    const tblInvoice = $("#tblInvoice");
    const tblInvoiceDetail = $("#tblInvoiceDetail");
    const btnSelectItem = $("#btnSelectItem");
    const tblProduct = $("#tblProduct");
    const btnSelect = $("#btnSelect");
    const btnAssignProduct = $("#btnAssignProduct");
    const btnCloseProduct = $("#btnCloseProduct");
    const btnClosePayment = $("#btnClosePayment");
    const stateSelect = $("#stateSelect");

    const modalPayment = $("#PaymentModal");
    const modalStudent = $("#StudentModal");
    const modalProduct = $("#ProductModal");
    // _PaymentModal should use PaymentForm. The fallback keeps the page
    // working if the partial still uses the older lowercase id.
    const formPayment = $("#PaymentForm").length
        ? $("#PaymentForm")
        : $("#paymentForm");

    const txtRateIn = $("#txtRateIn");
    const txtRateOut = $("#txtRateOut");
    let savePaymentRequest = null;
    let savePaymentButtonHtml = "";
    let selectedAcademic = {};
    let selectedExchangeRateId = "";

    $(document).ready(function () {
        formPayment.attr("novalidate", "novalidate");
        btnCreateNewPayment.prop("disabled", true);
        tblInvoice.DataTable();
        GetExchangeRate();
    });

    //1=====Search Student====
    btnSearchStudent.on("click", function (e) {
        e.preventDefault();
        tblSearchStudent.DataTable().clear().destroy();
        tblSearchStudent.DataTable({
            processing: true,
            serverSide: true,
            paging: true,
            lengthChange: true,
            searching: true,
            ordering: true,
            info: true,
            responsive: true,
            autoWidth: true,
            scrollCollapse: true,
            ajax: {
                url: "/student/academic/student-list/all",
                type: "POST",
                error: function (error) {
                    console.log(error.responseText);
                }
            },
            columns: [
                {data: "studentId"},
                {data: "studentName"},
                {data: "studentNameInKhmer"},
                {data: "sex"},
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    className: "text-center",
                    render: function (data, type, row) {
                        return renderStudentStatusBadge(row.status);
                    }
                },
                {
                    data: null,
                    render: function (data, type, row) {
                        return `<a id="btnSelectStudent" class="btn btn-success btn-xs btn-block">Select</a>`;
                    },
                },
            ],
            initComplete: function () {
                MyApp.utils.dataTableDebounceSearch("#tblSearchStudent", 500);
            }
        });
        modalStudent.modal("show");
    })

    //2====Select Student====
    tblSearchStudent.on("click", "#btnSelectStudent", function () {
        const $row = $(this).closest('tr');
        const selectedRow = tblSearchStudent.DataTable().row($row).data();
        if (selectedRow) {
            btnCreateNewPayment.prop("disabled", true);
            showLoading();
            getStudent(selectedRow.studentId);
            getInvoice(selectedRow.studentId);
            modalStudent.modal("hide");
        }
    });

    function getStudent(student_id) {
        return $.ajax({
            url: "/student/academic/student-id/" + student_id,
            type: "GET",
            data: {student_id: student_id},
            success: function (data) {
                if (data) {
                    data = data.data;
                    const student = data["student"];
                    console.log(student);
                    const degree = data["degree"];
                    const school = data["school"];
                    const field = data["field"];
                    const promotion = data["promotion"];
                    const stage = data["stage"];
                    const term = data["term"];
                    const group = data["group"];
                    const groupRoom = data["groupRoom"];
                    const registry = data["registry"];
                    $("#selectedStudentId").val(student.studentId ?? "");
                    $("#student_StudentName").val(`${student.studentName}`);
                    $("#student_StudentNameInKhmer").val(`${student.studentNameInKhmer}`);
                    $("#student_Sex").val(student.sex);
                    $("#student_Phone").val(student.phone);
                    $("#student_DateOfBirth").val(formatDate(student.dateOfBirth, "DD-MMM-YYYY"));
                    $("#displayDegreeName").val(degree?.degreeName ?? "");
                    $("#displaySchoolName").val(school?.schoolName ?? "");
                    $("#displayFieldName").val(field?.fieldName ?? "");

                    selectedAcademic = {
                        degreeId: degree?.degreeId ?? "",
                        schoolId: school?.schoolId ?? "",
                        fieldId: field?.fieldId ?? "",
                        promotionId: "",
                        stageId: "",
                        termNo: "",
                        groupId: "",
                        startDate: "",
                        endDate: ""
                    };

                    if (student.status !== "REGISTER") {
                        $("#displayPromotionNo").val(promotion?.promotionNo ?? "");
                        $("#displayStageNo").val(stage?.stageNo ?? "");
                        $("#displayTermNo").val(term?.termNo ?? "");
                        $("#group_StudyTime").val(group?.studyTime ?? "");
                        $("#displayStartDate").val(formatDate(term?.startDate, "DD-MMM-YYYY"));
                        $("#displayEndDate").val(formatDate(term?.endDate, "DD-MMM-YYYY"));
                        $("#displayGroupName").val(group?.groupName ?? "");

                        selectedAcademic.promotionId = promotion?.promotionId ?? "";
                        selectedAcademic.stageId = stage?.stageId ?? "";
                        selectedAcademic.termNo = term?.termNo ?? "";
                        selectedAcademic.groupId = group?.groupId ?? "";
                        selectedAcademic.startDate = term?.startDate ?? "";
                        selectedAcademic.endDate = term?.endDate ?? "";

                        if (groupRoom) {
                            $("#groupRoom_RoomName").val(groupRoom.roomName ?? "");
                        }
                    } else if (student.status === "REGISTER") {
                        $("#displayPromotionNo").val(registry?.promotionNo ?? "");
                        $("#displayStageNo").val(registry?.stageNo ?? "");
                        $("#displayTermNo").val(registry?.termNo ?? "");
                        $("#group_StudyTime").val(registry?.studyTime ?? "");
                        $("#displayStartDate").val("");
                        $("#displayEndDate").val("");
                        $("#displayGroupName").val(registry?.groupName ?? "");
                        $("#groupRoom_RoomName").val("");

                        selectedAcademic.promotionId =
                            registry?.promotionId ?? promotion?.promotionId ?? "";
                        selectedAcademic.stageId =
                            registry?.stageId ?? stage?.stageId ?? "";
                        selectedAcademic.termNo =
                            registry?.termNo ?? term?.termNo ?? "";
                        selectedAcademic.groupId =
                            registry?.groupId ?? group?.groupId ?? "";
                    }

                    applySelectedAcademicToPaymentForm();
                    btnCreateNewPayment.prop("disabled", false);
                } else {
                    alert("Student not found.");
                }
            },
            error: function () {
                btnCreateNewPayment.prop("disabled", true);
                alert("Error fetching student data.");
            },
            complete: function () {
                hideLoading(1);
            }
        });
    }

    function applySelectedAcademicToPaymentForm() {
        const values = {
            "invoice.DegreeId": selectedAcademic.degreeId,
            "invoice.SchoolId": selectedAcademic.schoolId,
            "invoice.FieldId": selectedAcademic.fieldId,
            "invoice.PromotionId": selectedAcademic.promotionId,
            "invoice.StageId": selectedAcademic.stageId,
            "invoice.TermNo": selectedAcademic.termNo,
            "invoice.GroupId": selectedAcademic.groupId,
            "invoice.StartDate": selectedAcademic.startDate,
            "invoice.EndDate": selectedAcademic.endDate,
            "invoice.ExchangeRateId": selectedExchangeRateId
        };

        Object.entries(values).forEach(([name, value]) => {
            formPayment
                .find(`[name='${name}']`)
                .val(value ?? "");
        });
    }

    function getInvoice(student_id) {
        tblInvoice.DataTable().clear().destroy();
        tblInvoice.DataTable({
            processing: true,
            serverSide: true,
            paging: true,
            lengthChange: true,
            searching: false,
            ordering: false,
            info: false,
            responsive: true,
            autoWidth: true,
            ajax: {
                url: "/invoice/get-invoice-by-student-id",
                type: "POST",
                data: function (d) {
                    d.studentId = student_id;
                },
                error: function (xhr, status, error) {
                    console.log(xhr.responseText);
                }
            },
            columns: [
                {data: "invoiceId"},
                {
                    data: null,
                    render: function (data, type, row) {
                        const invoiceId = row.invoiceId ?? 0;
                        const invoiceNo = row.invoiceNo ?? 0;
                        const year = row.yearNumber ?? 0
                        return invoiceNo > 0 ? `${invoiceNo}/${year}` : `${invoiceId}/${formatDate(row.invoiceDate, "YYYY")}`
                    }
                },
                {
                    data: null,
                    render: function (data, type, row) {
                        const dt = formatDate(row.invoiceDate, "DD-MMM-YYYY");
                        return `${dt}`
                    }
                },
                {data: "termNo"},
                {
                    data: null,
                    render: function (data, type, row) {
                        const dt = formatDate(row.invoiceDate, "DD-MMM-YYYY");
                        return row.grandTotalUsd ? `<button type="button" class="btn btn-warning btn-sm btn-block">${row.grandTotalUsd} $</button>`
                            : `<button type="button" class="btn btn-success btn-sm btn-block">${row.grandTotalKhr} R</button>`;
                    }
                },
                {
                    data: "totalDiscountUsd"
                },
                {
                    data: "vat",
                    defaultContent: "0",
                    render: function (data) {
                        return toNum(data);
                    }
                },
                {
                    data: null,
                    render: function (data, type, row) {
                        return row.owe > 0 ?
                            row.owe ?
                                `<button type="button" class="btn btn-danger btn-sm btn-block">${row.oweUsd}$</button>`
                                : `<button type="button" class="btn btn-default btn-sm btn-block">0 $</button>`
                            : row.oweKhr ?
                                `<button type="button" class="btn btn-danger btn-sm btn-block">${row.oweKhr} R</button>`
                                : `<button type="button" class="btn btn-default btn-sm btn-block">0 R</button>`;
                    }
                },
                {
                    //total
                    data: null,
                    render: function (data, type, row) {
                        return row.totalRiel > 0 ? `<button type="button" class="btn btn-info btn-sm btn-block">${parseFloat(row.totalRiel).toFixed(0)} R</button>`
                            : `<button type="button" class="btn btn-info btn-sm btn-block">${parseFloat(row.totalDollar).toFixed(0)} $</button>`;
                    }
                },
                {
                    //==total pay r
                    data: null,
                    render: function (data, type, row) {
                        return `<button type="button" class="btn btn-default btn-sm btn-block">${parseFloat(row.totalRiel).toFixed(0)} R</button>`;
                    }
                },
                {
                    //==total pay $
                    data: null,
                    render: function (data, type, row) {
                        return `<button type="button" class="btn btn-default btn-sm btn-block">${parseFloat(row.totalDollar).toFixed(2)} $</button>`;
                    }
                },
                {
                    data: null,
                    render: function (data, type, row) {
                        return `
                                <div class="input-group-prepend">
                                    <button type="button" class="btn btn-primary dropdown-toggle btn-sm" data-toggle="dropdown">
                                        Action
                                    </button>
                                        <div class="dropdown-menu dropdown-menu-right" style="min-width: 8rem;">
                                        <div class="col-md-12">
                                            <button type="button"
                                                    class="btn btn-success btn-sm btn-edit-invoice"
                                                    data-invoice-id="${row.invoiceId}"
                                                    style="display:block;width:100%;margin:.2rem 0">
                                                <i class="fas fa-edit"></i> Edit
                                            </button>
                                            <button type="button"
                                                    class="btn btn-danger btn-sm btn-delete-invoice"
                                                    data-invoice-id="${row.invoiceId}"
                                                    style="display:block;width:100%;margin:.2rem 0">
                                                <i class="fa-solid fa-trash"></i> Delete
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            `;
                    }
                }
            ]
        });
    }

    ///3=====Create New Payment
    btnCreateNewPayment
        .off("click.payment")
        .on("click.payment", function (e) {
            e.preventDefault();

            const studentId = String(
                $("#selectedStudentId").val() ?? ""
            ).trim();

            if (!studentId) {
                ShowToastError("Please select a student first.");
                return;
            }

            formPayment[0].reset();

            // The selected student is displayed in the main page form.
            // Copy it into the modal field used by ASP.NET model binding.
            formPayment
                .find("[name='invoice.StudentId']")
                .val(studentId);
            applySelectedAcademicToPaymentForm();

            resetInvoiceDetailTable();
            formPayment
                .find("[name='invoice.InvoiceId']")
                .val(0);

            $("#paymentModalTitle").text("Create Payment");
            btnSavePayment.html(
                '<i class="fas fa-save"></i> Save Payment'
            );
            showEmptyInvoiceDetail();
            btnSavePayment.prop("disabled", true);
            setPaymentFullscreen(false);
            modalPayment.modal("show");
        });
    function showEmptyInvoiceDetail() {
        const totalColumns = $("#tblInvoiceDetail thead th").length;
        $("#tblInvoiceDetail tbody").html(`
                <tr id="emptyInvoiceDetailRow">
                    <td colspan="${totalColumns}" class="text-center text-muted py-4">
                        <i class="fa-solid fa-circle-info mr-1"></i>
                        No item selected. Click <strong>Select Item</strong> to add payment item.
                    </td>
                </tr>
            `);
    }
    function removeEmptyInvoiceDetail() {
        $("#emptyInvoiceDetailRow").remove();
    }
    async function GetExchangeRate() {
        try {
            const response = await $.ajax({
                url: `/exchange-rates/get-exchange-rates`,
                method: 'POST',
                data: {isAll: true}
            });
            if (response.status.code === "200") {
                const data = response.data;
                selectedExchangeRateId = data.exchangeRateId ?? "";
                $("#invoice_ExchangeRateId").val(selectedExchangeRateId);
                txtRateIn.text(data.rateIn);
                txtRateOut.text(data.rateOut)
            }
        } catch (error) {
            console.log(error.responseText);
        }
    }

    function GetInvoiceDetail(invoice_id) {
        resetInvoiceDetailTable();
        $.ajax({
            url: "/payment/invoice/" + invoice_id,
            type: 'GET',
            dataType: 'json',
            success: function (response) {
                if (String(response?.status?.code) !== "200") {
                    ShowToastError(
                        response?.status?.message ??
                        "Cannot load payment."
                    );
                    return;
                }

                const result = response.data ?? {};
                const invoiceData = result.invoice ?? {};
                const details = result.details ?? [];

                formPayment[0].reset();
                fillInvoiceForm(invoiceData);
                applyMissingAcademicToPaymentForm(invoiceData);

                details.forEach(item => {
                    let list_data = [
                        item.invoiceDetailId, 
                        item.invoiceId, 
                        item.productId, 
                        item.productName, 
                        item.productNameKhmer, 
                        item.qty, 
                        item.priceKhr,
                        item.priceUsd, 
                        item.totalKhr,
                        item.totalUsd, 
                        item.type, 
                        item.vat, 
                        item.discountPercent, 
                        item.discountKhr, 
                        item.discountUsd, 
                        item.oweKhr, 
                        item.oweUsd, 
                        item.otherKhr, 
                        item.otherUsd, 
                        item.grandTotalKhr, 
                        item.grandTotalUsd, 
                        item.payKhr, 
                        item.payUsd, 
                        item.payBath, 
                        item.tuitionFees, 
                        item.cardCertificate, 
                        item.categoryId, 
                        item.paymentType ?? false 
                    ];

                    AddItemPayment(list_data);
                });

                if (details.length === 0) {
                    showEmptyInvoiceDetail();
                }

                $("#paymentModalTitle").text("Edit Payment");
                btnSavePayment
                    .prop("disabled", details.length === 0)
                    .html('<i class="fas fa-save"></i> Update Payment');

                calculateInvoiceTotals();
                modalPayment.modal("show");
                setPaymentFullscreen(true);
            },
            error: function (xhr) {
                ShowToastError(
                    xhr.responseJSON?.status?.message ??
                    "Cannot load payment."
                );
            }
        });
    }
    
    formPayment.off("submit").on("submit.payment", function (e) {
        e.preventDefault();
        e.stopImmediatePropagation();

        if (savePaymentRequest) {
            return;
        }

        const form = $(this);
        const studentId = String(
            $("#selectedStudentId").val() ?? ""
        ).trim();

        if (!studentId) {
            ShowToastError("Please select a student.");
            return;
        }

        if ($("#tblInvoiceDetail tbody tr")
            .not("#emptyInvoiceDetailRow").length === 0) {
            ShowToastError("Please add at least one payment item.");
            return;
        }

        calculateInvoiceTotals();
        savePaymentButtonHtml = btnSavePayment.html();
        setSaveButtonLoading(true);

        form.find("[name='invoice.StudentId']")
            .val(studentId);
        applySelectedAcademicToPaymentForm();
        const paymentData = form.serializeArray()
            .filter(item =>
                String(item.name).toLowerCase() !==
                "invoice.studentid"
            );

        paymentData.push({
            name: "invoice.StudentId",
            value: studentId
        });

        savePaymentRequest = $.ajax({
            url: '/payment/save-invoice',
            method: 'POST',
            data: $.param(paymentData),
            headers: {
                "RequestVerificationToken":
                    getAntiForgeryToken()
            },
            success: function (response) {
                if (String(response?.status?.code) === "200") {
                    ShowToastSuccess(response.status.message);
                    modalPayment.modal("hide");

                    if ($.fn.DataTable.isDataTable("#tblInvoice")) {
                        tblInvoice.DataTable().ajax.reload(null, false);
                    }

                    resetInvoiceDetailTable();
                    showEmptyInvoiceDetail();
                } else {
                    ShowToastError(
                        response?.status?.message ??
                        "Cannot save payment."
                    );
                }
            },
            error: function (xhr) {
                console.error(
                    "Save payment response:",
                    xhr.responseText
                );

                ShowToastError(
                    xhr.responseJSON?.status?.message ??
                    xhr.responseJSON?.message ??
                    "Cannot save payment."
                );
            },
            complete: function () {
                savePaymentRequest = null;
                setSaveButtonLoading(false);
            }
        });
    });
    
    btnSavePayment
        .off("click")
        .on("click.payment", function (e) {
            e.preventDefault();
            e.stopImmediatePropagation();

            if (savePaymentRequest) {
                return;
            }

            formPayment.triggerHandler("submit");
        });

    tblInvoice.on("click", ".btn-edit-invoice", function () {
        const invoiceId = Number($(this).data("invoice-id"));
        if (invoiceId > 0) {
            GetInvoiceDetail(invoiceId);
        }
    });

    tblInvoice.on("click", ".btn-delete-invoice", function () {
        const invoiceId = Number($(this).data("invoice-id"));
        if (invoiceId <= 0) return;

        const deletePayment = function () {
            $.ajax({
                url: `/payment/delete-invoice/${invoiceId}`,
                type: "DELETE",
                headers: {
                    "RequestVerificationToken":
                        getAntiForgeryToken()
                },
                success: function (response) {
                    if (String(response?.status?.code) === "200") {
                        ShowToastSuccess(response.status.message);
                        tblInvoice.DataTable().ajax.reload(null, false);
                        return;
                    }

                    ShowToastError(
                        response?.status?.message ??
                        "Cannot delete payment."
                    );
                },
                error: function (xhr) {
                    ShowToastError(
                        xhr.responseJSON?.status?.message ??
                        xhr.responseJSON?.message ??
                        "Cannot delete payment."
                    );
                }
            });
        };

        if (typeof Swal !== "undefined") {
            Swal.fire({
                title: "Delete payment?",
                text: "This payment and all of its items will be deleted.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#d33",
                confirmButtonText: "Delete"
            }).then(result => {
                if (result.isConfirmed) deletePayment();
            });
            return;
        }

        if (window.confirm(
            "Delete this payment and all of its items?")) {
            deletePayment();
        }
    });

    function fillInvoiceForm(invoiceData) {
        Object.entries(invoiceData).forEach(([key, value]) => {
            const pascalKey =
                key.charAt(0).toUpperCase() + key.slice(1);
            const input = document.getElementById(
                `invoice_${pascalKey}`
            );

            if (!input) return;

            if (input.type === "date" && value) {
                input.value = String(value).substring(0, 10);
