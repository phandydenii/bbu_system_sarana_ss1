        function getStudent(studentId) {
            const previousRequest = studentDetailRequest;
            studentDetailRequest = null;
            previousRequest?.abort();

            const request = $.ajax({
                url: "/student/academic/student-id/" + encodeURIComponent(studentId),
                type: "GET",
                timeout: 20000,
                data: { student_id: studentId }
            });
            studentDetailRequest = request;

            request.done(function (response) {
                if (studentDetailRequest !== request || !modalCreateStudentPayment[0]?.isConnected) return;
                try {
                    populatePaymentStudent(studentId, response);
                } catch (error) {
                    console.error("Cannot prepare the selected student for payment:", error);
                    handlePaymentStudentLoadError(error?.message || "Unable to prepare Payment Detail.");
                    return;
                }
                if (startNewPayment) {
                    loadPaymentInvoiceHistory(selectedStudentField.val());
                }
            }).fail(function (xhr, status) {
                if (status === "abort" || studentDetailRequest !== request || !modalCreateStudentPayment[0]?.isConnected) return;
                handlePaymentStudentLoadError(
                    xhr.responseJSON?.status?.message ||
                    xhr.responseJSON?.message ||
                    "Error fetching student data."
                );
            }).always(function () {
                if (studentDetailRequest !== request) return;
                studentDetailRequest = null;
                if (startNewPayment) {
                    if (selectedStudentField.val()) paymentStudentFeedback.text("").prop("hidden", true);
                } else if (typeof hideLoading === "function") {
                    hideLoading(1);
                }
                updatePaymentEditorAvailability();
            });
        }

        function populatePaymentStudent(studentId, response) {
            const data = response?.data ?? response;
            const student = data?.student ?? data?.Student;
            if (!student) {
                throw new Error("Student information was not returned by the server.");
            }

            const actualStudentId = String(student.studentId ?? student.StudentId ?? "").trim();
            const studentStatus = student.status ?? student.Status;
            if (startNewPayment && actualStudentId.toUpperCase() !== studentId.toUpperCase()) {
                throw new Error("The returned student does not match your selection. Please select the student again.");
            }

            const degree = data?.degree ?? data?.Degree;
            const school = data?.school ?? data?.School;
            const field = data?.field ?? data?.Field;
            const promotion = data?.promotion ?? data?.Promotion;
            const stage = data?.stage ?? data?.Stage;
            const term = data?.term ?? data?.Term;
            const group = data?.group ?? data?.Group;
            const groupRoom = data?.groupRoom ?? data?.GroupRoom;
            const registry = data?.registry ?? data?.Registry;
            $("#student_StudentName").val(student.studentName ?? student.StudentName ?? "");
            $("#student_StudentNameInKhmer").val(student.studentNameInKhmer ?? student.StudentNameInKhmer ?? "");
            $("#student_Sex").val(student.sex);
            $("#student_Phone").val(student.phone ?? student.Phone ?? "");
            $("#student_DateOfBirth").val(formatDate(student.dateOfBirth, "DD-MMM-YYYY"));
            $("#displayDegreeName").val(degree?.degreeName ?? "");
            $("#displaySchoolName").val(school?.schoolName ?? "");
            $("#displayFieldName").val(field?.fieldName ?? "");

            selectedAcademic = {
                degreeId: degree?.degreeId ?? "",
                schoolId: school?.schoolId ?? "",
                fieldId: field?.fieldId ?? "",
                promotionId: "",
                stageId: "",
                termNo: "",
                groupId: "",
                startDate: "",
                endDate: ""
            };

            if (studentStatus !== "REGISTER") {
                $("#displayPromotionNo").val(promotion?.promotionNo ?? "");
                $("#displayStageNo").val(stage?.stageNo ?? "");
                $("#displayTermNo").val(term?.termNo ?? "");
                $("#group_StudyTime").val(group?.studyTime ?? "");
                $("#displayStartDate").val(formatDate(term?.startDate, "DD-MMM-YYYY"));
                $("#displayEndDate").val(formatDate(term?.endDate, "DD-MMM-YYYY"));
                $("#displayGroupName").val(group?.groupName ?? "");

                selectedAcademic.promotionId = promotion?.promotionId ?? "";
                selectedAcademic.stageId = stage?.stageId ?? "";
                selectedAcademic.termNo = term?.termNo ?? "";
                selectedAcademic.groupId = group?.groupId ?? "";
                selectedAcademic.startDate = term?.startDate ?? "";
                selectedAcademic.endDate = term?.endDate ?? "";

                if (groupRoom) {
                    $("#groupRoom_RoomName").val(groupRoom.roomName ?? "");
                }
            } else {
                $("#displayPromotionNo").val(registry?.promotionNo ?? "");
                $("#displayStageNo").val(registry?.stageNo ?? "");
                $("#displayTermNo").val(registry?.termNo ?? "");
                $("#group_StudyTime").val(registry?.studyTime ?? "");
                $("#displayStartDate").val("");
                $("#displayEndDate").val("");
                $("#displayGroupName").val(registry?.groupName ?? "");
                $("#groupRoom_RoomName").val("");

                selectedAcademic.promotionId =
                    registry?.promotionId ?? promotion?.promotionId ?? "";
                selectedAcademic.stageId =
                    registry?.stageId ?? stage?.stageId ?? "";
                selectedAcademic.termNo =
                    registry?.termNo ?? term?.termNo ?? "";
                selectedAcademic.groupId =
                    registry?.groupId ?? group?.groupId ?? "";
            }

            selectedStudentField.val(actualStudentId);
            if (startNewPayment) {
                setPaymentStudentDropdown(actualStudentId);
            }
            applySelectedAcademicToPaymentForm();
            formPayment.find("[name='invoice.StudentId']").val(actualStudentId);
            updatePaymentDetailContext();
            btnCreateNewPayment.prop("disabled", false);
        }

        function showCreatePaymentError(message) {
