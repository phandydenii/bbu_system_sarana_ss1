    function GetInvoiceDetail(invoice_id) {
        resetInvoiceDetailTable();
        $.ajax({
            url: "/payment/invoice/" + invoice_id,
            type: 'GET',
            dataType: 'json',
            success: function (response) {
                if (String(response?.status?.code) !== "200") {
                    ShowToastError(
                        response?.status?.message ??
                        "Cannot load payment."
                    );
                    return;
                }

                const result = response.data ?? {};
                const invoiceData = result.invoice ?? {};
                const details = result.details ?? [];

                formPayment[0].reset();
                fillInvoiceForm(invoiceData);
                applyMissingAcademicToPaymentForm(invoiceData);

                details.forEach(item => {
                    let list_data = [
                        item.invoiceDetailId, 
                        item.invoiceId, 
                        item.productId, 
                        item.productName, 
                        item.productNameKhmer, 
                        item.qty, 
                        item.priceKhr,
                        item.priceUsd, 
                        item.totalKhr,
                        item.totalUsd, 
                        item.type, 
                        item.vat, 
                        item.discountPercent, 
                        item.discountKhr, 
                        item.discountUsd, 
                        item.oweKhr, 
                        item.oweUsd, 
                        item.otherKhr, 
                        item.otherUsd, 
                        item.grandTotalKhr, 
                        item.grandTotalUsd, 
                        item.payKhr, 
                        item.payUsd, 
                        item.payBath, 
                        item.tuitionFees, 
                        item.cardCertificate, 
                        item.categoryId, 
                        item.paymentType ?? false 
                    ];

                    AddItemPayment(list_data);
                });

                if (details.length === 0) {
                    showEmptyInvoiceDetail();
                }

                $("#paymentModalTitle").text("Edit Payment");
                btnSavePayment
                    .prop("disabled", details.length === 0)
                    .html('<i class="fas fa-save"></i> Update Payment');

                calculateInvoiceTotals();
                modalPayment.modal("show");
                setPaymentFullscreen(true);
            },
            error: function (xhr) {
                ShowToastError(
                    xhr.responseJSON?.status?.message ??
                    "Cannot load payment."
                );
            }
        });
    }
    
    formPayment.off("submit").on("submit.payment", function (e) {
        e.preventDefault();
        e.stopImmediatePropagation();

        if (savePaymentRequest) {
            return;
        }

        const form = $(this);
        const studentId = String(
            $("#selectedStudentId").val() ?? ""
        ).trim();

        if (!studentId) {
            ShowToastError("Please select a student.");
            return;
        }

        if ($("#tblInvoiceDetail tbody tr")
            .not("#emptyInvoiceDetailRow").length === 0) {
            ShowToastError("Please add at least one payment item.");
            return;
        }

        calculateInvoiceTotals();
        savePaymentButtonHtml = btnSavePayment.html();
        setSaveButtonLoading(true);

        form.find("[name='invoice.StudentId']")
            .val(studentId);
        applySelectedAcademicToPaymentForm();
        const paymentData = form.serializeArray()
            .filter(item =>
                String(item.name).toLowerCase() !==
                "invoice.studentid"
            );

        paymentData.push({
            name: "invoice.StudentId",
            value: studentId
        });

        savePaymentRequest = $.ajax({
            url: '/payment/save-invoice',
            method: 'POST',
            data: $.param(paymentData),
            headers: {
                "RequestVerificationToken":
                    getAntiForgeryToken()
            },
            success: function (response) {
                if (String(response?.status?.code) === "200") {
                    ShowToastSuccess(response.status.message);
                    modalPayment.modal("hide");

                    if ($.fn.DataTable.isDataTable("#tblInvoice")) {
                        tblInvoice.DataTable().ajax.reload(null, false);
                    }

                    resetInvoiceDetailTable();
                    showEmptyInvoiceDetail();
                } else {
                    ShowToastError(
                        response?.status?.message ??
                        "Cannot save payment."
                    );
                }
            },
            error: function (xhr) {
                console.error(
                    "Save payment response:",
                    xhr.responseText
                );

                ShowToastError(
                    xhr.responseJSON?.status?.message ??
                    xhr.responseJSON?.message ??
                    "Cannot save payment."
                );
            },
            complete: function () {
                savePaymentRequest = null;
                setSaveButtonLoading(false);
            }
        });
    });
    
    btnSavePayment
        .off("click")
        .on("click.payment", function (e) {
            e.preventDefault();
            e.stopImmediatePropagation();

            if (savePaymentRequest) {
                return;
            }

            formPayment.triggerHandler("submit");
        });

