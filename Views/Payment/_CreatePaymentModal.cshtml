        function loadInvoiceHistoryRows(table, studentId, page, complete, showError) {
            abortInvoiceHistory(table);
            showError("");
            const emptyPage = { draw: page.draw, recordsTotal: 0, recordsFiltered: 0, data: [] };

            function fetchPage(url, alternateUrl) {
                const request = $.ajax({
                    url,
                    type: "POST",
                    dataType: "json",
                    timeout: 20000,
                    headers: { "RequestVerificationToken": getAntiForgeryToken() },
                    data: { ...page, studentId }
                });
                invoiceHistoryRequests.set(table[0], request);

                return request.done(function (response) {
                    if (invoiceHistoryRequests.get(table[0]) !== request) return;
                    invoiceHistoryRequests.delete(table[0]);

                    const recordsTotal = Number(response?.recordsTotal ?? NaN);
                    const recordsFiltered = Number(response?.recordsFiltered ?? NaN);
                    const rows = response?.data;
                    if (!Array.isArray(rows) || rows.some(row => !row || typeof row !== "object") ||
                        !Number.isSafeInteger(recordsTotal) || recordsTotal < 0 ||
                        !Number.isSafeInteger(recordsFiltered) || recordsFiltered < 0) {
                        showError("The server returned an invalid invoice history response.");
                        complete(emptyPage);
                        return;
                    }

                    complete({ draw: page.draw, recordsTotal, recordsFiltered, data: rows });
                }).fail(function (xhr, status) {
                    if (invoiceHistoryRequests.get(table[0]) !== request) return;
                    invoiceHistoryRequests.delete(table[0]);

                    if (alternateUrl && (xhr.status === 404 || xhr.status === 405)) {
                        fetchPage(alternateUrl);
                        return;
                    }

                    const httpError = xhr.status >= 400 ? ` (HTTP ${xhr.status})` : "";
                    showError(status === "timeout"
                        ? "Invoice history took too long to load."
                        : `Unable to load invoice history${httpError}.`);
                    complete(emptyPage);
                });
            }

            // Newer views use the student ID in the route. Older controllers bind it from the form.
            return fetchPage(`${invoiceHistoryUrl}/${encodeURIComponent(studentId)}`, invoiceHistoryUrl);
        }

        function showInvoiceHistory(table, studentId) {
            resetInvoiceHistory(table);
            const feedback = table.closest(".invoice-table-wrap").find("[data-invoice-history-error]");
            feedback.find("button").off("click.invoiceHistory").on("click.invoiceHistory", function () {
                table.DataTable().ajax.reload();
            });

            function showError(message) {
                feedback.prop("hidden", !message).find("[role='alert']").text(message);
            }

            table.DataTable({
                processing: true,
                serverSide: true,
                paging: true,
                lengthChange: true,
                searching: false,
                ordering: false,
                info: false,
                responsive: true,
                autoWidth: true,
                language: { emptyTable: "No invoices to display." },
                ajax: function (page, complete) {
                    return loadInvoiceHistoryRows(table, studentId, page, complete, showError);
                },
                columns: invoiceHistoryColumns()
            });
        }

        function formatPaymentInvoiceNumber(invoice) {
            const invoiceNo = invoice.invoiceNo ?? 0;
            const year = invoiceNo > 0
                ? invoice.yearNumber
                : invoice.invoiceDate && formatDate(invoice.invoiceDate, "YYYY");
            const number = invoiceNo > 0 ? invoiceNo : invoice.invoiceId ?? "";
            return year ? `${number}/${year}` : number;
        }

        function invoiceHistoryColumns() {
            return [
                { data: "invoiceId", defaultContent: "", render: escapePaymentItemHtml },
                {
                    data: null,
                    render: (data, type, row) => escapePaymentItemHtml(formatPaymentInvoiceNumber(row))
                },
                {
                    data: null,
                    render: function (data, type, row) {
                        return row.invoiceDate ? escapePaymentItemHtml(formatDate(row.invoiceDate, "DD-MMM-YYYY")) : "";
                    }
                },
                { data: "termNo", defaultContent: "", render: escapePaymentItemHtml },
                {
                    data: null,
                    render: function (data, type, row) {
                        const grandTotalUsd = toNum(row.grandTotalUsd);
                        return grandTotalUsd ? `<button type="button" class="btn btn-warning btn-sm btn-block">${grandTotalUsd} $</button>`
                            : `<button type="button" class="btn btn-success btn-sm btn-block">${toNum(row.grandTotalKhr)} R</button>`;
                    }
                },
                {
                    data: "totalDiscountUsd",
                    defaultContent: "0",
                    render: toNum
                },
                {
                    data: "vat",
                    defaultContent: "0",
                    render: toNum
                },
                {
                    data: null,
                    render: function (data, type, row) {
                        const oweUsd = toNum(row.oweUsd);
                        const oweKhr = toNum(row.oweKhr);
                        return oweUsd > 0 ? `<button type="button" class="btn btn-danger btn-sm btn-block">${oweUsd} $</button>`
                            : oweKhr > 0 ? `<button type="button" class="btn btn-danger btn-sm btn-block">${oweKhr} R</button>`
                                : `<button type="button" class="btn btn-default btn-sm btn-block">0 R</button>`;
                    }
                },
                {
                    data: null,
                    render: function (data, type, row) {
                        const paidKhr = toNum(row.totalRiel);
                        return paidKhr > 0 ? `<button type="button" class="btn btn-info btn-sm btn-block">${paidKhr.toFixed(0)} R</button>`
                            : `<button type="button" class="btn btn-info btn-sm btn-block">${toNum(row.totalDollar).toFixed(0)} $</button>`;
                    }
                },
                {
                    data: null,
                    render: function (data, type, row) {
                        return `<button type="button" class="btn btn-default btn-sm btn-block">${toNum(row.totalRiel).toFixed(0)} R</button>`;
                    }
                },
                {
                    data: null,
                    render: function (data, type, row) {
                        return `<button type="button" class="btn btn-default btn-sm btn-block">${toNum(row.totalDollar).toFixed(2)} $</button>`;
                    }
                },
                {
                    data: null,
                    render: function (data, type, row) {
                        const invoiceId = Number(row.invoiceId);
                        if (!Number.isSafeInteger(invoiceId) || invoiceId <= 0) return "";
                        return `
                        <div class="invoice-history-actions">
                            <button type="button" class="btn btn-warning btn-sm btn-edit-invoice"
                                    data-invoice-id="${invoiceId}" title="Edit invoice" aria-label="Edit invoice ${invoiceId}">
                                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                            </button>
                            <button type="button" class="btn btn-danger btn-sm btn-delete-invoice"
                                    data-invoice-id="${invoiceId}" title="Delete invoice" aria-label="Delete invoice ${invoiceId}">
                                <i class="fa-solid fa-trash" aria-hidden="true"></i>
                            </button>
                        </div>
                    `;
                    }
                }
            ];
        }

