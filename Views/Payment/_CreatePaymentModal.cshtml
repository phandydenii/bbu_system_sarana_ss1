        products.forEach(row => {
            const isPayKhr = Boolean(row.paymentType ?? false);
            const isPayUsd = !isPayKhr;

            const list_data = [
                0, 0,
                row.productId,
                row.productName,
                row.productNameInKhmer,
                1,
                isPayKhr ? row.priceKhr : 0,
                isPayUsd ? row.price : 0,
                isPayKhr ? row.priceKhr : 0,
                isPayUsd ? row.price : 0,
                row.type,
                row.vat,
                0, 0, 0, 0, 0, 0, 0,
                isPayKhr ? row.priceKhr : 0,
                isPayUsd ? row.price : 0,
                isPayKhr ? row.priceKhr : 0,
                isPayUsd ? row.price : 0,
                0,
                row.tuitionFees,
                row.cardCertificate,
                row.categoryId,
                isPayKhr
            ];

            AddItemPayment(list_data);
        });

        clearSelectedProducts();
        modalProduct.modal("hide");
        btnSavePayment.prop("disabled", false);
