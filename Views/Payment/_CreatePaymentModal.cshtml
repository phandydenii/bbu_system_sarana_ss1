        function loadInvoiceForEdit(invoiceId, fromPaymentEditor) {
            const studentId = String(selectedStudentField.val() ?? "").trim();
            if (!studentId || paymentDraft || invoiceDetailRequest || invoiceDeletionPending || savePaymentRequest) return;

            const request = $.ajax({
                url: "/payment/invoice/" + invoiceId,
                type: "GET",
                dataType: "json",
                timeout: 20000
            });
            invoiceDetailRequest = request;
            updatePaymentEditorAvailability();

            request.done(function (response) {
                if (invoiceDetailRequest !== request || !modalCreateStudentPayment[0]?.isConnected) return;
                if (String(response?.status?.code) !== "200") {
                    ShowToastError(
                        response?.status?.message ??
                        "Cannot load payment."
                    );
                    return;
                }

                const invoiceData = response.data?.invoice;
                const details = response.data?.details;
                if (Number(invoiceData?.invoiceId) !== invoiceId ||
                    String(invoiceData?.studentId ?? studentId).trim().toUpperCase() !== studentId.toUpperCase() ||
                    !Array.isArray(details) || details.some(item => !item || typeof item !== "object")) {
                    showCreatePaymentError("The server did not return the requested invoice for this student.");
                    return;
                }

                if (fromPaymentEditor) savePaymentDraft();
                resetInvoiceDetailTable();
                formPayment[0].reset();
                resetPaymentDetailControls();
                setPaymentHistoryAvailable(false);
                fillInvoiceForm(invoiceData);
                formPayment.find("[name='invoice.InvoiceId']").val(invoiceId);
                applyMissingAcademicToPaymentForm(invoiceData);
                updatePaymentDetailContext();
                updatePaymentInvoiceDisplay(invoiceData);

                details.forEach(item => renderPaymentItemRow(item));
                if (details.length === 0) {
                    renderPaymentItemRow();
                }
                reindexInvoiceDetailRows();

                paymentDetailTitle.text("Edit Invoice");
                btnSavePayment.html('<i class="fas fa-save mr-1" aria-hidden="true"></i> Update');
                calculateInvoiceTotals();
                if (fromPaymentEditor) {
                    modalPayment.find("#paymentCloseLabel").text("Back to New Payment");
                    modalPayment.find("#paymentCloseIcon").removeClass("fa-times text-danger").addClass("fa-arrow-left");
                    paymentDetailTitle.trigger("focus");
                    modalPayment.find(".modal-body")[0].scrollTop = 0;
                } else {
                    modalPayment.modal("show");
                    setStudentPaymentFullscreen(true);
                }
            }).fail(function (xhr, status) {
                if (status === "abort" || invoiceDetailRequest !== request) return;
                showCreatePaymentError(
                    xhr.responseJSON?.status?.message ??
                    xhr.responseJSON?.message ??
                    "Cannot load payment."
                );
            }).always(function () {
                if (invoiceDetailRequest !== request) return;
                invoiceDetailRequest = null;
                updatePaymentEditorAvailability();
            });
        }

        formPayment.off("submit").on("submit.payment", function (e) {
            e.preventDefault();
            e.stopImmediatePropagation();

            if (savePaymentRequest || studentDetailRequest || invoiceDetailRequest || invoiceDeletionPending || !paymentDetailReady) {
                return;
            }

            const form = $(this);
            const studentId = String(
                selectedStudentField.val() ?? ""
            ).trim();

            if (!studentId) {
                ShowToastError("Please select a student.");
                return;
            }

            if (!tblInvoiceDetail.find("tbody tr[data-payment-product-id]").length) {
                ShowToastError("Please add at least one payment item.");
                return;
            }

            calculateInvoiceTotals();
            const saveButtonHtml = btnSavePayment.html();

            form.find("[name='invoice.StudentId']")
                .val(studentId);
            if (startNewPayment && !paymentDraft) applySelectedAcademicToPaymentForm();
            const paymentData = form.serialize();

            const request = $.ajax({
                url: '/payment/save-invoice',
                method: 'POST',
                data: paymentData,
                headers: {
                    "RequestVerificationToken":
                        getAntiForgeryToken()
                }
            });
            savePaymentRequest = request;
            updatePaymentEditorAvailability();
            btnSavePayment.addClass("is-saving")
                .html('<span class="spinner-border spinner-border-sm saving-spinner" aria-hidden="true"></span> Saving...');

            request.done(function (response) {
                if (String(response?.status?.code) === "200") {
                    ShowToastSuccess(response.status.message);
                    savePaymentRequest = null;
                    if (paymentDraft) {
                        restorePaymentDraft();
                        reloadInvoiceHistory(tblPaymentInvoiceHistory);
                        if (!startNewPayment) reloadInvoiceHistory(tblInvoice);
                        return;
                    }
                    modalPayment.modal("hide");

                    if (!startNewPayment) {
                        reloadInvoiceHistory(tblInvoice);
                        resetInvoiceDetailTable();
                    }
                } else {
                    ShowToastError(response?.status?.message ?? "Cannot save payment.");
                }
            }).fail(function (xhr) {
                console.error("Save payment response:", xhr.status);
                ShowToastError(
                    xhr.responseJSON?.status?.message ??
                    xhr.responseJSON?.message ??
                    "Cannot save payment."
                );
            }).always(function () {
                if (savePaymentRequest === request) {
                    savePaymentRequest = null;
                    btnSavePayment.html(saveButtonHtml);
                }
                btnSavePayment.removeClass("is-saving");
                updatePaymentEditorAvailability();
            });
        });

        btnSavePayment
            .off("click")
            .on("click.payment", function (e) {
                e.preventDefault();
                e.stopImmediatePropagation();

                if (savePaymentRequest) {
                    return;
                }

                formPayment.triggerHandler("submit");
            });

        function reloadInvoiceHistory(table, resetPaging = false) {
            if ($.fn.DataTable.isDataTable(table[0])) {
                table.DataTable().ajax.reload(null, resetPaging);
            }
        }

        const invoiceHistoryTables = tblInvoice.add(tblPaymentInvoiceHistory);
        invoiceHistoryTables.on("click", ".btn-edit-invoice", function () {
            const invoiceId = Number($(this).data("invoice-id"));
            const fromPaymentEditor = $(this).closest("table")[0] === tblPaymentInvoiceHistory[0];
            if (Number.isSafeInteger(invoiceId) && invoiceId > 0 && (!fromPaymentEditor || paymentDetailReady)) {
                loadInvoiceForEdit(invoiceId, fromPaymentEditor);
            }
        });

        invoiceHistoryTables.on("click", ".btn-delete-invoice", function () {
            const invoiceId = Number($(this).data("invoice-id"));
            if (!Number.isSafeInteger(invoiceId) || invoiceId <= 0 ||
                invoiceDeletionPending || invoiceDetailRequest || savePaymentRequest) return;

            invoiceDeletionPending = true;
            updatePaymentEditorAvailability();

            function finishDeletion() {
                invoiceDeletionPending = false;
                updatePaymentEditorAvailability();
            }

            const deletePayment = function () {
                if (!modalCreateStudentPayment[0]?.isConnected) {
                    finishDeletion();
                    return;
                }
                $.ajax({
                    url: `/payment/delete-invoice/${invoiceId}`,
                    type: "DELETE",
                    timeout: 20000,
                    headers: {
                        "RequestVerificationToken":
                            getAntiForgeryToken()
                    },
                    success: function (response) {
                        if (String(response?.status?.code) === "200") {
                            ShowToastSuccess(response.status.message);
                            reloadInvoiceHistory(tblInvoice, true);
                            reloadInvoiceHistory(tblPaymentInvoiceHistory, true);
                            return;
                        }

                        ShowToastError(
                            response?.status?.message ??
                            "Cannot delete payment."
                        );
                    },
                    error: function (xhr, status) {
                        if (status === "timeout") {
                            reloadInvoiceHistory(tblInvoice);
                            reloadInvoiceHistory(tblPaymentInvoiceHistory);
                        }
                        ShowToastError(
                            xhr.responseJSON?.status?.message ??
                            xhr.responseJSON?.message ??
                            (status === "timeout" ? "The delete request timed out. Check Invoice History." : "Cannot delete payment.")
                        );
                    }
                }).always(finishDeletion);
            };

            if (typeof Swal !== "undefined") {
                Swal.fire({
                    target: $(this).closest(".modal")[0],
                    title: "Delete payment?",
                    text: "This payment and all of its items will be deleted.",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#d33",
                    confirmButtonText: "Delete",
                    focusCancel: true
                }).then(result => {
                    if (result.isConfirmed) {
                        deletePayment();
                    } else {
                        finishDeletion();
                    }
                }, finishDeletion);
                return;
            }

            if (window.confirm(
                "Delete this payment and all of its items?")) {
                deletePayment();
            } else {
                finishDeletion();
            }
        });

        function fillInvoiceForm(invoiceData) {
            Object.entries(invoiceData).forEach(([key, value]) => {
                const pascalKey =
                    key.charAt(0).toUpperCase() + key.slice(1);
                const input = document.getElementById(
                    `invoice_${pascalKey}`
                );

                if (!input) return;

                if (input.type === "date" && value) {
                    input.value = String(value).substring(0, 10);
                } else {
                    input.value = value ?? "";
                }
            });
        }

        function applyMissingAcademicToPaymentForm(invoiceData) {
            const fallbackValues = {
                degreeId: selectedAcademic.degreeId,
                schoolId: selectedAcademic.schoolId,
                fieldId: selectedAcademic.fieldId,
                promotionId: selectedAcademic.promotionId,
                stageId: selectedAcademic.stageId,
                termNo: selectedAcademic.termNo,
                groupId: selectedAcademic.groupId,
                startDate: selectedAcademic.startDate,
                endDate: selectedAcademic.endDate,
                exchangeRateId: selectedExchangeRateId
            };

            Object.entries(fallbackValues).forEach(([key, fallback]) => {
                const currentValue = invoiceData?.[key];
                if (currentValue !== null &&
                    currentValue !== undefined &&
                    String(currentValue).trim() !== "") {
                    return;
                }

                const pascalKey =
                    key.charAt(0).toUpperCase() + key.slice(1);

                formPayment
                    .find(`[name='invoice.${pascalKey}']`)
                    .val(fallback ?? "");
            });
        }

        function resetInvoiceDetailTable() {
            destroyPaymentItemPickers(tblInvoiceDetail);
            if ($.fn.DataTable.isDataTable("#tblInvoiceDetail")) {
                tblInvoiceDetail.DataTable().clear().destroy();
            }

            tblInvoiceDetail.find("tbody").empty();
        }

        function getAntiForgeryToken() {
            return modalCreateStudentPayment.find("input[name='__RequestVerificationToken']").first().val() ?? "";
        }

        function toNum(value) {
            const normalized = String(value ?? "")
                .trim()
                .toLowerCase();

            if (value === true || normalized === "true") {
                return 1;
            }

            if (value === false ||
                normalized === "" ||
                normalized === "false") {
                return 0;
            }

            const number = Number(value);
            return Number.isFinite(number) ? number : 0;
        }

        function isNotValid(value) {
            const normalized = String(value ?? "")
                .trim()
                .toLowerCase();

            if (normalized === "" ||
                normalized === "true" ||
                normalized === "false") {
                return false;
            }

            return !Number.isFinite(Number(normalized));
        }


        function escapePaymentItemHtml(value) {
            return $("<div>").text(value ?? "").html();
        }

        function formatPaymentLookupPrice(value, isKhr) {
            const number = Number(value);
            const amount = Number.isFinite(number) ? number : 0;
            const fractionDigits = isKhr ? 0 : 2;
            const formatted = amount.toLocaleString(undefined, {
                minimumFractionDigits: fractionDigits,
                maximumFractionDigits: fractionDigits
            });
            return formatted + (isKhr ? " KHR" : " USD");
        }

        function renderPaymentLookupResult(option) {
            if (!option.primary) return option.text || "";

            const title = [option.primary, option.secondary, option.khmer].filter(Boolean).join("\n");
            const primary = $('<strong class="payment-lookup-primary">').text(option.primary);
            if (option.primaryLanguage) primary.attr("lang", option.primaryLanguage);

            const names = $('<span class="payment-lookup-names">')
                .attr("title", title)
                .append(primary);
            if (option.secondary || option.khmer) {
                const details = $('<span class="payment-lookup-details">');
                if (option.secondary) {
                    details.append($("<span>").text(option.secondary));
                }
                if (option.khmer) {
                    details.append($("<span>").attr("lang", "km").text(option.khmer));
                }
                names.append(details);
            }

            const result = $('<span class="payment-lookup-result">').append(names);
            if (option.priceLabel) {
                result.append($('<span class="payment-lookup-price">').text(option.priceLabel));
            }
            return result;
        }

        function paymentLookupOptions(url, columns, placeholder, toOption, requestChanged, excludedIds) {
            const pageSize = 20;
            return {
                width: "100%",
                dropdownParent: modalPayment,
                placeholder,
                templateResult: renderPaymentLookupResult,
                ajax: {
                    url,
                    type: "POST",
                    dataType: "json",
                    delay: 250,
                    data: function (params) {
                        const page = Number(params.page) || 1;
                        // Leave room for items removed from each page of results.
                        const length = params.paymentPageLength ?? (pageSize + (excludedIds?.().size ?? 0));
                        params.paymentPageLength = length;
                        return {
                            draw: page,
                            start: (page - 1) * length,
                            length,
                            search: { value: String(params.term ?? "").trim(), regex: false },
                            order: [{ column: 0, dir: "asc" }],
                            columns: columns.map(data => ({
                                data,
                                name: "",
                                searchable: true,
                                orderable: true,
                                search: { value: "", regex: false }
                            }))
                        };
                    },
                    transport: function (params, success, failure) {
                        if (!modalPayment[0]?.isConnected || !paymentDetailReady) return;

                        const request = $.ajax(params);
                        request.done(success).fail(function (xhr, status) {
                            if (status !== "abort") failure(xhr);
                        });
                        requestChanged(request);
                        return request;
                    },
                    processResults: function (response, params) {
                        const rows = Array.isArray(response?.data) ? response.data : [];
                        const total = Number(response?.recordsFiltered ?? response?.recordsTotal ?? NaN);
                        const page = Number(params.page) || 1;
                        const length = params.paymentPageLength ?? pageSize;
                        const excluded = excludedIds?.();
                        return {
                            results: rows.map(toOption).filter(option => option.id && !excluded?.has(option.id)),
                            pagination: {
                                more: rows.length > 0 &&
                                    (Number.isFinite(total) ? page * length < total : rows.length === length)
                            }
                        };
                    }
                }
            };
        }

        function paymentStudentOption(student) {
            const id = String(student?.studentId ?? student?.StudentId ?? "").trim();
            const name = String(student?.studentName ?? student?.StudentName ?? "").trim();
            const khmerName = String(student?.studentNameInKhmer ?? student?.StudentNameInKhmer ?? "").trim();
            const khmer = khmerName === name ? "" : khmerName;
            return { id, text: id, primary: id, secondary: name, khmer };
        }

        function setPaymentStudentDropdown(studentId) {
            paymentInlineStudent.empty()
                .append(new Option("", ""), new Option(studentId, studentId, false, true))
                .val(studentId)
                .trigger("change.select2");
        }

        function initializeInlinePaymentStudents() {
            const options = paymentLookupOptions(
                "/student/academic/student-list/all",
                ["studentId", "studentName", "studentNameInKhmer", "sex", "phone", "status"],
                "Search student ID or name",
                paymentStudentOption,
                request => { inlineStudentRequest = request; }
            );

            paymentInlineStudent.select2({
                ...options,
                minimumInputLength: 1,
                allowClear: true,
                language: { inputTooShort: () => "Enter a student ID or name." }
            })
                .on("change.paymentInlineStudent", function () {
                    if (savePaymentRequest || invoiceDetailRequest || invoiceDeletionPending || paymentDraft || !paymentDetailReady) return;

                    loadPaymentStudentSelection(String(paymentInlineStudent.val() ?? "").trim());
                });
        }

        modalPayment.on("select2:open.paymentLookup", "#paymentInlineStudent, .payment-product-picker", function () {
            const placeholder = this === paymentInlineStudent[0] ? "Search student ID or name" : "Search payment items";
            modalPayment.find(".select2-container--open .select2-search__field")
                .attr("placeholder", placeholder).attr("aria-label", placeholder).trigger("focus");
        });

        function loadPaymentStudentSelection(studentId) {
            if (!studentDetailRequest && studentId === selectedStudentField.val()) return;
            clearPaymentInvoiceHistory();
            if (!studentId) {
                const previousRequest = studentDetailRequest;
                studentDetailRequest = null;
                previousRequest?.abort();
            }

            selectedStudentField.val("");
            $("#student_StudentName").val("");
            $("#student_Phone").val("");
            selectedAcademic = {};
            formPayment.find("[name='invoice.StudentId']").val("");
            applySelectedAcademicToPaymentForm();
            updatePaymentDetailContext();

            paymentStudentFeedback.text(studentId ? "Loading student information…" : "").prop("hidden", !studentId);
            if (studentId) getStudent(studentId);
            updatePaymentEditorAvailability();
        }

        function selectedPaymentProductIds() {
            return new Set(tblInvoiceDetail.find("tbody tr[data-payment-product-id]").toArray()
                .map(row => row.dataset.paymentProductId));
        }

        function paymentProductNames(product, id) {
            const name = String(product?.productName ?? "").trim();
            const khmerName = String(product?.productNameInKhmer ?? "").trim()
                || String(product?.productNameKhmer ?? "").trim();
            return {
                text: name || khmerName || `Item ${id}`,
                khmer: name && name !== khmerName ? khmerName : "",
                primaryLanguage: !name && khmerName ? "km" : ""
            };
        }

        function renderPaymentItemSelection(option) {
            if (!option.id) return option.text || "";

            const khmer = option.khmer ?? option.element?.dataset?.khmer;
            const primaryLanguage = option.primaryLanguage ?? option.element?.lang;
            const primary = $("<span>").text(option.text);
            if (primaryLanguage) primary.attr("lang", primaryLanguage);

            const label = $('<span class="payment-item-selection">').append(primary);
            if (khmer) {
                label.attr("title", `${option.text}\n${khmer}`).append(
                    $('<span class="payment-item-selection-khmer">').attr("lang", "km").text(khmer)
                );
            }
            return label;
        }

        function initializePaymentItemPickers(row) {
            $(row).find(".payment-product-picker").each(function () {
                const element = this;
                const picker = $(element);
                const options = paymentLookupOptions(
                    "/product/get-product-list",
                    productListColumns,
                    "Search payment items",
                    product => {
                        const productId = Number(product?.productId);
                        const id = Number.isSafeInteger(productId) && productId > 0 ? String(productId) : "";
                        const names = paymentProductNames(product, id);
                        const isKhr = toNum(product?.paymentType) === 1;
                        return {
                            ...names,
                            id,
                            primary: names.text,
                            priceLabel: formatPaymentLookupPrice(isKhr ? product?.priceKhr : product?.price, isKhr),
                            product
                        };
                    },
                    request => {
                        productPickerRequests.set(element, request);
                        request.always(function () {
                            if (productPickerRequests.get(element) === request) productPickerRequests.delete(element);
                        });
                    },
                    selectedPaymentProductIds
                );
                const transport = options.ajax.transport;
                options.ajax.transport = function (params, success, failure) {
                    if (!element.isConnected || element.disabled || !picker.hasClass("select2-hidden-accessible")) return;
                    let request;
                    const isCurrent = () => request && productPickerRequests.get(element) === request && element.isConnected && !element.disabled;
                    request = transport(params, function (response) {
                        if (isCurrent()) success(response);
                    }, function (xhr) {
                        if (isCurrent()) failure(xhr);
                    });
                    return request;
                };
                picker.select2({
                    ...options,
                    templateSelection: renderPaymentItemSelection,
                    language: { noResults: () => "No available items found." }
                });
            });
        }

        function destroyPaymentItemPickers(container) {
            container.find(".payment-product-picker.select2-hidden-accessible").each(function () {
                const request = productPickerRequests.get(this);
                productPickerRequests.delete(this);
                const picker = $(this);
                picker.select2("close").select2("destroy");
                request?.abort();
            });
        }

        function cancelPaymentItemLookups() {
            const requests = Array.from(productPickerRequests.values());
            productPickerRequests.clear();
            requests.forEach(request => request.abort());
        }

        tblInvoiceDetail.on("select2:select.paymentProduct", ".payment-product-picker", function (event) {
            const row = this.closest("tr");
            const product = event.params?.data?.product;
            const currentId = row.dataset.paymentProductId;
            $(this).val(currentId ?? "").trigger("change.select2");
            if (!product || savePaymentRequest || invoiceDetailRequest || invoiceDeletionPending || !paymentDetailReady) return;

            const productId = Number(product.productId);
            if (!Number.isSafeInteger(productId) || productId <= 0 || String(productId) === currentId) return;

            // Let Select2 finish handling the selection before rebuilding the row.
            window.setTimeout(function () {
                if (!row.isConnected || savePaymentRequest || invoiceDetailRequest || invoiceDeletionPending || !paymentDetailReady) return;
                const productWasAdded = tblInvoiceDetail.find("tbody tr[data-payment-product-id]")
                    .toArray().some(item => item !== row && item.dataset.paymentProductId === String(productId));
                if (productWasAdded) {
                    showCreatePaymentError("This item is already in the payment. Change its quantity in the table.");
                    return;
                }
                selectPaymentItemProduct(row, product);
            }, 0);
        });

        function selectPaymentItemProduct(row, product) {
            const isKhr = toNum(product.paymentType) === 1;
            const priceKhr = isKhr ? product.priceKhr : 0;
            const priceUsd = isKhr ? 0 : product.price;
            const currentQuantity = row.querySelector('[data-invoice-detail="Qty"]').value;
            const qty = toNum(currentQuantity) || 1;
            renderPaymentItemRow({
                invoiceId: formPayment.find("[name='invoice.InvoiceId']").val(),
                productId: product.productId,
                productName: product.productName,
                productNameInKhmer: product.productNameInKhmer,
                productNameKhmer: product.productNameKhmer,
                qty,
                priceKhr,
                priceUsd,
                type: product.type,
                vat: product.vat,
                payKhr: qty * toNum(priceKhr),
                payUsd: qty * toNum(priceUsd),
                tuitionFees: product.tuitionFees,
                cardCertificate: product.cardCertificate,
                categoryId: product.categoryId,
                paymentType: isKhr
            }, row);
            reindexInvoiceDetailRows();
            calculateInvoiceTotals();
            updatePaymentEditorAvailability();
            $(row).find(".payment-item-qty").trigger("focus");
        }

        function updatePaymentEditorAvailability() {
            const saving = Boolean(savePaymentRequest);
            const itemControlsDisabled = saving || Boolean(invoiceDetailRequest) || invoiceDeletionPending;
            btnAddPaymentItem.prop("disabled", itemControlsDisabled);
            tblInvoiceDetail.find(".payment-product-picker").prop("disabled", itemControlsDisabled);
            if (itemControlsDisabled) {
                tblInvoiceDetail.find(".payment-product-picker.select2-hidden-accessible").select2("close");
                cancelPaymentItemLookups();
            }
            paymentInlineStudent.prop("disabled", saving || Boolean(invoiceDetailRequest || paymentDraft) || invoiceDeletionPending);
            btnClosePayment.add(modalPayment.find("#btnDismissPayment")).prop("disabled", saving || invoiceDeletionPending);
            const hasItems = tblInvoiceDetail.find("tbody tr[data-payment-product-id]").length > 0;
            const canSave = !saving && !studentDetailRequest && !invoiceDetailRequest && !invoiceDeletionPending &&
                Boolean(selectedStudentField.val()) && hasItems;
            btnSavePayment.prop("disabled", !canSave);
        }

        btnAddPaymentItem.on("click", function () {
            if (!paymentDetailReady || savePaymentRequest || invoiceDetailRequest || invoiceDeletionPending) return;
            const row = renderPaymentItemRow();
            reindexInvoiceDetailRows();
            // Open after the add click and the row insertion have both completed.
            window.setTimeout(function () {
                const picker = $(row).find(".payment-product-name");
                if (!paymentDetailReady || !row.isConnected || picker.prop("disabled")) return;
                tblInvoiceDetail.find(".payment-product-picker.select2-hidden-accessible").select2("close");
                row.scrollIntoView({ block: "nearest", inline: "nearest" });
                picker.select2("open");
            }, 0);
        });

        function renderPaymentItemRow(item = {}, target) {
            const productId = toNum(item.productId);
            const isKhr = toNum(item.paymentType) === 1;
            const currency = isKhr ? "KHR" : "USD";
            const currencySymbol = productId ? (isKhr ? "៛" : "$") : "—";
            const emptyReadOnly = productId ? "" : "readonly";

            const row = target ?? document.createElement("tr");
            if (productId > 0) row.dataset.paymentProductId = String(productId);
            destroyPaymentItemPickers($(row));
            $(row).html(`
                <td class="text-center text-muted" data-payment-row-number></td>
                <td class="hide-col"><input type="text" data-invoice-detail="InvoiceDetailId" value="${toNum(item.invoiceDetailId)}" /></td>
                <td class="hide-col"><input type="text" data-invoice-detail="InvoiceId" value="${toNum(item.invoiceId)}" /></td>
                <td class="hide-col"><input type="text" data-invoice-detail="ProductId" value="${productId}" /></td>
                <td class="payment-item-name">
                    <select class="form-control form-control-sm payment-product-picker payment-product-name" aria-label="Item description">
                        <option value=""></option>
                    </select>
                </td>
                <td> 
                    <input type="number" data-invoice-detail="Qty" value="${toNum(item.qty)}"
                           class="form-control form-control-sm text-right payment-item-qty" aria-label="Quantity" min="1" ${emptyReadOnly} />
                </td>
                <td>
                    <div class="input-group input-group-sm payment-item-amount">
                        <input type="${isKhr ? "number" : "hidden"}" data-invoice-detail="PriceKhr" value="${toNum(item.priceKhr)}"
                               class="form-control text-right" aria-label="Unit price in KHR" readonly />
                        <input type="${isKhr ? "hidden" : "number"}" data-invoice-detail="PriceUsd" value="${toNum(item.priceUsd)}"
                               class="form-control text-right" aria-label="Unit price in USD" readonly />
                        <div class="input-group-append"> 
                            <span class="input-group-text" aria-hidden="true">${currencySymbol}</span>
                        </div>
                    </div>
                </td>
                <td class="hide-col"> 
                    <input type="number" data-invoice-detail="TotalKhr" value="${toNum(item.totalKhr)}" class="form-control form-control-sm" readonly/>
                </td>
                <td class="hide-col"> 
                    <input type="number" data-invoice-detail="TotalUsd" value="${toNum(item.totalUsd)}" class="form-control form-control-sm" readonly/>
                </td>
                <td class="hide-col"> 
                    <input type="number" data-invoice-detail="Type" value="${toNum(item.type)}" class="form-control form-control-sm"  readonly/>
                </td>
                <td class="hide-col"> 
                    <input type="number" data-invoice-detail="Vat" value="${toNum(item.vat)}" class="form-control form-control-sm"  readonly/>
                </td>
                <td>
                    <div class="input-group input-group-sm payment-item-amount">
                        <input type="number" data-invoice-detail="DiscountPercent" value="${toNum(item.discountPercent)}"
                               class="form-control text-right" aria-label="Discount percentage" min="0" ${emptyReadOnly} />
                        <div class="input-group-append"> 
                            <span class="input-group-text" aria-hidden="true">%</span>
                        </div>
                    </div>
                </td>
                <td class="hide-col"> 
                    <input type="number" data-invoice-detail="DiscountKhr" value="${toNum(item.discountKhr)}" class="form-control form-control-sm"  readonly/>
                </td>
                <td class="hide-col"> 
                    <input type="number" data-invoice-detail="DiscountUsd" value="${toNum(item.discountUsd)}" class="form-control form-control-sm"  readonly/>
                </td>
                <td>
                    <div class="input-group input-group-sm payment-item-amount">
                        <input type="${isKhr ? "number" : "hidden"}" data-invoice-detail="OweKhr" value="${toNum(item.oweKhr)}"
                               class="form-control text-right" aria-label="Owe in ${currency}" min="0" ${emptyReadOnly} />
                        <input type="${isKhr ? "hidden" : "number"}" data-invoice-detail="OweUsd" value="${toNum(item.oweUsd)}"
                               class="form-control text-right" aria-label="Owe in ${currency}" min="0" ${emptyReadOnly} />
                        <div class="input-group-append"> 
                            <span class="input-group-text" aria-hidden="true">${currencySymbol}</span>
                        </div>
                    </div>
                </td>
                <td > 
                    <div class="input-group input-group-sm payment-item-amount">
                        <input type="${isKhr ? "number" : "hidden"}" data-invoice-detail="OtherKhr" value="${toNum(item.otherKhr)}"
                               class="form-control text-right" aria-label="Other amount in ${currency}" min="0" ${emptyReadOnly} />
                        <input type="${isKhr ? "hidden" : "number"}" data-invoice-detail="OtherUsd" value="${toNum(item.otherUsd)}"
                               class="form-control text-right" aria-label="Other amount in ${currency}" min="0" ${emptyReadOnly} />
                        <div class="input-group-append"> 
                            <span class="input-group-text" aria-hidden="true">${currencySymbol}</span>
                        </div>
                    </div>
                </td>
                <td>
                    <div class="input-group input-group-sm payment-item-amount payment-item-total">
                        <span class="form-control text-right font-weight-bold" data-payment-line-total="usd">0.00</span>
                        <div class="input-group-append"><span class="input-group-text" aria-hidden="true">$</span></div>
                    </div>
                </td>
                <td>
                    <div class="input-group input-group-sm payment-item-amount payment-item-total">
                        <span class="form-control text-right font-weight-bold" data-payment-line-total="khr">0</span>
                        <div class="input-group-append"><span class="input-group-text" aria-hidden="true">៛</span></div>
                    </div>
                </td>
                <td  class="hide-col"> 
                    <input type="number" data-invoice-detail="GrandTotalKhr" value="${toNum(item.grandTotalKhr)}" class="form-control form-control-sm"  readonly/>
                </td>
                <td  class="hide-col"> 
                    <input type="number" data-invoice-detail="GrandTotalUsd" value="${toNum(item.grandTotalUsd)}" class="form-control form-control-sm" readonly />
                </td >
                <td class="hide-col"> 
                    <input type="number" data-invoice-detail="PayKhr" value="${toNum(item.payKhr)}" class="form-control form-control-sm" min="0"/>
                </td>
                <td class="hide-col"> 
                    <input type="number" data-invoice-detail="PayUsd" value="${toNum(item.payUsd)}" class="form-control form-control-sm" min="0"/>
                </td>
                <td  class="hide-col"> 
                    <input type="text" data-invoice-detail="PayBath" value="${toNum(item.payBath)}" class="form-control form-control-sm" readonly/>
                </td>
                <td class="hide-col"> 
                    <input type="text" data-invoice-detail="Tuitionfees" value="${toNum(item.tuitionFees ?? item.tuitionfees)}" class="form-control form-control-sm" readonly/>
                </td>
                <td class="hide-col"> 
                    <input type="text" data-invoice-detail="CardCertificate" value="${toNum(item.cardCertificate)}" class="form-control form-control-sm" readonly/>
                </td>
                <td  class="hide-col"> 
                    <input type="text" data-invoice-detail="CategoryId" value="${toNum(item.categoryId)}" class="form-control form-control-sm" readonly/>
                </td>
                <td  class="hide-col"> 
                    <input type="text" data-invoice-detail="PaymentType" value="${isKhr}" class="form-control form-control-sm" readonly/>
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-outline-danger btn-sm btn-remove-payment-item"
                            title="Remove item" aria-label="Remove item">
                        <i class="fas fa-times" aria-hidden="true"></i>
                    </button>
                </td>
            `);
            if (!target) tblInvoiceDetail.find("tbody")[0].appendChild(row);
            if (productId > 0) {
                const id = String(productId);
                const names = paymentProductNames(item, id);
                const option = new Option(names.text, id, true, true);
                option.dataset.khmer = names.khmer;
                option.lang = names.primaryLanguage;
                $(row).find(".payment-product-name").append(option);
            }
            initializePaymentItemPickers(row);
            return row;
        }

        function reindexInvoiceDetailRows() {
            let detailIndex = 0;
            tblInvoiceDetail.find("tbody tr")
                .each(function (rowIndex) {
                    const row = $(this);
                    row.find("[data-payment-row-number]").text(rowIndex + 1);
                    if (!this.dataset.paymentProductId) return;

                    row.find("[data-invoice-detail]").each(function () {
                        this.name = `invoiceDetails[${detailIndex}].${this.dataset.invoiceDetail}`;
                    });
                    detailIndex++;
                });
        }

        tblInvoiceDetail.on("click", ".btn-remove-payment-item", function () {
            if (savePaymentRequest || invoiceDetailRequest || invoiceDeletionPending) return;

            const row = $(this).closest("tr");
            const nextRemoveButton = row.next().find(".btn-remove-payment-item");
            destroyPaymentItemPickers(row);
            row.remove();
            if (!tblInvoiceDetail.find("tbody tr").length) {
                renderPaymentItemRow();
            }
            reindexInvoiceDetailRows();
            calculateInvoiceTotals();
            updatePaymentEditorAvailability();
            (nextRemoveButton.length ? nextRemoveButton : btnAddPaymentItem)
                .trigger("focus");
        });

        tblInvoiceDetail.on('input', 'input[name*=".Qty"]', function (e) {
            const row = e.target.closest('tr');
            row.querySelector('[data-invoice-detail="DiscountPercent"]').value = 0;
            row.querySelector('[data-invoice-detail="DiscountKhr"]').value = 0;
            row.querySelector('[data-invoice-detail="DiscountUsd"]').value = 0;
            row.querySelector('[data-invoice-detail="OweKhr"]').value = 0;
            row.querySelector('[data-invoice-detail="OweUsd"]').value = 0;
            row.querySelector('[data-invoice-detail="OtherKhr"]').value = 0;
            row.querySelector('[data-invoice-detail="OtherUsd"]').value = 0;

            // Get and validate Qty
            const qtyInput = row.querySelector('[data-invoice-detail="Qty"]');
            if (qtyInput.value.trim() === "") {
                qtyInput.value = 1;
            }

            const qty = parseFloat(qtyInput.value);
            if (isNotValid(qty)) return;

            const priceKhr = parseFloat(row.querySelector('[data-invoice-detail="PriceKhr"]').value);
            const priceUsd = parseFloat(row.querySelector('[data-invoice-detail="PriceUsd"]').value);

            const grandTotalKhr = (qty * priceKhr).toFixed(0);
            const grandTotalUsd = (qty * priceUsd).toFixed(2);

            row.querySelector('[data-invoice-detail="GrandTotalKhr"]').value = grandTotalKhr;
            row.querySelector('[data-invoice-detail="GrandTotalUsd"]').value = grandTotalUsd;

            row.querySelector('[data-invoice-detail="TotalKhr"]').value = grandTotalKhr;
            row.querySelector('[data-invoice-detail="TotalUsd"]').value = grandTotalUsd;

            row.querySelector('[data-invoice-detail="PayKhr"]').value = grandTotalKhr;
            row.querySelector('[data-invoice-detail="PayUsd"]').value = grandTotalUsd;
        });

        tblInvoiceDetail.on('input', 'input[name*=".DiscountPercent"]', function (e) {
            const row = e.target.closest('tr');

            row.querySelector('[data-invoice-detail="OweKhr"]').value = 0;
            row.querySelector('[data-invoice-detail="OweUsd"]').value = 0;
            row.querySelector('[data-invoice-detail="OtherKhr"]').value = 0;
            row.querySelector('[data-invoice-detail="OtherUsd"]').value = 0;

            const input = row.querySelector('[data-invoice-detail="DiscountPercent"]');
            if (input.value.trim() === "") {
                input.value = 0;
            }

            const discountPercent = parseFloat(input.value);
            if(isNotValid(discountPercent)) return;

            const grandTotalKhr = parseFloat(row.querySelector('[data-invoice-detail="GrandTotalKhr"]').value);
            const grandTotalUsd = parseFloat(row.querySelector('[data-invoice-detail="GrandTotalUsd"]').value);

            if(isNotValid(grandTotalKhr) || isNotValid(grandTotalUsd)) return;

            const totalDiscountKhr = (grandTotalKhr * discountPercent) / 100;
            const totalDiscountUsd = (grandTotalUsd * discountPercent) / 100;

            const totalKhr = grandTotalKhr - totalDiscountKhr;
            const totalUsd = grandTotalUsd - totalDiscountUsd;

            row.querySelector('[data-invoice-detail="DiscountKhr"]').value = totalDiscountKhr.toFixed(0);
            row.querySelector('[data-invoice-detail="DiscountUsd"]').value = totalDiscountUsd.toFixed(2);

            row.querySelector('[data-invoice-detail="TotalKhr"]').value = totalKhr.toFixed(0);
            row.querySelector('[data-invoice-detail="TotalUsd"]').value = totalUsd.toFixed(2);

            row.querySelector('[data-invoice-detail="PayKhr"]').value = totalKhr.toFixed(0);
            row.querySelector('[data-invoice-detail="PayUsd"]').value = totalUsd.toFixed(2);
        });

        tblInvoiceDetail.on('input', 'input[name*=".OweKhr"]', function (e) {
            const row = e.target.closest('tr');

            const input = row.querySelector('[data-invoice-detail="OweKhr"]');
            if (input.value.trim() === "") {
                input.value = 0;
            }

            const oweKhr = parseFloat(input.value);
            const discountKhr = parseFloat(row.querySelector('[data-invoice-detail="DiscountKhr"]').value);
            const grandTotalKhr = parseFloat(row.querySelector('[data-invoice-detail="GrandTotalKhr"]').value);

            if(isNotValid(oweKhr) || isNotValid(discountKhr) || isNotValid(grandTotalKhr))return;

            const totalKhr = grandTotalKhr - oweKhr - discountKhr;
            row.querySelector('[data-invoice-detail="TotalKhr"]').value = totalKhr.toFixed(0);
            row.querySelector('[data-invoice-detail="PayKhr"]').value = totalKhr.toFixed(0);
        });

        tblInvoiceDetail.on('input', 'input[name*=".OweUsd"]', function (e) {
            const row = e.target.closest('tr');

            const input = row.querySelector('[data-invoice-detail="OweUsd"]');
            if (input.value.trim() === "") {
                input.value = 0;
            }

            const oweUsd = parseFloat(input.value);
            const discountUsd = parseFloat(row.querySelector('[data-invoice-detail="DiscountUsd"]').value);
            const grandTotalUsd = parseFloat(row.querySelector('[data-invoice-detail="GrandTotalUsd"]').value);

            if(isNotValid(oweUsd) || isNotValid(discountUsd) || isNotValid(grandTotalUsd)) return;

            const totalUsd = grandTotalUsd - oweUsd - discountUsd;
            row.querySelector('[data-invoice-detail="TotalUsd"]').value = totalUsd.toFixed(0);
            row.querySelector('[data-invoice-detail="PayUsd"]').value = totalUsd.toFixed(0);
        });

        tblInvoiceDetail.on('input', 'input[name*=".OtherKhr"]', function (e) {
            const row = e.target.closest('tr');

            const input = row.querySelector('[data-invoice-detail="OtherKhr"]');
            if (input.value.trim() === "") {
                input.value = 0;
            }

            const otherKhr = parseFloat(input.value);

            const oweKhr = parseFloat(row.querySelector('[data-invoice-detail="OweKhr"]').value);
            const discountKhr = parseFloat(row.querySelector('[data-invoice-detail="DiscountKhr"]').value);
            const grandTotalKhr = parseFloat(row.querySelector('[data-invoice-detail="GrandTotalKhr"]').value);

            if(isNotValid(otherKhr) || isNotValid(oweKhr) || isNotValid(discountKhr) || isNotValid(grandTotalKhr))return;
            const totalKhr = grandTotalKhr - oweKhr - discountKhr - otherKhr;
            row.querySelector('[data-invoice-detail="TotalKhr"]').value = totalKhr.toFixed(0);
            row.querySelector('[data-invoice-detail="PayKhr"]').value = totalKhr.toFixed(0);
        });

        tblInvoiceDetail.on('input', 'input[name*=".OtherUsd"]', function (e) {
            const row = e.target.closest('tr');

            const input = row.querySelector('[data-invoice-detail="OtherUsd"]');
            if (input.value.trim() === "") {
                input.value = 0;
            }

            const otherUsd = parseFloat(input.value);
            const oweUsd = parseFloat(row.querySelector('[data-invoice-detail="OweUsd"]').value);
            const discountUsd = parseFloat(row.querySelector('[data-invoice-detail="DiscountUsd"]').value);
            const grandTotalUsd = parseFloat(row.querySelector('[data-invoice-detail="GrandTotalUsd"]').value);

            if(isNotValid(otherUsd) || isNotValid(oweUsd) || isNotValid(discountUsd) || isNotValid(grandTotalUsd)) return;
            const totalUsd = grandTotalUsd - oweUsd - discountUsd - otherUsd;

            row.querySelector('[data-invoice-detail="TotalUsd"]').value = totalUsd.toFixed(0);

            row.querySelector('[data-invoice-detail="PayUsd"]').value = totalUsd.toFixed(0);
        });

        tblInvoiceDetail.on('input', 'input[name*=".PayKhr"]', function (e) {
            const row = e.target.closest('tr');

            const input = row.querySelector('[data-invoice-detail="PayKhr"]');
            if (input.value.trim() === "") {
                input.value = 0;
            }
            let payKhr = 0;
            const rateIn = parseFloat(txtRateIn.text());
            const rateOut = parseFloat(txtRateOut.text());

            const totalKhr = row.querySelector('[data-invoice-detail="TotalKhr"]');
            const totalUsd = row.querySelector('[data-invoice-detail="TotalUsd"]');

            const paymentType = row.querySelector('[data-invoice-detail="PaymentType"]').value;
            if(isNotValid(payKhr) || isNotValid(rateIn) || isNotValid(totalKhr.value) || isNotValid(totalUsd.value) || isNotValid(paymentType)) return;

            let payUsd = 0;
            if(paymentType){
                if(parseFloat(input.value) >= totalKhr.value){
                    input.value = totalKhr.value;
                }
                payKhr = parseFloat(input.value);
                payUsd = (totalKhr.value - payKhr) / rateIn;
            }else{
                if(parseFloat(input.value) / rateIn >= totalUsd){
                    input.value = totalUsd.value * rateIn;
                }
                payKhr = parseFloat(input.value);
                console.log(`Pay Khr=${payKhr}, Pay Khr/Rate In= ${payKhr/rateIn}, pay usd = ${totalUsd.value}`);
                payUsd = (totalUsd.value - (payKhr /rateIn));
                console.log(`Pay Usd=${payUsd}`);
            }
            const roundPayUsd = Math.round(payUsd);
            console.log(`Pay Usd=${roundPayUsd}`);
            row.querySelector('[data-invoice-detail="PayUsd"]').value = roundPayUsd.toString();
        });

        tblInvoiceDetail.on('input', 'input[name*=".PayUsd"]', function (e) {
            const row = e.target.closest('tr');

            const inputPayUsd = row.querySelector('[data-invoice-detail="PayUsd"]');
            if (inputPayUsd.value.trim() === "") {
                inputPayUsd.value = 0;
            }
            let payUsd = 0;

            const rateIn = parseFloat(txtRateIn.text());
            const rateOut = parseFloat(txtRateOut.text());

            const totalKhr = row.querySelector('[data-invoice-detail="TotalKhr"]');
            const totalUsd = row.querySelector('[data-invoice-detail="TotalUsd"]');

            const paymentType = row.querySelector('[data-invoice-detail="PaymentType"]').value;

            if(isNotValid(payUsd) || isNotValid(rateIn) || isNotValid(totalKhr.value) || isNotValid(totalUsd.value) || isNotValid(paymentType)) return;

            let payKhr = 0;
            if(paymentType){
                if(parseFloat(inputPayUsd.value) >= (totalKhr.value / rateIn)){
                    inputPayUsd.value = totalKhr.value / rateIn
                }
                payUsd = parseFloat(inputPayUsd.value);
                payKhr = (totalUsd.value - (payUsd * rateIn));
            }else{
                if(parseFloat(inputPayUsd.value) >= totalUsd.value){
                    inputPayUsd.value = totalUsd.value;
                }
                payUsd = parseFloat(inputPayUsd.value);
                payKhr = (totalUsd.value - payUsd) * rateIn;
            }
            const roundPayKhr = Math.round(payKhr /100) * 100;
            row.querySelector('[data-invoice-detail="PayKhr"]').value = roundPayKhr.toString();
        });

        tblInvoiceDetail.on('input', 'input', function () {
            calculateInvoiceTotals();
        });

        function calculateInvoiceTotals() {
            let grandTotalUsd = 0;
            let grandTotalKhr = 0;
            let totalDiscountKhr = 0;
            let totalDiscountUsd = 0;
            let totalOweUsd = 0;
            let totalOweKhr = 0;
            let totalOtherUsd = 0;
            let totalOtherKhr = 0;
            let totalUsd = 0;
            let totalKhr = 0;
            let totalPayUsd = 0;
            let totalPayKhr = 0;
            let invoiceVat = 0;

            const rows = tblInvoiceDetail.find("tbody tr[data-payment-product-id]").toArray();
            const formatUsd = new Intl.NumberFormat(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            const formatKhr = new Intl.NumberFormat(undefined, { maximumFractionDigits: 0 });

            rows.forEach(row => {
                const qty = toNum(row.querySelector('[data-invoice-detail="Qty"]')?.value);
                const priceKhr = toNum(row.querySelector('[data-invoice-detail="PriceKhr"]')?.value);
                const priceUsd = toNum(row.querySelector('[data-invoice-detail="PriceUsd"]')?.value);
                const discountPercent = toNum(row.querySelector('[data-invoice-detail="DiscountPercent"]')?.value);
                const oweKhr = toNum(row.querySelector('[data-invoice-detail="OweKhr"]')?.value);
                const oweUsd = toNum(row.querySelector('[data-invoice-detail="OweUsd"]')?.value);
                const otherKhr = toNum(row.querySelector('[data-invoice-detail="OtherKhr"]')?.value);
                const otherUsd = toNum(row.querySelector('[data-invoice-detail="OtherUsd"]')?.value);
                const payKhr = toNum(row.querySelector('[data-invoice-detail="PayKhr"]')?.value);
                const payUsd = toNum(row.querySelector('[data-invoice-detail="PayUsd"]')?.value);
                const vat = toNum(row.querySelector('[data-invoice-detail="Vat"]')?.value);


                // ---- Calculate item totals ----
                const grandKhr = qty * priceKhr;
                const grandUsd = qty * priceUsd;

                const discountKhr = (grandKhr * discountPercent) / 100;
                const discountUsd = (grandUsd * discountPercent) / 100;

                const subTotalKhr = grandKhr - discountKhr - oweKhr - otherKhr;
                const subTotalUsd = grandUsd - discountUsd - oweUsd - otherUsd;

                // ---- Update row fields ----
                const grandKhrInput = row.querySelector('[data-invoice-detail="GrandTotalKhr"]');
                const grandUsdInput = row.querySelector('[data-invoice-detail="GrandTotalUsd"]');
                const discountKhrInput = row.querySelector('[data-invoice-detail="DiscountKhr"]');
                const discountUsdInput = row.querySelector('[data-invoice-detail="DiscountUsd"]');
                const totalKhrInput = row.querySelector('[data-invoice-detail="TotalKhr"]');
                const totalUsdInput = row.querySelector('[data-invoice-detail="TotalUsd"]');
                if (grandKhrInput) grandKhrInput.value = grandKhr.toFixed(0);
                if (grandUsdInput) grandUsdInput.value = grandUsd.toFixed(2);
                if (discountKhrInput) discountKhrInput.value = discountKhr.toFixed(0);
                if (discountUsdInput) discountUsdInput.value = discountUsd.toFixed(2);
                if (totalKhrInput) totalKhrInput.value = subTotalKhr.toFixed(0);
                if (totalUsdInput) totalUsdInput.value = subTotalUsd.toFixed(2);
                row.querySelector('[data-payment-line-total="usd"]').textContent = formatUsd.format(subTotalUsd);
                row.querySelector('[data-payment-line-total="khr"]').textContent = formatKhr.format(subTotalKhr);

                // ---- Add to summary totals ----
                grandTotalKhr += grandKhr;
                grandTotalUsd += grandUsd;
                totalDiscountKhr += discountKhr;
                totalDiscountUsd += discountUsd;
                totalOweKhr += oweKhr;
                totalOweUsd += oweUsd;
                totalOtherKhr += otherKhr;
                totalOtherUsd += otherUsd;
                totalKhr +=subTotalKhr;
                totalUsd +=subTotalUsd
                totalPayKhr += payKhr;
                totalPayUsd += payUsd;
                invoiceVat = Math.max(invoiceVat, vat);
            });
            $("#invoice_Vat").val(invoiceVat);
            $("#invoice_GrandTotalKhr").val(grandTotalKhr);
            $("#invoice_TotalDiscountKhr").val(totalDiscountKhr);
            $("#invoice_OweKhr").val(totalOweKhr);
            $("#invoice_TotalOtherKhr").val(totalOtherKhr);
            $("#invoice_TotalRiel").val(totalKhr);
            $("#invoice_TotalPayKhr").val(totalPayKhr);

            $("#invoice_GrandTotalUsd").val(grandTotalUsd);
            $("#invoice_TotalDiscountUsd").val(totalDiscountUsd);
            $("#invoice_OweUsd").val(totalOweUsd);
            $("#invoice_TotalOtherUsd").val(totalOtherUsd);
            $("#invoice_TotalDollar").val(totalUsd);
            $("#invoice_TotalPayUsd").val(totalPayUsd);

            const itemCount = rows.length;
            $("#paymentDetailItemCount").text(itemCount + (itemCount === 1 ? " item" : " items"));
            $("#paymentDetailGrandKhr").text(formatKhr.format(grandTotalKhr));
            $("#paymentDetailGrandUsd").text(formatUsd.format(grandTotalUsd));
        }
        btnClosePayment.on('click', function () {
            modalPayment.modal("hide");
        });
    })(window.paymentPageJQuery || window.jQuery);
</script>
