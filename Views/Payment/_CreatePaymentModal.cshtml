        function handlePaymentStudentLoadError(message) {
            btnCreateNewPayment.prop("disabled", true);
            if (startNewPayment) {
                selectedStudentField.val("");
                paymentInlineStudent.val(null).trigger("change.select2");
                paymentStudentFeedback.text(message).prop("hidden", false);
                clearPaymentInvoiceHistory();
                return;
            }
            showCreatePaymentError(message);
