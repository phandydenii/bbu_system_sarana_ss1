    tblInvoice.on("click", ".btn-delete-invoice", function () {
        const invoiceId = Number($(this).data("invoice-id"));
        if (invoiceId <= 0) return;

        const deletePayment = function () {
            $.ajax({
                url: `/payment/delete-invoice/${invoiceId}`,
                type: "DELETE",
                headers: {
                    "RequestVerificationToken":
                        getAntiForgeryToken()
                },
                success: function (response) {
                    if (String(response?.status?.code) === "200") {
                        ShowToastSuccess(response.status.message);
                        tblInvoice.DataTable().ajax.reload(null, false);
                        return;
                    }

                    ShowToastError(
                        response?.status?.message ??
                        "Cannot delete payment."
                    );
                },
                error: function (xhr) {
                    ShowToastError(
                        xhr.responseJSON?.status?.message ??
                        xhr.responseJSON?.message ??
                        "Cannot delete payment."
                    );
                }
            });
        };

        if (typeof Swal !== "undefined") {
            Swal.fire({
                title: "Delete payment?",
                text: "This payment and all of its items will be deleted.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#d33",
                confirmButtonText: "Delete"
            }).then(result => {
                if (result.isConfirmed) deletePayment();
            });
            return;
        }

        if (window.confirm(
            "Delete this payment and all of its items?")) {
            deletePayment();
        }
    });

    function fillInvoiceForm(invoiceData) {
        Object.entries(invoiceData).forEach(([key, value]) => {
            const pascalKey =
                key.charAt(0).toUpperCase() + key.slice(1);
            const input = document.getElementById(
                `invoice_${pascalKey}`
            );

            if (!input) return;

            if (input.type === "date" && value) {
                input.value = String(value).substring(0, 10);
            } else {
                input.value = value ?? "";
            }
        });
    }

    function applyMissingAcademicToPaymentForm(invoiceData) {
        const fallbackValues = {
            degreeId: selectedAcademic.degreeId,
            schoolId: selectedAcademic.schoolId,
            fieldId: selectedAcademic.fieldId,
            promotionId: selectedAcademic.promotionId,
            stageId: selectedAcademic.stageId,
            termNo: selectedAcademic.termNo,
            groupId: selectedAcademic.groupId,
            startDate: selectedAcademic.startDate,
            endDate: selectedAcademic.endDate,
            exchangeRateId: selectedExchangeRateId
        };

        Object.entries(fallbackValues).forEach(([key, fallback]) => {
            const currentValue = invoiceData?.[key];
            if (currentValue !== null &&
                currentValue !== undefined &&
                String(currentValue).trim() !== "") {
                return;
            }

            const pascalKey =
                key.charAt(0).toUpperCase() + key.slice(1);

            formPayment
                .find(`[name='invoice.${pascalKey}']`)
                .val(fallback ?? "");
        });
    }

