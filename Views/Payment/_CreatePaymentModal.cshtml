    $(document)
        .off(
            "click.selectPaymentProduct",
            "#tblProduct .js-select-product, #tblProduct #btnSelect"
        )
        .on(
            "click.selectPaymentProduct",
            "#tblProduct .js-select-product, #tblProduct #btnSelect",
            function (event) {
        event.preventDefault();

        let rowElement = $(this).closest("tr");

        if (rowElement.hasClass("child")) {
            rowElement = rowElement.prev();
        }

        const productTable = tblProduct.DataTable();
        const product = productTable.row(rowElement).data();

        if (!product) {
            console.error("Selected product row could not be read.");
            return;
        }

        const productId = String(product.productId ?? "").trim();

        if (!productId || selectedProducts.has(productId)) {
            return;
        }

        selectedProducts.set(productId, product);

        const optionText = `${productId} - ${product.productName || ""}`;
        stateSelect.append(
            new Option(optionText, productId, true, true)
        ).trigger("change");

        renderSelectedProducts();
        updateProductSelectButtons();
            }
        );

