    function reindexInvoiceDetailRows() {
        $("#tblInvoiceDetail tbody tr")
            .not("#emptyInvoiceDetailRow")
            .each(function (rowIndex) {
                $(this).find("[name^='invoiceDetails[']")
                    .each(function () {
                        this.name = this.name.replace(
                            /^invoiceDetails\[\d+\]/,
                            `invoiceDetails[${rowIndex}]`
                        );
                    });
            });
    }

    tblInvoiceDetail
        .off("click.deletePaymentItem")
        .on(
            "click.deletePaymentItem",
            ".btn-delete-payment-item",
            function () {
                const row = $(this).closest("tr");

                const removeItem = function () {
                    row.fadeOut(180, function () {
                        $(this).remove();
                        reindexInvoiceDetailRows();
                        calculateInvoiceTotals();

                        const hasItems =
                            $("#tblInvoiceDetail tbody tr")
                                .not("#emptyInvoiceDetailRow")
                                .length > 0;

                        btnSavePayment.prop(
                            "disabled",
                            !hasItems
                        );

                        if (!hasItems) {
                            showEmptyInvoiceDetail();
                        }
                    });
                };

                if (typeof Swal !== "undefined") {
                    Swal.fire({
                        title: "Delete this item?",
                        text: "The item will be removed from this payment.",
                        icon: "warning",
                        showCancelButton: true,
                        confirmButtonColor: "#dc3545",
                        cancelButtonColor: "#6c757d",
                        confirmButtonText: "Delete"
                    }).then(function (result) {
                        if (result.isConfirmed) {
                            removeItem();
                        }
                    });
                    return;
                }

                if (window.confirm(
                    "Delete this item from the payment?"
                )) {
                    removeItem();
                }
            }
        );

