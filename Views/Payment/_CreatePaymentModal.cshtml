            const existingHistory = formPayment.find("#paymentInvoiceHistory");
            if (existingHistory.length) {
                const headers = existingHistory.find("#tblPaymentInvoiceHistory thead tr");
                if (headers.find("th").length === tblInvoice.find("thead th").length - 1) {
                    headers.append('<th scope="col">Action</th>');
