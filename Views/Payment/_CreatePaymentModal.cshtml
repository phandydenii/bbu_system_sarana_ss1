@model BBU_SYSTEM.ViewModel.PaymentViewModel
@using BBU_SYSTEM.DTOs
@{
ViewData["OpenMenu"] = "Administration";
ViewData["Action"] = "Create";
var student = new Student();
var degree = new Degree();
var school = new School();
var field = new Field();
var promotion = new Promotion();
var stage = new Stage();
var term = new Term();
var product = new Product();
var group = new GroupDto();
var groupRoom = new GroupRoomDto();
var invoice = new InvoiceDto();
var selectedStudentId = (ViewBag.SelectedStudentId as string ?? "").Trim();
}

<style>
    #CreateStudentPaymentModal {
        padding-right: 0 !important;
    }

    #CreateStudentPaymentModal .create-payment-dialog {
        width: 100vw;
        max-width: none;
        height: 100vh;
        margin: 0;
    }

    #CreateStudentPaymentModal .create-payment-content {
        height: 100vh;
        max-height: 100vh;
        border: 0;
        border-radius: 0;
        overflow: hidden;
    }

    #CreateStudentPaymentModal.payment-modal-windowed .create-payment-dialog {
        width: calc(100vw - 40px);
        max-width: 1400px;
        height: calc(100vh - 40px);
        margin: 20px auto;
    }

    #CreateStudentPaymentModal.payment-modal-windowed .create-payment-content {
        height: 100%;
        max-height: 100%;
        border: 1px solid rgba(0, 0, 0, .15);
        border-radius: .3rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, .22);
    }

    #CreateStudentPaymentModal .create-payment-body {
        min-height: 0;
        padding: 14px;
        overflow-x: hidden;
        overflow-y: auto;
        background: #f4f6f9;
    }

    #CreateStudentPaymentModal .create-payment-modal-title {
        display: flex;
        align-items: center;
        gap: .55rem;
        margin: 0;
        font-size: 1.25rem;
        font-weight: 600;
    }

    #CreateStudentPaymentModal .create-payment-modal-title i {
        color: #191970;
    }

    #CreateStudentPaymentModal .modal-header {
        flex: 0 0 auto;
        background: #fff;
    }

    #CreateStudentPaymentModal .payment-modal-header-actions {
        display: flex;
        align-items: center;
        gap: .35rem;
    }

    #CreateStudentPaymentModal .payment-modal-size-btn {
        width: 34px;
        height: 34px;
        padding: 0;
        color: #191970;
        border: 0;
        border-radius: .25rem;
        background: transparent;
    }

    #CreateStudentPaymentModal .payment-modal-size-btn:hover,
    #CreateStudentPaymentModal .payment-modal-size-btn:focus {
        color: #0f0f55;
        background: #f1f3f5;
        box-shadow: none;
    }

    #CreateStudentPaymentModal .payment-modal-close-btn {
        width: 34px;
        height: 34px;
        margin: 0;
        padding: 0;
    }

    #CreateStudentPaymentModal .modal-footer {
        flex: 0 0 auto;
        padding: .75rem 1rem;
        background: #fff;
    }

    .payment-page-card {
        border: 0;
        border-radius: 12px;
        box-shadow: 0 4px 18px rgba(25, 42, 70, .10);
        overflow: hidden;
    }

    .payment-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 1.25rem;
        background: #fff;
        border-bottom: 1px solid #e5e9f0;
    }

    .payment-page-title {
        display: flex;
        align-items: center;
        gap: .75rem;
        min-width: 0;
    }

    .payment-page-title-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        border-radius: 10px;
        color: #fff;
        background: #191970;
        box-shadow: 0 4px 10px rgba(25, 25, 112, .22);
    }

    .payment-page-title h3 {
        margin: 0;
        color: #1f2937;
        font-size: 1.15rem;
        font-weight: 700;
    }

    .payment-page-title p {
        margin: .15rem 0 0;
        color: #6b7280;
        font-size: .82rem;
    }

    .payment-create-btn {
        min-width: 190px;
        min-height: 42px;
        border: 0;
        border-radius: 8px;
        background: #191970;
        box-shadow: 0 3px 8px rgba(25, 25, 112, .20);
        font-weight: 600;
    }

    .payment-create-btn:hover,
    .payment-create-btn:focus {
        background: #121257;
    }

    .payment-summary-row {
        margin-right: -8px;
        margin-left: -8px;
    }

    .payment-summary-row > [class*="col-"] {
        padding-right: 8px;
        padding-left: 8px;
    }

    .payment-info-panel {
        height: 100%;
        padding: 1rem;
        background: #fff;
        border: 1px solid #dfe4ec;
        border-top: 3px solid #191970;
        border-radius: 9px;
        box-shadow: 0 2px 8px rgba(25, 42, 70, .05);
    }

    .payment-section-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        margin-bottom: .85rem;
        padding-bottom: .7rem;
        border-bottom: 1px solid #e7eaf0;
    }

    .payment-section-title h4 {
        display: flex;
        align-items: center;
        gap: .5rem;
        margin: 0;
        color: #252f3f;
        font-size: .98rem;
        font-weight: 700;
    }

    .payment-section-title i {
        color: #191970;
    }

    .payment-section-hint {
        color: #8a94a6;
        font-size: .76rem;
        white-space: nowrap;
    }

    .payment-field {
        margin-bottom: .75rem;
    }

    .payment-field label {
        display: block;
        margin-bottom: .3rem;
        color: #374151;
        font-size: .78rem;
        font-weight: 700;
    }

    .payment-field .form-control {
        height: 40px;
        border-color: #d5dae3;
        border-radius: 7px;
        font-size: .88rem;
    }

    .payment-field .form-control[readonly] {
        color: #4b5563;
        background: #f3f5f8;
    }

    #selectedStudentId {
        color: #191970;
        font-weight: 700;
    }

    .invoice-history-panel {
        margin-top: 1rem;
        background: #fff;
        border: 1px solid #dfe4ec;
        border-radius: 9px;
        overflow: hidden;
    }

    .invoice-history-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: .85rem 1rem;
        background: #f8f9fc;
        border-bottom: 1px solid #dfe4ec;
    }

    .invoice-history-header h4 {
        display: flex;
        align-items: center;
        gap: .5rem;
        margin: 0;
        color: #252f3f;
        font-size: .98rem;
        font-weight: 700;
    }

    .invoice-history-header h4 i {
        color: #191970;
    }

    .invoice-history-header span {
        color: #6b7280;
        font-size: .78rem;
    }

    .invoice-table-wrap {
        padding: .75rem;
        overflow-x: auto;
    }

    #tblInvoice {
        width: 100% !important;
        margin-bottom: 0 !important;
        white-space: nowrap;
    }

    #tblInvoice thead th {
        padding: .7rem .55rem;
        color: #374151;
        background: #f2f4f8;
        border-color: #dce1e8;
        font-size: .78rem;
        font-weight: 700;
        vertical-align: middle;
    }

    #tblInvoice tbody td {
        padding: .5rem .55rem;
        border-color: #e0e4eb;
        font-size: .82rem;
        vertical-align: middle;
    }

    #tblInvoice_wrapper .dataTables_length,
    #tblInvoice_wrapper .dataTables_filter {
        margin-bottom: .65rem;
    }

    #tblInvoiceDetail .item-action-buttons {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .35rem;
        white-space: nowrap;
    }

    #btnSavePayment.is-saving {
        cursor: wait;
        opacity: .9;
    }

    #btnSavePayment.is-saving .saving-spinner {
        display: inline-block;
        margin-right: .35rem;
    }

    @@media (max-width: 991.98px) {
        .payment-info-panel {
            height: auto;
        }
    }

    @@media (max-width: 575.98px) {
        #CreateStudentPaymentModal.payment-modal-windowed .create-payment-dialog {
            width: 100vw;
            height: 100vh;
            margin: 0;
        }

        #CreateStudentPaymentModal.payment-modal-windowed .create-payment-content {
            border: 0;
            border-radius: 0;
        }

        .payment-page-header,
        .invoice-history-header {
            align-items: stretch;
            flex-direction: column;
        }

        .payment-create-btn {
            width: 100%;
            min-width: 0;
        }

        .payment-page-title p,
        .payment-section-hint,
        .invoice-history-header span {
            display: none;
        }

        .payment-info-panel {
            padding: .85rem;
        }
    }
</style>

<div class="modal fade"
     id="CreateStudentPaymentModal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="CreateStudentPaymentModalLabel"
     aria-hidden="true"
     data-backdrop="static"
     data-keyboard="false">
    <div class="modal-dialog modal-xl create-payment-dialog" role="document">
        <div class="modal-content create-payment-content">
            <div class="modal-header">
                <h4 class="create-payment-modal-title"
                    id="CreateStudentPaymentModalLabel">
                    <i class="fas fa-file-invoice-dollar"></i>
                    Student Payment
                </h4>

                <div class="payment-modal-header-actions">
                    <button type="button"
                            id="btnToggleCreatePaymentSize"
                            class="btn payment-modal-size-btn"
                            title="Exit full screen"
                            aria-label="Toggle modal size"
                            aria-pressed="false">
                        <i class="fas fa-compress"></i>
                    </button>

                    <button type="button"
                            class="close payment-modal-close-btn"
                            data-dismiss="modal"
                            aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            </div>

            <div class="modal-body create-payment-body">
                <form id="paymentForm" method="post">
                    @Html.AntiForgeryToken()
                    <div class="card payment-page-card mb-0">
        <div class="payment-page-header">
            <div class="payment-page-title">
                <span class="payment-page-title-icon">
                    <i class="fas fa-file-invoice-dollar"></i>
                </span>
                <div>
                    <h3>Create Student Payment</h3>
                    <p>Review the selected student and create or manage payment invoices.</p>
                </div>
            </div>

            <div class="d-flex flex-wrap justify-content-end" style="gap: .5rem;">
                <button id="btnCreateNewPayment"
                        type="button"
                        class="btn btn-primary payment-create-btn">
                    <i class="fas fa-plus-circle mr-1"></i>
                    Create New Payment
                </button>
            </div>
        </div>

        <div class="card-body">
            <div class="row payment-summary-row">
                <div class="col-xl-5 col-lg-12 mb-3 mb-xl-0">
                    <section class="payment-info-panel">
                        <div class="payment-section-title">
                            <h4>
                                <i class="fas fa-user-graduate"></i>
                                Student Information
                            </h4>
                            <span class="payment-section-hint">Selected student</span>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="payment-field">
                                    <label class="required">Student ID</label>
                                    <input type="text"
                                           id="selectedStudentId"
                                           name="selectedStudentId"
                                           value="@selectedStudentId"
                                           class="form-control"
                                           readonly/>
                                </div>
                            </div>

                            <div class="col-md-8">
                                <div class="payment-field">
                                    <label>Student Name</label>
                                    <input type="text" class="form-control" asp-for="@student.StudentName" readonly/>
                                </div>
                            </div>

                            <div class="col-md-8">
                                <div class="payment-field">
                                    <label>Student Name Khmer</label>
                                    <input type="text" class="form-control" asp-for="@student.StudentNameInKhmer" readonly/>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="payment-field">
                                    <label>Gender</label>
                                    <input type="text" class="form-control" asp-for="@student.Sex" readonly/>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="payment-field mb-md-0">
                                    <label>Date of Birth</label>
                                    <input type="text" class="form-control" asp-for="@student.DateOfBirth" readonly>
                                </div>
                            </div>

                            <div class="col-md-8">
                                <div class="payment-field mb-0">
                                    <label>Phone Number</label>
                                    <input type="text" class="form-control" asp-for="@student.Phone" readonly/>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="col-xl-7 col-lg-12">
                    <section class="payment-info-panel">
                        <div class="payment-section-title">
                            <h4>
                                <i class="fas fa-university"></i>
                                Academic Information
                            </h4>
                            <span class="payment-section-hint">Current academic record</span>
                        </div>

                        <div class="row">
                            <div class="col-md-3">
                                <div class="payment-field">
                                    <label>Degree</label>
                                    <input type="text" id="displayDegreeName" class="form-control" readonly>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="payment-field">
                                    <label>Promotion</label>
                                    <input type="text" id="displayPromotionNo" class="form-control" readonly>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="payment-field">
                                    <label>Stage</label>
                                    <input type="text" id="displayStageNo" class="form-control" readonly>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="payment-field">
                                    <label>Term</label>
                                    <input type="text" id="displayTermNo" class="form-control" readonly>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="payment-field">
                                    <label>School</label>
                                    <input type="text" id="displaySchoolName" class="form-control" readonly>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="payment-field">
                                    <label>Field</label>
                                    <input type="text" id="displayFieldName" class="form-control" readonly>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="payment-field mb-md-0">
                                    <label>Group</label>
                                    <input type="text" id="displayGroupName" class="form-control" readonly>
                                </div>
                            </div>

                            <input type="hidden" asp-for="@groupRoom.RoomName" readonly>

                            <div class="col-md-3">
                                <div class="payment-field mb-md-0">
                                    <label>Study Time</label>
                                    <input type="text" class="form-control" asp-for="@group.StudyTime" readonly>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="payment-field mb-md-0">
                                    <label>Start Date</label>
                                    <input type="text" id="displayStartDate" class="form-control" readonly>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="payment-field mb-0">
                                    <label>End Date</label>
                                    <input type="text" id="displayEndDate" class="form-control" readonly>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>

            <section class="invoice-history-panel">
                <div class="invoice-history-header">
                    <h4>
                        <i class="fas fa-history"></i>
                        Invoice History
                    </h4>
                    <span>Previous invoices for the selected student</span>
                </div>

                <div class="invoice-table-wrap">
                    <table id="tblInvoice" class="table table-bordered table-striped">
                        <thead>
                        <tr>
                            <th>ID</th>
                            <th>Invoice No.</th>
                            <th>Invoice Date</th>
                            <th>Term</th>
                            <th>Grand Total</th>
                            <th>Discount</th>
                            <th>VAT</th>
                            <th>Owe</th>
                            <th>Total Paid</th>
                            <th>Paid KHR</th>
                            <th>Paid USD</th>
                            <th>Action</th>
                        </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </section>
        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-danger"
                        data-dismiss="modal">
                    <i class="fas fa-times mr-1"></i>
                    Close
                </button>
            </div>
        </div>
    </div>
</div>
<partial name="_PaymentModal"/>
<script>
    (function ($) {
    if (!$ || !$.fn) {
        throw new Error("jQuery is not available for the payment modal.");
    }

    const btnCreateNewPayment = $("#btnCreateNewPayment");
    const btnSavePayment = $("#btnSavePayment");
    const btnNewItem = $("#btnNewItem");
    const tblInvoice = $("#tblInvoice");
    const tblInvoiceDetail = $("#tblInvoiceDetail");
    const btnSelectItem = $("#btnSelectItem");
    const tblProduct = $("#tblProduct");
    const btnSelect = $("#btnSelect");
    const btnAssignProduct = $("#btnAssignProduct");
    const btnCloseProduct = $("#btnCloseProduct");
    const btnClosePayment = $("#btnClosePayment");
    const btnToggleCreatePaymentSize = $("#btnToggleCreatePaymentSize");
    const stateSelect = $("#stateSelect");
    const selectedProductsList = $("#selectedProductsList");
    const selectedProductsEmpty = $("#selectedProductsEmpty");
    const selectedProductsCount = $("#selectedProductsCount");

    const modalPayment = $("#PaymentModal");
    const modalProduct = $("#ProductModal");
    const modalCreateStudentPayment = $("#CreateStudentPaymentModal");
    // _PaymentModal should use PaymentForm. The fallback keeps the page
    // working if the partial still uses the older lowercase id.
    const formPayment = $("#PaymentForm").length
        ? $("#PaymentForm")
        : $("#paymentForm");

    const txtRateIn = $("#txtRateIn");
    const txtRateOut = $("#txtRateOut");
    let savePaymentRequest = null;
    let savePaymentButtonHtml = "";
    let selectedAcademic = {};
    let selectedExchangeRateId = "";
    const selectedProducts = new Map();

    function initializeCreatePaymentModal() {
        try {
            formPayment.attr("novalidate", "novalidate");
            btnCreateNewPayment.prop("disabled", true);

            const studentId = String(
                $("#selectedStudentId").val() || ""
            ).trim();

            // When this partial is loaded through AJAX, document.ready has
            // already fired. Initialize the partial directly and load the
            // selected student before any optional payment setup.
            if (studentId) {
                loadSelectedStudent(studentId);
            } else if (!$.fn.DataTable.isDataTable("#tblInvoice")) {
                tblInvoice.DataTable();
            }
        } catch (error) {
            console.error("Create payment modal initialization error:", error);
            showCreatePaymentError(
                error?.message || "Unable to initialize the payment form."
            );
        }

        // Exchange-rate failure must not prevent student information from
        // loading into the modal.
        try {
            const exchangeRateRequest = GetExchangeRate();

            if (exchangeRateRequest?.catch) {
                exchangeRateRequest.catch(function (error) {
                    console.error("Cannot load exchange rate:", error);
                });
            }
        } catch (error) {
            console.error("Cannot start exchange-rate request:", error);
        }
    }

    window.setTimeout(initializeCreatePaymentModal, 0);

    modalCreateStudentPayment
        .off("hidden.bs.modal.createPayment")
        .on("hidden.bs.modal.createPayment", function () {
            ["#tblInvoice", "#tblInvoiceDetail", "#tblProduct"]
                .forEach(function (selector) {
                    if ($.fn.DataTable.isDataTable(selector)) {
                        $(selector).DataTable().destroy();
                    }
                });

            $("#createPaymentModalHost").empty();
        });

    btnToggleCreatePaymentSize
        .off("click.createPaymentSize")
        .on("click.createPaymentSize", function () {
            const isWindowed = modalCreateStudentPayment.toggleClass(
                "payment-modal-windowed"
            ).hasClass("payment-modal-windowed");

            const icon = $(this).find("i");

            icon.toggleClass("fa-compress", !isWindowed);
            icon.toggleClass("fa-expand", isWindowed);

            $(this)
                .attr("title", isWindowed ? "Full screen" : "Exit full screen")
                .attr("aria-pressed", isWindowed ? "true" : "false");

            window.setTimeout(function () {
                ["#tblInvoice", "#tblInvoiceDetail", "#tblProduct"]
                    .forEach(function (selector) {
                        if ($.fn.DataTable.isDataTable(selector)) {
                            $(selector).DataTable().columns.adjust();
                        }
                    });
            }, 150);
        });

    function loadSelectedStudent(studentId) {
        const normalizedStudentId = String(studentId || "").trim();

        if (!normalizedStudentId) {
            return;
        }

        $("#selectedStudentId").val(normalizedStudentId);
        btnCreateNewPayment.prop("disabled", true);

        if (typeof showLoading === "function") {
            showLoading();
        }

        getStudent(normalizedStudentId);
        getInvoice(normalizedStudentId);
    }

        function getStudent(student_id) {
            return $.ajax({
                url: "/student/academic/student-id/" + encodeURIComponent(student_id),
            type: "GET",
            data: {student_id: student_id},
            success: function (response) {
                const data = response?.data ?? response;
                const student = data?.student ?? data?.Student;

                if (student) {
                    const degree = data?.degree ?? data?.Degree;
                    const school = data?.school ?? data?.School;
                    const field = data?.field ?? data?.Field;
                    const promotion = data?.promotion ?? data?.Promotion;
                    const stage = data?.stage ?? data?.Stage;
                    const term = data?.term ?? data?.Term;
                    const group = data?.group ?? data?.Group;
                    const groupRoom = data?.groupRoom ?? data?.GroupRoom;
                    const registry = data?.registry ?? data?.Registry;
                    $("#selectedStudentId").val(student.studentId ?? "");
                    $("#student_StudentName").val(`${student.studentName}`);
                    $("#student_StudentNameInKhmer").val(`${student.studentNameInKhmer}`);
                    $("#student_Sex").val(student.sex);
                    $("#student_Phone").val(student.phone);
                    $("#student_DateOfBirth").val(formatDate(student.dateOfBirth, "DD-MMM-YYYY"));
                    $("#displayDegreeName").val(degree?.degreeName ?? "");
                    $("#displaySchoolName").val(school?.schoolName ?? "");
                    $("#displayFieldName").val(field?.fieldName ?? "");

                    selectedAcademic = {
                        degreeId: degree?.degreeId ?? "",
                        schoolId: school?.schoolId ?? "",
                        fieldId: field?.fieldId ?? "",
                        promotionId: "",
                        stageId: "",
                        termNo: "",
                        groupId: "",
                        startDate: "",
                        endDate: ""
                    };

                    if (student.status !== "REGISTER") {
                        $("#displayPromotionNo").val(promotion?.promotionNo ?? "");
                        $("#displayStageNo").val(stage?.stageNo ?? "");
                        $("#displayTermNo").val(term?.termNo ?? "");
                        $("#group_StudyTime").val(group?.studyTime ?? "");
                        $("#displayStartDate").val(formatDate(term?.startDate, "DD-MMM-YYYY"));
                        $("#displayEndDate").val(formatDate(term?.endDate, "DD-MMM-YYYY"));
                        $("#displayGroupName").val(group?.groupName ?? "");

                        selectedAcademic.promotionId = promotion?.promotionId ?? "";
                        selectedAcademic.stageId = stage?.stageId ?? "";
                        selectedAcademic.termNo = term?.termNo ?? "";
                        selectedAcademic.groupId = group?.groupId ?? "";
                        selectedAcademic.startDate = term?.startDate ?? "";
                        selectedAcademic.endDate = term?.endDate ?? "";

                        if (groupRoom) {
                            $("#groupRoom_RoomName").val(groupRoom.roomName ?? "");
                        }
                    } else if (student.status === "REGISTER") {
                        $("#displayPromotionNo").val(registry?.promotionNo ?? "");
                        $("#displayStageNo").val(registry?.stageNo ?? "");
                        $("#displayTermNo").val(registry?.termNo ?? "");
                        $("#group_StudyTime").val(registry?.studyTime ?? "");
                        $("#displayStartDate").val("");
                        $("#displayEndDate").val("");
                        $("#displayGroupName").val(registry?.groupName ?? "");
                        $("#groupRoom_RoomName").val("");

                        selectedAcademic.promotionId =
                            registry?.promotionId ?? promotion?.promotionId ?? "";
                        selectedAcademic.stageId =
                            registry?.stageId ?? stage?.stageId ?? "";
                        selectedAcademic.termNo =
                            registry?.termNo ?? term?.termNo ?? "";
                        selectedAcademic.groupId =
                            registry?.groupId ?? group?.groupId ?? "";
                    }

                    applySelectedAcademicToPaymentForm();
                    btnCreateNewPayment.prop("disabled", false);
                } else {
                    console.error("Unexpected student response:", response);
                    showCreatePaymentError("Student information was not returned by the server.");
                }
            },
            error: function (xhr) {
                btnCreateNewPayment.prop("disabled", true);
                console.error("Cannot load student:", xhr.status, xhr.responseText);
                showCreatePaymentError(
                    xhr.responseJSON?.status?.message ||
                    xhr.responseJSON?.message ||
                    "Error fetching student data."
                );
            },
            complete: function () {
                if (typeof hideLoading === "function") {
                    hideLoading(1);
                }
            }
        });
    }

    function showCreatePaymentError(message) {
        if (typeof ShowToastError === "function") {
            ShowToastError(message);
        } else if (window.toastr?.error) {
            window.toastr.error(message);
        } else {
            alert(message);
        }
    }

