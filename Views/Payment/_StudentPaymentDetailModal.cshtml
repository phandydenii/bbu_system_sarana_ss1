<div class="modal fade"
     id="PaymentModal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="paymentModalTitle"
     aria-hidden="true"
     data-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="paymentModalTitle" tabindex="-1">Invoice</h4>
                <div class="payment-header-actions">
                    <button type="button" id="btnTogglePaymentFullscreen" class="btn btn-sm"
                            title="Fullscreen" aria-label="Toggle full screen" aria-pressed="false">
                        <i id="paymentFullscreenIcon" class="fas fa-expand" aria-hidden="true"></i>
                    </button>
                    <button type="button" id="btnDismissPayment" class="btn btn-sm" data-dismiss="modal"
                            title="Close" aria-label="Close invoice">
                        <i class="fas fa-times" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
            <div class="modal-body">
                <form id="PaymentForm" method="post">
                    <input type="hidden" id="invoice_InvoiceId" name="invoice.InvoiceId" value="0" />
                    <input type="hidden" id="invoice_StudentId" name="invoice.StudentId" />
                    <input type="hidden" id="invoice_DegreeId" name="invoice.DegreeId" />
                    <input type="hidden" id="invoice_SchoolId" name="invoice.SchoolId" />
                    <input type="hidden" id="invoice_FieldId" name="invoice.FieldId" />
                    <input type="hidden" id="invoice_PromotionId" name="invoice.PromotionId" />
                    <input type="hidden" id="invoice_StageId" name="invoice.StageId" />
                    <input type="hidden" id="invoice_TermNo" name="invoice.TermNo" />
                    <input type="hidden" id="invoice_GroupId" name="invoice.GroupId" />
                    <input type="hidden" id="invoice_StartDate" name="invoice.StartDate" />
                    <input type="hidden" id="invoice_EndDate" name="invoice.EndDate" />
                    <input type="hidden" id="invoice_ExchangeRateId" name="invoice.ExchangeRateId" />
                    <input type="hidden" id="invoice_Vat" name="invoice.Vat" value="0" />

                    <section class="payment-detail-context" aria-label="Invoice information">
                        <div class="payment-context-fields">
                            <div class="payment-context-row">
                                <label for="paymentDetailStudentId">Student ID<span class="text-danger" aria-hidden="true">*</span></label>
                                <input type="text" id="paymentDetailStudentId" class="form-control form-control-sm payment-context-control" readonly />
                                <div id="paymentInlineStudentControl" class="payment-context-control payment-inline-picker d-none">
                                    <select id="paymentInlineStudent" class="form-control form-control-sm"
                                            aria-label="Search student ID or name" aria-describedby="paymentStudentFeedback">
                                        <option value=""></option>
                                    </select>
                                </div>
                                <p id="paymentStudentFeedback" class="small text-secondary mb-0 mt-1" role="status" hidden></p>
                            </div>
                            <div class="payment-context-row">
                                <label for="paymentDetailStudentName">Student Name</label>
                                <input type="text" id="paymentDetailStudentName" class="form-control form-control-sm" readonly />
                            </div>
                            <div class="payment-context-row">
                                <label for="paymentDetailPhone">Phone</label>
                                <input type="text" id="paymentDetailPhone" class="form-control form-control-sm" value="N/A" readonly />
                            </div>
                            <div class="payment-context-row">
                                <button type="button" id="btnPaymentHistoryPanel" class="btn btn-sm btn-outline-info payment-context-control"
                                        aria-controls="paymentInvoiceHistory">
                                    <i class="fas fa-history mr-1" aria-hidden="true"></i> Invoice History
                                </button>
                            </div>
                        </div>

                        <div class="payment-context-fields payment-invoice-fields">
                            <div class="payment-context-row">
                                <label for="paymentDetailInvoiceNo">Invoice No.</label>
                                <input type="text" id="paymentDetailInvoiceNo" class="form-control form-control-sm" readonly />
                            </div>
                            <div class="payment-context-row">
                                <label for="paymentDetailInvoiceDate">Invoice Date</label>
                                <div class="input-group input-group-sm">
                                    <input type="text" id="paymentDetailInvoiceDate" class="form-control" readonly />
                                    <div class="input-group-append">
                                        <span class="input-group-text"><i class="far fa-calendar-alt" aria-hidden="true"></i></span>
                                    </div>
                                </div>
                            </div>
                            <div class="payment-context-row">
                                <label for="paymentDetailTerm">Term</label>
                                <input type="text" id="paymentDetailTerm" class="form-control form-control-sm" readonly />
                            </div>
                            <div class="payment-context-row">
                                <span class="payment-context-label">Exchange Rate</span>
                                <div class="payment-context-control rate-values">
                                    <span>In: <strong id="txtRateIn"></strong></span>
                                    <span>Out: <strong id="txtRateOut"></strong></span>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="payment-table-area" aria-label="Payment Items">
                        <span id="paymentDetailItemCount" class="sr-only" role="status">0 items</span>
                        <div class="invoice-detail-scroll" role="region" aria-label="Payment items table" tabindex="0">
                            <table id="tblInvoiceDetail" class="table table-sm table-bordered table-hover">
                                <caption class="sr-only">Invoice items</caption>
                                <thead>
                                <tr>
                                    <th scope="col" class="text-center">No.</th>
                                    <th class="hide-col">invoice_detail_id</th>
                                    <th class="hide-col">invoice_id</th>
                                    <th class="hide-col">product_id</th>
                                    <th scope="col">Item Description</th>
                                    <th scope="col" class="text-center">Qty</th>
                                    <th scope="col" class="text-right">Unit Price</th>
                                    <th class="hide-col">total_khr</th>
                                    <th class="hide-col">total_usd</th>
                                    <th class="hide-col">type</th>
                                    <th class="hide-col">vat</th>
                                    <th scope="col" class="text-left">Discount %</th>
                                    <th class="hide-col">discount_khr</th>
                                    <th class="hide-col">discount_usd</th>
                                    <th scope="col" class="text-left">Owe</th>
                                    <th scope="col" class="text-left">Other</th>
                                    <th scope="col" class="text-left">Total USD</th>
                                    <th scope="col" class="text-left">Total KHR</th>
                                    <th class="hide-col">grand_total_khr</th>
                                    <th class="hide-col">grand_total_usd</th>
                                    <th class="hide-col">pay_as_khr</th>
                                    <th class="hide-col">pay_as_usd</th>
                                    <th class="hide-col">pay_bath</th>
                                    <th class="hide-col">tuition_fees</th>
                                    <th class="hide-col">card_certificate</th>
                                    <th class="hide-col">category_id</th>
                                    <th class="hide-col">payment_type</th>
                                    <th scope="col" class="text-center">
                                        <span class="sr-only">Action</span>
                                        <button type="button" id="btnAddPaymentItem" class="btn btn-success btn-sm"
                                                title="Add item" aria-label="Add item">
                                            <i class="fas fa-plus" aria-hidden="true"></i>
                                        </button>
                                    </th>
                                </tr>
                                </thead>
                                <tbody></tbody>
                                <tfoot>
                                <tr class="font-weight-bold">
                                    <th scope="row" colspan="7" class="text-right">Grand Total</th>
                                    <td id="paymentDetailGrandUsd" class="text-right">0.00</td>
                                    <td id="paymentDetailGrandKhr" class="text-right">0</td>
                                    <td></td>
                                </tr>
                                </tfoot>
                            </table>
                        </div>
                        <div class="payment-invoice-bottom">
                            <div class="payment-invoice-notes">
                                <div class="nav nav-tabs payment-invoice-tabs" role="tablist" aria-label="Invoice notes and history">
                                    <button type="button" id="btnPaymentRemarkTab" class="nav-link active" role="tab"
                                            aria-controls="paymentInvoiceRemark" aria-selected="true">Remark</button>
                                    <button type="button" id="btnPaymentHistoryTab" class="nav-link" role="tab"
                                            aria-controls="paymentInvoiceHistory" aria-selected="false" tabindex="-1">Invoice History</button>
                                </div>
                                <section id="paymentInvoiceRemark" class="payment-remark-panel" role="tabpanel" aria-labelledby="btnPaymentRemarkTab">
                                    <label for="invoice_Description" class="sr-only">Remark</label>
                                    <textarea id="invoice_Description" name="invoice.Description" class="form-control form-control-sm"
                                              rows="4" maxlength="100"></textarea>
                                </section>
                            </div>

                            <details class="payment-detail-summary" open>
                                <summary>
                                    <span>Summary</span>
                                    <i class="fas fa-chevron-down payment-summary-chevron" aria-hidden="true"></i>
                                </summary>
                                <div class="payment-summary-area">
                                    <span></span>
                                    <strong>USD</strong>
                                    <strong>KHR</strong>
                                    <span>Grand Total</span>
                                    <input type="number" id="invoice_GrandTotalUsd" name="invoice.GrandTotalUsd"
                                           aria-label="Grand Total (USD)" class="form-control form-control-sm" value="0.00" readonly />
                                    <input type="number" id="invoice_GrandTotalKhr" name="invoice.GrandTotalKhr"
                                           aria-label="Grand Total (KHR)" class="form-control form-control-sm" value="0" readonly />
                                    <span>Discount</span>
                                    <input type="number" id="invoice_TotalDiscountUsd" name="invoice.TotalDiscountUsd"
                                           aria-label="Discount (USD)" class="form-control form-control-sm" value="0.00" readonly />
                                    <input type="number" id="invoice_TotalDiscountKhr" name="invoice.TotalDiscountKhr"
                                           aria-label="Discount (KHR)" class="form-control form-control-sm" value="0" readonly />
                                    <span>Owe</span>
                                    <input type="number" id="invoice_OweUsd" name="invoice.OweUsd"
                                           aria-label="Owe (USD)" class="form-control form-control-sm" value="0.00" readonly />
                                    <input type="number" id="invoice_OweKhr" name="invoice.OweKhr"
                                           aria-label="Owe (KHR)" class="form-control form-control-sm" value="0" readonly />
                                    <span>Other</span>
                                    <input type="number" id="invoice_TotalOtherUsd" name="invoice.TotalOtherUsd"
                                           aria-label="Other (USD)" class="form-control form-control-sm" value="0.00" readonly />
                                    <input type="number" id="invoice_TotalOtherKhr" name="invoice.TotalOtherKhr"
                                           aria-label="Other (KHR)" class="form-control form-control-sm" value="0" readonly />
                                    <span>Paid</span>
                                    <input type="number" id="invoice_TotalPayUsd" name="invoice.TotalPayUsd"
                                           aria-label="Paid (USD)" class="form-control form-control-sm" value="0.00" min="0" step="0.01" />
                                    <input type="number" id="invoice_TotalPayKhr" name="invoice.TotalPayKhr"
                                           aria-label="Paid (KHR)" class="form-control form-control-sm" value="0" min="0" step="1" />
                                    <strong>Net Total</strong>
                                    <input type="number" id="invoice_TotalDollar" name="invoice.TotalDollar"
                                           aria-label="Net Total (USD)" class="form-control form-control-sm" value="0.00" readonly />
                                    <input type="number" id="invoice_TotalRiel" name="invoice.TotalRiel"
                                           aria-label="Net Total (KHR)" class="form-control form-control-sm" value="0" readonly />
                                </div>
                            </details>

                            <section id="paymentInvoiceHistory" role="tabpanel"
                                     aria-labelledby="btnPaymentHistoryTab" hidden>
                                <div class="invoice-history-header">
                                    <h4 id="paymentInvoiceHistoryTitle" tabindex="-1">
                                        <i class="fas fa-history" aria-hidden="true"></i>
                                        Invoice History
                                    </h4>
                                </div>
                                <p id="paymentInvoiceHistoryPrompt" class="text-muted px-3 py-2 mb-0">
                                    Select a student to see invoice history.
                                </p>
                                <div id="paymentInvoiceHistoryResults" class="invoice-table-wrap" hidden>
                                    <div class="alert alert-warning mb-2" data-invoice-history-error hidden>
                                        <span role="alert"></span>
                                        <button type="button" class="btn btn-sm btn-outline-dark ml-2">Retry</button>
                                    </div>
                                    <table id="tblPaymentInvoiceHistory" class="table table-bordered table-striped invoice-history-table"
                                           aria-labelledby="paymentInvoiceHistoryTitle">
                                        <thead>
                                        <tr>
                                            <th scope="col">ID</th>
                                            <th scope="col">Invoice No.</th>
                                            <th scope="col">Invoice Date</th>
                                            <th scope="col">Term</th>
                                            <th scope="col">Grand Total</th>
                                            <th scope="col">Discount</th>
                                            <th scope="col">VAT</th>
                                            <th scope="col">Owe</th>
                                            <th scope="col">Total Paid</th>
                                            <th scope="col">Paid KHR</th>
                                            <th scope="col">Paid USD</th>
                                            <th scope="col">Action</th>
                                        </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </section>
                        </div>
                    </section>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-sm" id="btnSavePayment" disabled>
                    <i class="fas fa-save mr-1" aria-hidden="true"></i> Save
                </button>
                <button type="button" id="btnClosePayment" class="btn btn-danger btn-sm">
                    <i id="paymentCloseIcon" class="fas fa-times mr-1" aria-hidden="true"></i>
                    <span id="paymentCloseLabel">Close</span>
                </button>
            </div>
        </div>
    </div>
</div>
