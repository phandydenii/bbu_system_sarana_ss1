                document.getElementById("@nameof(group)_@nameof(group.StudyTime)").value = data["@nameof(group)"]["@nameof(group.StudyTime)"];
                document.getElementById("@nameof(invoice)_@nameof(invoice.StartDate)").value = formatDate(data["@nameof(term)"]["@nameof(term.StartDate)"], "DD-MMM-YYYY");
                document.getElementById("@nameof(invoice)_@nameof(invoice.EndDate)").value = formatDate(data["@nameof(term)"]["@nameof(term.EndDate)"], "DD-MMM-YYYY");
            },
            error: function (xhr, status, error) {
                console.error('AJAX Error:', error);
            }
        });
    }

    $('#tblInvoice tbody').on('click', 'tr', function () {
        $('#tblInvoice tbody tr').removeClass('highlight');
        $(this).addClass('highlight');
        GetInvoiceDetail($(this).find('td:nth-child(1)').text().trim());
        document.getElementById("btnAddItem").classList.add("btn-warning");
        document.getElementById("btnAddItem").value = "add_item";
        document.getElementById("btnAddItem").innerText = "Add Item";

        document.getElementById("btnSave").classList.add("btn-success");
        document.getElementById("btnSave").value = "update_payment";
        document.getElementById("btnSave").innerText = "Update Payment";
    });
</script>