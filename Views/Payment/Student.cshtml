    function ToggleEditMode(button) {
        const row = button.closest('tr');
        const viewElems = row.querySelectorAll('.view-mode');
        const editElems = row.querySelectorAll('.edit-mode');

        const isEditing = button.getAttribute("data-editing") === "true";

        // Toggle visibility
        viewElems.forEach(el => el.style.display = isEditing ? "" : "none");
        editElems.forEach(el => el.style.display = isEditing ? "none" : "");

        // Toggle button content
        button.innerHTML = isEditing
            ? '<i class="fa-solid fa-pen-to-square"></i>'
            : '<i class="fa-solid fa-check"></i>';
        button.classList.add(isEditing ? 'btn-warning' : 'btn-success');
        button.classList.remove(isEditing ? 'btn-success' : 'btn-warning');
        // Toggle state
        button.setAttribute("data-editing", (!isEditing).toString());
    }

