    function OnChangePayR(input) {
        const row = input.closest('tr');
        if (input.value === "") {
            row.querySelector('input[name$=".pay_khr"]').value = 0;
        }

        const pay_r = parseFloat(input.value);

        const qty = parseInt(row.querySelector('input[name$=".qty"]').value);
        const price_khr = parseFloat(row.querySelector('input[name$=".price_khr"]').value);
        const discount_r = parseFloat(row.querySelector('input[name$=".discount_khr"]').value);
        const owe_khr = parseFloat(row.querySelector('input[name$=".owe_khr"]').value);
        const total = qty * price_khr;
        const total_pay_r = total - owe_khr - discount_r;
        const rate_out = document.getElementById("rateOut").value;

        row.querySelector('input[name$=".pay_usd"]').value = (total_pay_r - pay_r) / parseFloat(rate_out);
        row.querySelector('input[name$=".pay_bath"]').value = 0;
        CalculateGrandTotal();
    }

    function CalculateGrandTotal() {
        let grand_total_khr = 0;
        let total_khr = 0;
        let total_pay_khr = 0;
        let total_pay_usd = 0;
        let total_dis_khr = 0;
        let total_owe_khr = 0;

        document.querySelectorAll('#tblInvoiceDetail tbody tr').forEach(row => {
            const grandtotalkhr = row.querySelector('input[name*=".total_khr"]');
            const totalkhr = row.querySelector('input[name*=".grand_total_khr"]');
            const totalpaykhr = row.querySelector('input[name*=".pay_khr"]');
            const totalpayusd = row.querySelector('input[name*=".pay_usd"]');

            const diskhr = row.querySelector('input[name*=".discount_khr"]');
            const owekhr = row.querySelector('input[name*=".owe_khr"]');

            if (grandtotalkhr && !isNaN(parseFloat(grandtotalkhr.value))) {
                grand_total_khr += parseFloat(grandtotalkhr.value);
            }
            if (totalkhr && !isNaN(parseFloat(totalkhr.value))) {
                total_khr += parseFloat(totalkhr.value);
            }
            if (totalpaykhr && !isNaN(parseFloat(totalpaykhr.value))) {
                total_pay_khr += parseFloat(totalpaykhr.value);
            }
            if (totalpayusd && !isNaN(parseFloat(totalpayusd.value))) {
                total_pay_usd += parseFloat(totalpayusd.value);
            }
            if (diskhr && !isNaN(parseFloat(diskhr.value))) {
                total_dis_khr += parseFloat(diskhr.value);
            }
            if (owekhr && !isNaN(parseFloat(owekhr.value))) {
                total_owe_khr += parseFloat(owekhr.value);
            }
        });

        document.getElementById("@nameof(invoice)_@nameof(invoice.GrandTotalKhr)").value = grand_total_khr.toFixed(2);
        document.getElementById("total_khr").value = total_khr;
        document.getElementById("total_usd").value = 0;
        document.getElementById("total_bath").value = 0;
        document.getElementById("@nameof(invoice)_@nameof(invoice.TotalRiel)").value = total_pay_khr;
        document.getElementById("@nameof(invoice)_@nameof(invoice.TotalDollar)").value = total_pay_usd;
        document.getElementById("@nameof(invoice)_@nameof(invoice.TotalBath)").value = 0;

        document.getElementById("@nameof(invoice)_@nameof(invoice.TotalDiscountKhr)").value = total_dis_khr;
        document.getElementById("@nameof(invoice)_@nameof(invoice.OweKhr)").value = total_owe_khr;
    }

    function fetchStudent() {
        $.ajax({
            url: '/student/getsearchstudent', // API URL
            type: 'GET', // or 'POST'
            dataType: 'json',
            success: function (data) {
                // console.log(data);
                const cboRoom = document.getElementById("@nameof(invoice)_@nameof(invoice.StudentId)");
                cboRoom.innerText = "";
                const optionRoom = document.createElement("option");
                optionRoom.value = 0;
                optionRoom.text = "Select Student";
                optionRoom.disabled = true;
                cboRoom.appendChild(optionRoom);
                data.forEach(item => {
                    const option = document.createElement("option");
                    option.value = item.student_id;
                    option.text = item.student_name;
                    cboRoom.appendChild(option);
                });
            },
            error: function (xhr, status, error) {
                console.error('AJAX Error:', error);
            }
        });
    }

