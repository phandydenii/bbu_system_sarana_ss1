<partial name="_ProductModal"/>
@* <partial name="_PaymentModal" /> *@
<script src="/AdminLTE/plugins/jquery/jquery.min.js"></script>
<script src="/AdminLTE/plugins/select2/js/select2.full.min.js"></script>
<script>
    var student_id =@Html.Raw(Json.Serialize(@Model.Student!.StudentId));

    function OnPrint() {
        window.print();
    }

    $(document).ready(function () {
        getInvoice(student_id);
        fetchStudent(student_id);
    });

    document.getElementById("btnAddItem").addEventListener("click", function (e) {
        $("#tblProduct").DataTable().clear().destroy();
        $("#tblProduct").DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: "/product/getproductlist",
                type: "POST",
            },
            columns: [
                {
                    data: null,
                    render: function (data, type, row) {
                        return `<input type="checkbox">`
                    }
                },
                {data: "@nameof(product.ProductId)"},
                {data: "@nameof(product.ProductName)"},
                {data: "@nameof(product.ProductNameInKhmer)"},
                {data: "@nameof(product.PriceKhr)"},
                {data: "@nameof(product.Price)"},
                {data: "@nameof(product.DegreeId)"},
                {data: "@nameof(product.Vat)", className: "hide-col"},
                {data: "@nameof(product.Type)"},
                {data: "@nameof(product.CategoryId)"},
                {data: "@nameof(product.CardCertificate)"},
                {data: "@nameof(product.TuitionFees)"},
                {data: "@nameof(product.Status)"}
            ]
        });
        $("#ProductModal").modal("show");
    });

    function getInvoice(student_id) {
        $("#tblInvoice").DataTable().clear().destroy();
        $("#tblInvoice").DataTable({
            processing: true,
            serverSide: true,
            paging: true,
            lengthChange: false,
            searching: false,
            ordering: false,
            info: false,
            responsive: true,
            autoWidth: true,
            ajax: {
                url: "/invoice/getinvoicebystudentid",
                type: "POST",
                data: function (d) {
                    d.student_id = student_id;
                }
            },
            columns: [
                {data: "@nameof(invoice.InvoiceId)", className: "hide-col"},
                {data: "@nameof(invoice.InvoiceNo)"},
                {
                    data: null,
                    render: function (data, type, row) {
                        const dt = formatDate(row.invoice_date, "DD-MMM-YYYY");
                        return `${dt}`
                    }
                },
                {data: "@nameof(student.StudentId)"},
                {data: "@nameof(invoice.GrandTotalKhr)"},
                {data: "@nameof(invoice.TotalDiscountUsd)"},
                {data: "@nameof(invoice.Vat)"},
                {
                    data: null,
                    render: function (data, type, row) {
                        return row.owe > 0 ? `<button type="button" class="btn btn-danger btn-sm">${row.owe}</button>` : 0;
                    }
                },
                {data: "@nameof(invoice.TotalRiel)"},
                {data: "@nameof(invoice.TotalDollar)"},
                {data: "@nameof(invoice.TotalBath)"},
                {data: "@nameof(invoice.TotalRiel)"},
                {data: "@nameof(invoice.TotalDollar)"},
                {data: "@nameof(invoice.TotalBath)"},
                {
                    data: null,
                    render: function (data, type, row) {
                        if (row.owe > 0) {
                            return `
                                <div class="input-group-prepend">
                                    <button type="button" class="btn btn-primary dropdown-toggle btn-sm" data-toggle="dropdown">
                                        Action
                                    </button>
                                        <div class="dropdown-menu dropdown-menu-right" style="min-width: 8rem;">
                                        <div class="col-md-12">
                                            <a onclick="OnEdit('${row.invoice_id}')" class="btn btn-success btn-sm" style="display: block;margin:.2rem 0rem"><i class='fas fa-edit'></i> Edit</a>
                                            <a onclick="OnDelete('${row.invoice_id}')" class="btn btn-primary btn-sm" style="display: block;margin:.2rem 0rem">Return</a>
                                            <a onclick="OnDelete('${row.invoice_id}')" class="btn btn-danger btn-sm" style="display: block;margin:.2rem 0rem"><i class="fa-solid fa-trash"></i> Delete</a>
                                        </div>
                                    </div>
                                </div>
                            `;
                        } else {
                            return `
                                <div class="input-group-prepend">
                                    <button type="button" class="btn btn-primary dropdown-toggle btn-sm" data-toggle="dropdown">
                                        Action
                                    </button>
                                        <div class="dropdown-menu dropdown-menu-right" style="min-width: 8rem;">
                                        <div class="col-md-12">
                                            <a onclick="OnEdit('${row.invoice_id}')" class="btn btn-success btn-sm" style="display: block;margin:.2rem 0rem"><i class='fas fa-edit'></i> Edit</a>
                                            <a onclick="OnDelete('${row.invoice_id}')" class="btn btn-warning btn-sm" style="display: block;margin:.2rem 0rem">Change Student</a>
                                            <a onclick="OnDelete('${row.invoice_id}')" class="btn btn-danger btn-sm" style="display: block;margin:.2rem 0rem"><i class="fa-solid fa-trash"></i> Delete</a>
                                        </div>
                                    </div>
                                </div>
                            `;
                        }

                    }
                }
            ]
        });
    }

    function GetInvoiceDetail(invoice_id) {
        $("#tblInvoiceDetail").DataTable().clear().destroy();
        $.ajax({
            url: "/invoice/getinvoicedetail/" + invoice_id,
            type: 'GET', // or 'POST'
            dataType: 'json',
            success: function (data) {
                console.log(data);
                data.forEach(item => {
                    let listdata = [
                        item.invoicedetail_id,
                        item.invoice_id,
                        item.product_id,
                        item.product_name,
                        item.product_name_khmer,
                        item.qty,
                        item.price_khr,
                        item.price_usd,
                        item.total_khr,
                        item.total_usd,
                        item.type,
                        item.vat,
                        item.discount_percent,
                        item.discount_khr,
                        item.discount_usd,
                        item.owe_khr,
                        item.owe_usd,
                        item.grand_total_khr,
                        item.grand_total_usd,
                        item.pay_khr,
                        item.pay_usd,
                        item.pay_bath,
                        item.tuitionfees,
                        item.card_certificate,
                        item.category_id,
                        item.other
                    ];
                    AddRow(listdata);
                });
            },
            error: function (xhr, status, error) {
                console.error('AJAX Error:', error);
            }
        });
    }

    function OnAssign() {
        const tableRows = document.querySelectorAll('#tblProduct tbody tr');
        const checkboxes = document.querySelectorAll('#tblProduct input[type="checkbox"]');
        checkboxes.forEach(checkbox => {
            if (checkbox.checked) {
                const row = checkbox.closest('tr');
                if (row) {
                    var is_pay_khr = true;
                    var is_pay_usd = !is_pay_khr;
                    let listdata = [
                        0,
                        0,
                        getCellValueByHeaderName(row, "@nameof(product.ProductId)"),
                        getCellValueByHeaderName(row, "@nameof(product.ProductName)"),
                        getCellValueByHeaderName(row, "@nameof(product.ProductNameInKhmer)"),
                        1,
                        is_pay_khr ? getCellValueByHeaderName(row, "@nameof(product.PriceKhr)") : 0,
                        is_pay_usd ? getCellValueByHeaderName(row, "@nameof(product.Price)") : 0,
                        is_pay_khr ? getCellValueByHeaderName(row, "@nameof(product.PriceKhr)") : 0,
                        is_pay_usd ? getCellValueByHeaderName(row, "@nameof(product.Price)") : 0,
                        getCellValueByHeaderName(row, "@nameof(product.Type)"),
                        getCellValueByHeaderName(row, "@nameof(product.Vat)"),
                        0,
                        0,
                        0,
                        0,
                        0,
                        is_pay_khr ? getCellValueByHeaderName(row, "@nameof(product.PriceKhr)") : 0,
                        is_pay_usd ? getCellValueByHeaderName(row, "@nameof(product.Price)") : 0,
                        is_pay_khr ? getCellValueByHeaderName(row, "@nameof(product.PriceKhr)") : 0,
                        0,
                        0,
                        getCellValueByHeaderName(row, "@nameof(product.TuitionFees)"),
                        getCellValueByHeaderName(row, "@nameof(product.CardCertificate)"),
                        getCellValueByHeaderName(row, "@nameof(product.CategoryId)"),
                        0
                    ];
                    AddRow(listdata);
                }
            }
        });
        $("#ProductModal").modal("hide");
    };

    function getCellValueByHeaderName(row, headerName) {
        const table = row.closest('table');
        const headers = Array.from(table.querySelectorAll('thead th'));

        const index = headers.findIndex(th => th.dataset.name === headerName);
        if (index === -1) return null;

        return row.cells[index]?.textContent.trim() ?? null;
    }

    function AddRow(params) {
        const tableBody = document.querySelector('#tblInvoiceDetail tbody');
        var i = document.querySelectorAll('#tblInvoiceDetail tbody tr').length;
        const row = document.createElement('tr');
        row.innerHTML = `
                <td data-name="invoice_detail_id" class="hide-col"><input type="hidden" name="invoiceDetails[${i}].invoice_detail_id" value="${params[0]}" />${params[0]}</td>
                <td data-name="invoice_id" class="hide-col"><input type="hidden" name="invoiceDetails[${i}].invoice_id" value="${params[1]}" />${params[1]}</td>
                <td data-name="product_id" ><input type="hidden" name="invoiceDetails[${i}].product_id" value="${params[2]}" />${params[2]}</td>
                <td data-name="product_name">${params[3]}</td>
                <td data-name="product_name_kher" class="hide-col">${params[4]}</td>
                <td data-name="qty">
                    <span class="view-mode">${params[5]}</span>
                    <input type="number" oninput="OnChangeQty(this)" name="invoiceDetails[${i}].qty" value="${params[5]}" class="form-control edit-mode" style="display:none;" min="1"/>
                </td>
                <td data-name="price_khr">
                    <span class="view-mode">${params[6]}</span>
                    <input type="number" name="invoiceDetails[${i}].price_khr" value="${params[6]}" class="form-control edit-mode" style="display:none;" readonly/>
                </td>
                <td data-name="price_usd"  class="hide-col">
                    <span class="view-mode">${params[7]}</span>
                    <input type="number" name="invoiceDetails[${i}].price_usd" value="${params[7]}" class="form-control edit-mode" style="display:none;" readonly/>
                </td>
                <td data-name="total_khr">
                    <span class="view-mode">${params[8]}</span>
                    <input type="number" name="invoiceDetails[${i}].total_khr" value="${params[8]}" class="form-control edit-mode" style="display:none;" readonly/>
                </td>
