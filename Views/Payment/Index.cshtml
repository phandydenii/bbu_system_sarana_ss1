@model BBU_SYSTEM.ViewModel.ListData
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Student Payment";
    ViewData["TitleContent"] = "Student Payment";
    ViewData["Controller"] = "Payment";
    ViewData["OpenMenu"] = "Administration";
    ViewData["Action"] = "Payment";
    ViewData["HideHeader"] = true;
}

<link rel="stylesheet" href="~/AdminLTE/plugins/select2/css/select2.min.css" />

<style>
    #studentPaymentPage h1 {
        margin: 0;
        color: #222d43;
        font-size: clamp(1.4rem, 2.5vw, 1.75rem);
        font-weight: 700;
        line-height: 1.2;
    }

    #studentPaymentPage .payment-page-subtitle,
    #PaymentInvoiceDateFilterModal .payment-filter-intro {
        color: #56637a;
        font-size: .875rem;
    }

    #studentPaymentPage .payment-page-subtitle {
        margin: .2rem 0 0;
    }

    #studentPaymentPage .payment-page-actions {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
    }

    #studentPaymentPage .payment-page-actions .btn {
        min-height: 2.5rem;
        border-radius: .4rem;
        padding-inline: .95rem;
        font-weight: 600;
    }

    #studentPaymentPage .payment-date-summary {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: .4rem .6rem;
        padding: .8rem 1rem;
        border-bottom-color: #dce2ed;
    }

    #studentPaymentPage .payment-date-chip {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .24rem .55rem;
        border-radius: 1rem;
        background: #eef0fa;
        color: #25296b;
        font-size: .78rem;
        font-weight: 600;
    }

    #PaymentInvoiceDateFilterModal .modal-dialog {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        width: 460px;
        max-width: 100%;
        height: 100%;
        margin: 0;
    }

    #PaymentInvoiceDateFilterModal.fade .modal-dialog {
        transform: translateX(100%);
        transition: transform .3s ease;
    }

    #PaymentInvoiceDateFilterModal.show .modal-dialog {
        transform: translateX(0);
    }

    #PaymentInvoiceDateFilterModal .modal-content {
        height: 100%;
        border: 0;
        border-radius: 0;
        box-shadow: -8px 0 30px rgba(0, 0, 0, .12);
    }

    #PaymentInvoiceDateFilterModal .modal-header {
        flex-shrink: 0;
        padding: 20px 24px;
        border-bottom-color: #dce2ed;
        color: #222d43;
    }

    #PaymentInvoiceDateFilterModal .modal-body {
        min-height: 0;
        overflow-y: auto;
        padding: 24px;
        background: #f7f8fc;
    }

    #PaymentInvoiceDateFilterModal label {
        color: #222d43;
        font-size: .875rem;
    }

    #PaymentInvoiceDateFilterModal .form-control,
    #PaymentInvoiceDateFilterModal .custom-select {
        border-color: #c7d0df;
        border-radius: .4rem;
    }

    #PaymentInvoiceDateFilterModal .modal-footer {
        flex-shrink: 0;
        padding: 16px 24px;
        border-top-color: #dce2ed;
        background: #fff;
    }

    @@media (max-width: 575px) {
        #studentPaymentPage .payment-page-actions {
            width: 100%;
        }

        #studentPaymentPage .payment-page-actions .btn {
            flex: 1 1 auto;
        }

        #studentPaymentPage .payment-date-summary,
        #PaymentInvoiceDateFilterModal .modal-header,
        #PaymentInvoiceDateFilterModal .modal-body,
        #PaymentInvoiceDateFilterModal .modal-footer {
            padding-inline: .85rem;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        #PaymentInvoiceDateFilterModal.fade .modal-dialog {
            transition: none;
        }
    }

    #tblStudent_wrapper {
        width: 100%;
    }

    #tblStudent_wrapper:not(.payment-has-results) .dataTables_length,
    #tblStudent_wrapper:not(.payment-has-results) .dt-length,
    #tblStudent_wrapper:not(.payment-has-pages) .dataTables_paginate,
    #tblStudent_wrapper:not(.payment-has-pages) .dt-paging {
        display: none;
    }

    #tblStudent th,
    #tblStudent td {
        vertical-align: middle !important;
        white-space: nowrap;
    }

    #tblStudent .dt-status-col,
    #tblStudent .dt-action-col {
        text-align: center !important;
    }

    #tblStudent td.dataTables_empty,
    #tblStudent td.dt-empty {
        white-space: normal;
    }

    #studentPaymentPage .payment-table-scroll {
        width: 100%;
        max-width: 100%;
        overflow-x: auto;
    }

    .payment-status-badge {
        display: inline-block;
        min-width: 70px;
        padding: 5px 8px;
        text-align: center;
    }

</style>

<div id="studentPaymentPage" class="container-fluid px-0 pt-3">
    <header class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div class="mr-3">
            <h1>Student Payment</h1>
            <p class="payment-page-subtitle">Find students, view their payments, and create new payments</p>
        </div>
        <div class="payment-page-actions ml-auto mt-2 mt-sm-0">
            <button type="button"
                    id="btnOpenPaymentInvoiceDateFilter"
                    class="btn btn-outline-primary text-nowrap"
                    data-toggle="modal"
                    data-target="#PaymentInvoiceDateFilterModal"
                    aria-haspopup="dialog"
                    aria-controls="PaymentInvoiceDateFilterModal">
                <i class="fas fa-filter mr-1" aria-hidden="true"></i>
                Filter
            </button>
            <button type="button"
                    id="btnNewPayment"
                    class="btn btn-primary shadow-sm text-nowrap"
                    aria-haspopup="dialog"
                    aria-controls="PaymentModal">
                <i class="fas fa-plus-circle mr-1" aria-hidden="true"></i>
                New Payment
            </button>
        </div>
    </header>

    <section class="card shadow-sm border-0" aria-label="Student payments">
        <div id="paymentInvoiceDateFilterSummary" class="card-header bg-white payment-date-summary d-none">
            <span class="payment-date-chip">
                <i class="far fa-calendar-alt" aria-hidden="true"></i>
                <span id="paymentActiveInvoiceDateLabel"></span>
            </span>
            <button type="button" id="btnClearPaymentInvoiceDates" class="btn btn-link btn-sm px-1"
                    aria-label="Clear invoice date filter">
                Clear
            </button>
        </div>
        <span id="paymentInvoiceDateFilterStatus" class="sr-only" role="status"></span>
        <div class="card-body">
            <table id="tblStudent"
                   class="table table-sm table-hover table-bordered table-striped"
                   style="width: 100%;">
                <caption class="sr-only">Students and payment actions</caption>
                <thead class="thead-light">
                    <tr>
                        <th scope="col">Student ID</th>
                        <th scope="col">Name English</th>
                        <th scope="col">Name Khmer</th>
                        <th scope="col">Gender</th>
                        <th scope="col">DOB</th>
                        <th scope="col">Phone</th>
                        <th scope="col" class="text-center">Status</th>
                        <th scope="col" class="text-center" style="width: 145px;">Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </section>
</div>

<div class="modal fade"
     id="PaymentInvoiceDateFilterModal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="paymentInvoiceDateFilterTitle"
     aria-describedby="paymentInvoiceDateHelp"
     aria-hidden="true">
    <div class="modal-dialog" role="document">
        <form id="frmPaymentStudentFilters" class="modal-content" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title font-weight-bold" id="paymentInvoiceDateFilterTitle">
                    <i class="fas fa-filter mr-2 text-primary" aria-hidden="true"></i>Filter by Invoice Date
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <p id="paymentInvoiceDateHelp" class="payment-filter-intro mb-3">
                    Choose a preset or enter one or both dates for a custom range.
                </p>
                <div class="form-group">
                    <label for="paymentInvoiceDateRange">Invoice Date</label>
                    <select id="paymentInvoiceDateRange" class="custom-select">
                        <option value="all" selected>All Dates</option>
                        <option value="today">Today</option>
                        <option value="last7">Last 7 Days</option>
                        <option value="month">This Month</option>
                        <option value="custom">Custom Range</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="paymentFromDate">From Date</label>
                    <input type="date" id="paymentFromDate" name="fromDate" min="0001-01-01" max="9999-12-31"
                           class="form-control" aria-describedby="paymentInvoiceDateFilterError" />
                </div>

                <div class="form-group">
                    <label for="paymentToDate">To Date</label>
                    <input type="date" id="paymentToDate" name="toDate" min="0001-01-01" max="9999-12-30"
                           class="form-control" aria-describedby="paymentInvoiceDateFilterError" />
                </div>

                <p id="paymentInvoiceDateFilterError" class="text-danger small mb-0" role="alert" hidden></p>
            </div>

            <div class="modal-footer">
                <button type="button" id="btnResetPaymentStudentFilter" class="btn btn-outline-secondary mr-auto"
                        aria-label="Reset invoice date filter">
                    <i class="fas fa-redo-alt mr-1" aria-hidden="true"></i> Reset
                </button>
                <button type="button" class="btn btn-light" data-dismiss="modal">Close</button>
                <button type="submit" id="btnFilterPaymentStudents" class="btn btn-primary">
                    <i class="fas fa-check mr-1" aria-hidden="true"></i> Apply Filter
                </button>
            </div>
        </form>
    </div>
</div>

<div id="createPaymentModalHost"></div>

<template id="newPaymentModalTemplate">
    @await Html.PartialAsync("_CreatePaymentModal", new BBU_SYSTEM.ViewModel.PaymentViewModel())
</template>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Alert.js"></script>
    <script src="~/function/Product.js"></script>
    <script src="~/AdminLTE/plugins/select2/js/select2.full.min.js"
            asp-fallback-src="~/AdminLTE/plugins/select2/js/select2.min.js"
            asp-fallback-test="window.jQuery && window.jQuery.fn.select2"></script>

    <script>
    // Keep the jQuery instance that already owns Bootstrap and DataTables.
    // Some older modal partials load jquery.min.js again and replace it.
    window.paymentPageJQuery = window.paymentPageJQuery || window.jQuery;

    let paymentStudentListRequest = null;
    let paymentStudentCountUnavailable = false;
    const paymentStudentSearchPrompt = "Search by Student ID or name, or apply an invoice date range.";
    const paymentStudentNoMatches = "No students match your search or invoice date range.";
    let paymentStudentEmptyMessage = paymentStudentSearchPrompt;
    const paymentStudentListUrl = '@Url.Content("~/student/academic/student-list/all")';
    const paymentInvoiceDateListUrl = '@Url.Action("GetStudentsByInvoiceDate", "Payment")';
    const paymentInvoiceDateFilterModal = $("#PaymentInvoiceDateFilterModal");
    const paymentInvoiceDateRange = $("#paymentInvoiceDateRange");
    let appliedPaymentInvoiceDates = { preset: "all", fromDate: "", toDate: "" };

    $(document).ready(function () {
        registerPaymentInvoiceDateFilters();
        fetchStudent();
    });

    function registerPaymentInvoiceDateFilters() {
        $("#frmPaymentStudentFilters")
            .off("submit.paymentInvoiceFilters")
            .on("submit.paymentInvoiceFilters", function (event) {
                event.preventDefault();
                applyPaymentDateFilter();
            });

        paymentInvoiceDateRange
            .off("change.paymentInvoiceFilters")
            .on("change.paymentInvoiceFilters", syncPaymentInvoiceDateInputs);

        $("#paymentFromDate, #paymentToDate")
            .off("input.paymentInvoiceFilters change.paymentInvoiceFilters")
            .on("input.paymentInvoiceFilters change.paymentInvoiceFilters", function () {
                paymentInvoiceDateRange.val("custom");
                setPaymentInvoiceDateFilterError("");
            });

        $("#btnResetPaymentStudentFilter")
            .off("click.paymentInvoiceFilters")
            .on("click.paymentInvoiceFilters", clearPaymentInvoiceDateFilters);

        $("#btnClearPaymentInvoiceDates")
            .off("click.paymentInvoiceFilters")
            .on("click.paymentInvoiceFilters", function () {
                clearPaymentInvoiceDateFilters();
                $("#btnOpenPaymentInvoiceDateFilter").trigger("focus");
            });

        paymentInvoiceDateFilterModal
            .off(".paymentInvoiceFilters")
            .on("show.bs.modal.paymentInvoiceFilters", restoreAppliedPaymentInvoiceDates)
            .on("shown.bs.modal.paymentInvoiceFilters", function () {
                paymentInvoiceDateRange.trigger("focus");
            });

        restoreAppliedPaymentInvoiceDates();
        updatePaymentInvoiceDateFilterSummary();
    }

    function restoreAppliedPaymentInvoiceDates() {
        paymentInvoiceDateRange.val(appliedPaymentInvoiceDates.preset);
        setPaymentInvoiceDateInputs(appliedPaymentInvoiceDates);
        setPaymentInvoiceDateFilterError("");
    }

    function syncPaymentInvoiceDateInputs() {
        const preset = paymentInvoiceDateRange.val();

        if (preset !== "custom") {
            setPaymentInvoiceDateInputs(getPaymentInvoicePresetDates(preset));
        }

        setPaymentInvoiceDateFilterError("");
    }

    function setPaymentInvoiceDateInputs({ fromDate, toDate }) {
        $("#paymentFromDate").val(fromDate);
        $("#paymentToDate").val(toDate);
    }

    function setPaymentInvoiceDateFilterError(message, fieldSelector) {
        $("#paymentInvoiceDateFilterError").text(message).prop("hidden", !message);
        $("#paymentFromDate, #paymentToDate").removeAttr("aria-invalid");

        if (fieldSelector) {
            $(fieldSelector).attr("aria-invalid", "true").trigger("focus");
        }
    }

    function getPaymentInvoicePresetDates(preset, now = new Date()) {
        if (!["today", "last7", "month"].includes(preset)) {
            return { preset: "all", fromDate: "", toDate: "" };
        }

        // Resolve the calendar day in Cambodia even if the device is in another timezone.
        const parts = Object.fromEntries(
            new Intl.DateTimeFormat("en-GB", {
                timeZone: "Asia/Phnom_Penh",
                year: "numeric",
                month: "2-digit",
                day: "2-digit"
            }).formatToParts(now).map(part => [part.type, part.value])
        );
        const year = Number(parts.year);
        const month = Number(parts.month) - 1;
        const today = Date.UTC(year, month, Number(parts.day));
        const isoDay = timestamp => new Date(timestamp).toISOString().slice(0, 10);

        if (preset === "month") {
            return {
                preset,
                fromDate: isoDay(Date.UTC(year, month, 1)),
                toDate: isoDay(Date.UTC(year, month + 1, 0))
            };
        }

        const dayInMilliseconds = 24 * 60 * 60 * 1000;
        const firstDay = preset === "last7" ? today - 6 * dayInMilliseconds : today;
        return { preset, fromDate: isoDay(firstDay), toDate: isoDay(today) };
    }

    function applyPaymentDateFilter() {
        const preset = paymentInvoiceDateRange.val();
        let dates;

        setPaymentInvoiceDateFilterError("");

        if (preset === "custom") {
            const fromInput = document.getElementById("paymentFromDate");
            const toInput = document.getElementById("paymentToDate");

            if (!fromInput.validity.valid) {
                setPaymentInvoiceDateFilterError("Enter a valid From Date.", "#paymentFromDate");
                return;
            }

            if (!toInput.validity.valid) {
                setPaymentInvoiceDateFilterError("Enter a valid To Date.", "#paymentToDate");
                return;
            }

            const fromDate = fromInput.value;
            const toDate = toInput.value;

            if (!fromDate && !toDate) {
                setPaymentInvoiceDateFilterError("Enter at least one date, or choose All Dates.", "#paymentFromDate");
                return;
            }

            if (fromDate && toDate && fromDate > toDate) {
                setPaymentInvoiceDateFilterError("To Date must be on or after From Date.", "#paymentToDate");
                return;
            }

            dates = { preset, fromDate, toDate };
        } else {
            dates = getPaymentInvoicePresetDates(preset);
            setPaymentInvoiceDateInputs(dates);
        }

        if ((dates.fromDate || dates.toDate) && !paymentInvoiceDateListUrl) {
            setPaymentInvoiceDateFilterError("The invoice date filter endpoint is not available. Add the Payment controller action and restart the app.");
            return;
        }

        appliedPaymentInvoiceDates = dates;
        updatePaymentInvoiceDateFilterSummary();
        reloadPaymentStudentList();
        paymentInvoiceDateFilterModal.modal("hide");
    }

    function clearPaymentInvoiceDateFilters() {
        const hadDateFilter = Boolean(appliedPaymentInvoiceDates.fromDate || appliedPaymentInvoiceDates.toDate);

        appliedPaymentInvoiceDates = { preset: "all", fromDate: "", toDate: "" };
        restoreAppliedPaymentInvoiceDates();
        updatePaymentInvoiceDateFilterSummary();

        if (hadDateFilter) {
            reloadPaymentStudentList();
        }
    }

    function updatePaymentInvoiceDateFilterSummary() {
        const { preset, fromDate, toDate } = appliedPaymentInvoiceDates;
        const labels = {
            all: "All Dates",
            today: "Today",
            last7: "Last 7 Days",
            month: "This Month",
            custom: "Custom Range"
        };
        const displayDate = iso => iso.split("-").reverse().join("/");
        const active = Boolean(fromDate || toDate);
        let summary = labels[preset];

        if (fromDate && toDate) {
            summary += ": " + displayDate(fromDate) +
                (fromDate === toDate ? "" : " – " + displayDate(toDate));
        } else if (fromDate) {
            summary += ": From " + displayDate(fromDate);
        } else if (toDate) {
            summary += ": Through " + displayDate(toDate);
        }

        $("#paymentInvoiceDateFilterSummary").toggleClass("d-none", !active);
        $("#paymentActiveInvoiceDateLabel").text(active ? summary : "");
        $("#paymentInvoiceDateFilterStatus").text("Applied invoice dates: " + summary);
    }

    function reloadPaymentStudentList() {
        const pageJQuery = window.paymentPageJQuery;
        if (pageJQuery.fn.DataTable.isDataTable("#tblStudent")) {
            pageJQuery("#tblStudent").DataTable().ajax.reload(null, true);
        }
    }

    $("#btnNewPayment").on("click", function () {
        openNewPaymentModal(this);
    });

    function openNewPaymentModal(trigger, studentId = "") {
        const host = window.paymentPageJQuery("#createPaymentModalHost");
        if (host.children().length) return;

        const template = document.getElementById("newPaymentModalTemplate");
        if (!template) {
            showPaymentError("The New Payment form is unavailable.");
            return;
        }

        host.attr("data-payment-entry-mode", "new")
            .attr("data-payment-student-id", studentId)
            .data("payment-trigger", trigger);
        try {
            host.html(template.innerHTML);
        } catch (error) {
            host.removeAttr("data-payment-entry-mode data-payment-student-id")
                .removeData("payment-trigger")
                .empty();
            showPaymentError(error?.message || "Unable to open the New Payment form.");
        }
    }

    $(document)
        .off("click.openPaymentModal", ".js-open-payment-modal")
        .on("click.openPaymentModal", ".js-open-payment-modal", function () {
            const studentId = String($(this).attr("data-student-id") ?? "").trim();

            if (!studentId) {
                showPaymentError("The selected student ID is missing.");
                return;
            }

            openNewPaymentModal(this, studentId);
        });

    function fetchStudent() {
        const tblStudent = $("#tblStudent");

        if ($.fn.DataTable.isDataTable("#tblStudent")) {
            tblStudent.DataTable().clear().destroy();
        }

        tblStudent.DataTable({
            processing: true,
            serverSide: true,
            paging: true,
            pageLength: 10,
            lengthMenu: [10, 25, 50, 100],
            lengthChange: true,
            searching: true,
            ordering: true,
            info: true,
            responsive: false,
            autoWidth: false,
            scrollX: false,
            scrollY: "",
            searchDelay: 500,

            ajax: loadPaymentStudentRows,

            columns: [
                {
                    data: "studentId",
                    defaultContent: ""
                },
                {
                    data: "studentName",
                    defaultContent: ""
                },
                {
                    data: "studentNameInKhmer",
                    defaultContent: "",
                    render: function (data) {
                        return data || "";
                    }
                },
                {
                    data: "sex",
                    defaultContent: ""
                },
                {
                    data: "dateOfBirth",
                    defaultContent: "",
                    render: function (data, type) {
                        if (type !== "display") {
                            return data || "";
                        }

                        return formatPaymentDate(data);
                    }
                },
                {
                    data: "phone",
                    defaultContent: ""
                },
                {
                    data: "status",
                    defaultContent: "",
                    className: "dt-status-col",
                    render: function (data, type) {
                        return renderPaymentStatus(data, type);
                    }
                },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    className: "dt-action-col",
                    render: function (data, type, row) {
                        const studentId = String(row.studentId || "").trim();

                        if (!studentId) {
                            return "";
                        }

                        const studentIdAttribute = escapePaymentHtml(studentId).replace(/"/g, "&quot;");
                        return `
                            <button type="button"
                                    class="btn btn-success btn-sm js-open-payment-modal"
                                    aria-haspopup="dialog"
                                    data-student-id="${studentIdAttribute}">
                                <i class="fas fa-dollar-sign mr-1" aria-hidden="true"></i>
                                Payment
                            </button>
                        `;
                    }
                }
            ],

            columnDefs: [
                { targets: 0, width: "110px" },
                { targets: 3, width: "90px" },
                { targets: 4, width: "110px" },
                { targets: 6, width: "100px" },
                { targets: 7, width: "145px" }
            ],

            language: {
                processing: "Loading...",
                searchPlaceholder: "Student ID or name",
                info: "Showing _START_ to _END_ of _TOTAL_ entries",
                infoEmpty: "Showing 0 to 0 of _MAX_ entries",
                infoFiltered: "",
                thousands: ",",
                emptyTable: paymentStudentSearchPrompt,
                zeroRecords: paymentStudentNoMatches
            },

            infoCallback: function (_settings, _start, _end, _max, _total, text) {
                return paymentStudentCountUnavailable ? "Total entries unavailable" : text;
            },

            initComplete: function () {
                const table = window.paymentPageJQuery(this.api().table().node());
                if (!table.parent().hasClass("payment-table-scroll")) {
                    table.wrap('<div class="payment-table-scroll" role="region" aria-label="Student Payment table" tabindex="0"></div>');
                }

                if (window.MyApp?.utils?.dataTableDebounceSearch) {
                    MyApp.utils.dataTableDebounceSearch("#tblStudent", 500);
                }
            },

            drawCallback: function () {
                updatePaymentStudentResultControls(this.api());
            }
        });
    }

    function loadPaymentStudentRows(request, complete) {
        if (paymentStudentListRequest) {
            const previousRequest = paymentStudentListRequest;
            paymentStudentListRequest = null;
            previousRequest.abort();
        }

        const pageJQuery = window.paymentPageJQuery;
        const searchValue = String(request.search?.value ?? "").trim();
        const { fromDate, toDate } = appliedPaymentInvoiceDates;
        const invoiceFiltered = Boolean(fromDate || toDate);
        const summaryOnly = !searchValue && !invoiceFiltered;
        const emptyResponse = { draw: request.draw, recordsTotal: 0, recordsFiltered: 0, data: [] };
        const requestData = {
            ...request,
            search: { ...request.search, value: searchValue }
        };

        if (summaryOnly) {
            // Read the total from the existing list endpoint without displaying its row.
            requestData.start = 0;
            requestData.length = 1;
        }
        if (invoiceFiltered) {
            requestData.fromDate = fromDate;
            requestData.toDate = toDate;
            requestData.__RequestVerificationToken = pageJQuery("#frmPaymentStudentFilters")
                .find("input[name='__RequestVerificationToken']").val();
        }

        paymentStudentEmptyMessage = summaryOnly ? paymentStudentSearchPrompt : paymentStudentNoMatches;
        const pending = pageJQuery.ajax({
            url: invoiceFiltered ? paymentInvoiceDateListUrl : paymentStudentListUrl,
            type: "POST",
            dataType: "json",
            data: requestData
        });
        paymentStudentListRequest = pending;

        function showLoadError(reason, message) {
            if (paymentStudentListRequest !== pending) return;

            paymentStudentCountUnavailable = true;
            if (!summaryOnly) {
                paymentStudentEmptyMessage = "Unable to load payment students. Try searching again.";
            }
            console.error("Cannot load payment students:", reason);
            complete(emptyResponse);
            if (!summaryOnly) {
                showPaymentError(message || "Cannot load student payment data.");
            }
        }

        return pending.done(function (response) {
            if (paymentStudentListRequest !== pending) return;

            const recordsTotal = Number(response?.recordsTotal ?? NaN);
            const recordsFiltered = Number(response?.recordsFiltered ?? NaN);
            if (!Array.isArray(response?.data) ||
                !Number.isSafeInteger(recordsTotal) || recordsTotal < 0 ||
                !Number.isSafeInteger(recordsFiltered) || recordsFiltered < 0) {
                showLoadError("Unexpected list response.");
                return;
            }

            paymentStudentCountUnavailable = false;
            complete(summaryOnly
                ? { ...emptyResponse, recordsTotal }
                : { ...response, draw: request.draw, recordsTotal, recordsFiltered });
        }).fail(function (xhr, status) {
            if (status !== "abort") {
                showLoadError(xhr.status || status, xhr.responseJSON?.message);
            }
        }).always(function () {
            if (paymentStudentListRequest === pending) {
                paymentStudentListRequest = null;
            }
        });
    }

    function updatePaymentStudentResultControls(api) {
        const pageJQuery = window.paymentPageJQuery;
        const page = api.page.info();
        const hasResults = page.recordsDisplay > 0;

        pageJQuery(api.table().container())
            .toggleClass("payment-has-results", hasResults)
            .toggleClass("payment-has-pages", hasResults && page.pages > 1);

        if (!hasResults) {
            pageJQuery(api.table().body())
                .find("td.dataTables_empty, td.dt-empty")
                .text(paymentStudentEmptyMessage);
        }
    }

    function formatPaymentDate(value) {
        if (!value) {
            return "";
        }

        const date = new Date(value);

        if (Number.isNaN(date.getTime())) {
            return value;
        }

        const day = String(date.getDate()).padStart(2, "0");
        const month = String(date.getMonth() + 1).padStart(2, "0");
        const year = date.getFullYear();

        return `${day}/${month}/${year}`;
    }

    function renderPaymentStatus(value, type) {
        const status = String(value || "").trim();
        const normalizedStatus = status.toUpperCase();

        if (type !== "display") {
            return status;
        }

        let badgeClass = "badge-secondary";

        if (normalizedStatus === "ACTIVE") {
            badgeClass = "badge-success";
        } else if (
            normalizedStatus === "REGISTER" ||
            normalizedStatus === "SUSPEND" ||
            normalizedStatus === "SUSPENDED"
        ) {
            badgeClass = "badge-warning";
        } else if (
            normalizedStatus === "QUIT" ||
            normalizedStatus === "SUPPRESS" ||
            normalizedStatus === "INACTIVE"
        ) {
            badgeClass = "badge-danger";
        }

        return `
            <span class="badge ${badgeClass} payment-status-badge px-2 py-1">
                ${escapePaymentHtml(status || "N/A")}
            </span>
        `;
    }

    function escapePaymentHtml(value) {
        return $("<div>").text(value ?? "").html();
    }

    function showPaymentError(message) {
        if (typeof ShowToastError === "function") {
            ShowToastError(message);
        } else if (window.toastr?.error) {
            window.toastr.error(message);
        } else {
            alert(message);
        }
    }

    </script>
}
