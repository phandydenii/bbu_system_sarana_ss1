@model BBU_SYSTEM.ViewModel.ListData

@{
ViewData["Title"] = "Student Payment";
ViewData["TitleContent"] = "Student Payment";
ViewData["Controller"] = "Payment";
ViewData["OpenMenu"] = "Administration";
ViewData["Action"] = "Payment";
ViewData["HideHeader"] = true;
}

<style>
    #tblStudent_wrapper {
        width: 100%;
    }

    #tblStudent_wrapper:not(.payment-has-results) .dataTables_length,
    #tblStudent_wrapper:not(.payment-has-results) .dt-length,
    #tblStudent_wrapper:not(.payment-has-pages) .dataTables_paginate,
    #tblStudent_wrapper:not(.payment-has-pages) .dt-paging {
        display: none;
    }

    #tblStudent th,
    #tblStudent td {
        vertical-align: middle !important;
        white-space: nowrap;
    }

    #tblStudent .dt-status-col,
    #tblStudent .dt-action-col {
        text-align: center !important;
    }

    #tblPaymentStudentPicker {
        width: 100% !important;
        min-width: 760px;
    }

    #tblPaymentStudentPicker th,
    #tblPaymentStudentPicker td {
        vertical-align: middle !important;
        white-space: nowrap;
    }

    #tblPaymentStudentPicker .dt-picker-status-col,
    #tblPaymentStudentPicker .dt-picker-action-col {
        text-align: center !important;
    }

    #studentPaymentPage .payment-table-scroll {
        width: 100%;
        max-width: 100%;
        overflow-x: auto;
    }

    .payment-status-badge {
        display: inline-block;
        min-width: 70px;
        padding: 5px 8px;
        text-align: center;
    }

</style>

<div id="studentPaymentPage" class="container-fluid px-0 pt-3" data-ui-design="booking-clothes-sample">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div class="mr-3">
            <h3 class="m-0 font-weight-bold text-dark">Student Payment</h3>
            <small class="text-muted">Find students, view their payments, and create new payments</small>
        </div>
        <button type="button"
                id="btnOpenPaymentStudentPicker"
                class="btn btn-primary shadow-sm text-nowrap ml-auto mt-2 mt-sm-0">
            <i class="fas fa-plus-circle mr-1" aria-hidden="true"></i>
            New Payment
        </button>
    </div>

    <!-- Date filter card; the DataTable keeps its built-in text search. -->
    <div class="card card-outline card-primary shadow-sm mb-4">
        <div class="card-header bg-white py-2">
            <h3 class="card-title font-weight-bold text-secondary" style="font-size: 0.95rem;">
                <i class="fas fa-filter text-primary mr-1"></i>
                Filter by Invoice Date
            </h3>
            <div class="card-tools">
                <button type="button"
                        class="btn btn-tool"
                        data-card-widget="collapse"
                        aria-label="Collapse invoice date filters">
                    <i class="fas fa-minus"></i>
                </button>
            </div>
        </div>
        <div class="card-body bg-light py-3">
            <form id="frmPaymentStudentFilters" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div class="row align-items-end">
                    <div class="col-sm-6 col-lg-3 col-xl-2 mb-2 mb-xl-0">
                        <label for="paymentInvoiceDateRange" class="text-secondary small font-weight-bold">
                            Invoice Date
                        </label>
                        <select id="paymentInvoiceDateRange"
                                class="custom-select"
                                aria-controls="paymentInvoiceDateFields">
                            <option value="all" selected>All Dates</option>
                            <option value="today">Today</option>
                            <option value="last7">Last 7 Days</option>
                            <option value="month">This Month</option>
                            <option value="custom">Custom Range</option>
                        </select>
                    </div>
                    <div id="paymentInvoiceDateFields" class="col-12 col-lg-6 col-xl-4 mb-2 mb-xl-0">
                        <div class="row">
                            <div class="col-sm-6 mb-2 mb-sm-0">
                                <label for="paymentFromDate" class="text-secondary small font-weight-bold">
                                    From Date
                                </label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-white border-right-0">
                                            <i class="far fa-calendar-alt text-muted" aria-hidden="true"></i>
                                        </span>
                                    </div>
                                    <input type="date"
                                           id="paymentFromDate"
                                           name="fromDate"
                                           min="0001-01-01"
                                           max="9999-12-31"
                                           class="form-control border-left-0"
                                           aria-describedby="paymentInvoiceDateHelp paymentInvoiceDateFilterError" />
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <label for="paymentToDate" class="text-secondary small font-weight-bold">
                                    To Date
                                </label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-white border-right-0">
                                            <i class="far fa-calendar-alt text-muted" aria-hidden="true"></i>
                                        </span>
                                    </div>
                                    <input type="date"
                                           id="paymentToDate"
                                           name="toDate"
                                           min="0001-01-01"
                                           max="9999-12-30"
                                           class="form-control border-left-0"
                                           aria-describedby="paymentInvoiceDateHelp paymentInvoiceDateFilterError" />
                                </div>
                            </div>
                        </div>
                        <small id="paymentInvoiceDateHelp" class="sr-only">
                            Enter one or both dates. Both selected dates are included.
                        </small>
                    </div>
                    <div class="col-auto d-flex mb-2 mb-xl-0">
                        <div class="btn-group shadow-sm" role="group" aria-label="Invoice date filters">
                            <button type="submit"
                                    id="btnFilterPaymentStudents"
                                    class="btn btn-success">
                                <i class="fas fa-search mr-1" aria-hidden="true"></i>
                                Filter
                            </button>
                            <button type="button"
                                    id="btnResetPaymentStudentFilter"
                                    class="btn btn-success border-left"
                                    title="Reset filters"
                                    aria-label="Reset invoice date filters">
                                <i class="fas fa-redo-alt" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div id="paymentInvoiceDateFilterError" class="text-danger small mt-2" role="alert" hidden></div>
                <div id="paymentInvoiceDateFilterSummary" class="small text-secondary mt-3" role="status">
                    Applied invoice dates: All Dates
                </div>
            </form>
        </div>
    </div>

    <!-- Student payment table: retain the existing columns and Payment action. -->
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <table id="tblStudent"
                   class="table table-sm table-hover table-bordered table-striped"
                   style="width: 100%;">
                <thead class="thead-light">
                <tr>
                    <th>Student ID</th>
                    <th>Name English</th>
                    <th>Name Khmer</th>
                    <th>Gender</th>
                    <th>DOB</th>
                    <th>Phone</th>
                    <th class="text-center">Status</th>
                    <th class="text-center" style="width: 110px;">Action</th>
                </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade"
     id="PaymentStudentPickerModal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="PaymentStudentPickerTitle"
     aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="PaymentStudentPickerTitle">
                    <i class="fas fa-user-check mr-2"></i>
                    Select Student
                </h4>
                <button type="button"
                        class="close"
                        data-dismiss="modal"
                        aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="table-responsive">
                    <table id="tblPaymentStudentPicker"
                           class="table table-sm table-hover table-bordered table-striped w-100"
                           style="width: 100%;">
                        <thead class="thead-light">
                        <tr>
                            <th>Student Id</th>
                            <th>Name English</th>
                            <th>Name Khmer</th>
                            <th>Gender</th>
                            <th>Phone</th>
                            <th>Status</th>
                            <th>Select</th>
                        </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-danger"
                        data-dismiss="modal">
                    <i class="fas fa-times mr-1"></i>
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

<div id="createPaymentModalHost"></div>

@section Scripts
{
<partial name="_ValidationScriptsPartial" />
<script src="~/js/Alert.js"></script>
<script src="~/function/Product.js"></script>

<script>
    // Keep the jQuery instance that already owns Bootstrap and DataTables.
    // Some older modal partials load jquery.min.js again and replace it.
    window.paymentPageJQuery = window.paymentPageJQuery || window.jQuery;

    let paymentModalRequest = null;
    let paymentStudentListRequest = null;
    let paymentStudentCountUnavailable = false;
    const paymentStudentSearchPrompt = "Search by Student ID or name, or apply an invoice date range.";
    const paymentStudentNoMatches = "No students match your search or invoice date range.";
    let paymentStudentEmptyMessage = paymentStudentSearchPrompt;
    const paymentStudentListUrl = '@Url.Content("~/student/academic/student-list/all")';
    const paymentInvoiceDateListUrl = '@Url.Action("GetStudentsByInvoiceDate", "Payment")';
    let appliedPaymentInvoiceDates = { preset: "all", fromDate: "", toDate: "" };

    $(document).ready(function () {
        registerPaymentInvoiceDateFilters();
        fetchStudent();
    });

    function registerPaymentInvoiceDateFilters() {
        $("#frmPaymentStudentFilters")
            .off("submit.paymentInvoiceFilters")
            .on("submit.paymentInvoiceFilters", function (event) {
                event.preventDefault();
                applyPaymentDateFilter();
            });

        $("#paymentInvoiceDateRange")
            .off("change.paymentInvoiceFilters")
            .on("change.paymentInvoiceFilters", syncPaymentInvoiceDateInputs);

        $("#paymentFromDate, #paymentToDate")
            .off("input.paymentInvoiceFilters change.paymentInvoiceFilters")
            .on("input.paymentInvoiceFilters change.paymentInvoiceFilters", function () {
                $("#paymentInvoiceDateRange").val("custom");
                setPaymentInvoiceDateFilterError("");
            });

        $("#btnResetPaymentStudentFilter")
            .off("click.paymentInvoiceFilters")
            .on("click.paymentInvoiceFilters", clearPaymentInvoiceDateFilters);

        syncPaymentInvoiceDateInputs();
    }

    function syncPaymentInvoiceDateInputs() {
        const preset = $("#paymentInvoiceDateRange").val();

        if (preset !== "custom") {
            setPaymentInvoiceDateInputs(getPaymentInvoicePresetDates(preset));
        }

        setPaymentInvoiceDateFilterError("");
    }

    function setPaymentInvoiceDateInputs({ fromDate, toDate }) {
        $("#paymentFromDate").val(fromDate);
        $("#paymentToDate").val(toDate);
    }

    function setPaymentInvoiceDateFilterError(message, fieldSelector) {
        $("#paymentInvoiceDateFilterError").text(message).prop("hidden", !message);
        $("#paymentFromDate, #paymentToDate").removeAttr("aria-invalid");

        if (fieldSelector) {
            $(fieldSelector).attr("aria-invalid", "true").trigger("focus");
        }
    }

    function getPaymentInvoicePresetDates(preset, now = new Date()) {
        if (!["today", "last7", "month"].includes(preset)) {
            return { preset: "all", fromDate: "", toDate: "" };
        }

        // Resolve the calendar day in Cambodia even if the device is in another timezone.
        const parts = Object.fromEntries(
            new Intl.DateTimeFormat("en-GB", {
                timeZone: "Asia/Phnom_Penh",
                year: "numeric",
                month: "2-digit",
                day: "2-digit"
            }).formatToParts(now).map(part => [part.type, part.value])
        );
        const year = Number(parts.year);
        const month = Number(parts.month) - 1;
        const today = Date.UTC(year, month, Number(parts.day));
        const isoDay = timestamp => new Date(timestamp).toISOString().slice(0, 10);

        if (preset === "month") {
            return {
                preset,
                fromDate: isoDay(Date.UTC(year, month, 1)),
                toDate: isoDay(Date.UTC(year, month + 1, 0))
            };
        }

        const dayInMilliseconds = 24 * 60 * 60 * 1000;
        const firstDay = preset === "last7" ? today - 6 * dayInMilliseconds : today;
        return { preset, fromDate: isoDay(firstDay), toDate: isoDay(today) };
    }

    function applyPaymentDateFilter() {
        const preset = $("#paymentInvoiceDateRange").val();
        let dates;

        setPaymentInvoiceDateFilterError("");

        if (preset === "custom") {
            const fromInput = document.getElementById("paymentFromDate");
            const toInput = document.getElementById("paymentToDate");

            if (!fromInput.validity.valid) {
                setPaymentInvoiceDateFilterError("Enter a valid From Date.", "#paymentFromDate");
                return;
            }

            if (!toInput.validity.valid) {
                setPaymentInvoiceDateFilterError("Enter a valid To Date.", "#paymentToDate");
                return;
            }

            const fromDate = fromInput.value;
            const toDate = toInput.value;

            if (!fromDate && !toDate) {
                setPaymentInvoiceDateFilterError("Enter at least one date, or choose All Dates.", "#paymentFromDate");
                return;
            }

            if (fromDate && toDate && fromDate > toDate) {
                setPaymentInvoiceDateFilterError("To Date must be on or after From Date.", "#paymentToDate");
                return;
            }

            dates = { preset, fromDate, toDate };
        } else {
            dates = getPaymentInvoicePresetDates(preset);
            setPaymentInvoiceDateInputs(dates);
        }

        if ((dates.fromDate || dates.toDate) && !paymentInvoiceDateListUrl) {
            setPaymentInvoiceDateFilterError("The invoice date filter endpoint is not available. Add the Payment controller action and restart the app.");
            return;
        }

        appliedPaymentInvoiceDates = dates;
        updatePaymentInvoiceDateFilterSummary();
        reloadPaymentStudentList();
    }

    function clearPaymentInvoiceDateFilters() {
        const hadDateFilter = Boolean(appliedPaymentInvoiceDates.fromDate || appliedPaymentInvoiceDates.toDate);

        $("#paymentInvoiceDateRange").val("all");
        appliedPaymentInvoiceDates = { preset: "all", fromDate: "", toDate: "" };
        syncPaymentInvoiceDateInputs();
        updatePaymentInvoiceDateFilterSummary();

        // Reset dates only; keep the user's DataTables search.
        if (hadDateFilter) {
            reloadPaymentStudentList();
        }
    }

    function updatePaymentInvoiceDateFilterSummary() {
        const { preset, fromDate, toDate } = appliedPaymentInvoiceDates;
        const labels = {
            all: "All Dates",
            today: "Today",
            last7: "Last 7 Days",
            month: "This Month",
            custom: "Custom Range"
        };
        const displayDate = iso => iso.split("-").reverse().join("/");
        let summary = "Applied invoice dates: " + labels[preset];

        if (fromDate && toDate) {
            summary += " (" + displayDate(fromDate) +
                (fromDate === toDate ? "" : " – " + displayDate(toDate)) + ")";
        } else if (fromDate) {
            summary += " (from " + displayDate(fromDate) + ")";
        } else if (toDate) {
            summary += " (through " + displayDate(toDate) + ")";
        }

        $("#paymentInvoiceDateFilterSummary").text(summary);
    }

    function reloadPaymentStudentList() {
        const pageJQuery = window.paymentPageJQuery;
        if (pageJQuery.fn.DataTable.isDataTable("#tblStudent")) {
            pageJQuery("#tblStudent").DataTable().ajax.reload(null, true);
        }
    }

    $(document)
        .off("click.openPaymentStudentPicker", "#btnOpenPaymentStudentPicker")
        .on("click.openPaymentStudentPicker", "#btnOpenPaymentStudentPicker", function () {
            openPaymentStudentPicker();
        })
        .off("click.selectPaymentStudent", ".js-select-payment-student")
        .on("click.selectPaymentStudent", ".js-select-payment-student", function () {
            const button = $(this);
            const studentId = String(button.attr("data-student-id") || "").trim();

            if (!studentId) {
                showPaymentError("The selected student ID is missing.");
                return;
            }

            $("#PaymentStudentPickerModal")
                .one("hidden.bs.modal.openPayment", function () {
                    openCreatePaymentModal(studentId, button);
                })
                .modal("hide");
        });

    $(document)
        .off("click.openPaymentModal", ".js-open-payment-modal")
        .on("click.openPaymentModal", ".js-open-payment-modal", function () {
            const button = $(this);
            const studentId = String(button.attr("data-student-id") || "").trim();

            openCreatePaymentModal(studentId, button);
        });

    function openCreatePaymentModal(studentId, button) {
        const triggerButton = button && button.length ? button : $();

        if (!studentId) {
            showPaymentError("Please select a student first.");
            return;
        }

        // Only one modal request may run at a time. This prevents several
        // rows from remaining in the Loading state after repeated clicks.
        if (paymentModalRequest && paymentModalRequest.readyState !== 4) {
            return;
        }

        if (triggerButton.length) {
            setPaymentButtonLoading(triggerButton, true);
        }

        paymentModalRequest = $.ajax({
            url: "/payment/create-student-payment-modal",
            type: "GET",
            cache: false,
            timeout: 20000,
            data: {
                studentId: studentId
            }
        })
            .done(function (html) {
                try {
                    if (!html || !String(html).trim()) {
                        throw new Error("The server returned an empty payment form.");
                    }

                    const host = $("#createPaymentModalHost");
                    host.empty();

                    // The returned partial contains its own initialization
                    // script, so insertion may throw a JavaScript error.
                    host.html(html);

                    // Restore the page instance if an older nested partial
                    // loaded another copy of jQuery during insertion.
                    if (window.paymentPageJQuery) {
                        window.jQuery = window.paymentPageJQuery;
                        window.$ = window.paymentPageJQuery;
                    }

                    const modal = host.find("#CreateStudentPaymentModal");

                    if (!modal.length) {
                        throw new Error("The payment modal was not returned by the server.");
                    }

                    modal.modal({
                        backdrop: "static",
                        keyboard: false,
                        show: true
                    });
                } catch (error) {
                    console.error("Payment modal initialization error:", error);
                    $("#createPaymentModalHost").empty();
                    showPaymentError(
                        error?.message || "Unable to initialize the payment form."
                    );
                }
            })
            .fail(function (xhr, textStatus, errorThrown) {
                console.error(
                    "Cannot load payment modal:",
                    xhr.status,
                    textStatus,
                    errorThrown,
                    xhr.responseText
                );

                const timedOut = textStatus === "timeout";

                showPaymentError(
                    xhr.responseJSON?.status?.message ||
                    xhr.responseJSON?.message ||
                    (timedOut
                        ? "The payment form took too long to load. Please try again."
                        : "") ||
                    "Unable to load the payment form."
                );
            })
            .always(function () {
                if (triggerButton.length) {
                    setPaymentButtonLoading(triggerButton, false);
                }

                paymentModalRequest = null;
            });
    }

    function openPaymentStudentPicker() {
        const picker = $("#PaymentStudentPickerModal");
        const tableSelector = "#tblPaymentStudentPicker";

        if (!$.fn.DataTable.isDataTable(tableSelector)) {
            $(tableSelector).DataTable({
                processing: true,
                serverSide: true,
                paging: true,
                pageLength: 10,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                responsive: false,
                autoWidth: false,
                searchDelay: 500,
                ajax: {
                    url: "/student/academic/student-list/all",
                    type: "POST",
                    dataSrc: function (json) {
                        return json.data || [];
                    },
                    error: function (xhr) {
                        console.error(
                            "Cannot load students for payment:",
                            xhr.status,
                            xhr.responseText
                        );
                        showPaymentError("Cannot load the student list.");
                    }
                },
                columns: [
                    { data: "studentId", defaultContent: "" },
                    { data: "studentName", defaultContent: "" },
                    { data: "studentNameInKhmer", defaultContent: "" },
                    { data: "sex", defaultContent: "" },
                    { data: "phone", defaultContent: "" },
                    {
                        data: "status",
                        defaultContent: "",
                        className: "dt-picker-status-col",
                        render: function (data, type) {
                            return renderPaymentStatus(data, type);
                        }
                    },
                    {
                        data: "studentId",
                        orderable: false,
                        searchable: false,
                        className: "dt-picker-action-col",
                        render: function (studentId) {
                            const normalizedId = String(studentId || "").trim();

                            if (!normalizedId) {
                                return "";
                            }

                            return `
                                <button type="button"
                                        class="btn btn-primary btn-sm js-select-payment-student"
                                        data-student-id="${escapePaymentHtml(normalizedId)}">
                                    <i class="fas fa-check mr-1"></i>
                                    Select
                                </button>
                            `;
                        }
                    }
                ],
                columnDefs: [
                    { targets: 0, width: "110px" },
                    { targets: 3, width: "90px" },
                    { targets: 5, width: "100px" },
                    { targets: 6, width: "100px" }
                ],
                initComplete: function () {
                    this.api().columns.adjust();

                    if (window.MyApp?.utils?.dataTableDebounceSearch) {
                        MyApp.utils.dataTableDebounceSearch(tableSelector, 500);
                    }
                }
            });
        } else {
            $(tableSelector).DataTable().ajax.reload(null, false);
        }

        picker
            .off("shown.bs.modal.paymentStudentPicker")
            .on("shown.bs.modal.paymentStudentPicker", function () {
                $(tableSelector).DataTable().columns.adjust();
            })
            .modal("show");
    }

    function setPaymentButtonLoading(button, isLoading) {
        if (isLoading) {
            button.data("payment-original-html", button.html());
            button
                .prop("disabled", true)
                .attr("aria-busy", "true")
                .html('<i class="fas fa-spinner fa-spin mr-1"></i>Loading...');
            return;
        }

        const originalHtml = button.data("payment-original-html");

        button
            .prop("disabled", false)
            .removeAttr("aria-busy")
            .html(
                originalHtml ||
                '<i class="fas fa-dollar-sign mr-1"></i>Payment'
            );

        button.removeData("payment-original-html");
    }

    function fetchStudent() {
        const tblStudent = $("#tblStudent");

        if ($.fn.DataTable.isDataTable("#tblStudent")) {
            tblStudent.DataTable().clear().destroy();
        }

        tblStudent.DataTable({
            processing: true,
            serverSide: true,
            paging: true,
            pageLength: 10,
            lengthMenu: [10, 25, 50, 100],
            lengthChange: true,
            searching: true,
            ordering: true,
            info: true,
            responsive: false,
            autoWidth: false,
            scrollX: false,
            scrollY: "",
            searchDelay: 500,

            ajax: loadPaymentStudentRows,

            columns: [
                {
                    data: "studentId",
                    defaultContent: ""
                },
                {
                    data: "studentName",
                    defaultContent: ""
                },
                {
                    data: "studentNameInKhmer",
                    defaultContent: "",
                    render: function (data) {
                        return data || "";
                    }
                },
                {
                    data: "sex",
                    defaultContent: ""
                },
                {
                    data: "dateOfBirth",
                    defaultContent: "",
                    render: function (data, type) {
                        if (type !== "display") {
                            return data || "";
                        }

                        return formatPaymentDate(data);
                    }
                },
                {
                    data: "phone",
                    defaultContent: ""
                },
                {
                    data: "status",
                    defaultContent: "",
                    className: "dt-status-col",
                    render: function (data, type) {
                        return renderPaymentStatus(data, type);
                    }
                },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    className: "dt-action-col",
                    render: function (data, type, row) {
                        const studentId = String(row.studentId || "").trim();

                        if (!studentId) {
                            return "";
                        }

                        return `
                            <button type="button"
                                    class="btn btn-success btn-sm js-open-payment-modal"
                                    data-student-id="${escapePaymentHtml(studentId)}">
                                <i class="fas fa-dollar-sign mr-1"></i>
                                Payment
                            </button>
                        `;
                    }
                }
            ],

            columnDefs: [
                { targets: 0, width: "110px" },
                { targets: 3, width: "90px" },
                { targets: 4, width: "110px" },
                { targets: 6, width: "100px" },
                { targets: 7, width: "110px" }
            ],

            language: {
                processing: "Loading...",
                searchPlaceholder: "Student ID or name",
                info: "Showing _START_ to _END_ of _TOTAL_ entries",
                infoEmpty: "Showing 0 to 0 of _MAX_ entries",
                infoFiltered: "",
                thousands: ",",
                emptyTable: paymentStudentSearchPrompt,
                zeroRecords: paymentStudentNoMatches
            },

            infoCallback: function (_settings, _start, _end, _max, _total, text) {
                return paymentStudentCountUnavailable ? "Total entries unavailable" : text;
            },

            initComplete: function () {
                const table = window.paymentPageJQuery(this.api().table().node());
                if (!table.parent().hasClass("payment-table-scroll")) {
                    table.wrap('<div class="payment-table-scroll" role="region" aria-label="Student Payment table" tabindex="0"></div>');
                }

                if (window.MyApp?.utils?.dataTableDebounceSearch) {
                    MyApp.utils.dataTableDebounceSearch("#tblStudent", 500);
                }
            },

            drawCallback: function () {
                updatePaymentStudentResultControls(this.api());
            }
        });
    }

    function loadPaymentStudentRows(request, complete) {
        if (paymentStudentListRequest) {
            const previousRequest = paymentStudentListRequest;
            paymentStudentListRequest = null;
            previousRequest.abort();
        }

        const pageJQuery = window.paymentPageJQuery;
        const searchValue = String(request.search?.value ?? "").trim();
        const { fromDate, toDate } = appliedPaymentInvoiceDates;
        const invoiceFiltered = Boolean(fromDate || toDate);
        const summaryOnly = !searchValue && !invoiceFiltered;
        const emptyResponse = { draw: request.draw, recordsTotal: 0, recordsFiltered: 0, data: [] };
        const requestData = {
            ...request,
            search: { ...request.search, value: searchValue }
        };

        if (summaryOnly) {
            // Read the total from the existing list endpoint without displaying its row.
            requestData.start = 0;
            requestData.length = 1;
        }
        if (invoiceFiltered) {
            requestData.fromDate = fromDate;
            requestData.toDate = toDate;
            requestData.__RequestVerificationToken = pageJQuery("#frmPaymentStudentFilters")
                .find("input[name='__RequestVerificationToken']").val();
        }

        paymentStudentEmptyMessage = summaryOnly ? paymentStudentSearchPrompt : paymentStudentNoMatches;
        const pending = pageJQuery.ajax({
            url: invoiceFiltered ? paymentInvoiceDateListUrl : paymentStudentListUrl,
            type: "POST",
            dataType: "json",
            data: requestData
        });
        paymentStudentListRequest = pending;

        function showLoadError(reason, message) {
            if (paymentStudentListRequest !== pending) return;

            paymentStudentCountUnavailable = true;
            if (!summaryOnly) {
                paymentStudentEmptyMessage = "Unable to load payment students. Try searching again.";
            }
            console.error("Cannot load payment students:", reason);
            complete(emptyResponse);
            if (!summaryOnly) {
                showPaymentError(message || "Cannot load student payment data.");
            }
        }

        return pending.done(function (response) {
            if (paymentStudentListRequest !== pending) return;

            const recordsTotal = Number(response?.recordsTotal ?? NaN);
            const recordsFiltered = Number(response?.recordsFiltered ?? NaN);
            if (!Array.isArray(response?.data) ||
                !Number.isSafeInteger(recordsTotal) || recordsTotal < 0 ||
                !Number.isSafeInteger(recordsFiltered) || recordsFiltered < 0) {
                showLoadError("Unexpected list response.");
                return;
            }

            paymentStudentCountUnavailable = false;
            complete(summaryOnly
                ? { ...emptyResponse, recordsTotal }
                : { ...response, draw: request.draw, recordsTotal, recordsFiltered });
        }).fail(function (xhr, status) {
            if (status !== "abort") {
                showLoadError(xhr.status || status, xhr.responseJSON?.message);
            }
        }).always(function () {
            if (paymentStudentListRequest === pending) {
                paymentStudentListRequest = null;
            }
        });
    }

    function updatePaymentStudentResultControls(api) {
        const pageJQuery = window.paymentPageJQuery;
        const page = api.page.info();
        const hasResults = page.recordsDisplay > 0;

        pageJQuery(api.table().container())
            .toggleClass("payment-has-results", hasResults)
            .toggleClass("payment-has-pages", hasResults && page.pages > 1);

        if (!hasResults) {
            pageJQuery(api.table().body())
                .find("td.dataTables_empty, td.dt-empty")
                .text(paymentStudentEmptyMessage);
        }
    }

    function formatPaymentDate(value) {
        if (!value) {
            return "";
        }

        const date = new Date(value);

        if (Number.isNaN(date.getTime())) {
            return value;
        }

        const day = String(date.getDate()).padStart(2, "0");
        const month = String(date.getMonth() + 1).padStart(2, "0");
        const year = date.getFullYear();

        return `${day}/${month}/${year}`;
    }

    function renderPaymentStatus(value, type) {
        const status = String(value || "").trim();
        const normalizedStatus = status.toUpperCase();

        if (type !== "display") {
            return status;
        }

        let badgeClass = "badge-secondary";

        if (normalizedStatus === "ACTIVE") {
            badgeClass = "badge-success";
        } else if (
            normalizedStatus === "REGISTER" ||
            normalizedStatus === "SUSPEND" ||
            normalizedStatus === "SUSPENDED"
        ) {
            badgeClass = "badge-warning";
        } else if (
            normalizedStatus === "QUIT" ||
            normalizedStatus === "SUPPRESS" ||
            normalizedStatus === "INACTIVE"
        ) {
            badgeClass = "badge-danger";
        }

        return `
            <span class="badge ${badgeClass} payment-status-badge px-2 py-1">
                ${escapePaymentHtml(status || "N/A")}
            </span>
        `;
    }

    function escapePaymentHtml(value) {
        return $("<div>").text(value ?? "").html();
    }

    function showPaymentError(message) {
        if (typeof ShowToastError === "function") {
            ShowToastError(message);
        } else if (window.toastr?.error) {
            window.toastr.error(message);
        } else {
            alert(message);
        }
    }

    $(window).on("resize.paymentStudents", function () {
        if ($.fn.DataTable.isDataTable("#tblPaymentStudentPicker")) {
            $("#tblPaymentStudentPicker").DataTable().columns.adjust();
        }
    });
</script>
}
