@model BBU_SYSTEM.ViewModel.ListData
@{
    ViewData["Title"] = "Index";
    ViewData["OpenMenu"] = "Dean";
    ViewData["Action"] = "ThesisMark";
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                @*<h3 class="card-title">AssignStudentGroup</h3>*@
                <div class="row">
                    <div class="col-md-2">
                        <label>Degree</label>
                        <select id="cboDegree" class="form-control select2"></select>
                    </div>
                    <div class="col-md-2">
                        <label>School</label>
                        <select id="cboSchool" class="form-control select2"></select>
                    </div>
                    <div class="col-md-2">
                        <label>Field</label>
                        <select id="cboField" class="form-control select2"></select>
                    </div>
                    <div class="col-md-1">
                        <label>Promotion</label>
                        <select id="cboPromotion" class="form-control select2"></select>
                    </div>
                    <div class="col-md-1">
                        <label>Stage</label>
                        <select id="cboStage" class="form-control select2"></select>
                    </div>
                    <div class="col-md-1">
                        <label>Term</label>
                        <select id="cboTerm" class="form-control select2"> </select>
                    </div>
                    <div class="col-md-2">
                        <label>Group</label>
                        <select id="cboGroup" class="form-control select2"> </select>
                    </div>
                    <div class="col-md-1">
                        <label>#</label>
                        <button onclick="OnFilter()" class="form-control btn btn-success float-right"><i
                                class="fas fa-filter"></i>
                            Filter
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-5">
                        <div class="card card-outline card-primary">
                            <div class="card-header">
                                <h3 class="card-title">Student List</h3>
                            </div>
                            <div class="card-body">
                                <table id="tblStudent" class="table-sm table table-bordered table-striped">
                                    <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Name</th>
                                        <th>Gender</th>
                                        <th>DOB</th> 
                                    </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-7">
                        <div class="card card-outline card-primary">
                            <div class="card-header">
                                <h3 class="card-title">Score List</h3>
                            </div>
                            <div class="card-body">
                                <table id="tblScore" class="table table-sm table-bordered table-striped">
                                    <thead>
                                    <tr>
                                        <th class="hide-col">id</th>
                                        <th class="hide-col">student_group_id</th>
                                        <th>name</th>
                                        <th>midterm</th>
                                        <th>final</th>
                                        <th>grade</th>
                                        <th>action</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>

@section Scripts
{
    <script src="~/function/Degree.js"></script>
    <script src="~/function/School.js"></script>
    <script src="~/function/Field.js"></script>
    <script src="~/function/Promotion.js"></script>
    <script src="~/function/Stage.js"></script>
    <script src="~/function/Term.js"></script>
    <script src="~/function/Group.js"></script>
    <script>

        const cboDegree = $("#cboDegree");
        const cboSchool = $("#cboSchool");
        const cboField = $("#cboField");
        const cboPromotion = $("#cboPromotion");
        const cboStage = $("#cboStage");
        const cboTerm = $("#cboTerm");
        const cboGroup = $("#cboGroup");
        const tblStudent = $("#tblStudent");
        const tblScore = $("#tblScore");
        $(document).ready(function () {
            $("#tblStudent").DataTable({
                responsive: true,
            });
            $("#tblScore").DataTable({
                responsive: true,
            });

            GetDegree();
            GetSchool();
            GetField();
            GetPromotion();
            GetStage();
            GetTerm();
            GetGroup();
        });

        cboDegree.change(function () {
            GetField();
            GetPromotion();
            GetStage();
            GetTerm();
            GetGroup();
        });

        cboSchool.change(function () {
            GetField();
            GetPromotion();
        });

        cboPromotion.change(function () {
            GetStage();
            GetTerm();
            GetGroup();
        });
        cboStage.change(function () {
            GetTerm();
            GetGroup();
        });
        cboTerm.change(function () {
            GetGroup();
        });

        async function GetDegree() {
            cboDegree.empty();
            cboDegree.append(`<option value='' disabled>Select Degree</option>`);
            const degrees = await Degree.GetAllDegree();
            degrees.forEach(item => {
                cboDegree.append(`<option value='${item.degreeId}'>${item.degreeName}</option>`);
            });
            cboDegree.val('').trigger("change");
        }

        async function GetSchool() {
            cboSchool.empty();
            cboSchool.append("<option value='' disabled>Select School</option>");
            const schools = await School.GetSchool()
            schools.forEach(function (item) {
                cboSchool.append(`<option value='${item.schoolId}'>${item.schoolName}</option>`);
            });
            cboSchool.val('').trigger("change");
        }


        async function GetField() {
            const degreeId = parseInt(cboDegree.val());
            const schoolId = parseInt(cboSchool.val());
            cboField.empty();
            cboField.append("<option value='' disabled>Select Field</option>");
            if (!degreeId || !schoolId) {
                cboField.val('');
                return;
            }

            const fields = await Field.GetFields({isAll: true, degreeId, schoolId});
            fields.forEach(item => {
                cboField.append(`<option value='${item.fieldId}'>${item.fieldName}</option>`);
            });
            cboField.val('').trigger("change");
        }

        async function GetPromotion() {
            const degreeId = cboDegree.val();
            const schoolId = cboSchool.val();
            cboPromotion.empty();
            cboPromotion.append("<option value='' disabled>Select Promotion</option>");
            if (!degreeId || !schoolId) {
                cboPromotion.val('');
                return;
            }
            const promotions = await Promotion.GetPromotions();
            let hasPromotion = false;
            promotions.forEach(item => {
                if (item.degree === parseInt(degreeId) && item.school === parseInt(schoolId)) {
                    cboPromotion.append(`<option value='${item.promotionId}'>${item.promotionNo}</option>`);
                    hasPromotion = true;
                }
            });
            if (!hasPromotion) {
                cboPromotion.empty();
                cboPromotion.append("<option value='' disabled>No promotion available</option>");
            }
            cboPromotion.val('').trigger("change");
        }

        async function GetStage() {
            const promotionId = cboPromotion.val();
            cboStage.empty();
            cboStage.append("<option value='' disabled>Select Stage</option>");
            if (!promotionId) {
                cboPromotion.val('');
                return;
            }
            const stages = await Stage.GetStages();
            stages.forEach(item => {
                if (item.promotionId === parseInt(promotionId)) {
                    cboStage.append(`<option value='${item.stageId}'>${item.stageNo}</option>`);
                }
            });
            cboStage.val('').trigger("change");
        }

        async function GetTerm() {
            const stageId = cboStage.val();
            cboTerm.empty();
            cboTerm.append("<option value='' disabled>Select Term</option>");
            if (!stageId) {
                cboTerm.val('');
                return;
            }
            const terms = await Term.GetTerms();
            terms.forEach(item => {
                if (item.stageId === parseInt(stageId)) {
                    cboTerm.append(`<option value='${item.termNo}'>${item.termNo}</option>`);
                }
            });
            cboTerm.val('').trigger("change");
        }

        async function GetGroup() {
            const stageId = cboStage.val();
            const fieldId = cboField.val();

            cboGroup.empty();
            cboGroup.append("<option value='' disabled>Select Group</option>");
            if (!stageId || !fieldId) {
                cboGroup.val('');
                return;
            }
            const groups = await Group.GetGroups();
            groups.forEach(item => {
                if (item.stageId === parseInt(stageId) && item.fieldId === parseInt(fieldId)) {
                    cboGroup.append(`<option value='${item.groupId}'>${item.groupName}</option>`);
                }
            });
            cboGroup.val('').trigger("change");
        }

        function OnFilter() {
            const term_no = cboTerm.find("option:selected").text();
            const group_id = cboGroup.val();

            if (!group_id || !term_no) return;

            tblStudent.DataTable().clear().destroy();
            tblStudent.DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                ajax: {
                    url: `/student/GetStudents`,
                    type: "POST",
                    data: {
                        groupid: group_id,
                        termno: term_no
                    },
                },
                columns: [
                    {data: "studentId"},
                    {data: "studentName"},
                    {data: "sex"},
                    {
                        data: "dateOfBirth",
                        render: function (data, type, row) {
                            return `${formatDate(data)}`
                        }
                    }
                ]
            })
        }

        tblStudent.on('click', 'tbody tr', function () {
            tblStudent.find('tbody tr').removeClass('highlight');
            $(this).addClass('highlight');
            const $row = $(this).closest('tr');
            const data = tblStudent.DataTable().row($row).data();
            GetScores(data.studentGroupId);
        });

        function GetScores(student_group_id) {
            if (!student_group_id) return;
            tblScore.DataTable().clear().destroy();
            tblScore
                .DataTable({
                    processing: true,
                    serverSide: true,
                    responsive: true,
                    ajax: {
                        url: `/scores/get-scores/${student_group_id}`,
                        type: "POST",
                        data: {
                            type: "PROJECT_PAPER"
                        },
                    },
                    columns: [
                        {data: "scoreId", visible: false},
                        {data: "studentGroupId", visible: false},
                        {data: "courseName"},
                        {
                            data: "midTermScore",
                            render: function (data, type, row) {
                                return `<input type="number" class="form-control form-control-sm is-warning" name="midterm" value="${data ? data.toFixed(2) : 0.00}" readonly/>`;
                            }
                        },
                        {
                            data: "finalScore",
                            render: function (data, type, row) {
                                return `<input type="number" class="form-control form-control-sm is-warning" name="final" value="${data ? data.toFixed(2) : 0.00}" readonly/>`;
                            }
                        },
                        {
                            data: null,
                            render: function (data, type, row) {
                                const totalScore = (row.midTermScore || 0) + (row.finalScore || 0);
                                if (totalScore >= 60) {
                                    return `<badge class="badge badge-success">Pass</badge>`;
                                } else {
                                    return `<badge class="badge badge-danger">Fail</badge>`;
                                }
                            }
                        },
                        {
                            data: null,
                            render: function (data, type, row) {
                                return `<button class="btn btn-warning btn-sm" id="btnEdit"><i class="fa-solid fa-pen-to-square"></i></button>`;
                            }
                        }
                    ]
                });
        }

        tblScore.on("click", "#btnEdit", function () {
            // Find the clicked row
            const $row = $(this).closest('tr');
            $row.find('input[name="midterm"]').prop('readonly', false);
            $row.find('input[name="final"]').prop('readonly', false);

            // Optionally change button to Save
            $(this)
                .attr('id', 'btnSave')
                .removeClass('btn-warning')
                .addClass('btn-success')
                .html('<i class="fas fa-check"></i>');
        });

        tblScore.on("click", "#btnSave", function () {
            // Find the clicked row
            const $row = $(this).closest('tr');
            // Enable the input fields in this row
            $row.find('input[name="midterm"]').prop('readonly', true);
            $row.find('input[name="final"]').prop('readonly', true);

            // Optionally change button to Save
            $(this)
                .attr('id', 'btnEdit')
                .removeClass('btn-success')
                .addClass('btn-warning')
                .html('<i class="fa-solid fa-pen-to-square"></i>');
        });
    </script>
}
