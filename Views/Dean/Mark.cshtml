@model BBU_SYSTEM.ViewModel.ListData
@{
    ViewData["Title"] = "Index";
    ViewData["OpenMenu"] = "Dean";
    ViewData["Action"] = "Mark";
    ViewData["HideHeader"] = true;
}

<style>
    .filter-drawer .modal-dialog {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        width: 460px;
        max-width: 100%;
        height: 100%;
        margin: 0;
    }

    .filter-drawer.fade .modal-dialog {
        transform: translateX(100%);
        transition: transform 0.3s ease;
    }

    .filter-drawer.show .modal-dialog {
        transform: translateX(0);
    }

    .filter-drawer .modal-content {
        height: 100%;
        border: 0;
        border-radius: 0;
        box-shadow: -8px 0 30px rgba(0, 0, 0, 0.12);
    }

    .filter-drawer .modal-header,
    .filter-drawer .modal-footer {
        flex-shrink: 0;
        padding: 16px 24px;
    }

    .filter-drawer .modal-body {
        flex: 1 1 auto;
        overflow-y: auto;
        padding: 24px;
    }

    .filter-drawer .form-group {
        margin-bottom: 20px;
    }
</style>

<div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <div class="mr-3 mb-2">
        <h3 class="m-0 font-weight-bold text-dark">Learner Management</h3>
        <small class="text-muted">
            Filter learners by academic criteria and manage assigned courses
        </small>
    </div>

    <div class="d-flex mb-2">
        <button type="button"
                class="btn btn-outline-primary mr-2"
                data-toggle="modal"
                data-target="#LearnerFilterModal">
            <i class="fas fa-filter mr-1"></i> Filter
        </button>
    </div>
</div>

<!-- Filter drawer -->
<div class="modal fade filter-drawer"
     id="LearnerFilterModal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="learnerFilterTitle"
     aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title font-weight-bold"
                    id="learnerFilterTitle">
                    <i class="fas fa-filter mr-2 text-primary"></i>
                    Filter Criteria
                </h5>
                <button type="button"
                        class="close"
                        data-dismiss="modal"
                        aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="cboDegree">Degree</label>
                    <select id="cboDegree"
                            class="form-control select2"
                            style="width:100%"></select>
                </div>
                <div class="form-group">
                    <label for="cboSchool">School</label>
                    <select id="cboSchool"
                            class="form-control select2"
                            style="width:100%"></select>
                </div>

                <div class="form-group">
                    <label for="cboField">Field</label>
                    <select id="cboField"
                            class="form-control select2"
                            style="width:100%"></select>
                </div>

                <div class="form-group">
                    <label for="cboPromotion">Promotion</label>
                    <select id="cboPromotion"
                            class="form-control select2"
                            style="width:100%"></select>
                </div>

                <div class="form-group">
                    <label for="cboStage">Stage</label>
                    <select id="cboStage"
                            class="form-control select2"
                            style="width:100%"></select>
                </div>

                <div class="form-group">
                    <label for="cboTerm">Term</label>
                    <select id="cboTerm"
                            class="form-control select2"
                            style="width:100%"></select>
                </div>

                <div class="form-group">
                    <label for="cboGroup">Group</label>
                    <select id="cboGroup"
                            class="form-control select2"
                            style="width:100%"></select>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-light"
                        data-dismiss="modal">
                    Close
                </button>

                <button type="button"
                        class="btn btn-primary"
                        id="btnFilter">
                    <i class="fas fa-check mr-1"></i>
                    Apply Filter
                </button>
            </div>

        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-body bg-light/30">
                <div id="activeFilterSummary"
                     class="d-none mb-3"
                     role="status"
                     aria-live="polite">
                    <div class="d-flex align-items-center flex-wrap">
                        <small class="text-primary font-weight-bold mr-2 mb-1">
                            <i class="fas fa-filter mr-1"></i>
                            Filtered by:
                        </small>
                        <div id="activeFilterBadges" class="d-flex flex-wrap"></div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-xl-5 mb-2">
                        <div class="card card-outline card-primary h-100 shadow-sm border-top-3">
                            <div class="card-header bg-white d-flex align-items-center justify-content-between">
                                <h3 class="card-title font-weight-bold text-primary m-0"><i class="fas fa-user-graduate mr-2"></i>Student List</h3>
                                <h4 id="studentCountText" class="text-muted mb-0 ml-auto text-end" style="font-size: 18px;font-weight: 500;"></h4>
                            </div>
                            <div class="card-body p-2">
                                <div class="table-responsive w-100">
                                    <table id="tblStudent" class="table table-hover table-bordered table-sm w-100 m-0">
                                        <thead class="thead-light">
                                        <tr>
                                            <th width="15%">ID</th>
                                            <th>Name</th>
                                            <th width="10%">Gender</th>
                                            <th width="20%">DOB</th>
                                            <th width="10%">Action</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td colspan="5" class="text-center text-muted">
                                                    Apply filters to load students.
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-xl-7 mb-2">
                        <div class="card card-outline card-success h-100 shadow-sm border-top-3">
                            <div class="card-header bg-white d-flex align-items-center justify-content-between">
                                <h3 class="card-title font-weight-bold text-primary m-0"><i class="fas fa-star mr-2"></i>Score Performance</h3>
                                <span class="badge badge-pill badge-info px-3 py-2 font-weight-normal" id="lblStudentName" style="display:none;"></span>
                            </div>
                            <div class="card-body p-2">
                                <div class="table-responsive w-100">
                                    <table id="tblScore" class="table table-hover table-bordered table-sm w-100 m-0">
                                        <thead class="thead-light">
                                        <tr>
                                            <th>Course Name</th>
                                            <th width="25%">Midterm</th>
                                            <th width="25%">Final</th>
                                            <th width="10%">Grade</th>
                                            <th width="10%">Action</th>
                                        </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>

@section Scripts
{
    <script src="~/function/Degree.js"></script>
    <script src="~/function/School.js"></script>
    <script src="~/function/Field.js"></script>
    <script src="~/function/Promotion.js"></script>
    <script src="~/function/Stage.js"></script>
    <script src="~/function/Term.js"></script>
    <script src="~/function/Group.js"></script>

    <script>
        const cboDegree = $("#cboDegree");
        const cboSchool = $("#cboSchool");
        const cboField = $("#cboField");
        const cboPromotion = $("#cboPromotion");
        const cboStage = $("#cboStage");
        const cboTerm = $("#cboTerm");
        const cboGroup = $("#cboGroup"); 
        const tblStudent = $("#tblStudent");
        const tblScore = $("#tblScore");
        let dtStudent = null;
        let dtScore = null;

        let appliedFilters = null;
        const academicFilters = [
            { label: "Degree", select: cboDegree },
            { label: "School", select: cboSchool },
            { label: "Field", select: cboField },
            { label: "Promotion", select: cboPromotion },
            { label: "Stage", select: cboStage },
            { label: "Term", select: cboTerm },
            { label: "Group", select: cboGroup }
        ];

        function updateFilterSummary() {
            const container = $("#activeFilterBadges").empty();
            academicFilters.forEach(function (filter) {
                $("<span>")
                    .addClass("badge badge-light border mr-2 mb-1 px-2 py-2")
                    .text(
                        filter.label + ": " +
                        filter.select.find("option:selected").text().trim()
                    )
                    .appendTo(container);
            });
            $("#activeFilterSummary").removeClass("d-none");
        }

        $(document).ready(function () {
            $("#LearnerFilterModal .select2").select2({
                dropdownParent: $("#LearnerFilterModal"),
                width: "100%"
            });
            GetDegree();
            GetSchool();
        });

        $("#btnFilter").on("click", function () {
            OnFilter();
        });

        cboField.change(function () {
            GetGroup();
        });

        cboDegree.change(function () { GetField(); GetPromotion(); });
        cboSchool.change(function () { GetField(); GetPromotion(); });
        cboPromotion.change(function () { GetStage(); GetTerm(); GetGroup(); });
        cboStage.change(function () { GetTerm(); GetGroup(); });
        cboTerm.change(function () { GetGroup(); });

        async function GetDegree() {
            cboDegree.empty().append(`<option value='' disabled>Select Degree</option>`);
            const degrees = await Degree.GetAllDegree();
            degrees.forEach(item => {
                cboDegree.append(`<option value='${item.degreeId}'>${item.degreeName}</option>`);
            });
            cboDegree.val('').trigger("change");
        }

        async function GetSchool() {
            cboSchool.empty().append("<option value='' disabled>Select School</option>");
            const schools = await School.GetSchool();
            schools.forEach(function (item) {
                cboSchool.append(`<option value='${item.schoolId}'>${item.schoolName}</option>`);
            });
            cboSchool.val('').trigger("change");
        }

        async function GetField() {
            const degreeId = parseInt(cboDegree.val());
            const schoolId = parseInt(cboSchool.val()); 
            if (!degreeId || !schoolId) return;
            const fields = await Field.GetFields({isAll: true, degreeId, schoolId});
            fields.forEach(item => {
                cboField.append(`<option value='${item.fieldId}'>${item.fieldName}</option>`);
            });
            cboField.val('').trigger("change");
        }

        async function GetPromotion() {
            const degreeId = cboDegree.val();
            const schoolId = cboSchool.val(); 
            if (!degreeId || !schoolId) return; 
            const promotions = await Promotion.GetPromotions({isSelect2: true, degreeId, schoolId});
            let hasPromotion = false;
            promotions.forEach(item => {
                cboPromotion.append(`<option value='${item.promotionId}'>${item.promotionNo}</option>`);
                hasPromotion = true;
            });
            if (!hasPromotion) {
                cboPromotion.empty().append("<option value='' disabled>No promotion available</option>");
            }
            cboPromotion.val('').trigger("change");
        }

        async function GetStage() {
            const promotionId = cboPromotion.val();
            cboStage.empty().append("<option value='' disabled>Select Stage</option>");
            if (!promotionId) { cboPromotion.val(''); return; }

            const stages = await Stage.GetStages({promotionId});
            stages.forEach(item => {
                cboStage.append(`<option value='${item.stageId}'>${item.stageNo}</option>`);
            });
            cboStage.val('').trigger("change");
        }

        async function GetTerm() {
            const stageId = cboStage.val();
            cboTerm.empty().append("<option value='' disabled>Select Term</option>");
            if (!stageId) { cboTerm.val(''); return; }

            const terms = await Term.GetTerms({stageId});
            terms.forEach(item => {
                cboTerm.append(`<option value='${item.termNo}'>${item.termNo}</option>`);
            });
            cboTerm.val('').trigger("change");
        }

        async function GetGroup() {
            const stageId = cboStage.val();
            const fieldId = cboField.val();
            cboGroup.empty().append("<option value='' disabled>Select Group</option>");
            if (!stageId || !fieldId) { cboGroup.val(''); return; }

            const groups = await Group.GetGroups({stageId, fieldId});
            groups.forEach(item => {
               cboGroup.append(`<option value='${item.groupId}'>${item.groupName}</option>`);
            });
            cboGroup.val('').trigger("change");
        }

        function OnFilter() {
            if (academicFilters.some(filter => !(Number(filter.select.val()) > 0))) {
                ShowToastInfo("Please select all filter criteria.");
                return;
            }
            appliedFilters = {
                termNo: cboTerm.val(),
                groupId: cboGroup.val()
            };

            updateFilterSummary();
            $("#LearnerFilterModal").modal("hide");
            $("#lblStudentName").hide().text("");
            tblStudent.find("tbody tr").removeClass("highlight");
            if ($.fn.DataTable.isDataTable("#tblScore")) {
                tblScore.DataTable().destroy();
            }
            tblScore.find("tbody").empty();
            if (dtStudent) {
                dtStudent.ajax.reload();
                return;
            }
            dtStudent = tblStudent.DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                autoWidth: false,
                language: {
                    emptyTable: "No students available.",
                    zeroRecords: "No matching students found."
                },
                info:false,
                ajax: {
                    url: `/student/GetStudents`,
                    type: "POST",
                    data: function (d) {
                        d.TermNo = appliedFilters.termNo;
                        d.GroupId = appliedFilters.groupId;
                    }
                },
                drawCallback: function () {
                    const info = this.api().page.info();
                    $("#studentCountText").text(
                        `Showing ${info.start + 1} to ${info.end} of ${info.recordsDisplay}`
                    );
                },
                columns: [
                    { data: "studentId" },
                    { data: "studentName" },
                    { data: "sex" },
                    {
                        data: "dateOfBirth",
                        render: function (data) { return formatDate(data); }
                    },
                    {
                        data: null,
                        defaultContent: `<button class="btn btn-xs btn-outline-primary py-0 px-1"><i class="fas fa-eye"></i></button>`
                    }
                ],
                initComplete: function (){
                    MyApp.utils.dataTableDebounceSearch("#tblStudent", 500);
                }
            });
        }

        $('#tblStudent tbody').on('click', 'tr', function () {
            $('#tblStudent tbody tr').removeClass('highlight');
            $(this).addClass('highlight');
            
            const selectedRow = $('#tblStudent').DataTable().row(this).data();
            if(selectedRow) {
                $("#lblStudentName").show().html(`<i class="fas fa-user mr-1"></i> ${selectedRow.studentName}`);
                GetScores(selectedRow.studentGroupId);
            }
        });

        function GetScores(student_group_id) {
            if (!student_group_id) return;
            tblScore.DataTable().clear().destroy();
            tblScore.DataTable({
                    processing: true,
                    serverSide: true,
                    responsive: false,
                    autoWidth: false,
                    ajax: {
                        url: `/scores/get-scores/${student_group_id}`,
                        type: "POST",
                        // data: { type: "FINAL" },
                        dataSrc: function (json) { return json.data; },
                        error: function (jqXHR) { console.log(jqXHR.responseText); }
                    },
                    columns: [
                        { 
                            data: null,
                            render: function (data, type, row) {
                                return `${data.courseName} <badge class="badge badge-warning">${data.type}</badge>`;
                            }
                        },
                        {
                            data: "midTermScore", 
                            render: function (data) {
                                return `<input type="number" step="0.01" class="form-control form-control-sm text-center font-weight-bold border-warning" name="midterm" value="${data ? data.toFixed(2) : '0.00'}" readonly/>`;
                            }
                        },
                        {
                            data: "finalScore", 
                            render: function (data) {
                                return `<input type="number" step="0.01" class="form-control form-control-sm text-center font-weight-bold border-warning" name="final" value="${data ? data.toFixed(2) : '0.00'}" readonly/>`;
                            }
                        },
                        {
                            data: null,
                            render: function (data, type, row) {
                                const totalScore = (row.midTermScore || 0) + (row.finalScore || 0);
                                return totalScore >= 60 
                                    ? `<span class="badge badge-success d-block py-1">Pass</span>` 
                                    : `<span class="badge badge-danger d-block py-1">Fail</span>`;
                            }
                        },
                        {
                            data: null,
                            render: function () {
                                return `<div class="text-center"><button class="btn btn-warning btn-sm" id="btnEdit"><i class="fas fa-edit"></i></button></div>`;
                            }
                        }
                    ],
                    initComplete: function (){
                        MyApp.utils.dataTableDebounceSearch("#tblScore", 500); 
                        setTimeout(() => { $('#tblScore').DataTable().columns.adjust(); }, 150);
                    }
                });
        }
        
        tblScore.on("click", "#btnEdit", function (e) {
            e.preventDefault();
            const $row = $(this).closest('tr'); 
            $row.find('input[name="midterm"]').prop('readonly', false).addClass('bg-white');
            $row.find('input[name="final"]').prop('readonly', false).addClass('bg-white');

            $(this)
                .attr('id', 'btnSave')
                .removeClass('btn-warning')
                .addClass('btn-success')
                .html('<i class="fas fa-save"></i>');
        });

        tblScore.on("click", "#btnSave", async function (e) {
            e.preventDefault();
            const $row = $(this).closest('tr');
            const newMid = parseFloat($row.find('input[name="midterm"]').val()) || 0;
            const newFinal = parseFloat($row.find('input[name="final"]').val()) || 0;
            
            // Instantly recalculate dynamic Badge visual without needing a server trip
            const total = newMid + newFinal;
            const $badgeCell = $row.find('span.badge');
            if(total >= 60) {
                $badgeCell.removeClass('badge-danger').addClass('badge-success').text('Pass');
            } else {
                $badgeCell.removeClass('badge-success').addClass('badge-danger').text('Fail');
            }

            $(this)
                .attr('id', 'btnEdit')
                .removeClass('btn-success')
                .addClass('btn-warning')
                .html('<i class="fas fa-edit"></i>'); 
            $row.find('input[name="midterm"]').prop('readonly', true).removeClass('bg-white');
            $row.find('input[name="final"]').prop('readonly', true).removeClass('bg-white'); 
            const table = $('#tblScore').DataTable();
            const rowData = table.row($row).data(); 
            if(e.target){
                const updatedMid = parseFloat($row.find('input[name="midterm"]').val());
                const updatedFinal = parseFloat($row.find('input[name="final"]').val());
                try {
                    const response = await $.ajax({
                        url: "/scores/update-score",
                        method: 'PUT',
                        data: {
                            id: rowData.scoreId,
                            midterm: updatedMid,
                            final: updatedFinal,
                        },
                    });
                    if (response.status.code === "200") {
                        ShowToastSuccess(response.status.message);
                        tblScore.DataTable().ajax.reload(null, false);
                    }else{
                        ShowToastError(response.status.message);
                    }
                }catch(err) {
                    ShowToastError(err);
                }
            }
        });
    </script>
}