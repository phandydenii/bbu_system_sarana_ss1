@model BBU_SYSTEM.ViewModel.LearnerViewModel
@{
    ViewData["Title"] = "Index";
    ViewData["OpenMenu"] = "Dean";
    ViewData["Action"] = "Learner";
    ViewData["HideHeader"] = true;
}  
<style>
    /* Right-side filter drawer */
    .filter-drawer .modal-dialog {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        width: 460px;
        max-width: 100%;
        height: 100%;
        margin: 0;
    }

    .filter-drawer.fade .modal-dialog {
        transform: translateX(100%);
        transition: transform 0.3s ease;
    }

    .filter-drawer.show .modal-dialog {
        transform: translateX(0);
    }

    .filter-drawer .modal-content {
        height: 100%;
        border: 0;
        border-radius: 0;
        box-shadow: -8px 0 30px rgba(0, 0, 0, 0.12);
    }

    .filter-drawer .modal-header {
        flex-shrink: 0;
        padding: 20px 24px;
    }

    .filter-drawer .modal-body {
        flex: 1 1 auto;
        overflow-y: auto;
        padding: 24px;
    }

    .filter-drawer .modal-footer {
        flex-shrink: 0;
        padding: 16px 24px;
        background: #fff;
        border-top: 1px solid #e9ecef;
    }

    /* Stack filter fields vertically */
    .filter-drawer .modal-body .form-group {
        flex: 0 0 100%;
        max-width: 100%;
        margin-bottom: 20px;
    }
</style>
<div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <div class="mr-3 mb-2">
        <h3 class="m-0 font-weight-bold text-dark">Learner Management</h3>
        <small class="text-muted">
            Filter learners by academic criteria and manage assigned courses
        </small>
    </div>

    <div class="d-flex mb-2">
        <button type="button"
                class="btn btn-outline-primary mr-2"
                data-toggle="modal"
                data-target="#LearnerFilterModal">
            <i class="fas fa-filter mr-1"></i> Filter
        </button>

        <button type="button" class="btn btn-success" id="btnAddCourse">
            <i class="fas fa-plus mr-1"></i> Add Course
        </button>
    </div>
</div>

<!-- Filter drawer -->
<div class="modal fade filter-drawer"
     id="LearnerFilterModal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="learnerFilterTitle"
     aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title font-weight-bold" id="learnerFilterTitle">
                    <i class="fas fa-filter mr-2 text-primary"></i>Filter Criteria
                </h5>

                <button type="button"
                        class="close"
                        data-dismiss="modal"
                        aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6 form-group">
                        <label for="cboDegree" class="filter-label">Degree</label>
                        <select id="cboDegree" class="form-control select2"
                                style="width:100%"></select>
                    </div>

                    <div class="col-md-6 form-group">
                        <label for="cboSchool" class="filter-label">School</label>
                        <select id="cboSchool" class="form-control select2"
                                style="width:100%"></select>
                    </div>

                    <div class="col-md-6 form-group">
                        <label for="cboField" class="filter-label">Field</label>
                        <select id="cboField" class="form-control select2"
                                style="width:100%"></select>
                    </div>

                    <div class="col-md-6 form-group">
                        <label for="cboPromotion" class="filter-label">Promotion</label>
                        <select id="cboPromotion" class="form-control select2"
                                style="width:100%"></select>
                    </div>

                    <div class="col-md-6 form-group">
                        <label for="cboStage" class="filter-label">Stage</label>
                        <select id="cboStage" class="form-control select2"
                                style="width:100%"></select>
                    </div>

                    <div class="col-md-6 form-group">
                        <label for="cboTerm" class="filter-label">Term</label>
                        <select id="cboTerm" class="form-control select2"
                                style="width:100%"></select>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-light"
                        data-dismiss="modal">
                    Close
                </button>

                <button type="button" class="btn btn-primary" id="btnFilter">
                    <i class="fas fa-check mr-1"></i> Apply Filter
                </button>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid">   
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <div id="activeFilterSummary"
                 class="d-none mb-3"
                 role="status"
                 aria-live="polite">
                <div class="d-flex align-items-center flex-wrap">
                    <small class="text-primary font-weight-bold mr-2 mb-1">
                        <i class="fas fa-filter mr-1"></i> Filtered by:
                    </small>

                    <div id="activeFilterBadges" class="d-flex flex-wrap"></div>
                </div>
            </div>
            <div class="table-responsive">
                <table id="tblCourse" class="table table-bordered table-sm table-hover w-100">
                    <thead>
                    <tr>
                        <th>Course Term Id</th>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Credit</th>
                        <th>Hour</th>
                        <th class="text-center" style="width: 160px;">Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_ValidationScriptsPartial"/>
<partial name="_CourseTerm"/>

@section Scripts
{
    <script src="~/function/Degree.js"></script>
    <script src="~/function/School.js"></script>
    <script src="~/function/Field.js"></script>
    <script src="~/function/Promotion.js"></script>
    <script src="~/function/Stage.js"></script>
    <script src="~/function/Term.js"></script>
    <script src="~/function/Group.js"></script>
    <script>
        const cboDegree = $("#cboDegree");
        const cboSchool = $("#cboSchool");
        const cboField = $("#cboField");
        const cboPromotion = $("#cboPromotion");
        const cboStage = $("#cboStage");
        const cboTerm = $("#cboTerm");
        const cboGroup = $("#cboGroup");
        const tblCourse = $("#tblCourse");
        const modalCourseTerm = $("#CourseTermModal");
        const btnClose = $("#btnClose");
        const btnSave = $("#btnSave"); 
        const btnAddCourse = $("#btnAddCourse");
        
        $(document).ready(function () {
            tblCourse.DataTable({responsive: true,});
            btnAddCourse.prop("disabled", true);
            $("#LearnerFilterModal .select2").select2({
                dropdownParent: $("#LearnerFilterModal"),
                width: "100%"
            });
            GetDegree();
            GetSchool();
            GetCourse();
        });

        cboDegree.change(function () {
            GetField();
            GetPromotion();
            GetStage();
            GetTerm(); 
        });

        cboSchool.change(function () {
            GetField();
            GetPromotion();
        });

        cboPromotion.change(function () {
            GetStage();
            GetTerm(); 
        });
        cboStage.change(function () {
            GetTerm(); 
        });

        $("#btnFilter").on("click", function () {
            const requiredFilters = [
                cboDegree,
                cboSchool,
                cboField,
                cboPromotion,
                cboStage,
                cboTerm
            ];

            if (requiredFilters.some(select => !(Number(select.val()) > 0))) {
                ShowToastInfo("Please select all filter criteria.");
                return;
            }

            OnFilter();
            OnFilter();
            updateFilterSummary(); 
            btnAddCourse.prop("disabled", false); 
            btnAddCourse.prop("disabled", false);
            $("#LearnerFilterModal").modal("hide");
        });
        async function GetCourse(){
            $.ajax(
                {
                    url: "/course/get-course-list",
                    type: "GET",
                    success: function (response) {
                        const cboGroup = document.getElementById("courseTerm_CourseId");
                        cboGroup.innerText = "";
                        const option = document.createElement("option");
                        option.value = -1;
                        option.text = "Select Course";
                        cboGroup.appendChild(option);
                        response.data.forEach(item => {
                            const option = document.createElement("option");
                            option.value = item.courseId;
                            option.text = item.courseFullName;
                            cboGroup.appendChild(option);
                        });
                    }
                }
            )
        }
        async function GetDegree() {
            cboDegree.empty();
            cboDegree.append(`<option value='0' disabled>Select Degree</option>`);
            const degrees = await Degree.GetAllDegree();
            degrees.forEach(item => {
                cboDegree.append(`<option value='${item.degreeId}'>${item.degreeName}</option>`);
            });
            cboDegree.val('0').trigger("change");
        }

        async function GetSchool() {
            cboSchool.empty();
            cboSchool.append("<option value='0' disabled>Select School</option>");
            const schools = await School.GetSchool()
            schools.forEach(function (item) {
                cboSchool.append(`<option value='${item.schoolId}'>${item.schoolName}</option>`);
            });
            cboSchool.val('0').trigger("change");
        }


        async function GetField() {
            const degreeId = parseInt(cboDegree.val());
            const schoolId = parseInt(cboSchool.val());
            cboField.empty();
            cboField.append("<option value='0' disabled>Select Field</option>");
            if (!degreeId || !schoolId) {
                cboField.val('0');
                return;
            }

            const fields = await Field.GetFields({isAll: true, degreeId, schoolId});
            fields.forEach(item => {
                cboField.append(`<option value='${item.fieldId}'>${item.fieldName}</option>`);
            });
            cboField.val('0').trigger("change");
        }

        async function GetPromotion() {
            const degreeId = cboDegree.val();
            const schoolId = cboSchool.val();
            cboPromotion.empty();
            cboPromotion.append("<option value='0' disabled>Promotion</option>");
            if (!degreeId || !schoolId) {
                cboPromotion.val('0');
                return;
            }
            const promotions = await Promotion.GetPromotions({degreeId,schoolId});
            let hasPromotion = false;
            promotions.forEach(item => {
                cboPromotion.append(`<option value='${item.promotionId}'>${item.promotionNo}</option>`);
                hasPromotion = true;
            });
            if (!hasPromotion) {
                cboPromotion.empty();
                cboPromotion.append("<option value='0' disabled>No promotion available</option>");
            }
            cboPromotion.val('0').trigger("change");
        }

        async function GetStage() {
            const promotionId = cboPromotion.val();
            cboStage.empty();
            cboStage.append("<option value='0' disabled>Stage</option>");
            if (!promotionId) {
                cboPromotion.val('0');
                return;
            }
            const stages = await Stage.GetStages({promotionId});
            stages.forEach(item => {
                cboStage.append(`<option value='${item.stageId}'>${item.stageNo}</option>`);
            });
            cboStage.val('0').trigger("change");
        }
        async function GetTerm() {
            const stageId = cboStage.val();
            cboTerm.empty();
            cboTerm.append("<option value='0' disabled>Select Term</option>");
            if (!stageId) {
                cboTerm.val('0');
                return;
            }
            const terms = await Term.GetTerms({stageId});
            terms.forEach(item => {
                cboTerm.append(`<option value='${item.termId}'>${item.termNo}</option>`); 
            });
            cboTerm.val('0').trigger("change");
        }
        function OnFilter() {
            const termId = cboTerm.find(":selected").val();
            const stageId = cboStage.find(":selected").val();
            const fieldId = cboField.find(":selected").val();
            const promotionId = cboPromotion.find(":selected").val();

            tblCourse.DataTable().clear().destroy();
            tblCourse.DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                orderings: true,
                ajax: {
                    url: `/course-term/get-course-terms/${termId}/${stageId}/${promotionId}/${fieldId}`,
                    type: "POST",
                },
                columns: [
                    {data: "courseTermId"},
                    {data: "courseFullName"},
                    {data: "type"},
                    {data: "credit"},
                    {data: "hours"},
                    {
                        data: null,
                        width: 160,
                        className: "text-center",
                        render: (data, type, row) => { 
                            return `
                                <div class="btn-group" role="group">
                                    <button class="btn btn-outline-warning btn-sm mx-1 px-3" id="btnEdit" style="border-radius:4px;"><i class="fas fa-edit mr-1"></i> Edit</button>
                                    <button class="btn btn-outline-danger btn-sm mx-1 px-3" id="btnRemove" style="border-radius:4px;"><i class="fas fa-trash-alt mr-1"></i> Remove</button>
                                </div>                               
                            `;
                        }
                    },
                ],
                initComplete: function (){
                    MyApp.utils.dataTableDebounceSearch("#tblCourse",500);
                } 
            })
        }

        tblCourse.on("click","#btnEdit", async function(e) {
            tblCourse.find("tr").removeClass("highlight");
            let $row = $(this).closest("tr");
            if ($row.hasClass("child")) {
                $row = $row.prev();
            }
            $row.addClass("highlight");
            const data = tblCourse.DataTable().row($row).data(); 
            if (data) {  
                $("#courseTerm_CoursetermId").val(data.courseTermId);
                $("#courseTerm_FieldId").val(cboField.find(":selected").val());
                $("#courseTerm_TermId").val(cboTerm.find(":selected").val()); 
                $("#courseTerm_CourseId").val(data.courseId).trigger("change");
                $(`input[name="courseTerm.Type"][value="${data.type}"]`).prop("checked", true);
                $("#courseTerm_Credit").val(data.credit);
                $("#courseTerm_Hours").val(data.hours);
                modalCourseTerm.modal("show");
            }
        });
        
        tblCourse.on("click","#btnRemove", async function(e) {
            let $row = $(this).closest("tr");
            if ($row.hasClass("child")) $row = $row.prev();
            const data = tblCourse.DataTable().row($row).data();  
            ShowBoxConfirm("Are you sure to remove this course?",function (){
                $.ajax({
                    url: "/course-term/delete/" + data.courseTermId,
                    type: "DELETE", 
                    success: function (response) {
                        showLoading();
                        if (response.code === "200" || response.status?.code === "200") {
                            ShowToastSuccess(response.status.message);
                            $("#tblCourse").DataTable().ajax.reload(null, false);
                            hideLoading(1.5);
                        } else {
                            ShowToastError(response.message || response.status?.message || "Delete failed.");
                        }
                    },
                    error: function (xhr) {
                        ShowToastError(xhr.responseText);
                    }
                });
            });
        });

        btnAddCourse.click(function () { 
            $("#courseTerm_CoursetermId").val(0);
            $("#courseTerm_FieldId").val(cboField.find(":selected").val());
            $("#courseTerm_TermId").val(cboTerm.find(":selected").val());
            modalCourseTerm.modal("show");
        })
        $(document).on("click", "#btnSave", function (e) {
            e.preventDefault(); 
            const formData = $("#courseTermForm").serialize(); 
            $.ajax({
                url: "/course-term/save-changes",
                type: "POST",
                data: formData,
                success: function (response) {
                    if (response.code === "200" || response.status?.code === "200") {
                        ShowToastSuccess(response.status.message);
                        $("#courseTermForm")[0].reset();
                        $("#CourseTermModal").modal("hide");
                        $("#tblCourse").DataTable().ajax.reload(null, false);
                    } else {
                        ShowToastError(response.message || response.status?.message || "Save failed.");
                    }
                },
                error: function (xhr) {
                    ShowToastError(xhr.responseText);
                }
            });
        });

        btnClose.click(function () {
            tblCourse.find("tr").removeClass("highlight");
            modalCourseTerm.modal("hide");
        })

        function updateFilterSummary() {
            const filters = [
                { label: "Degree", select: cboDegree },
                { label: "School", select: cboSchool },
                { label: "Field", select: cboField },
                { label: "Promotion", select: cboPromotion },
                { label: "Stage", select: cboStage },
                { label: "Term", select: cboTerm }
            ];

            const container = $("#activeFilterBadges").empty();

            filters.forEach(function (filter) {
                $("<span>")
                    .addClass("badge badge-light border mr-2 mb-1 px-2 py-2")
                    .text(
                        filter.label + ": " +
                        filter.select.find("option:selected").text().trim()
                    )
                    .appendTo(container);
            });

            $("#activeFilterSummary").removeClass("d-none");
        }
    </script>
}