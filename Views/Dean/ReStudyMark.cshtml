@model BBU_SYSTEM.ViewModel.ListData
@{
    ViewData["Title"] = "Index";
    ViewData["OpenMenu"] = "Dean";
    ViewData["Action"] = "RestudyMark";
}
<style>
    .glass-card {
        border: 0;
        border-radius: 8px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }

    .section-title {
        font-size: .85rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #64748b;
        letter-spacing: .06em;
        margin-bottom: .75rem;
    }

    .soft-panel {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 1rem;
        height: 100%;
    }

    .form-label-sm {
        font-size: .82rem;
        font-weight: 500;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: .25rem;
    }

    .student-search-box .input-group-text {
        border: 0;
        background: #16a34a !important;
        color: #fff;
    }

    .student-search-box input {
        border-right: 0;
    }

    #btnSearchStudent {
        transition: .2s ease;
    }

    #btnSearchStudent:hover {
        transform: translateY(-1px);
        filter: brightness(.95);
    }

    .info-chip {
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: .65rem .75rem;
        min-height: 66px;
    }

    .info-chip label {
        display: block;
        font-size: .82rem;
        font-weight: 500;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: .2rem;
    }

    .score-card {
        border: 0;
        border-radius: 16px;
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.07);
        overflow: hidden;
        padding: .75rem .55rem;
        height: 100%;
    }

    .score-card .card-header {
        border-bottom: 1px solid #e5e7eb;
        background: #fff;
        padding: .8rem .7rem;
    }

    .score-card .card-title {
        font-size: .9rem;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }

    .score-card .card-body {
        padding: .6rem;
    }

    .table-modern {
        margin-bottom: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

    .table-modern thead th {
        background: #f8fafc;
        color: #475569;
        border-bottom: 1px solid #e5e7eb !important;
        font-size: .88rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        padding: .65rem;
    }

    .table-modern tbody td {
        vertical-align: middle;
        padding: .55rem .65rem;
        border-color: #eef2f7;
    }

    .table-modern tbody tr:hover {
        background: #f0fdf4;
    }

    .history-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }

    .history-body {
        height: 210px;
        overflow: auto;
    }

    .action-bar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: .5rem;
        margin-top: 1rem;
    }

    .btn-modern-success {
        border: 0;
        border-radius: 999px;
        padding: .45rem 1rem;
        font-weight: 700;
        background: #16a34a;
        color: #fff;
        box-shadow: 0 8px 18px rgba(22, 163, 74, .25);
    }

    .btn-modern-success:hover {
        color: #fff;
        background: #15803d;
    }

    @@media (max-width: 991.98px) {
        .history-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="py-2">
    <div class="card glass-card">
        <div class="card-body">
            <div class="row">
                <!-- Student Information -->
                <div class="col-lg-5 mb-3 mb-lg-0">
                    <div class="soft-panel">
                        <div class="section-title">
                            <i class="fa-solid fa-user mr-1"></i>
                            Student Information
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label-sm">Student ID</label>
                                <div class="input-group input-group-sm student-search-box">
                                    <input type="text" class="form-control" id="studentId" readonly>
                                    <div class="input-group-append" style="cursor: pointer;" id="btnSearchStudent">
                                        <span class="input-group-text">
                                            <i class="fa-solid fa-magnifying-glass"></i>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="form-label-sm">Name</label>
                                <input type="text" class="form-control form-control-sm" id="studentName" readonly />
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="form-label-sm">Khmer Name</label>
                                <input type="text" class="form-control form-control-sm" id="studentNameInKhmer" readonly />
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="form-label-sm">Date of Birth</label>
                                <input type="text" class="form-control form-control-sm" id="dateOfBirth" readonly>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="form-label-sm">Gender</label>
                                <input type="text" class="form-control form-control-sm" id="sex" readonly />
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="form-label-sm">Phone</label>
                                <input type="text" class="form-control form-control-sm" id="phone" readonly />
                            </div>

                            <div class="col-md-12">
                                <label class="form-label-sm">Status</label>
                                <input type="text" class="form-control form-control-sm" id="status" readonly />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Academic Information -->
                <div class="col-lg-7">
                    <div class="soft-panel">
                        <div class="section-title">
                            <i class="fa-solid fa-building-columns mr-1"></i>
                            Academic Information
                        </div>
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <div class="info-chip">
                                    <label>Degree</label>
                                    <input type="text" class="form-control form-control-sm border-0 pl-1" id="degree" readonly>
                                </div>
                            </div>

                            <div class="col-md-5 mb-3">
                                <div class="info-chip">
                                    <label>School</label>
                                    <input type="text" class="form-control form-control-sm border-0 pl-1" id="school" readonly>
                                </div>
                            </div>

                            <div class="col-md-4 mb-3">
                                <div class="info-chip">
                                    <label>Field</label>
                                    <input type="text" class="form-control form-control-sm border-0 pl-1" id="field" readonly>
                                </div>
                            </div>

                            <div class="col-md-2 col-6 mb-3">
                                <label class="form-label-sm">Promotion</label>
                                <input type="text" class="form-control form-control-sm" id="promotion" readonly>
                            </div>

                            <div class="col-md-2 col-6 mb-3">
                                <label class="form-label-sm">Stage</label>
                                <input type="number" class="form-control form-control-sm" id="stage" readonly>
                            </div>

                            <div class="col-md-2 col-6 mb-3">
                                <label class="form-label-sm">Term</label>
                                <input type="number" class="form-control form-control-sm" id="term" readonly>
                            </div>

                            <div class="col-md-2 col-6 mb-3">
                                <label class="form-label-sm">Group</label>
                                <input type="text" class="form-control form-control-sm" id="group" readonly>
                            </div>

                            <div class="col-md-2 col-6 mb-3">
                                <label class="form-label-sm">Room</label>
                                <input type="text" class="form-control form-control-sm" id="room" readonly>
                            </div>

                            <div class="col-md-2 col-6 mb-3">
                                <label class="form-label-sm">Study Time</label>
                                <input type="text" class="form-control form-control-sm" id="study_time" readonly>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="my-4">

            <div class="row">
                <!-- Main Student Score -->
                <div class="col-xl-6 mb-3 mb-xl-0">
                    <div class="card score-card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h3 class="card-title">
                                <i class="fa-solid fa-table-list text-success mr-1"></i>
                                Student Score
                            </h3>
                            <span class="badge badge-success">Selectable</span>
                        </div>

                        <div class="card-body table-responsive py-2">
                            <table id="tblStudentScore"
                                   class="table table-sm table-modern table-bordered table-hover text-nowrap"
                                   style="width: 100%;">
                                <thead>
                                    <tr>
                                        <th class="hide-col">course_id</th>
                                        <th>Term</th>
                                        <th>Course Name</th>
                                        <th>Midterm</th>
                                        <th>Final</th>
                                        <th>Total</th>
                                        <th>#</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Histories -->
                <div class="col-xl-6">
                    <div class="history-grid">
                        <div class="card score-card">
                            <div class="card-header">
                                <h3 class="card-title">
                                    <i class="fa-solid fa-clock-rotate-left text-primary mr-1"></i>
                                    Exam Score History
                                </h3>
                            </div>

                            <div class="card-body table-responsive p-0 history-body">
                                <table id="tblExamScoreHistory"
                                       class="table table-sm table-bordered table-modern table-head-fixed text-nowrap">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Term</th>
                                            <th>Midterm</th>
                                            <th>Final</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>

                        <div class="card score-card">
                            <div class="card-header">
                                <h3 class="card-title">
                                    <i class="fa-solid fa-book-open-reader text-success mr-1"></i>
                                    Re-Study Score History
                                </h3>
                            </div>

                            <div class="card-body table-responsive p-0 history-body">
                                <table id="tblReStudyScoreHistory"
                                       class="table table-sm table-bordered table-modern table-head-fixed text-nowrap">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Midterm</th>
                                            <th>Final</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>

                        <div class="card score-card">
                            <div class="card-header">
                                <h3 class="card-title">
                                    <i class="fa-solid fa-rotate-right text-warning mr-1"></i>
                                    Re-Exam 1
                                </h3>
                            </div>

                            <div class="card-body table-responsive p-0 history-body">
                                <table id="tblReExam1"
                                       class="table table-sm table-bordered table-modern table-head-fixed text-nowrap">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Term</th>
                                            <th>Midterm</th>
                                            <th>Final</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>

                        <div class="card score-card">
                            <div class="card-header">
                                <h3 class="card-title">
                                    <i class="fa-solid fa-rotate text-warning mr-1"></i>
                                    Re-Exam 2
                                </h3>
                            </div>

                            <div class="card-body table-responsive p-0 history-body">
                                <table id="tblReExam2"
                                       class="table table-sm table-bordered table-modern table-head-fixed text-nowrap">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Term</th>
                                            <th>Midterm</th>
                                            <th>Final</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="action-bar">
                        <button class="btn btn-modern-success btn-sm">
                            <i class="fas fa-plus mr-1"></i>
                            Add Re-Study Subject
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_studentPartial"/>

@section Scripts
{
    <script>
        const tblStudentScore = $("#tblStudentScore");
        const tblExamScoreHistory = $("#tblExamScoreHistory");
        const tblReStudyScoreHistory  = $("#tblReStudyScoreHistory");


        const tblReExam1 = $("#tblReExam1");
        const tblReExam2 = $("#tblReExam2");
        const studentId = $("#studentId");
        $(document).ready(function () {
            tblStudentScore.DataTable({
                responsive: true,
            });
        });

        $("#btnSearchStudent").on("click", function (e) {
            e.preventDefault();
            $("#StudentModal").modal("show");
            const tblSearchStudent = $("#tblSearchStudent");
            tblSearchStudent.DataTable().clear().destroy();
            tblSearchStudent.DataTable({
                processing: true,
                serverSide: true,
                paging: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                responsive: true,
                autoWidth: true,
                scrollCollapse: true,
                ajax: {
                    url: "/student/academic/student-list/all",
                    type: "POST",
                },
                columns: [
                    {data: "studentId"},
                    {data: "studentName"},
                    {data: "studentNameInKhmer"},
                    {data: "sex"},
                    {
                        data: null,
                        render: function (data, type, row) {
                            if (row.status === "REGISTER") {
                                return ` <span class="badge badge-warning">${row.status}</span>`;
                            } else if (row.status === "ACTIVE") {
                                return ` <span class="badge badge-primary">${row.status}</span>`;
                            } else if (row.status === "QUIT") {
                                return ` <span class="badge badge-danger">${row.status}</span>`;
                            } else {
                                return `<span class="badge badge-secondary">${row.status}</span>`;
                            }
                        },
                    },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `<a onclick="OnSelectStudent(this)"  class="btn btn-success btn-xs">Select</a>`;
                        },
                    },
                ],
                initComplete: function () {
                    MyApp.utils.dataTableDebounceSearch("#tblSearchStudent", 500);
                }
            });
        });

        function OnSelectStudent(e) {
            const $input = $(e);
            const $row = $input.closest('tr');
            const selectedRow = $("#tblSearchStudent").DataTable().row($row).data();
            if (selectedRow) {
                getStudent(selectedRow.studentId);
                getStudentScore(selectedRow.studentId);
                $("#StudentModal").modal("hide");
            }
        }

        function getStudent(student_id) {
            $.ajax({
                url: "/student/academic/student-id/" + student_id,
                type: "GET",
                data: {student_id: student_id},
                success: function (res) {
                    const data = res.data;
                    if (data) {
                        const student = data.student ?? {};
                        const degree = data.degree ?? {};
                        const school = data.school ?? {};
                        const field = data.field ?? {};
                        const promotion = data.promotion ?? {};
                        const stage = data.stage ?? {};
                        const term = data.term ?? {};
                        const group = data.group ?? {};
                        const groupRoom = data.groupRoom ?? {};
                        const registry = data.registry ?? {};

                        $("#studentId").val(student.studentId ?? "");
                        $("#studentName").val(student.studentName ?? "");
                        $("#studentNameInKhmer").val(student.studentNameInKhmer ?? "");
                        $("#phone").val(student.phone ?? "");

                        if (student.dateOfBirth) {
                            $("#dateOfBirth").val(formatDate(student.dateOfBirth, "DD-MMM-YYYY"));
                        } else {
                            $("#dateOfBirth").val("");
                        }

                        $("#sex").val(student.sex ?? "");
                        $("#status").val(student.status ?? "");

                        $("#degree").val(degree.degreeName ?? "");
                        $("#school").val(school.schoolName ?? "");
                        $("#field").val(field.fieldName ?? "");

                        $("#promotion").val(promotion.promotionNo ?? "");
                        $("#stage").val(stage.stageNo ?? "");
                        $("#term").val(term.termNo ?? "");

                        $("#group").val(group.groupName ?? "");
                        $("#room").val(groupRoom.roomName ?? group.roomName ?? "");
                        $("#study_time").val(groupRoom.studyTime ?? group.studyTime ?? "");
                    } else {
                        alert("Student not found.");
                    }
                },
                error: function () {
                    alert("Error fetching student data.");
                }
            });
        }

        function getStudentScore(student_id) {
            tblStudentScore.DataTable().clear().destroy();
            tblStudentScore.DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                ajax: {
                    url: "/scores/get-student-score/" + student_id,
                    type: "POST",
                },
                columns: [
                    {data: "courseId"},
                    {data: "termNo"},
                    {data: "courseFullName"},
                    {
                        data: "midTermScore",
                        render: function (data, type, row) {
                            return `<input type="number" class="form-control form-control-sm form-control form-control-sm-sm is-warning" name="midterm" value="${data ? data.toFixed(2) : 0.00}" readonly/>`;
                        }
                    },
                    {
                        data: "finalScore",
                        render: function (data, type, row) {
                            return `<input type="number" class="form-control form-control-sm form-control form-control-sm-sm is-warning" name="final" value="${data ? data.toFixed(2) : 0.00}" readonly/>`;
                        }
                    },
                    {
                        data: null,
                        render: function (data, type, row) {
                            const mid = parseInt(row.midTermScore);
                            const fin = parseInt(row.finalScore);
                            return mid + fin;
                        }
                    },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `<button id="btnEdit" class="btn btn-warning btn-sm"><i class="fa-solid fa-pen-to-square"></i></button>`;
                        }
                    }
                ],
                columnDefs: [
                    {
                        targets: [0],
                        visible: false,
                        searchable: false
                    }
                ]
            })
        }

        tblStudentScore.on("click", "tbody tr", function (e) {
            e.preventDefault();
            tblStudentScore.find('tbody tr').removeClass('highlight');
            $(this).addClass('highlight');
            const $row = $(this).closest('tr');
            const selectedRow = tblStudentScore.DataTable().row($row).data();
            GetScoreHistory(studentId.val());
            GetReStudyHistory(studentId.val(), selectedRow.courseId);
        });

        async function GetScoreHistory(student_id) {
            try {
                const response = await $.ajax({
                    url: "/scores/get-score-history/" + student_id,
                    method: 'POST',
                    data: {isAll: true}
                });
                if (response.status.code === "200") {
                    tblExamScoreHistory.find("tbody").empty();
                    response.data.forEach(item => {
                        tblExamScoreHistory.find("tbody").append(`
                            <tr>
                                <td>${item.courseId}</td>
                                <td>${item.termNo}</td>
                                <td>${item.midTermScore}</td>
                                <td>${item.finalScore}</td>
                            </tr>
                        `);
                    });
                } else {
                    console.log(response.status.code);
                }
            } catch (err) {
                console.log(err?.responseText ?? err);
            }

        }

        async function GetReStudyHistory(studentId,courseId) {
            try {
                const response = await $.ajax({
                    url: `/scores/get-restudy-history/${studentId}/${courseId}`,
                    method: 'POST',
                    data: {isAll: true}
                });
                if (response.status.code === "200") {
                    tblReStudyScoreHistory.find("tbody").empty();
                    response.data.forEach(item => {
                        tblReStudyScoreHistory.find("tbody").append(`
                            <tr>
                                <td>${item.courseId}</td> 
                                <td>${item.midTermScore}</td>
                                <td>${item.finalScore}</td>
                            </tr>
                        `);
                    });
                } else {
                    console.log(response.status.code);
                }
            } catch (err) {
                console.log(err?.responseText ?? err);
            }
        }
        
        tblStudentScore.on("click", "#btnEdit", function (event) {
            event.preventDefault(); 
            const $row = $(this).closest('tr'); 
            $row.find('input[name="midterm"]').prop('readonly', false);
            $row.find('input[name="final"]').prop('readonly', false);

            $(this)
                .attr('id', 'btnSave')
                .removeClass('btn-warning')
                .addClass('btn-success')
                .html('<i class="fas fa-check"></i>');
        });
        tblStudentScore.on("click", "#btnSave", function (event) {
            event.preventDefault();
            const $row = $(this).closest('tr'); 
            $row.find('input[name="midterm"]').prop('readonly', true);
            $row.find('input[name="final"]').prop('readonly', true);

            $(this)
                .attr('id', 'btnEdit')
                .removeClass('btn-success')
                .addClass('btn-warning')
                .html('<i class="fa-solid fa-pen-to-square"></i>');
        });
    </script>
}
