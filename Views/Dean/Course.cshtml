@model BBU_SYSTEM.ViewModel.ListData
@{
    ViewData["Title"] = "Index";
    ViewData["OpenMenu"] = "Dean";
    ViewData["Action"] = "DeanCourse";
}
<div class="row">
    <div class="col-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">School</h3>
            </div>
            <div class="card-body">
                <table id="tblSchool" class="table table-bordered table-sm table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>id</th>
                        @* <th>code</th> *@
                        <th>name</th>
                        @* <th>name_khmer</th> *@
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Courses</h3>
                <button id="btnAssignSubject" class="btn btn-primary btn-sm float-right"><i class="fas fa-add"></i>
                    Assign subject
                </button>
            </div>
            <div class="card-body">
                <table id="tblCourse" class="table table-bordered table-sm table-striped" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>id</th>
                        @* <th>code</th> *@
                        <th>name</th>
                        <th>name_khmer</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<partial name="_ValidationScriptsPartial"/>
<partial name="_AssignCourse"/>

@section Scripts
{
    <script>
        const tblSchool = $("#tblSchool");
        const btnAssignSubject = $("#btnAssignSubject");
        const btnAssignCourse = $("#btnAssignCourse");
        const tblAssignCourse = $("#tblAssignCourse");
        const tblCourse = $("#tblCourse");
        $(document).ready(function () {
            fetchSchool();
            tblCourse.DataTable({responsive: true,});
            btnAssignSubject.prop("disabled", true);
        });

        function fetchSchool() { 
            tblSchool.DataTable().clear().destroy();
            tblSchool.DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                ajax: {
                    url: "/school/get-schools",
                    type: "POST",
                },
                columns: [
                    {data: "schoolId"}, 
                    {data: "schoolName"}, 
                ]
            })
        }

        tblSchool.on('click', 'tbody tr', function () {
            tblSchool.find('tbody tr').removeClass('highlight');
            $(this).addClass('highlight');

            const schoolId = tblSchool.find('tbody tr.highlight td:eq(0)').text().trim();
            fetchCourse(schoolId);
            btnAssignSubject.prop("disabled", false);
        });

        function fetchCourse(schoolId) {
            tblCourse.DataTable().clear().destroy();
            tblCourse.DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                orderings: true,
                ajax: {
                    url: "/course-school/get-course-school/" + schoolId,
                    type: "POST",
                },
                columns: [
                    {data: "courseId"},
                    {data: "courseFullName"},
                    {data: "courseFullNameInKhmer"}
                ]
            })
        }

        btnAssignSubject.on('click', function () {
            tblAssignCourse.DataTable().clear().destroy();
            tblAssignCourse.DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                ajax: {
                    url: "/course/get-courses",
                    type: "POST",
                },
                columns: [
                    {data: "courseId"},
                    {data: "courseFullName"},
                    {data: "courseShortName"},
                    {data: "credit"},
                    {data: "numberOfHours"},
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `<a class="btn btn-secondary btn-xs" id="btnSelectSubject">select</a>`;
                        }
                    },
                ]
            })
            $("#AssignCourseModal").modal("show");
        });

        tblAssignCourse.on('click', '#btnSelectSubject', function (e) {
            e.preventDefault();
            const $row = $(this).closest('tr');
            const json = tblAssignCourse.DataTable().row($row).data();
            console.log(json);
            const value = json.courseId;
            const text = value + "-" + json.courseFullName;

            if ($('#stateSelect option[value="' + value + '"]').length === 0) {
                const newOption = new Option(text, value, true, true);
                $('#stateSelect').append(newOption).trigger('change');
            }
        });

        btnAssignCourse.on('click', function () {
            const selectedValues = $('#stateSelect').val(); 
            selectedValues.forEach(selectedValue => {
                console.log(selectedValue);
            })
        });
    </script>
}
