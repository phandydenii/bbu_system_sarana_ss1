@{
    ViewData["Title"] = "Index";
    ViewData["OpenMenu"] = "Dean";
    ViewData["Action"] = "PracticumMark";
    ViewData["HideHeader"] = true;
}

<style>
    .filter-drawer .modal-dialog {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        width: 460px;
        max-width: 100%;
        height: 100%;
        margin: 0;
    }

    .filter-drawer.fade .modal-dialog {
        transform: translateX(100%);
        transition: transform .3s ease;
    }

    .filter-drawer.show .modal-dialog {
        transform: translateX(0);
    }

    .filter-drawer .modal-content {
        height: 100%;
        border: 0;
        border-radius: 0;
        box-shadow: -8px 0 30px rgba(0, 0, 0, .12);
    }

    .filter-drawer .modal-header,
    .filter-drawer .modal-footer {
        flex-shrink: 0;
        padding: 16px 24px;
    }

    .filter-drawer .modal-body {
        flex: 1 1 auto;
        overflow-y: auto;
        padding: 24px;
    }

    .filter-drawer .form-group {
        margin-bottom: 20px;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="m-0 font-weight-bold text-dark">Practicum Mark</h3>
        <small class="text-muted">Record, manage, and evaluate student internship scores, practical field training marks, and hands-on performance assessment results</small>
    </div>
    <button type="button"
            class="btn btn-outline-primary"
            data-toggle="modal"
            data-target="#PracticumFilterModal">
        <i class="fas fa-filter mr-1"></i> Filter
    </button>
</div>

<div class="row">
    <div class="col-12">
        <div class="card"> 
            <div class="card-body">
                <div id="activeFilterSummary"
                     class="d-none mb-3"
                     role="status"
                     aria-live="polite">
                    <div class="d-flex align-items-center flex-wrap">
                        <small class="text-primary font-weight-bold mr-2 mb-1">
                            <i class="fas fa-filter mr-1"></i> Filtered by:
                        </small>

                        <div id="activeFilterBadges" class="d-flex flex-wrap"></div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-5">
                        <div class="card card-outline card-primary">
                            <div class="card-header bg-white d-flex align-items-center justify-content-between">
                                <h3 class="card-title font-weight-bold text-primary m-0"><i class="fas fa-user-graduate mr-2"></i>Student List</h3>
                                <h4 id="studentCountText" class="text-muted mb-0 ml-auto text-end" style="font-size: 18px;font-weight: 500;"></h4>
                            </div>
                            <div class="card-body">
                                <table id="tblStudent" class="table table-sm table-bordered table-striped">
                                    <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Name</th>
                                        <th>Gender</th>
                                        <th>DOB</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-7">
                        <div class="card card-outline card-primary">
                            <div class="card-header bg-white d-flex align-items-center justify-content-between">
                                <h3 class="card-title font-weight-bold text-primary m-0"><i class="fas fa-star mr-2"></i>Score Performance</h3>
                                <span class="badge badge-pill badge-info px-3 py-2 font-weight-normal" id="lblStudentName" style="display:none;"></span>
                            </div>
                            <div class="card-body">
                                <table id="tblScore" class="table table-sm table-bordered table-striped">
                                    <thead>
                                    <tr>
                                        <th class="hide-col">id</th>
                                        <th class="hide-col">student_group_id</th>
                                        <th>name</th>
                                        <th>midterm</th>
                                        <th>final</th>
                                        <th>grade</th>
                                        <th>action</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade filter-drawer"
     id="PracticumFilterModal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="practicumFilterTitle"
     aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title font-weight-bold"
                    id="practicumFilterTitle">
                    <i class="fas fa-filter mr-2 text-primary"></i>
                    Filter Criteria
                </h5>

                <button type="button" class="close"
                        data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="form-group">
                    <label for="cboDegree">Degree</label>
                    <select id="cboDegree" class="form-control select2"></select>
                </div>

                <div class="form-group">
                    <label for="cboSchool">School</label>
                    <select id="cboSchool" class="form-control select2"></select>
                </div>

                <div class="form-group">
                    <label for="cboField">Field</label>
                    <select id="cboField" class="form-control select2"></select>
                </div>

                <div class="form-group">
                    <label for="cboPromotion">Promotion</label>
                    <select id="cboPromotion" class="form-control select2"></select>
                </div>

                <div class="form-group">
                    <label for="cboStage">Stage</label>
                    <select id="cboStage" class="form-control select2"></select>
                </div>

                <div class="form-group">
                    <label for="cboTerm">Term</label>
                    <select id="cboTerm" class="form-control select2"></select>
                </div>

                <div class="form-group">
                    <label for="cboGroup">Group</label>
                    <select id="cboGroup" class="form-control select2"></select>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-light"
                        data-dismiss="modal">
                    Close
                </button>

                <button type="button" class="btn btn-primary" id="btnFilter">
                    <i class="fas fa-check mr-1"></i> Apply Filter
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/function/Degree.js"></script>
    <script src="~/function/School.js"></script>
    <script src="~/function/Field.js"></script>
    <script src="~/function/Promotion.js"></script>
    <script src="~/function/Stage.js"></script>
    <script src="~/function/Term.js"></script>
    <script src="~/function/Group.js"></script>
    <script>
        const cboDegree = $("#cboDegree");
        const cboSchool = $("#cboSchool");
        const cboField = $("#cboField");
        const cboPromotion = $("#cboPromotion");
        const cboStage = $("#cboStage");
        const cboTerm = $("#cboTerm");
        const cboGroup = $("#cboGroup");
        const tblStudent = $("#tblStudent");
        const tblScore = $("#tblScore");

        let appliedFilters = null;

        const academicFilters = [
            { label: "Degree", select: cboDegree },
            { label: "School", select: cboSchool },
            { label: "Field", select: cboField },
            { label: "Promotion", select: cboPromotion },
            { label: "Stage", select: cboStage },
            { label: "Term", select: cboTerm },
            { label: "Group", select: cboGroup }
        ];

        function resetFilter(select, label) {
            select.empty()
                .append(new Option("Select " + label, "", true, true))
                .trigger("change.select2");
        }

        function resetScoreTable() {
            if ($.fn.DataTable.isDataTable("#tblScore")) {
                tblScore.DataTable().destroy();
            }

            tblScore.find("tbody").empty();

            tblScore.DataTable({
                responsive: true,
                columnDefs: [
                    { targets: [0, 1], visible: false }
                ],
                language: {
                    emptyTable: "Select a student to view practicum scores."
                }
            });
        }

        $(document).ready(function () {
            $("#PracticumFilterModal .select2").select2({
                dropdownParent: $("#PracticumFilterModal"),
                width: "100%"
            });

            academicFilters.forEach(function (filter) {
                resetFilter(filter.select, filter.label);
            });

            tblStudent.DataTable({
                responsive: true,
                language: {
                    emptyTable: "Apply filters to load students."
                }
            });

            resetScoreTable();

            GetDegree();
            GetSchool();
        });

        $("#btnFilter").on("click", OnFilter);

        cboDegree.add(cboSchool).on("change", function () {
            resetFilter(cboField, "Field");
            resetFilter(cboPromotion, "Promotion");
            resetFilter(cboStage, "Stage");
            resetFilter(cboTerm, "Term");
            resetFilter(cboGroup, "Group");

            GetField();
            GetPromotion();
        });

        cboPromotion.on("change", function () {
            resetFilter(cboStage, "Stage");
            resetFilter(cboTerm, "Term");
            resetFilter(cboGroup, "Group");

            GetStage();
        });

        cboStage.on("change", function () {
            resetFilter(cboTerm, "Term");
            resetFilter(cboGroup, "Group");

            GetTerm();
            GetGroup();
        });

        cboField.on("change", function () {
            resetFilter(cboGroup, "Group");
            GetGroup();
        }); 

        async function GetDegree() {
            cboDegree.empty();
            cboDegree.append(`<option value='' disabled>Select Degree</option>`);
            const degrees = await Degree.GetAllDegree();
            degrees.forEach(item => {
                cboDegree.append(`<option value='${item.degreeId}'>${item.degreeName}</option>`);
            });
            cboDegree.val('').trigger("change");
        }

        async function GetSchool() {
            cboSchool.empty();
            cboSchool.append("<option value='' disabled>Select School</option>");
            const schools = await School.GetSchool()
            schools.forEach(function (item) {
                cboSchool.append(`<option value='${item.schoolId}'>${item.schoolName}</option>`);
            });
            cboSchool.val('').trigger("change");
        }


        async function GetField() {
            const degreeId = parseInt(cboDegree.val());
            const schoolId = parseInt(cboSchool.val());
            cboField.empty();
            cboField.append("<option value='' disabled>Select Field</option>");
            if (!degreeId || !schoolId) {
                cboField.val('');
                return;
            }
            const fields = await Field.GetFields({isAll: true, degreeId, schoolId});
            fields.forEach(item => {
                cboField.append(`<option value='${item.fieldId}'>${item.fieldName}</option>`);
            });
            cboField.val('').trigger("change");
        }

        async function GetPromotion() {
            const degreeId = cboDegree.val();
            const schoolId = cboSchool.val();
            cboPromotion.empty();
            cboPromotion.append("<option value='' disabled>Select Promotion</option>");
            if (!degreeId || !schoolId) {
                cboPromotion.val('');
                return;
            }
            const promotions = await Promotion.GetPromotions({schoolId,degreeId});
            let hasPromotion = false;
            promotions.forEach(item => {
                cboPromotion.append(`<option value='${item.promotionId}'>${item.promotionNo}</option>`);
                hasPromotion = true;
            });
            if (!hasPromotion) {
                cboPromotion.empty();
                cboPromotion.append("<option value='' disabled>No promotion available</option>");
            }
            cboPromotion.val('').trigger("change");
        }

        async function GetStage() {
            const promotionId = cboPromotion.val();
            cboStage.empty();
            cboStage.append("<option value='' disabled>Select Stage</option>");
            if (!promotionId) {
                cboPromotion.val('');
                return;
            }
            const stages = await Stage.GetStages({promotionId});
            stages.forEach(item => {
                cboStage.append(`<option value='${item.stageId}'>${item.stageNo}</option>`);
            });
            cboStage.val('').trigger("change");
        }

        async function GetTerm() {
            const stageId = cboStage.val();
            cboTerm.empty();
            cboTerm.append("<option value='' disabled>Select Term</option>");
            if (!stageId) {
                cboTerm.val('');
                return;
            }
            const terms = await Term.GetTerms({stageId});
            terms.forEach(item => {
                cboTerm.append(`<option value='${item.termNo}'>${item.termNo}</option>`);
            });
            cboTerm.val('').trigger("change");
        }

        async function GetGroup() {
            const stageId = cboStage.val();
            const fieldId = cboField.val();

            cboGroup.empty();
            cboGroup.append("<option value='' disabled>Select Group</option>");
            if (!stageId || !fieldId) {
                cboGroup.val('');
                return;
            }
            const groups = await Group.GetGroups({fieldId,stageId});
            groups.forEach(item => {
                cboGroup.append(`<option value='${item.groupId}'>${item.groupName}</option>`);
            });
            cboGroup.val('').trigger("change");
        }


        function OnFilter() {
            if (academicFilters.some(filter => !(Number(filter.select.val()) > 0))) {
                ShowToastInfo("Please select all filter criteria.");
                return;
            }
            appliedFilters = {
                groupId: cboGroup.val(),
                termNo: cboTerm.val()
            };
            const container = $("#activeFilterBadges").empty();
            academicFilters.forEach(function (filter) {
                $("<span>")
                    .addClass("badge badge-light border mr-2 mb-1 px-2 py-2")
                    .text(
                        filter.label + ": " +
                        filter.select.find("option:selected").text().trim()
                    )
                    .appendTo(container);
            });
            $("#activeFilterSummary").removeClass("d-none");
            $("#PracticumFilterModal").modal("hide");
            $("#lblStudentName").hide().text("");
            resetScoreTable();
            if ($.fn.DataTable.isDataTable("#tblStudent")) {
                tblStudent.DataTable().destroy();
            }
            tblStudent.find("tbody").empty();
            tblStudent.DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                info: false,
                language: {
                    emptyTable: "No students available for these filters.",
                    zeroRecords: "No matching students found."
                },
                ajax: {
                    url: "/student/GetStudents",
                    type: "POST",
                    data: {
                        groupid: appliedFilters.groupId,
                        termno: appliedFilters.termNo
                    }
                },
                drawCallback: function () {
                    const info = this.api().page.info();
                    const start = info.recordsDisplay > 0 ? info.start + 1 : 0;

                    $("#studentCountText").text(
                        `Showing ${start} to ${info.end} of ${info.recordsDisplay}`
                    );
                },
                columns: [
                    { data: "studentId" },
                    { data: "studentName" },
                    { data: "sex" },
                    {
                        data: "dateOfBirth",
                        render: function (data) {
                            return formatDate(data);
                        }
                    }
                ],
                initComplete: function () {
                    MyApp.utils.dataTableDebounceSearch("#tblStudent", 500);
                }
            });
        }

        tblStudent.on("click", "tbody tr", function () {
            let row = $(this); 
            if (row.hasClass("child")) {
                row = row.prev();
            } 
            const data = tblStudent.DataTable().row(row).data(); 
            if (!data || !data.studentGroupId) return;

            tblStudent.find("tbody tr").removeClass("highlight");
            row.addClass("highlight"); 
            $("#lblStudentName").text(`${data.studentId} - ${data.studentName}`).show();
            GetScores(data.studentGroupId);
        });

        function GetScores(student_group_id) {
            if (!student_group_id) return;
            if ($.fn.DataTable.isDataTable("#tblScore")) {
                tblScore.DataTable().destroy();
            }
            tblScore.find("tbody").empty();
            tblScore
                .DataTable({
                    processing: true,
                    serverSide: true,
                    responsive: true,
                    ajax: {
                        url: `/scores/get-scores/${student_group_id}`,
                        type: "POST",
                        data: {
                            type: "PRACTICUM"
                        },
                    },
                    columns: [
                        {data: "scoreId", visible: false},
                        {data: "studentGroupId", visible: false},
                        {data: "courseName"},
                        {
                            data: "midTermScore",
                            render: function (data, type, row) {
                                return `<input type="number" class="form-control form-control-sm is-warning" name="midterm" value="${data ? data.toFixed(2) : 0.00}" readonly/>`;
                            }
                        },
                        {
                            data: "finalScore",
                            render: function (data, type, row) {
                                return `<input type="number" class="form-control form-control-sm is-warning" name="final" value="${data ? data.toFixed(2) : 0.00}" readonly/>`;
                            }
                        },
                        {
                            data: null,
                            render: function (data, type, row) {
                                const totalScore = (row.midTermScore || 0) + (row.finalScore || 0);
                                if (totalScore >= 60) {
                                    return `<badge class="badge badge-success">Pass</badge>`;
                                } else {
                                    return `<badge class="badge badge-danger">Fail</badge>`;
                                }
                            }
                        },
                        {
                            data: null,
                            render: function (data, type, row) {
                                return `<button class="btn btn-warning btn-sm" id="btnEdit"><i class="fa-solid fa-pen-to-square"></i></button>`;
                            }
                        }
                    ]
                });
        }

        tblScore.on("click", "#btnEdit", function () {
            // Find the clicked row
            const $row = $(this).closest('tr'); 
            $row.find('input[name="midterm"]').prop('readonly', false);
            $row.find('input[name="final"]').prop('readonly', false);

            // Optionally change button to Save
            $(this)
                .attr('id', 'btnSave')
                .removeClass('btn-warning')
                .addClass('btn-success')
                .html('<i class="fas fa-check"></i>');
        });

        tblScore.on("click", "#btnSave", function () {
            // Find the clicked row
            const $row = $(this).closest('tr');
            // Enable the input fields in this row
            $row.find('input[name="midterm"]').prop('readonly', true);
            $row.find('input[name="final"]').prop('readonly', true);

            // Optionally change button to Save
            $(this)
                .attr('id', 'btnEdit')
                .removeClass('btn-success')
                .addClass('btn-warning')
                .html('<i class="fa-solid fa-pen-to-square"></i>');
        });
    </script>
}
